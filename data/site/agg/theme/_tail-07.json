50,"th":["哲理","尊师","崇儒"],"ap":1},{"id":"6d3b5c98850d","t":"论语·子张篇 其24","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"叔孙武叔毁仲尼，子贡曰：“无以为也，仲尼不可毁也。他人之贤者，丘陵也，犹可逾也；仲尼，日月也，无得而逾焉。人虽欲自绝，其何伤于日月乎？多见其不知量也。”","b":2,"y":-450,"th":["哲理","尊师","论辩"],"ap":1},{"id":"186fb700e1ba","t":"孟子·公孙丑上 其31","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「否。自有生民以来，未有孔子也。」","b":4,"y":-320,"th":["哲理","尊师","崇圣"],"ap":1}],"t262":[{"id":"554c000832fe","t":"哀命","a":"东方朔","d":1,"f":"楚辞","g":"诗","x":"哀时命之不合兮，伤楚国之多忧。","b":5,"y":-300,"th":["怀古","忠贞","悲愤"],"ap":1},{"id":"e4f26c165293","t":"守志","a":"王逸","d":1,"f":"楚辞","g":"诗","x":"陟玉峦兮逍遥，览高冈兮峣峣。","b":5,"y":-300,"th":["忠贞","神游","咏怀","政治抱负"],"ap":1},{"id":"769b5ab274f5","t":"咏灯","a":"南唐先主李昪","d":6,"f":"七绝","g":"诗","x":"一点分明值万金，开时惟怕冷风侵。","b":4,"y":750,"th":["咏物","忠贞","哲理"],"ap":1},{"id":"de18afc0459c","t":"伏读二刘公瑞岩留题感事兴怀至于陨涕追次元韵偶成二篇  其一","a":"朱熹","d":8,"f":"七律","g":"诗","x":"谁将健笔写崖阴，想见当年抱膝吟。","b":3,"y":1190,"th":["怀古","感时","忠贞","伤逝"],"ap":1},{"id":"bcf34ec228d8","t":"过零丁洋","a":"文天祥","d":8,"f":"七律","g":"诗","x":"辛苦遭逢起一经，干戈落落四周星。","b":4,"y":1279,"th":["爱国","忠贞","人生哲理"],"ap":1}],"t271":[{"id":"29ba2b743e4d","t":"杂曲歌辞 行路难三首 一","a":"李白","d":6,"f":"古体","g":"诗","x":"金尊清酒斗十千，玉盘珍羞直万钱。","b":3,"y":736,"th":["仕途坎坷","理想抱负","人生哲理"],"ap":1},{"id":"7dd16b8daca8","t":"鼓吹曲辞 君马黄","a":"李白","d":6,"f":"古体","g":"诗","x":"君马黄，我马白。","b":3,"y":740,"th":["友情","人生哲理","世态炎凉"],"ap":1},{"id":"51fbbb991a6a","t":"遣悲怀三首 三","a":"元稹","d":6,"f":"七律","g":"诗","x":"闲坐悲君亦自悲，百年都是几多时。","b":8,"y":811,"th":["爱情","悼亡","人生哲理"],"ap":1},{"id":"24d7436e338d","t":"无题","a":"李商隐","d":6,"f":"七律","g":"诗","x":"相见时难别亦难，东风无力百花残。","b":9,"y":848,"th":["爱情","离别","人生哲理"],"ap":1},{"id":"bcf34ec228d8","t":"过零丁洋","a":"文天祥","d":8,"f":"七律","g":"诗","x":"辛苦遭逢起一经，干戈落落四周星。","b":4,"y":1279,"th":["爱国","忠贞","人生哲理"],"ap":1}],"t293":[{"id":"2a5597e36409","t":"孟子·梁惠王上 其42","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「王之所大欲可得闻与？」王笑而不言。","b":4,"y":-320,"th":["哲理","政治","心理"],"ap":1},{"id":"9e78ca8e0b10","t":"诈妮子调风月・幺篇","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"教人道\"眼里无珍