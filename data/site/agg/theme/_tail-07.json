27,"th":["爱情","乐府"],"ap":1},{"id":"bebabdcbd9dc","t":"横吹曲辞 捉搦歌","a":"张祜","d":6,"f":"古体","g":"诗","x":"门上关，墙上棘，窗中女子声唧唧，洛阳大道徒自直。","b":9,"y":827,"th":["婚嫁","闺怨","乐府"],"ap":1}],"t154":[{"id":"ae5fa8015092","t":"论语·雍也篇 其9","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"季氏使闵子骞为费宰，闵子骞曰：“善为我辞焉。如有复我者，则吾必在汶上矣。”","b":1,"y":-500,"th":["气节","辞官","守道"],"ap":1},{"id":"551fbf9cdf81","t":"论语·卫灵公篇 其2","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"在陈绝粮，从者病莫能兴。子路愠见曰：“君子亦有穷乎？”子曰：“君子固穷，小人穷斯滥矣。”","b":2,"y":-489,"th":["哲理","气节","修身"],"ap":1},{"id":"ef6ee2c8e508","t":"孟子·公孙丑下 其56","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「非也。于崇，吾得见王。退而有去志，不欲变，故不受也。继而有师命，不可以请。久于齐，非我志也。」","b":4,"y":-320,"th":["哲理","气节","家国"],"ap":1},{"id":"f51965782d5e","t":"孟子·公孙丑下 其3","a":"孟子","d":1,"f":"文","g":"文","x":"明日，出吊于东郭氏，公孙丑曰：「昔者辞以病，今日吊，或者不可乎！」曰：「昔者疾，今日愈，如之何不吊？」","b":4,"y":-320,"th":["哲理","处世","气节"],"ap":1},{"id":"29d18072c69b","t":"孟子·滕文公下 其2","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「昔齐景公田，招虞人以旌，不至，将杀之。志士不忘在沟壑，勇士不忘丧其元。孔子奚取焉？取非其招不往也，如不待其招而往，何哉？且夫枉尺而直寻者，以利言也。如以利，则枉寻直尺而利，亦可为与？昔者赵简子使王良与嬖奚乘，终日而不获一禽。嬖奚反命曰：『天下之贱工也。』或以告王良。良曰：『请复之。』彊而后可，一朝而获十禽。嬖奚反命曰：『天下之良工也。』简子曰：『我使掌与女乘。』谓王良。良不可，曰：『吾为之范我驰驱，终日不获一；为之诡遇，一朝而获十。《诗》云：「不失其驰，舍矢如破。」我不贯与小人乘，请辞。』御者且羞与射者比。比而得禽兽，虽若丘陵，弗为也。如枉道而从彼，何也？且子过矣，枉己者，未有能直人者也。」","b":5,"y":-300,"th":["哲理","气节","守正"],"ap":1},{"id":"4aa58a78dc7b","t":"孟子·滕文公下 其29","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「古者不为臣不见。段干木逾垣而辟之，泄柳闭门而不内，是皆已甚。迫，斯可以见矣。阳货欲见孔子而恶无礼，大夫有赐于士，不得受于其家，则往拜其门。阳货矙孔子之亡也，而馈孔子蒸豚；孔子亦矙其亡也，而往拜之。当是时，阳货先，岂得不见？曾子曰：『胁肩谄笑，病于夏畦。』子路曰：『未同而言，观其色赧赧然，非由之所知也。』由是观之，则君子之所养可知已矣。」","b":5,"y":-300,"th":["哲理","气节","礼制"],"ap":1},{"id":"ca84ba05cee0","t":"孟子·公孙丑下 其12","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「不待三。」","b":5,"y":-300,"th":["哲理","治国","气节"],"ap":1},{"id":"db5b659db711","t":"夏日绝句","a":"李清照","d":8,"f":"五绝","g":"诗","x":"生当为人杰，死亦作鬼雄。","b":3,"y":1127,"th":["怀古","咏史","气节"],"ap":1},{"id":"41a1fafe14bb","t":"题画菊","a":"郑思肖","d":8,"f":"七绝","g":"诗","x":"花开不并百花丛，独立疏篱趣未穷。","b":4,"y":1279,"th":["咏物","气节","孤高"],"ap":1},{"id":"1ca8b6515efd","t":"正气歌","a":"