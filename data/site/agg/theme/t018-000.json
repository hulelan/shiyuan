[{"id":"ec64a7a9d8ae","t":"考槃","a":"佚名","d":1,"f":"诗经","g":"诗","x":"考槃在涧，硕人之宽。独寐寤言，永矢弗谖。","b":0,"y":-700,"th":["隐逸","咏人","高洁"],"ap":1},{"id":"9f70fbe1f516","t":"论语·微子篇 其5","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"楚狂接舆歌而过孔子曰：“凤兮凤兮，何德之衰？往者不可谏，来者犹可追。已而已而，今之从政者殆而！”孔子下，欲与之言，趋而辟之，不得与之言。","b":1,"y":-500,"th":["哲理","隐逸","入世与出世"],"ap":1},{"id":"02af8d1c39a1","t":"论语·宪问篇 其39","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子击磬于卫，有荷蒉而过孔氏之门者，曰：“有心哉，击磬乎！”既而曰：“鄙哉，硁硁乎！莫己知也，斯己而已矣。深则厉，浅则揭。”子曰：“果哉！末之难矣。”","b":1,"y":-492,"th":["哲理","入世","隐逸","知音"],"ap":1},{"id":"64fba8e504a5","t":"论语·微子篇 其7","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子路从而后，遇丈人，以杖荷蓧。子路问曰：“子见夫子乎？”丈人曰：“四体不勤，五谷不分，孰为夫子？”植其杖而芸，子路拱而立。止子路宿，杀鸡为黍而食之，见其二子焉。明日，子路行以告，子曰：“隐者也。”使子路反见之，至则行矣。子路曰：“不仕无义。长幼之节不可废也，君臣之义如之何其废之？欲洁其身而乱大伦。君子之仕也，行其义也，道之不行已知之矣。”","b":2,"y":-490,"th":["哲理","隐逸","入世担当"],"ap":1},{"id":"d75c98915e43","t":"论语·宪问篇 其37","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“贤者辟世，其次辟地，其次辟色，其次辟言。”子曰：“作者七人矣。”","b":3,"y":-450,"th":["哲理","隐逸","出处进退"],"ap":1},{"id":"c0b9a8df30ca","t":"论语·微子篇 其8","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"逸民：伯夷、叔齐、虞仲、夷逸、朱张、柳下惠、少连。子曰：“不降其志，不辱其身，伯夷、叔齐与！”谓：“柳下惠、少连降志辱身矣，言中伦，行中虑，其斯而已矣。”谓：“虞仲、夷逸隐居放言，身中清，废中权。我则异于是，无可无不可。”","b":3,"y":-450,"th":["哲理","隐逸","处世之道"],"ap":1},{"id":"122e7b9991a1","t":"哀岁","a":"王逸","d":1,"f":"楚辞","g":"诗","x":"旻天兮清凉，玄气兮高朗。","b":5,"y":-300,"th":["岁暮感怀","咏物抒愤","怀古伤己","隐逸"],"ap":1},{"id":"118c4e01b127","t":"悼乱","a":"王逸","d":1,"f":"楚辞","g":"诗","x":"嗟嗟兮悲夫，殽乱兮纷挐。","b":5,"y":-300,"th":["乱世之悲","孤臣之愤","隐逸","怀古"],"ap":1},{"id":"397af628877d","t":"饮酒·其五","a":"陶渊明","d":3,"f":"五古","g":"诗","x":"结庐在人境，而无车马喧。","b":0,"y":417,"th":["田园","隐逸","哲理"],"ap":1},{"id":"cfaf6cb847c6","t":"望终南山","a":"太宗皇帝","d":6,"f":"五律","g":"诗","x":"重峦俯渭水，碧嶂插遥天。","b":0,"y":630,"th":["山水","哲理","隐逸"],"ap":1},{"id":"d13541020c51","t":"初晴落景","a":"太宗皇帝","d":6,"f":"五律","g":"诗","x":"晚霞聊自怡，初晴弥可喜。","b":0,"y":640,"th":["田园","哲理","隐逸"],"ap":1},{"id":"9cbbdf38013b","t":"秋日翠微宫","a":"太宗皇帝","d":6,"f":"五律","g":"诗","x":"秋光凝翠岭，凉吹肃离宫。","b":0,"y":642,"th":["咏物","隐逸",