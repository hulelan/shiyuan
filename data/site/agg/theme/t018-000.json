[{"id":"b24a61578d79","t":"卷阿","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有卷者阿，飘风自南。岂弟君子，来游来歌，以矢其音。","b":0,"y":-1032,"th":["颂德","咏物","宴饮"],"ap":1},{"id":"4c6c56271264","t":"斯干","a":"佚名","d":1,"f":"诗经","g":"诗","x":"秩秩斯干，幽幽南山。如竹苞矣，如松茂矣。兄及弟矣，式相好矣，无相犹矣。","b":0,"y":-908,"th":["宴饮","咏物","祈福"],"ap":1},{"id":"fc9e79b534ae","t":"鱼藻","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鱼在在藻，有颁其首。王在在镐，岂乐饮酒。","b":0,"y":-908,"th":["颂赞","宴饮","太平"],"ap":1},{"id":"03280f3e5120","t":"六月","a":"佚名","d":1,"f":"诗经","g":"诗","x":"六月栖栖，戎车既饬。四牡骙骙，载是常服。玁狁孔炽，我是用急。王于出征，以匡王国。","b":0,"y":-823,"th":["边塞","战争","颂功","宴饮"],"ap":1},{"id":"5f16bb42f2a9","t":"凫鹥","a":"佚名","d":1,"f":"诗经","g":"诗","x":"凫鹥在泾，公尸在燕来宁。尔酒既清，尔肴既馨。公尸燕饮，福禄来成。","b":0,"y":-771,"th":["祭祀","宴饮","祈福","颂歌"],"ap":1},{"id":"93974184a46d","t":"天保","a":"佚名","d":1,"f":"诗经","g":"诗","x":"天保定尔，亦孔之固。俾尔单厚，何福不除？俾尔多益，以莫不庶。","b":0,"y":-771,"th":["祝颂","祭祀","宴饮"],"ap":1},{"id":"4d276f2ca195","t":"既醉","a":"佚名","d":1,"f":"诗经","g":"诗","x":"既醉以酒，既饱以德。君子万年，介尔景福。","b":0,"y":-771,"th":["祭祀","宴饮","祝颂","祈福"],"ap":1},{"id":"214da9858e2f","t":"鹿鸣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"呦呦鹿鸣，食野之苹。我有嘉宾，鼓瑟吹笙。吹笙鼓簧，承筐是将。人之好我，示我周行。","b":0,"y":-771,"th":["宴饮","礼乐","求贤"],"ap":1},{"id":"0db2efd4c52f","t":"伐木","a":"佚名","d":1,"f":"诗经","g":"诗","x":"伐木丁丁，鸟鸣嘤嘤。出自幽谷，迁于乔木。嘤其鸣矣，求其友声。","b":0,"y":-700,"th":["宴饮","友情","哲理"],"ap":1},{"id":"a3964f6dc9d4","t":"南山有台","a":"佚名","d":1,"f":"诗经","g":"诗","x":"南山有台，北山有莱。乐只君子，邦家之基。乐只君子，万寿无期。","b":0,"y":-700,"th":["颂德","祝寿","宴饮"],"ap":1},{"id":"7a1916fe30d7","t":"南有嘉鱼","a":"佚名","d":1,"f":"诗经","g":"诗","x":"南有嘉鱼，烝然罩罩。君子有酒，嘉宾式燕以乐。","b":0,"y":-700,"th":["宴饮","贵族","颂德"],"ap":1},{"id":"287290565ef0","t":"吉日","a":"佚名","d":1,"f":"诗经","g":"诗","x":"吉日维戊，既伯既祷。田车既好，四牡孔阜。升彼大阜，从其群丑。","b":0,"y":-700,"th":["田猎","宴饮","颂赞"],"ap":1},{"id":"130aa4d8e99c","t":"宾之初筵","a":"佚名","d":1,"f":"诗经","g":"诗","x":"宾之初筵，左右秩秩。笾豆有楚，殽核维旅。酒既和旨，饮酒孔偕。","b":0,"y":-700,"th":["宴饮","讽刺","礼仪","劝诫"],"ap":1},{"id":"96bc9355fda3","t":"彤弓","a":"佚名","d":1,"f":"诗经","g":"诗","x":"彤弓弨兮，受言藏之。我有嘉宾，中心贶之。钟鼓既设，一朝飨之。","b":0,"y":-700,"th":["宴饮","赏赐","礼乐"],"ap":1},{"id":"e9a41e7c53da","t":"有客","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有客有客，亦白其马。有萋有且，敦琢其旅。有客宿宿，有客信信。","b":0,"y":-700,"th":["宴饮","送别","颂德"],"ap":1},{"id":"cf9b1085ec99","t":"桑扈","a":"佚名","d":1,"f":"诗经","g":"诗","x":"交交桑扈，有莺其羽。君子乐胥，受天之祜。","b":0,"y":-700,"th":["宴饮","颂赞","礼乐"],"ap":1},{"id":"46c81de5b94b","t":"棠棣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"棠棣之华，鄂不韡韡。凡今之人，莫如兄弟。","b":0,"y":-700,"th":["亲情","伦理","宴饮"],"ap":1},{"id":"75a6a2f68eb4","t":"湛露","a":"佚名","d":1,"f":"诗经","g":"诗","x":"湛湛露斯，匪阳不晞。厌厌夜饮，不醉无归。","b":0,"y":-700,"th":["宴饮","颂德","宗庙"],"ap":1},{"id":"ea756c25a962","t":"瓠叶","a":"佚名","d":1,"f":"诗经","g":"诗","x":"幡幡瓠叶，采之亨之。君子有酒，酌言尝之。","b":0,"y":-700,"th":["宴饮","尚礼","田园"],"ap":1},{"id":"405bdaca3281","t":"菁菁者莪","a":"佚名","d":1,"f":"诗经","g":"诗","x":"菁菁者莪，在彼中阿。既见君子，乐且有仪。","b":0,"y":-700,"th":["宴饮","尊贤","知遇"],"ap":1},{"id":"85747689802c","t":"蓼萧","a":"佚名","d":1,"f":"诗经","g":"诗","x":"蓼彼萧斯，零露湑兮。既见君子，我心写兮。燕笑语兮，是以有誉处兮。","b":0,"y":-700,"th":["宴饮","颂德","祈福"],"ap":1},{"id":"288f7e9a1a19","t":"行苇","a":"佚名","d":1,"f":"诗经","g":"诗","x":"敦彼行苇，牛羊勿践履。方苞方体，维叶泥泥。","b":1,"y":-700,"th":["宴饮","亲情","礼乐","祈福"],"ap":1},{"id":"6a8b4e9655a6","t":"车邻","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有车邻邻，有马白颠。未见君子，寺人之令。","b":1,"y":-700,"th":["宴饮","哲理","咏怀"],"ap":1},{"id":"cc47b6ccbed9","t":"頍弁","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有頍者弁，实维伊何？尔酒既旨，尔肴既嘉。岂伊异人？兄弟匪他。","b":1,"y":-700,"th":["宴饮","亲情","伤时","哲理"],"ap":1},{"id":"57a898e49afa","t":"鱼丽","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鱼丽于罶，鲿鲨。君子有酒，旨且多。","b":1,"y":-700,"th":["宴饮","颂赞","乐歌"],"ap":1},{"id":"9d74835f627e","t":"鸳鸯","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鸳鸯于飞，毕之罗之。君子万年，福禄宜之。","b":1,"y":-700,"th":["祝颂","宴饮","咏物"],"ap":1},{"id":"6b9c1e0d07f4","t":"有駜","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有駜有駜，駜彼乘黄。夙夜在公，在公明明。振振鹭，鹭于下。鼓咽咽，醉言舞。于胥乐兮！","b":1,"y":-650,"th":["颂赞","宴饮","祈福"],"ap":1},{"id":"b3bea4edf8a8","t":"舞曲歌辞 白纻辞三首 三","a":"李白","d":6,"f":"七古","g":"诗","x":"吴刀翦彩缝舞衣，明妆丽服夺春辉。","b":3,"y":736,"th":["乐舞","宴饮","爱情"],"ap":1},{"id":"d7b342b01b6