及弟子","d":1,"f":"文","g":"文","x":"子曰：“君子求诸己，小人求诸人。”","b":2,"y":-480,"th":["哲理","修身","对比"],"ap":1}],"t392":[{"id":"dd7530e714cc","t":"论语·子张篇 其18","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"曾子曰：“吾闻诸夫子，孟庄子之孝也，其他可能也；其不改父之臣与父之政，是难能也。”","b":2,"y":-450,"th":["孝道","哲理","政治伦理"],"ap":1},{"id":"ad244a3ab530","t":"孟子·滕文公上 其24","a":"孟子","d":1,"f":"文","g":"文","x":"「然则治天下独可耕且为与？有大人之事，有小人之事。且一人之身，而百工之所为备。如必自为而后用之，是率天下而路也。故曰：或劳心，或劳力；劳心者治人，劳力者治于人；治于人者食人，治人者食于人：天下之通义也。","b":5,"y":-320,"th":["哲理","社会分工","政治伦理"],"ap":1}],"t406":[{"id":"4d2e0122c177","t":"相和歌辞 从军行二首 一","a":"李白","d":6,"f":"五律","g":"诗","x":"从军玉门道，逐虏金微山。","b":2,"y":730,"th":["边塞","壮志","征战"],"ap":1},{"id":"1670a5ace502","t":"舞曲歌辞 柘枝词 二","a":"薛能","d":6,"f":"五古","g":"诗","x":"悬军征拓羯，内地隔萧关。","b":10,"y":860,"th":["边塞","征战","壮志"],"ap":1}],"t415":[{"id":"8e90b00503b8","t":"杂曲歌辞 长安少年行十首 十","a":"李廓","d":6,"f":"五律","g":"诗","x":"小妇教鹦鹉，头边唤醉醒。","b":9,"y":820,"th":["豪奢","讽刺","宴饮"],"ap":1},{"id":"476ac294c7cc","t":"杂曲歌辞 长安少年行十首 四","a":"李廓","d":6,"f":"五律","g":"诗","x":"好胜耽长行，天明烛满楼。","b":10,"y":850,"th":["讽喻","都市生活","豪奢"],"ap":1}],"t459":[{"id":"06c18dc57a53","t":"孟子·梁惠王上 其32","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「王无异于百姓之以王为爱也。以小易大，彼恶知之？王若隐其无罪而就死地，则牛羊何择焉？」","b":4,"y":-320,"th":["哲理","仁政","辩理"],"ap":1}],"t460":[{"id":"06fefae78b50","t":"论语·乡党篇 其13","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"乡人饮酒，杖者出，斯出矣。","b":2,"y":-450,"th":["礼仪","尊老","修身"],"ap":1}],"t510":[{"id":"2fc18e096113","t":"孟子·公孙丑上 其32","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「然则有同与？」","b":5,"y":-300,"th":["哲理","问答","思辨"],"ap":1}],"t529":[{"id":"44a2b31cf11c","t":"论语·先进篇 其23","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子畏于匡，颜渊后。子曰：“吾以女为死矣！”曰：“子在，回何敢死！”","b":1,"y":-496,"th":["师生情谊","哲理","患难"],"ap":1}],"t565":[{"id":"69965ccd8665","t":"论语·子罕篇 其15","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“吾自卫反鲁，然后乐正，《雅》、《颂》各得其所。”","b":2,"y":-484,"th":["哲理","文化","礼乐"],"ap":1}],"t576":[{"id":"74a6717ece80","t":"葛屦","a":"佚名","d":1,"f":"诗经","g":"诗","x":"纠纠葛屦，可以履霜？掺掺女手，可以缝裳？要之襋之，好人服之。","b":1,"y":-650,"th":["讽喻","社会批判","阶级对