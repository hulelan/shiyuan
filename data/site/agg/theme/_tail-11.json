乙祠","b":0,"y":1680,"th":["应制","春景","皇家"],"ap":1},{"id":"aea514b41fdb","t":"扈驾马兰峪赐观温泉恭纪十韵","a":"纳兰性德","d":11,"f":"词","g":"词","x":"御天来凤辇，浴日启龙池","b":0,"y":1680,"th":["应制","颂圣","纪游"],"ap":1},{"id":"9a99e02b0e01","t":"汤泉应制·清时礼乐萃朝端","a":"纳兰性德","d":11,"f":"词","g":"词","x":"清时礼乐萃朝端，次第郊原引玉銮","b":1,"y":1681,"th":["应制","颂圣","巡幸"],"ap":1},{"id":"3f397d8361be","t":"拟冬日景忠山应制·雄关阻塞戴灵鳌","a":"纳兰性德","d":11,"f":"词","g":"词","x":"雄关阻塞戴灵鳌，控制卢龙胜百牢","b":1,"y":1682,"th":["边塞","应制","写景"],"ap":1},{"id":"42198f3ee7fb","t":"兴京陪祭福陵","a":"纳兰性德","d":11,"f":"词","g":"词","x":"龙盘凤翥气佳哉，东指斋宫玉辇来","b":1,"y":1682,"th":["应制","怀古","咏史"],"ap":1},{"id":"8210f7592773","t":"汤泉应制·六龙初驻浴蓝天","a":"纳兰性德","d":11,"f":"词","g":"词","x":"六龙初驻浴蓝天，碧瓦朱旗共一川","b":1,"y":1683,"th":["应制","颂圣","咏物","春日"],"ap":1},{"id":"e5b0b2b4eb95","t":"汤泉应制·身向咸池榜末光","a":"纳兰性德","d":11,"f":"词","g":"词","x":"身向咸池榜末光，三危露暖不成霜","b":1,"y":1683,"th":["应制","颂圣","咏物"],"ap":1}],"t099":[{"id":"3250637bf5c5","t":"孟子·离娄上 其18","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「求也为季氏宰，无能改于其德，而赋粟倍他日。孔子曰：『求非我徒也，小子鸣鼓而攻之可也。』由此观之，君不行仁政而富之，皆弃于孔子者也。况于为之强战？争地以战，杀人盈野；争城以战，杀人盈城。此所谓率土地而食人肉，罪不容于死。故善战者服上刑，连诸侯者次之，辟草莱、任土地者次之。」","b":5,"y":-300,"th":["仁政","反战","民本","哲理"],"ap":1},{"id":"85b1e7fd06a9","t":"相和歌辞 从军行","a":"乔知之","d":6,"f":"五古","g":"诗","x":"南庭结白露，北风埽黄叶。","b":1,"y":690,"th":["闺怨","边塞","反战"],"ap":1},{"id":"d6f3bb94ec34","t":"古从军行","a":"李颀","d":6,"f":"七古","g":"诗","x":"白日登山望烽火，黄昏饮马傍交河。","b":3,"y":748,"th":["边塞","反战","讽喻"],"ap":1},{"id":"34518ad47977","t":"杂曲歌辞 蓟门行五首 一","a":"高适","d":6,"f":"五古","g":"诗","x":"边城十一月，雨雪乱霏霏。","b":4,"y":750,"th":["边塞","反战","讽喻"],"ap":1},{"id":"69970b9f28d5","t":"相和歌辞 饮马长城窟行","a":"僧子兰","d":6,"f":"五古","g":"诗","x":"游客长城下，饮马长城窟。","b":5,"y":750,"th":["边塞","反战","怀古"],"ap":1},{"id":"ac68b03bddd0","t":"杂曲歌辞 北风行","a":"李白","d":6,"f":"古体","g":"诗","x":"烛龙栖寒门，光曜犹旦开。","b":7,"y":752,"th":["边塞","思妇","悼亡","反战"],"ap":1},{"id":"deaa132f5cf4","t":"相和歌辞 从军行六首 三","a":"刘长卿","d":6,"f":"五古","g":"诗","x":"草枯秋塞上，望见渔阳郭。","b":7,"y":780,"th":["边塞","反战","怀古"],"ap":1},{"id":"0c74f9799d37","t":"相和歌辞 饮马长城窟行","a":"王建","d":6,"f":"古体","g":"诗","x":"长城窟，长城窟边多马骨。","b":8,"y":800,"th":["边塞","反战","怀古"],"ap":1},{"id":"36058ab213a9","t":"相和歌辞 从军行三首 二","a":"李约","d":6,"f":"五律","g":"诗","x":"栅高三面鬬，箭尽举烽频。","b":8,"y":800,"th":["边塞","战争","反战"],"ap":1},{"id":"786e5cc60d37","t":"相和歌辞 从军行五首 一","a":"令狐楚","d":6,"f":"五绝","g":"诗","x":"荒鸡隔水啼，汗马逐风嘶。","b":8,"y":800,"th":["边塞","反战","思归"],"ap":1},{"id":"765bd208a14c","t":"相和歌辞 胡无人行","a":"僧贯休","d":6,"f":"古体","g":"诗","x":"霍嫖姚，赵充国，天子将之平朔漠。","b":10,"y":880,"th":["边塞","战争","反战","怀古"],"ap":1}],"t125":[{"id":"0c8c43c86b45","t":"孟子·梁惠王上 其25","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「若寡人者，可以保民乎哉？」","b":4,"y":-320,"th":["仁政","哲理","王道"],"ap":1},{"id":"3ef06732e899","t":"孟子·公孙丑上 其38","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「尊贤使能，俊杰在位，则天下之士皆悦而愿立于其朝矣。市廛而不征，法而不廛，则天下之商皆悦而愿藏于其市矣。关讥而不征，则天下之旅皆悦而愿出于其路矣。耕者助而不税，则天下之农皆悦而愿耕于其野矣。廛无夫里之布，则天下之民皆悦而愿为之氓矣。信能行此五者，则邻国之民仰之若父母矣。率其子弟，攻其父母，自生民以来，未有能济者也。如此，则无敌于天下。无敌于天下者，天吏也。然而不王者，未之有也。」","b":4,"y":-320,"th":["哲理","仁政","王道","民本"],"ap":1},{"id":"730c67303756","t":"孟子·公孙丑上 其1","a":"孟子","d":1,"f":"文","g":"文","x":"公孙丑问曰：「夫子当路于齐，管仲、晏子之功，可复许乎？」","b":4,"y":-320,"th":["哲理","政治","王道"],"ap":1},{"id":"763f80313015","t":"孟子·滕文公下 其24","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「汤居亳，与葛为邻，葛伯放而不祀。汤使人问之曰：『何为不祀？』曰：『无以供牺牲也。』汤使遗之牛羊。葛伯食之，又不以祀。汤又使人问之曰：『何为不祀？』曰：『无以供粢盛也。』汤使亳众往为之耕，老弱馈食。葛伯率其民，要其有酒食黍稻者夺之，不授者杀之。有童子以黍肉饷，杀而夺之。《书》曰：『葛伯仇饷。』此之谓也。为其杀是童子而征之，四海之内皆曰：『非富天下也，为匹夫匹妇复雠也。』『汤始征，自葛载』，十一征而无敌于天下。东面而征，西夷怨；南面而征，北狄怨，曰：『奚为后我？』民之望之，若大旱之望雨也。归市者弗止，芸者不变，诛其君，吊其民，如时雨降。民大悦。《书》曰：『徯我后，后来其无罚。』『有攸不惟臣，东征，绥厥士女，匪厥玄黄，绍我周王见休，惟臣附于大邑周。』其君子实玄黄于匪以迎其君子，其小人箪食壶浆以迎其小人，救民于水火之中，取其残而已矣。《太誓》曰：『我武惟扬，侵于之疆，则取于残，杀伐用张，于汤有光。』不行王政云尔，苟行王政，四海之内皆举首而望之，欲以为君。齐楚虽大，何畏焉？」","b":5,"y":-320,"th":["王道","仁政","民本","哲理"],"ap":1},{"id":"8aecda1ea5fd","t":"孟子·梁惠王下 其49","a":"孟子","d":1,"f":"文","g":"文","x":"孟子对曰：「臣闻七十里为政于天下者，汤是也。未闻以千里畏人者也。《书》曰：『汤一征，自葛始。』天下信之。『东面而征，西夷怨；南面而征，北狄怨。曰，奚为后我？』民望之，若大旱之望云霓也。归市者不止，耕者不变。诛其君而吊其民，若时雨降，民大悦。《书》曰：『徯我后，后来其苏。』","b":5,"y":-320,"th":["哲理","仁政","王道","民本"],"ap":1},{"id":"ec88cf819177","t":"孟子·离娄上 其17","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「伯夷辟纣，居北海之滨，闻文王作，兴曰：『盍归乎来！吾闻西伯善养老者。』太公辟纣，居东海之滨，闻文王作，兴曰：『盍归乎来！吾闻西伯善养老者。』二老者，天下之大老也，而归之，是天下之父归之也。天下之父归之，其子焉往？诸侯有行文王之政者，七年之内，必为政于天下矣。」","b":5,"y":-320,"th":["仁政","王道","哲理"],"ap":1},{"id":"c073810038d6","t":"孟子·梁惠王上 其18","a":"孟子","d":1,"f":"文","g":"文","x":"孟子见梁襄王。出，语人曰：「望之不似人君，就之而不见所畏焉。卒然问曰：『天下恶乎定？』吾对曰：『定于一。』","b":5,"y":-319,"th":["哲理","政治","王道"],"ap":1},{"id":"1c7cb78962e0","t":"孟子·梁惠王上 其44","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「否。吾不为是也。」","b":5,"y":-300,"th":["哲理","王道","论辩"],"ap":1}],"t136":[{"id":"a7576cb8dcf0","t":"召旻","a":"佚名","d":1,"f":"诗经","g":"诗","x":"旻天疾威，天笃降丧。瘨我饥馑，民卒流亡。我居圉卒荒。","b":0,"y":-750,"th":["忧国","怀古","讽谏"],"ap":1},{"id":"244dda264797","t":"墓门","a":"佚名","d":1,"f":"诗经","g":"诗","x":"墓门有棘，斧以斯之。夫也不良，国人知之。知而不已，谁昔然矣。","b":0,"y":-700,"th":["讽谏","忧国","疾恶"],"ap":1},{"id":"fe4f0804da9f","t":"角弓","a":"佚名","d":1,"f":"诗经","g":"诗","x":"骍骍角弓，翩其反矣。兄弟婚姻，无胥远矣。","b":1,"y":-700,"th":["说理","讽谏","宗族"],"ap":1},{"id":"1114bd5ebaeb","t":"孟子·梁惠王下 其36","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「四境之内不治，则如之何？」","b":5,"y":-300,"th":["哲理","讽谏","治国"],"ap":1},{"id":"2ea344e10bce","t":"孟子·梁惠王下 其12","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「民犹以为小也。」","b":5,"y":-300,"th":["民本","讽谏","哲理"],"ap":1},{"id":"9f1f225b1c3f","t":"相和歌辞 楚妃叹","a":"张籍","d":6,"f":"七古","g":"诗","x":"湘云初起江沈沈，君王遥在云梦林。","b":9,"y":810,"th":["怀古","宫怨","讽谏"],"ap":1},{"id":"825c98c6ab9d","t":"相和歌辞 关山曲 二","a":"马戴","d":6,"f":"五律","g":"诗","x":"火发龙山北，中宵易左贤。","b":10,"y":850,"th":["边塞","战争","讽谏"],"ap":1}],"t150":[{"id":"cc9c7e052b03","t":"论语·颜渊篇 其18","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"季康子患盗，问于孔子。孔子对曰：“苟子之不欲，虽赏之不窃。”","b":2,"y":-490,"th":["哲理","为政","德治"],"ap":1},{"id":"1ae1bc1e1a11","t":"论语·为政篇 其1","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“为政以德，譬如北辰，居其所而众星共之。”","b":2,"y":-450,"th":["哲理","政治","德治"],"ap":1},{"id":"aca19d3abc5c","t":"论语·宪问篇 其41","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“上好礼，则民易使也。”","b":3,"y":-450,"th":["哲理","政治","德治"],"ap":1},{"id":"c3540dcfd4cb","t":"论语·子路篇 其11","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“‘善人为邦百年，亦可以胜残去杀矣。’诚哉是言也！”","b":3,"y":-450,"th":["哲理","仁政","德治"],"ap":1},{"id":"d45120126467","t":"大学·大学 其8","a":"曾子（传）","d":1,"f":"文","g":"文","x":"子曰：「听讼，吾犹人也，必也使无讼乎！」无情者不得尽其辞，大畏民志。此谓知本。","b":4,"y":-430,"th":["哲理","治国","德治"],"ap":1},{"id":"44745e094f0b","t":"中庸·中庸 其32","a":"子思（传）","d":1,"f":"文","g":"文","x":"唯天下至圣，为能聪明睿知，足以有临也；宽裕温柔，足以有容也；发强刚毅，足以有执也；齐庄中正，足以有敬也；文理密察，足以有别也。溥博渊泉，而时出之。溥博如天，渊泉如渊。见而民莫不敬，言而民莫不信，行而民莫不说。是以声名洋溢乎中国，施及蛮貊；舟车所至，人力所通，天之所覆，地之所载，日月所照，霜露所队；凡有血气者，莫不尊亲，故曰配天。","b":5,"y":-250,"th":["哲理","修身","圣人","德治"],"ap":1}],"t169":[{"id":"a4ebd069fc17","t":"舞曲歌辞 白纻辞三首 二","a":"李白","d":6,"f":"古体","g":"诗","x":"月寒江清夜沈沈，美人一笑千黄金。","b":3,"y":736,"th":["爱情","咏怀","乐舞"],"ap":1},{"id":"b3bea4edf8a8","t":"舞曲歌辞 白纻辞三首 三","a":"李白","d":6,"f":"七古","g":"诗","x":"吴刀翦彩缝舞衣，明妆丽服夺春辉。","b":3,"y":736,"th":["乐舞","宴饮","爱情"],"ap":1},{"id":"6aa6493e47a5","t":"舞曲歌辞 白纻辞二首 二","a":"杨衡","d":6,"f":"古体","g":"诗","x":"蹑珠履，步琼筵。","b":5,"y":750,"th":["乐舞","闺怨","伤时"],"ap":1},{"id":"d7b342b01b64","t":"舞曲歌辞 白纻辞三首 一","a":"李白","d":6,"f":"古体","g":"诗","x":"扬清歌，发皓齿，北方佳人东邻子。","b":5,"y":750,"th":["乐舞","宴饮","咏怀"],"ap":1},{"id":"f1d47db30d3d","t":"舞曲歌辞 白纻歌","a":"柳宗元","d":6,"f":"七绝","g":"诗","x":"翠帷双卷出倾城，龙劒破匣霜月明。","b":9,"y":808,"th":["乐舞","咏物","宫廷"],"ap":1},{"id":"c41332fd0b4e","t":"舞曲歌辞 吴俞儿舞歌 劒俞","a":"陆龟蒙","d":6,"f":"古体","g":"诗","x":"枝月喉，櫂霜脊，北斗离离在寒碧。","b":10,"y":855,"th":["乐舞","咏武","壮美"],"ap":1}],"t183":[{"id":"12583be7dee8","t":"论语·子张篇 其23","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"叔孙武叔语大夫于朝曰：“子贡贤于仲尼。”子服景伯以告子贡，子贡曰：“譬之宫墙，赐之墙也及肩，窥见室家之好；夫子之墙数仞，不得其门而入，不见宗庙之美、百官之富。得其门者或寡矣，夫子之云不亦宜乎！”","b":2,"y":-450,"th":["哲理","尊师","辩才"],"ap":1},{"id":"1e1be69f804d","t":"论语·子罕篇 其11","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"颜渊喟然叹曰：“仰之弥高，钻之弥坚。瞻之在前，忽焉在后。夫子循循然善诱人，博我以文，约我以礼，欲罢不能。既竭吾才，如有所立卓尔，虽欲从之，末由也已。”","b":2,"y":-450,"th":["哲理","教育","尊师"],"ap":1},{"id":"33f5c0bf1a7a","t":"论语·子张篇 其25","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"陈子禽谓子贡曰：“子为恭也，仲尼岂贤于子乎？”子贡曰：“君子一言以为知，一言以为不知，言不可不慎也。夫子之不可及也，犹天之不可阶而升也。夫子之得邦家者，所谓立之斯立，道之斯行，绥之斯来，动之斯和。其生也荣，其死也哀，如之何其可及也？”","b":2,"y":-450,"th":["哲理","尊师","崇儒"],"ap":1},{"id":"6d3b5c98850d","t":"论语·子张篇 其24","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"叔孙武叔毁仲尼，子贡曰：“无以为也，仲尼不可毁也。他人之贤者，丘陵也，犹可逾也；仲尼，日月也，无得而逾焉。人虽欲自绝，其何伤于日月乎？多见其不知量也。”","b":2,"y":-450,"th":["哲理","尊师","论辩"],"ap":1},{"id":"186fb700e1ba","t":"孟子·公孙丑上 其31","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「否。自有生民以来，未有孔子也。」","b":4,"y":-320,"th":["哲理","尊师","崇圣"],"ap":1}],"t194":[{"id":"5450461ad56a","t":"论语·卫灵公篇 其19","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“君子病无能焉，不病人之不己知也。”","b":2,"y":-450,"th":["修身","哲理","内省"],"ap":1},{"id":"5c3a19a17e78","t":"大学·大学 其9","a":"曾子（传）","d":1,"f":"文","g":"文","x":"所谓修身在正其心者：身有所忿懥，则不得其正；有所恐惧，则不得其正；有所好乐，则不得其正；有所忧患，则不得其正。心不在焉，视而不见，听而不闻，食而不知其味。此谓修身在正其心。","b":2,"y":-450,"th":["哲理","修身","内省"],"ap":1},{"id":"aa1881e62e04","t":"论语·里仁篇 其17","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“见贤思齐焉，见不贤而内自省也。”","b":3,"y":-450,"th":["哲理","修身","内省"],"ap":1},{"id":"36219e74c558","t":"孟子·公孙丑上 其40","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「矢人岂不仁于函人哉？矢人唯恐不伤人，函人唯恐伤人。巫匠亦然，故术不可不慎也。孔子曰：『里仁为美。择不处仁，焉得智？』夫仁，天之尊爵也，人之安宅也。莫之御而不仁，是不智也。不仁、不智、无礼、无义，人役也。人役而耻为役，由弓人而耻为弓，矢人而耻为矢也。如耻之，莫如为仁。仁者如射，射者正己而后发。发而不中，不怨胜己者，反求诸己而已矣。」","b":5,"y":-300,"th":["哲理","修身","内省"],"ap":1},{"id":"e5af7552e73b","t":"孟子·离娄上 其7","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「爱人不亲反其仁，治人不治反其智，礼人不答反其敬。行有不得者，皆反求诸己，其身正而天下归之。《诗》云：『永言配命，自求多福。』」","b":5,"y":-300,"th":["哲理","修身","内省"],"ap":1}],"t200":[{"id":"fd04af5cee6f","t":"黍苗","a":"佚名","d":1,"f":"诗经","g":"诗","x":"芃芃黍苗，阴雨膏之。悠悠南行，召伯劳之。","b":0,"y":-800,"th":["颂功","劳役","思归"],"ap":1},{"id":"d8a940788f15","t":"式微","a":"佚名","d":1,"f":"诗经","g":"诗","x":"式微，式微，胡不归？微君之故，胡为乎中露！","b":1,"y":-650,"th":["劳役","怨刺","思归"],"ap":1},{"id":"fef7dec8bc4d","t":"泉水","a":"佚名","d":1,"f":"诗经","g":"诗","x":"毖彼泉水，亦流于淇。有怀于卫，靡日不思。娈彼诸姬，聊与之谋。","b":1,"y":-650,"th":["思乡","思归","闺怨"],"ap":1},{"id":"786e5cc60d37","t":"相和歌辞 从军行五首 一","a":"令狐楚","d":6,"f":"五绝","g":"诗","x":"荒鸡隔水啼，汗马逐风嘶。","b":8,"y":800,"th":["边塞","反战","思归"],"ap":1},{"id":"9ae372b5b662","t":"相和歌辞 江南曲","a":"李贺"