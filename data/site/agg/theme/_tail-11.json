b":2,"y":-450,"th":["哲理","知人论世","独立思考"],"ap":1}],"t767":[{"id":"c23495781d7b","t":"孟子·公孙丑上 其42","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「伯夷，非其君不事，非其友不友。不立于恶人之朝，不与恶人言。立于恶人之朝，与恶人言，如以朝衣朝冠坐于涂炭。推恶恶之心，思与乡人立，其冠不正，望望然去之，若将浼焉。是故诸侯虽有善其辞命而至者，不受也。不受也者，是亦不屑就已。柳下惠，不羞污君，不卑小官。进不隐贤，必以其道。遗佚而不怨，阨穷而不悯。故曰：『尔为尔，我为我，虽袒裼裸裎于我侧，尔焉能浼我哉？』故由由然与之偕而不自失焉，援而止之而止。援而止之而止者，是亦不屑去已。」","b":5,"y":-300,"th":["哲理","处世之道","人格修养"],"ap":1}],"t778":[{"id":"ca9af60c2f03","t":"孟子·公孙丑下 其7","a":"孟子","d":1,"f":"文","g":"文","x":"景子曰：「否，非此之谓也。礼曰：『父召，无诺；君命召，不俟驾。』固将朝也，闻王命而遂不果，宜与夫礼若不相似然。」","b":4,"y":-320,"th":["哲理","礼制","士人风骨"],"ap":1}],"t785":[{"id":"d3dd62d5ce45","t":"论语·乡党篇 其15","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"问人于他邦，再拜而送之。","b":1,"y":-500,"th":["礼敬","友情","修身"],"ap":1}],"t796":[{"id":"ddb49662a96c","t":"孟子·滕文公下 其15","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「否。士无事而食，不可也。」","b":5,"y":-320,"th":["哲理","道德修养","社会责任"],"ap":1}],"t819":[{"id":"eec0a1935fe1","t":"论语·乡党篇 其6","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"君子不以绀緅饰，红紫不以为亵服。当暑袗絺绤，必表而出之。缁衣羔裘，素衣麑裘，黄衣狐裘。亵裘长，短右袂。必有寝衣，长一身有半。狐貉之厚以居。去丧，无所不佩。非帷裳，必杀之。羔裘玄冠不以吊。吉月，必朝服而朝。","b":2,"y":-450,"th":["礼制","修身","服饰"],"ap":1}],"t820":[{"id":"f0bf8a635be0","t":"小毖","a":"佚名","d":1,"f":"诗经","g":"诗","x":"予其惩，而毖后患。莫予荓蜂，自求辛螫。肇允彼桃虫，拚飞维鸟。未堪家多难，予又集于蓼。","b":0,"y":-1042,"th":["政治咏怀","哲理","自省"],"ap":1}],"t846":[{"id":"009019a9c541","t":"江南逢李龟年","a":"杜甫","d":6,"f":"七绝","g":"诗","x":"歧王宅里寻常见，崔九堂前几度闻。","b":7,"y":770,"th":["怀旧","人生感慨","盛衰之叹"],"ap":1}],"t855":[{"id":"0586789c234b","t":"舞曲歌辞 东海有勇妇","a":"李白","d":6,"f":"五古","g":"诗","x":"梁山感杞妻，恸哭为之倾。","b":4,"y":745,"th":["咏史","烈义","赞颂女性"],"ap":1}],"t882":[{"id":"16b1f0b0e479","t":"相和歌辞 江南曲八首 二","a":"刘希夷","d":6,"f":"五古","g":"诗","x":"艳唱潮初落，江花露未晞。","b":1,"y":675,"th":["江南","春光","惜时"],"ap":1}],"t891":[{"id":"1cf2fc851c7b","t":"咸亨殿宴近臣诸亲柏梁体","a":"高宗皇帝","d":6,"f":"七古","g":"诗","x":"屏欲除奢政返淳。","b":0,"y":663,"th":["政治讽喻","治国理念"],"ap":1}],"t903":[{"id":"22673f5ab4ce","t":"伤辽东战亡","a":"太宗皇帝","d":6,"f":"五律","g":"诗","x":"凿门初奉律，仗战始临戎。","b":0,"y":645,"th":["边塞","咏史","忠烈"],"ap":1}],