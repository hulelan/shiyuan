633d8c0b55c","t":"琵琶仙·中秋","a":"纳兰性德","d":11,"f":"词","g":"词","x":"碧海年年，试问取、冰轮为谁圆缺","b":0,"y":1680,"th":["悼亡","中秋","孤独"],"ap":1}],"t330":[{"id":"0efcda4e7786","t":"孟子·公孙丑上 其30","a":"孟子","d":1,"f":"文","g":"文","x":"「伯夷、伊尹于孔子，若是班乎？」","b":4,"y":-320,"th":["哲理","圣贤之道","儒家思想"],"ap":1},{"id":"1518a0af89c3","t":"孟子·公孙丑上 其29","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「不同道。非其君不事，非其民不使；治则进，乱则退，伯夷也。何事非君，何使非民；治亦进，乱亦进，伊尹也。可以仕则仕，可以止则止，可以久则久，可以速则速，孔子也。皆古圣人也，吾未能有行焉；乃所愿，则学孔子也。」","b":5,"y":-300,"th":["哲理","圣贤之道","处世哲学"],"ap":1}],"t345":[{"id":"2e7662f7b719","t":"论语·卫灵公篇 其41","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“辞达而已矣。”","b":2,"y":-450,"th":["哲理","言辞","修辞"],"ap":1},{"id":"fb5583c44827","t":"孟子·公孙丑上 其23","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「诐辞知其所蔽，淫辞知其所陷，邪辞知其所离，遁辞知其所穷。生于其心，害于其政；发于其政，害于其事。圣人复起，必从吾言矣。」","b":4,"y":-320,"th":["哲理","政治","言辞"],"ap":1}],"t356":[{"id":"445be98712f9","t":"清庙","a":"佚名","d":1,"f":"诗经","g":"诗","x":"于穆清庙，肃雍显相。济济多士，秉文之德。对越在天，骏奔走在庙。不显不承，无射于人斯。","b":0,"y":-1050,"th":["祭祀","颂德","宗庙"],"ap":1},{"id":"75a6a2f68eb4","t":"湛露","a":"佚名","d":1,"f":"诗经","g":"诗","x":"湛湛露斯，匪阳不晞。厌厌夜饮，不醉无归。","b":0,"y":-700,"th":["宴饮","颂德","宗庙"],"ap":1}],"t381":[{"id":"824cee8e2ba3","t":"谷风","a":"佚名","d":1,"f":"诗经","g":"诗","x":"习习谷风，以阴以雨。黾勉同心，不宜有怒。采葑采菲，无以下体？德音莫违，及尔同死。","b":0,"y":-1050,"th":["弃妇","婚姻","怨情","对比"],"ap":1},{"id":"7fa17daa2b49","t":"论语·卫灵公篇 其21","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“君子求诸己，小人求诸人。”","b":2,"y":-480,"th":["哲理","修身","对比"],"ap":1}],"t392":[{"id":"dd7530e714cc","t":"论语·子张篇 其18","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"曾子曰：“吾闻诸夫子，孟庄子之孝也，其他可能也；其不改父之臣与父之政，是难能也。”","b":2,"y":-450,"th":["孝道","哲理","政治伦理"],"ap":1},{"id":"ad244a3ab530","t":"孟子·滕文公上 其24","a":"孟子","d":1,"f":"文","g":"文","x":"「然则治天下独可耕且为与？有大人之事，有小人之事。且一人之身，而百工之所为备。如必自为而后用之，是率天下而路也。故曰：或劳心，或劳力；劳心者治人，劳力者治于人；治于人者食人，治人者食于人：天下之通义也。","b":5,"y":-320,"th":["哲理","社会分工","政治伦理"],"ap":1}],"t406":[{"id":"1a56c4e65495","t":"相和歌辞 采莲曲","a":"李白","d":6,"f":"七律","g":"诗","x":"若耶溪边采莲女，笑隔荷花共人语。","b":4,"y":750,"th":["爱情","田园","少女情怀"],"ap":1},{"id":"e025a1267aa1","t":"如梦令·常记溪亭日暮","a":"李清照","d":8,"f":"词","g":"词","x":"常记溪亭日暮，沉醉不知归路。","b":3,"y":1100,"th":["少女情怀","田园","回忆"],"ap":1}],"t415":[{"id":"50e1aedb8ba5","t":"琴曲歌辞 湘妃列女操","a":"鲍溶","d":6,"f":"七古","g":"诗","x":"有虞夫人哭虞后，淑女何事又伤离。","b":9,"y":815,"th":["悼亡","伤离","咏史"],"ap":1},{"id":"2c851a72b0cc","t":"倾杯乐","a":"柳永","d":8,"f":"词","g":"词","x":"皓月初圆，暮云飘散，分明夜色如晴昼。","b":2,"y":1035,"th":["爱情","相思","伤离"],"ap":1}],"t459":[{"id":"06fefae78b50","t":"论语·乡党篇 其13","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"乡人饮酒，杖者出，斯出矣。","b":2,"y":-450,"th":["礼仪","尊老","修身"],"ap":1}],"t460":[{"id":"0761a7d98e30","t":"论语·八佾篇 其24","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"仪封人请见，曰：“君子之至于斯也，吾未尝不得见也。”从者见之。出曰：“二三子何患于丧乎？天下之无道也久矣，天将以夫子为木铎。”","b":1,"y":-492,"th":["哲理","使命","教化"],"ap":1}],"t510":[{"id":"31bccfb89af5","t":"论语·雍也篇 其8","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"季康子问：“仲由可使从政也与？”子曰：“由也果，于从政乎何有？”曰：“赐也可使从政也与？”曰：“赐也达，于从政乎何有？”曰：“求也可使从政也与？”曰：“求也艺，于从政乎何有？”","b":2,"y":-490,"th":["知人善任","因材施教","治国理政"],"ap":1}],"t529":[{"id":"44aeefea0069","t":"论语·微子篇 其6","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"长沮、桀溺耦而耕，孔子过之，使子路问津焉。长沮曰：“夫执舆者为谁？”子路曰：“为孔丘。”曰：“是鲁孔丘与？”曰：“是也。”曰：“是知津矣。”问于桀溺，桀溺曰：“子为谁？”曰：“为仲由。”曰：“是鲁孔丘之徒与？”对曰：“然。”曰：“滔滔者天下皆是也，而谁以易之？且而与其从辟人之士也，岂若从辟世之士？”耰而不辍。子路行以告，夫子怃然曰：“鸟兽不可与同群，吾非斯人之徒与而谁与？天下有道，丘不与易也。”","b":2,"y":-490,"th":["哲理","入世与避世","知其不可而为之"],"ap":1}],"t565":[{"id":"6a3203c744ee","t":"孟子·梁惠王下 其25","a":"孟子","d":1,"f":"文","g":"文","x":"对曰：「昔者文王之治岐也，耕者九一，仕者世禄，关市讥而不征，泽梁无禁，罪人不孥。老而无妻曰鳏。老而无夫曰寡。老而无子曰独。幼而无父曰孤。此四者，天下之穷民而无告者。文王发政施仁，必先斯四者。《诗》云：『哿矣富人，哀此茕独。』」","b":4,"y":-320,"th":["仁政","恤民","哲理"],"ap":1}],"t576":[{"id":"76bd4be8a1dc","t":"论语·子路篇 其5","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“诵《诗》三百，授之以政，不达；使于四方，不能专对；虽多，亦奚以为？”","b":3,"y":-450,"th":["哲理","教育","学以致用"],"ap":1}],"t587":[{"id":"86d42f9e8732","t":"孟子·公孙丑下 其51","a":"孟子","d":1,"f":"文","g":"文","x":"尹士闻之曰：「士诚小人也。」","b":5,"y":-300,"th":["哲理","自省","圣贤胸怀"],"ap":1}],"t598":[{"id":"96bc9355fda3","t":"彤弓","a":"佚名","d":1,"f":"诗经","g":"诗","x":"彤弓弨兮，受言藏之。我有嘉宾，中心贶之。钟鼓既设，一朝飨之。","b":0,"y":-700,"th":["宴饮","赏赐","礼乐"],"ap":1}],"t604":[{"id":"a15a295bd2d4","t":"论语·述而篇 其23","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“天生德于予，桓魋其如予何？”","b":1,"y":-492,"th":["哲理","天命","临危不惧"],"ap":1}],"t613":[{"id":"a7b6164a3e00","t":"孟子·公孙丑下 其48","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「坐！我明语子。昔者鲁缪公无人乎子思之侧，则不能安子思；泄柳、申详，无人乎缪公之侧，则不能安其身。子为长者虑，而不及子思，子绝长者乎？长者绝子乎？」","b":5,"y":-300,"th":["哲理","尊贤","辞受"],"ap":1}],"t648":[{"id":"c6f31d2b9bbf","t":"论语·先进篇 其14","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"鲁人为长府，闵子骞曰：“仍旧贯如之何？何必改作？”子曰：“夫人不言，言必有中。”","b":2,"y":-450,"th":["哲理","政治","为人处世"],"ap":1}],"t657":[{"id":"cde7a9f19999","t":"论语·颜渊篇 其20","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子张问：“士何如斯可谓之达矣？”子曰：“何哉尔所谓达者？”子张对曰：“在邦必闻，在家必闻。”子曰：“是闻也，非达也。夫达也者，质直而好义，察言而观色，虑以下人。在邦必达，在家必达。夫闻也者，色取仁而行违，居之不疑。在邦必闻，在家必闻。”","b":1,"y":-500,"th":["哲理","修身","辨名实"],"ap":1}],"t662":[{"id":"d715bdd19170","t":"论语·颜渊篇 其8","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"棘子成曰：“君子质而已矣，何以文为？”子贡曰：“惜乎，夫子之说君子也！驷不及舌。文犹质也，质犹文也。虎豹之鞟犹犬羊之鞟。”","b":1,"y":-500,"th":["哲理","文质关系","儒家思想"],"ap":1}],"t671":[{"id":"dcef9ba2f40f","t":"黄鸟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"黄鸟黄鸟，无集于穀，无啄我粟。此邦之人，不我肯穀。言旋言归，复我邦族。","b":1,"y":-700,"th":["思乡","流离","怀亲"],"ap":1}],"t723":[{"id":"fee982b24535","t":"四月","a":"佚名","d":1,"f":"诗经","g":"诗","x":"四月维夏，六月徂署。先祖匪人，胡宁忍予？","b":0,"y":-700,"th":["乱离之苦","仕途之怨","告哀"],"ap":1}],"t734":[{"id":"1101768c70ae","t":"相和歌辞 从军行","a":"刘希夷","d":6,"f":"五古","g":"诗","x":"秋来风瑟瑟，群马胡行疾。","b":1,"y":680,"th":["边塞","壮志","从军"],"ap":1}],"t741":[{"id":"202793323f92","t":"相和歌辞 怨歌行","a":"吴少微","d":6,"f":"古体","g":"诗","x":"城南有怨妇，含怨倚兰丛。","b":4,"y":750,"th":["宫怨","咏史","美人迟暮"],"ap":1}],"t752":[{"id":"3fe230f9c405","t":"相和歌辞 子夜四时歌四首 夏歌","a":"陆龟蒙","d":6,"f":"五绝","g":"诗","x":"兰眼擡露斜，莺唇映花老。","b":10,"y":880,"th":["闺怨","咏物","夏景"],"ap":1}],"t767":[{"id":"6931c980b835","t":"相和歌辞 祠神歌 迎神","a":"王叡","d":6,"f":"七绝","g":"诗","x":"蓪草头花椰叶裙，蒲葵树下舞蛮云。","b":4,"y":750,"th":["祭祀","民俗","南国风光"],"ap":1}],"t778":[{"id":"86e05e74a4d4","t":"琴曲歌辞 雉朝飞操","a":"李白","d":6,"f":"古体","g":"诗","x":"麦陇青青三月时，