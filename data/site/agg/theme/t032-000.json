[{"id":"cf25f99cc376","t":"新台","a":"佚名","d":1,"f":"诗经","g":"诗","x":"新台有泚，河水瀰瀰。燕婉之求，蘧篨不鲜。","b":0,"y":-718,"th":["讽刺","婚姻","怨愤"],"ap":1},{"id":"130aa4d8e99c","t":"宾之初筵","a":"佚名","d":1,"f":"诗经","g":"诗","x":"宾之初筵，左右秩秩。笾豆有楚，殽核维旅。酒既和旨，饮酒孔偕。","b":0,"y":-700,"th":["宴饮","讽刺","礼仪","劝诫"],"ap":1},{"id":"bac75d7e4008","t":"山有枢","a":"佚名","d":1,"f":"诗经","g":"诗","x":"山有枢，隰有榆。子有衣裳，弗曳弗娄。子有车马，弗驰弗驱。宛其死矣，他人是愉。","b":0,"y":-700,"th":["讽刺","哲理","及时行乐"],"ap":1},{"id":"a60570ff024e","t":"狼跋","a":"佚名","d":1,"f":"诗经","g":"诗","x":"狼跋其胡，载疐其尾。公孙硕肤，赤舄几几。","b":0,"y":-700,"th":["讽刺","咏物","政治"],"ap":1},{"id":"42f8ba2d2c3b","t":"羔裘","a":"佚名","d":1,"f":"诗经","g":"诗","x":"羔裘豹祛，自我人居居。岂无他人？维子之故。","b":0,"y":-700,"th":["讽刺","怨刺","人情冷暖"],"ap":1},{"id":"e11aca99240e","t":"芄兰","a":"佚名","d":1,"f":"诗经","g":"诗","x":"芄兰之支，童子佩觿。虽则佩觿，能不我知。容兮遂兮，垂带悸兮。","b":0,"y":-700,"th":["讽刺","爱情","咏物"],"ap":1},{"id":"e0f794d59720","t":"蝃蝀","a":"佚名","d":1,"f":"诗经","g":"诗","x":"蝃蝀在东，莫之敢指。女子有行，远父母兄弟。","b":0,"y":-700,"th":["婚姻","讽刺","礼教"],"ap":1},{"id":"74d23b1c9afe","t":"南山","a":"佚名","d":1,"f":"诗经","g":"诗","x":"南山崔崔，雄狐绥绥。鲁道有荡，齐子由归。既曰归止，曷又怀止？","b":1,"y":-694,"th":["讽刺","政治","伦理"],"ap":1},{"id":"55a2cd4e75ff","t":"载驱","a":"佚名","d":1,"f":"诗经","g":"诗","x":"载驱薄薄，簟茀朱鞹。鲁道有荡，齐子发夕。","b":1,"y":-694,"th":["讽刺","史事","政治"],"ap":1},{"id":"34f7d460708f","t":"君子偕老","a":"佚名","d":1,"f":"诗经","g":"诗","x":"君子偕老，副笄六珈。委委佗佗，如山如河，象服是宜。子之不淑，云如之何？","b":1,"y":-650,"th":["讽刺","咏人","宫廷"],"ap":1},{"id":"458a0c6020bf","t":"墙有茨","a":"佚名","d":1,"f":"诗经","g":"诗","x":"墙有茨，不可扫也。中冓之言，不可道也。所可道也，言之丑也。","b":1,"y":-650,"th":["讽刺","政治","宫闱"],"ap":1},{"id":"fd285bc59340","t":"敝笱","a":"佚名","d":1,"f":"诗经","g":"诗","x":"敝笱在梁，其鱼鲂鳏。齐子归止，其从如云。","b":1,"y":-650,"th":["讽刺","政治","咏物"],"ap":1},{"id":"b33bdc927c62","t":"清人","a":"佚名","d":1,"f":"诗经","g":"诗","x":"清人在彭，驷介旁旁。二矛重英，河上乎翱翔。","b":1,"y":-650,"th":["讽刺","军旅","怀古"],"ap":1},{"id":"9b22d6c4574a","t":"相鼠","a":"佚名","d":1,"f":"诗经","g":"诗","x":"相鼠有皮，人而无仪！人而无仪，不死何为？","b":1,"y":-650,"th":["讽刺","哲理"],"ap":1},{"id":"64f67b16c954","t":"鹑之奔奔","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鹑之奔奔，鹊之彊彊。人之无良，我以为兄！","b":1,"y":-650,"th":["讽刺","弃怨","伦理"],"ap":1},{"id":"51672a83c681","t":"株林","a":"佚名","d":1,"f":"诗经","g":"诗","x":"胡为乎株林？从夏南！匪适株林，从夏南！","b":1,"y":-600,"th":["讽刺","政治","咏史"],"ap":1},{"id":"cae0d464bcd5","t":"孟子·梁惠王下 其37","a":"孟子","d":1,"f":"文","g":"文","x":"王顾左右而言他。","b":5,"y":-320,"th":["哲理","讽刺","政治"],"ap":1},{"id":"e87c2c340df2","t":"孟子·滕文公下 其41","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「仲子，齐之世家也。兄戴，盖禄万锺。以兄之禄为不义之禄而不食也，以兄之室为不义之室而不居也，辟兄离母，处于于陵。他日归，则有馈其兄生鹅者，己频𫖹曰：『恶用是鶃鶃者为哉？』他日，其母杀是鹅也，与之食之。其兄自外至，曰：『是鶃鶃之肉也。』出而哇之。以母则不食，以妻则食之；以兄之室则弗居，以于陵则居之。是尚为能充其类也乎？若仲子者，蚓而后充其操者也。」","b":5,"y":-320,"th":["哲理","讽刺","伦理"],"ap":1},{"id":"b37c51647a13","t":"杂曲歌辞 妾薄命","a":"王贞白","d":6,"f":"五律","g":"诗","x":"薄命头欲白，频年嫁不成。","b":0,"y":750,"th":["闺怨","讽刺"],"ap":1},{"id":"f71c56c123d1","t":"杂曲歌辞 少年乐","a":"张祜","d":6,"f":"五古","g":"诗","x":"二十便封侯，名居第一流。","b":0,"y":750,"th":["豪情","奢华","讽刺"],"ap":1},{"id":"9a6256c0b0fa","t":"杂曲歌辞 轻薄篇二首 一","a":"僧贯休","d":6,"f":"古体","g":"诗","x":"绣林锦野，春态相压。","b":1,"y":750,"th":["讽刺","社会批判","咏人"],"ap":1},{"id":"267272e52e29","t":"相和歌辞 猛虎行","a":"李贺","d":6,"f":"古体","g":"诗","x":"长戈莫舂，彊弩莫烹。","b":1,"y":750,"th":["咏物","讽刺","咏史"],"ap":1},{"id":"57dee9390fea","t":"相和歌辞 猛虎行","a":"僧齐己","d":6,"f":"古体","g":"诗","x":"磨尔牙，错尔爪，狐莫威，兔莫狡，饮来吞噬取肠饱。","b":1,"y":750,"th":["咏物","讽刺","政治"],"ap":1},{"id":"050271d13752","t":"相和歌辞 王昭君三首 三","a":"郭元振","d":6,"f":"五绝","g":"诗","x":"闻有南河信，传闻杀画师。","b":1,"y":750,"th":["咏史","宫怨","讽刺"],"ap":1},{"id":"d4b7bef9bbd5","t":"相和歌辞 读曲歌五首 三","a":"张祜","d":6,"f":"五绝","g":"诗","x":"不见心相许，徒云脚漫勤。","b":2,"y":750,"th":["爱情","闺怨","讽刺"],"ap":1},{"id":"8a6c5137b859","t":"杂曲歌辞 丽人行","a":"杜甫","d":6,"f":"古体","g":"诗","x":"三月三日天气新，长安水边多丽人。","b":2,"y":753,"th":["讽刺","咏史","宫廷"],"ap":1},{"id":"39b43c06ac93","t":"杂曲歌辞 羽林行","a":"孟郊","d":6,"f":"五律","g":"诗","x":"朔雪寒断指，朔风劲裂冰。","b":2,"y":800,"th":["边塞","讽刺","咏怀"],"ap":1},{"id":"21feedf08294","t":"琴曲歌辞 走马引","a":"李贺","d":6,"f":"五律","g":"诗","x":"我有辞乡劒，玉锋堪截云。","b":3,"y":800,"th":["游侠","讽刺","咏物"],"ap":1},{"id":