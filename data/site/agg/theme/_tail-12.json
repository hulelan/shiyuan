b","t":"看花回","a":"柳永","d":8,"f":"词","g":"词","x":"屈指劳生百岁期。","b":1,"y":1030,"th":["哲理","叹时","厌世"],"ap":1},{"id":"331df8e08745","t":"过涧歇近・过涧歇","a":"柳永","d":8,"f":"词","g":"词","x":"淮楚。","b":2,"y":1045,"th":["羁旅","厌世","归隐"],"ap":1},{"id":"fd54b38c7066","t":"南吕・四块玉闲适（四首）","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"适意行，安心坐，渴时饮饥时餐醉时歌，困来时就向莎茵卧。","b":0,"y":1290,"th":["隐逸","闲适","厌世","哲理"],"ap":1}],"t436":[{"id":"0efcda4e7786","t":"孟子·公孙丑上 其30","a":"孟子","d":1,"f":"文","g":"文","x":"「伯夷、伊尹于孔子，若是班乎？」","b":4,"y":-320,"th":["哲理","圣贤之道","儒家思想"],"ap":1},{"id":"1518a0af89c3","t":"孟子·公孙丑上 其29","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「不同道。非其君不事，非其民不使；治则进，乱则退，伯夷也。何事非君，何使非民；治亦进，乱亦进，伊尹也。可以仕则仕，可以止则止，可以久则久，可以速则速，孔子也。皆古圣人也，吾未能有行焉；乃所愿，则学孔子也。」","b":5,"y":-300,"th":["哲理","圣贤之道","处世哲学"],"ap":1}],"t447":[{"id":"2715da05da9c","t":"论语·公冶长篇 其16","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子谓子产：“有君子之道四焉：其行己也恭，其事上也敬，其养民也惠，其使民也义。”","b":1,"y":-500,"th":["哲理","治国","儒家"],"ap":1},{"id":"45b41608c99e","t":"孟子·滕文公上 其6","a":"孟子","d":1,"f":"文","g":"文","x":"然友复之邹问孟子。孟子曰：「然。不可以他求者也。孔子曰：『君薨，听于冢宰。歠粥，面深墨。即位而哭，百官有司，莫敢不哀，先之也。』上有好者，下必有甚焉者矣。『君子之德，风也；小人之德，草也。草尚之风必偃。』是在世子。」","b":5,"y":-320,"th":["哲理","治国","儒家"],"ap":1}],"t454":[{"id":"362e8d2a8df7","t":"论语·季氏篇 其12","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"齐景公有马千驷，死之日，民无德而称焉；伯夷、叔齐饿于首阳之下，民到于今称之。其斯之谓与？”","b":1,"y":-500,"th":["哲理","咏史","修德"],"ap":1},{"id":"88eb026b3ee8","t":"孟子·离娄上 其20","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「恭者不侮人，俭者不夺人。侮夺人之君，惟恐不顺焉，恶得为恭俭？恭俭岂可以声音笑貌为哉？」","b":5,"y":-320,"th":["哲理","政治","修德"],"ap":1}],"t472":[{"id":"632cdfaa598a","t":"鼓钟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鼓钟将将，淮水汤汤，忧心且伤。淑人君子，怀允不忘。","b":1,"y":-700,"th":["伤时","怀古","咏乐"],"ap":1},{"id":"1fe68ce4a1cd","t":"更漏子","a":"张先","d":8,"f":"词","g":"词","x":"相君家，宾宴集。","b":1,"y":1035,"th":["宴饮","咏乐","写人"],"ap":1}],"t483":[{"id":"9f2a79732c93","t":"鹤鸣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鹤鸣于九皋，声闻于野。鱼潜在渊，或在于渚。乐彼之园，爰有树檀，其下维萚。他山之石，可以为错。","b":1,"y":-700,"th":["哲理","咏物","招贤"],"ap":1},{"id":"8bec7ed3ad4d","t":"干旄","a":"佚名","d":1,"f":"诗经","g":"诗","x":"孑孑干旄，在浚之郊。素丝纰之，良马四之。彼姝者子，何以畀之？","b":1,"y":-650,"th":["招贤","爱情","礼赞"],"ap":1}],"t490":[{"id":"ed7c1299c44c","t":"孟子·公孙丑上 其35","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「宰我、子贡、有若智足以知圣人。污，不至阿其所好。宰我曰：『以予观于夫子，贤于尧舜远矣。』子贡曰：『见其礼而知其政，闻其乐而知其德。由百世之后，等百世之王，莫之能违也。自生民以来，未有夫子也。』有若曰：『岂惟民哉？麒麟之于走兽，凤凰之于飞鸟，太山之于丘垤，河海之于行潦，类也。圣人之于民，亦类也。出于其类，拔乎其萃，自生民以来，未有盛于孔子也。』」","b":4,"y":-320,"th":["尊师重道","儒家道统","哲理"],"ap":1},{"id":"a20a0db6f22c","t":"孟子·公孙丑上 其26","a":"孟子","d":1,"f":"文","g":"文","x":"「昔者窃闻之：子夏、子游、子张皆有圣人之一体，冉牛、闵子、颜渊则具体而微。敢问所安。」","b":5,"y":-300,"th":["哲理","儒家道统","人物品鉴"],"ap":1}],"t502":[{"id":"01a8f322d99d","t":"舞曲歌辞 白纻歌二首 一","a":"王建","d":6,"f":"七古","g":"诗","x":"天河漫漫北斗粲，宫中乌啼知夜半。","b":8,"y":800,"th":["宫廷","咏舞","宴饮"],"ap":1},{"id":"713a1718df9f","t":"舞曲歌辞 霓裳辞十首 七","a":"王建","d":6,"f":"七绝","g":"诗","x":"敕赐宫人澡浴回，遥看美女院门开。","b":8,"y":803,"th":["宫廷","咏舞","盛世"],"ap":1}],"t524":[{"id":"2747b73734b0","t":"游长宁公主流杯池二十五首 二十四","a":"上官昭容","d":6,"f":"七绝","g":"诗","x":"参差碧岫耸莲花，潺湲绿水莹金沙。","b":1,"y":705,"th":["山水/仙境/哲理"],"ap":1},{"id":"dedbea836730","t":"玄都观","a":"蜀太后徐氏","d":6,"f":"七律","g":"诗","x":"千寻绿嶂夹流溪，登眺因知海岳低。","b":10,"y":900,"th":["山水/仙境/哲理"],"ap":1}],"t537":[{"id":"44ec1dd1b6b3","t":"相和歌辞 相逢行二首 二","a":"李白","d":6,"f":"五绝","g":"诗","x":"相逢红尘内，高揖黄金鞭。","b":3,"y":736,"th":["相逢","都市风情","友情"],"ap":1},{"id":"f427193640a4","t":"相和歌辞 相逢行","a":"韦应物","d":6,"f":"五古","g":"诗","x":"二十登汉朝，英声迈今古。","b":7,"y":780,"th":["友情","相逢","离别","仕途"],"ap":1}],"t546":[{"id":"f4b5577e9082","t":"唐明堂乐章 皇帝行","a":"则天皇后","d":6,"f":"四言","g":"诗","x":"仰膺历数，俯顺讴歌。","b":1,"y":690,"th":["政治颂赞","太平理想","礼乐教化"],"ap":1},{"id":"5700743ffeb0","t":"句","a":"宣宗皇帝","d":6,"f":"古体","g":"诗","x":"海岳宴咸通，七载秉钧调四序。","b":10,"y":866,"th":["咏史怀古","政治颂赞","民生关怀"],"ap":1}],"t551":[{"id":"72f39f380138","t":"郊庙歌辞 明皇祀圜丘乐章 太和","a":"不详","d":6,"f":"四言","g":"诗","x":"郊坛斋帝，礼乐祀天。","b":3,"y":735,"th":["礼乐/祭祀/祥瑞"],"ap":1},{"id":"e31a20710971","t":"郊庙歌辞 朝日乐章 迎神","a":"不详","d":6,"f":"四言","g":"诗","x":"太阳朝序，王宫有仪。","b":5,"y":750,"th":["礼乐/祭祀/祥瑞"],"ap":1}],"t568":[{"id":"f0c92b5b88a4","t":"游长宁公主流杯池二十五首 十五","a":"上官昭容","d":6,"f":"五绝","g":"诗","x":"携琴侍叔夜，负局访安期。","b":1,"y":705,"th":["隐逸","山水","雅趣"],"ap":1},{"id":"c883a22be3fb","t":"蔷薇诗一首十八韵呈东海侍郎徐铉","a":"韩王从善","d":6,"f":"古体","g":"诗","x":"绿影覆幽池，芳菲四月时。","b":10,"y":970,"th":["咏物","酬赠","自然","雅趣"],"ap":1}],"t595":[{"id":"0196c108a286","t":"孟子·滕文公下 其14","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「非其道，则一箪食不可受于人；如其道，则舜受尧之天下，不以为泰，子以为泰乎？」","b":5,"y":-320,"th":["哲理","义利之辨","道德操守"],"ap":1}],"t609":[{"id":"122e7b9991a1","t":"哀岁","a":"王逸","d":1,"f":"楚辞","g":"诗","x":"旻天兮清凉，玄气兮高朗。","b":5,"y":-300,"th":["岁暮感怀","咏物抒愤","怀古伤己","隐逸"],"ap":1}],"t623":[{"id":"1dbe6359aaf9","t":"有狐","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有狐绥绥，在彼淇梁。心之忧矣，之子无裳。","b":0,"y":-700,"th":["爱情","忧思","怀人"],"ap":1}],"t630":[{"id":"263091314ea2","t":"大司命","a":"屈原","d":1,"f":"楚辞","g":"诗","x":"广开兮天门，纷吾乘兮玄云","b":5,"y":-300,"th":["神话祭祀","生死哲理","离愁别绪"],"ap":1}],"t645":[{"id":"2f0b826a96e0","t":"孟子·公孙丑上 其17","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「志壹则动气，气壹则动志也。今夫蹶者趋者，是气也，而反动其心。」","b":4,"y":-320,"th":["哲理","修身","养气"],"ap":1}],"t681":[{"id":"4fc516c18189","t":"孟子·滕文公上 其11","a":"孟子","d":1,"f":"文","g":"文","x":"使毕战问井地。孟子曰：「子之君将行仁政，选择而使子，子必勉之！夫仁政，必自经界始。经界不正，井地不钧，谷禄不平。是故暴君污吏必慢其经界。经界既正，分田制禄可坐而定也。夫滕壤地褊小，将为君子焉，将为野人焉。无君子莫治野人，无野人莫养君子。请野九一而助，国中什一使自赋。卿以下必有圭田，圭田五十亩。余夫二十五亩。死徙无出乡，乡田同井。出入相友，守望相助，疾病相扶持，则百姓亲睦。方里而井，井九百亩，其中为公田。八家皆私百亩，同养公田。公事毕，然后敢治私事，所以别野人也。此其大略也。若夫润泽之，则在君与子矣。」","b":5,"y":-320,"th":["仁政","井田制","经界","社会理想"],"ap":1}],"t696":[{"id":"64fba8e504a5","t":"论语·微子篇 其7","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子路从而后，遇丈人，以杖荷蓧。子路问曰：“子见夫子乎？”丈人曰：“四体不勤，五谷不分，孰为夫子？”植其杖而芸，子路拱而立。止子路宿，杀鸡为黍而食之，见其二子焉。明日，子路行以告，子曰：“隐者也。”使子路反见之，至则行矣。子路曰：“不仕无义。长幼之节不可废也，君臣之义如之何其废之？欲洁其身而乱大伦。君子之仕也，行其义也，道之不行已知之矣。”","b":2,"y":-490,"th":["哲理","隐逸","入世担当"],"ap":1}],"t700":[{"id":"6bf4715ef787","t":"论语·季氏篇 其14","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"邦君之妻，君称之曰夫人，夫人自称曰小童；邦人称之曰君夫人，称诸异邦曰寡小君；异邦人称之亦曰君夫人。","b":3,"y":-450,"th":["礼制","正名","称谓"],"ap":1}],"t713":[{"id":"7b14c6cd71ac","t":"孟子·梁惠王上 其21","a":"孟子","d":1,"f":"文","g":"文","x":"齐宣王问曰：「齐桓、晋文之事可得闻乎？」","b":4,"y":-320,"th":["王道霸业","仁政","哲学思辨"],"ap":1}],"t739":[{"id":"a2b2a4f2e7a1","t":"东方未明","a":"佚名","d":1,"f":"诗经","g":"诗","x":"东方未明，颠倒衣裳。颠之倒之，自公召之。","b":0,"y":-700,"th":["徭役","批判","疾苦"],"ap":1}],"t775":[{"id":"c76e6765b9b2","t":"下泉","a":"佚名","d":1,"f":"诗经","g":"诗","x":"冽彼下泉，浸彼苞稂。忾我寤叹，念彼周京。","b":1,"y":-550,"th":["怀古","伤时","思治"],"ap":1}],"t788":[{"id":"d8bd160f58db","t":"中庸·中庸 其5","a":"子思（传）","d":1,"f":"文","g":"文","x":"子曰：「道其不行矣夫。」","b":4,"y":-430,"th":["哲理","忧世"],"ap":1}],"t807":[{"id":"e7c5d2fccf1e","t":"论语·卫灵公篇 其11","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"颜渊问为邦，子曰：“行夏之时，乘殷之辂，服周之冕，乐则《韶》、《舞》；放郑声，远佞人。郑声淫，佞人殆。”","b":2,"y":-450,"th":["治国理政","礼乐文明","儒家哲理"],"ap":1}],"t814":[{"id":"eafec38057ff","t":"论语·卫灵公篇 其30","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“过而不改，是谓过矣。”","b":1,"y":-500,"th":["哲理","修身","知错能改"],"ap":1}],"t832":[{"id":"fbfe34336e1a","t":"孟子·公孙丑上 其10","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「若是，则夫子过孟贲远矣。」","b":4,"y":-320,"th":["哲理","修养","勇德"],"ap":1}],"t858":[{"id":"063c87ad2b60","t":"郊庙歌辞 释奠文宣王乐章 肃和","a":"不详","d":6,"f":"四言","g":"诗","x":"粤惟上圣，有纵自天。","b":6,"y":750,"th":["礼乐/尊儒/教化"],"ap":1}],"t861":[{"id":"07cea7dca98d","t":"郊庙歌辞 禅社首乐章 雍和","a":"贺知章、源乾曜","d":6,"f":"四言","g":"诗","x":"夙夜宥密，不敢宁宴。","b":2,"y":713,"th":["礼乐/德治/祭祀"],"ap":1}],"t876":[{"id":"138ad144e6e3","t":"杂曲歌辞 苦热行","a":"僧皎然","d":6,"f":"五古","g":"诗","x":"六月金数伏，兹辰日在庚。","b":7,"y":780,"th":["苦热","赠答","哲理","济世"],"ap":1}],"t919":[{"id":"2cd8eb36aa9e","t":"相和歌辞  苦寒行","a":"僧齐己","d":6,"f":"古体","g":"诗","x":"冰峰撑空寒矗矗，雪凝水冻埋海陆。","b":10,"y":898,"th":["咏物","哲理","政治隐喻","济世情怀"],"ap":1}],"t920":[{"id":"2cfcf8c62c8c","t":"相和歌辞 子夜四时歌四首 冬歌","a":"陆龟蒙","d":6,"f":"五绝","g":"诗","x":"南光走冷圭，北籁号空木。","b":9,"y":855,"th":["咏物","托物言志","岁寒"],"ap":1}],"t933":[{"id":"357abfb19a12","t":"鼓吹曲辞 黄雀行","a":"庄南杰","d":6,"f":"七律","g":"诗","x":"穿屋穿墙不知止，争树争巢入营死。","b":6,"y":750,"th":["咏物","讽喻","生命哲思"],"ap":1}],"t955":[{"id":"4282472de922","t":"题程修己竹障","a":"文宗皇帝","d":6,"f":"古体","g":"诗","x":"良工运精思，巧极似有神。","b":9,"y":840,"th":["咏物"