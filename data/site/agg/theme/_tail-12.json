{"t069":[{"id":"94fda7635e5c","t":"草虫","a":"佚名","d":1,"f":"诗经","g":"诗","x":"喓喓草虫，趯趯阜螽。未见君子，忧心忡忡。亦既见止，亦既觏止，我心则降。","b":0,"y":-761,"th":["爱情","思妇","怀人"],"ap":1},{"id":"56f8e3c9e32f","t":"卷耳","a":"佚名","d":1,"f":"诗经","g":"诗","x":"采采卷耳，不盈顷筐。嗟我怀人，置彼周行。","b":0,"y":-700,"th":["爱情","思妇","征役"],"ap":1},{"id":"924d597e17e6","t":"殷其雷","a":"佚名","d":1,"f":"诗经","g":"诗","x":"殷其雷，在南山之阳。何斯违斯，莫敢或遑？振振君子，归哉归哉！","b":0,"y":-700,"th":["思妇","行役","怀人"],"ap":1},{"id":"9804dcbe5a47","t":"雄雉","a":"佚名","d":1,"f":"诗经","g":"诗","x":"雄雉于飞，泄泄其羽。我之怀矣，自诒伊阻。","b":1,"y":-700,"th":["思妇","怀人","哲理"],"ap":1},{"id":"c5bee6a12ac0","t":"杕杜","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有杕之杜，有睆其实。王事靡盬，继嗣我日。日月阳止，女心伤止，征夫遑止。","b":0,"y":-700,"th":["思妇","怀远","战争徭役"],"ap":1},{"id":"dad70fdb2381","t":"汝坟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"遵彼汝坟，伐其条枚。未见君子，惄如调饥。","b":0,"y":-700,"th":["闺怨","思妇","乱世离愁"],"ap":1},{"id":"e2a86f29696a","t":"君子于役","a":"佚名","d":1,"f":"诗经","g":"诗","x":"君子于役，不知其期。曷至哉？鸡栖于埘。日之夕矣，羊牛下来。君子于役，如之何勿思！","b":0,"y":-700,"th":["思妇","战争","田园"],"ap":1},{"id":"1e37209942b8","t":"小戎","a":"佚名","d":1,"f":"诗经","g":"诗","x":"小戎俴收，五楘梁辀。游环胁驱，阴靷鋈续。文茵畅毂，驾我骐馵。","b":1,"y":-650,"th":["思妇","战争","咏物"],"ap":1},{"id":"9e22f10553cd","t":"相和歌辞 中妇织流黄","a":"虞世南","d":6,"f":"五律","g":"诗","x":"寒闺织素锦，含怨敛双蛾。","b":0,"y":620,"th":["闺怨","边塞","思妇"],"ap":1},{"id":"72b1514c9125","t":"相和歌辞 江南曲","a":"宋之问","d":6,"f":"古体","g":"诗","x":"妾住越城南，离居不自堪。","b":1,"y":700,"th":["闺怨","思妇","离愁"],"ap":1},{"id":"67c905988446","t":"古意呈补阙乔知之","a":"沈佺期","d":6,"f":"七律","g":"诗","x":"卢家少妇郁金堂，海燕双栖玳瑁梁。","b":1,"y":705,"th":["闺怨","思妇","边塞","离愁"],"ap":1},{"id":"7edb2692b24a","t":"闺怨","a":"王昌龄","d":6,"f":"七绝","g":"诗","x":"闺中少妇不曾愁，春日凝妆上翠楼。","b":3,"y":733,"th":["爱情","闺怨","思妇"],"ap":1},{"id":"d364ad0611fa","t":"相和歌辞 乌夜啼","a":"李白","d":6,"f":"七古","g":"诗","x":"黄云城边乌欲栖，归飞哑哑枝上啼。","b":3,"y":736,"th":["闺怨","思妇","怀人"],"ap":1},{"id":"e2b98d52156c","t":"杂曲歌辞 长相思三首 二","a":"李白","d":6,"f":"古体","g":"诗","x":"日色已尽花含烟，月明欲素愁不眠。","b":3,"y":736,"th":["闺怨","思妇","边塞","相思"],"ap":1},{"id":"04a193055497","t":"