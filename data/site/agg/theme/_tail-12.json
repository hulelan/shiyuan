:["咏物","仙道","夜景"],"ap":1},{"id":"3a72e4484da8","t":"琴曲歌辞  秋思二首 一","a":"王涯","d":6,"f":"七绝","g":"诗","x":"网轩凉吹动轻衣，夜听更长玉漏稀。","b":8,"y":799,"th":["秋思","夜景","孤寂"],"ap":1},{"id":"285680dc7cf2","t":"琴曲歌辞 宛转行","a":"张籍","d":6,"f":"五古","g":"诗","x":"华屋重翠幄，绮席雕象床。","b":9,"y":815,"th":["闺怨","爱情","夜景"],"ap":1}],"t256":[{"id":"0f9444526673","t":"孟子·公孙丑下 其55","a":"孟子","d":1,"f":"文","g":"文","x":"公孙丑问曰：「仕而不受禄，古之道乎？」","b":4,"y":-320,"th":["哲理","义利之辨","出仕之道"],"ap":1},{"id":"a8f1b19615aa","t":"孟子·滕文公下 其9","a":"孟子","d":1,"f":"文","g":"文","x":"「出疆必载质，何也？」","b":5,"y":-320,"th":["哲理","礼制","出仕之道"],"ap":1},{"id":"0d008a93b1a7","t":"孟子·滕文公下 其12","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「丈夫生而愿为之有室，女子生而愿为之有家。父母之心，人皆有之。不待父母之命、媒妁之言，钻穴隙相窥，逾墙相从，则父母国人皆贱之。古之人未尝不欲仕也，又恶不由其道。不由其道而往者，与钻穴隙之类也。」","b":5,"y":-300,"th":["哲理","礼义","出仕之道"],"ap":1}],"t278":[{"id":"67e01d30b70e","t":"孟子·滕文公上 其1","a":"孟子","d":1,"f":"文","g":"文","x":"滕文公为世子，将之楚，过宋而见孟子。孟子道性善，言必称尧舜。","b":4,"y":-330,"th":["哲理","性善","仁政"],"ap":1},{"id":"a86cc7948ecc","t":"孟子·梁惠王上 其31","a":"孟子","d":1,"f":"文","g":"文","x":"王曰：「然。诚有百姓者。齐国虽褊小，吾何爱一牛？即不忍其觳觫，若无罪而就死地，故以羊易之也。」","b":4,"y":-320,"th":["哲理","仁政","性善"],"ap":1},{"id":"dff588c3313c","t":"孟子·公孙丑上 其39","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「人皆有不忍人之心。先王有不忍人之心，斯有不忍人之政矣。以不忍人之心，行不忍人之政，治天下可运之掌上。所以谓人皆有不忍人之心者，今人乍见孺子将入于井，皆有怵惕恻隐之心。非所以内交于孺子之父母也，非所以要誉于乡党朋友也，非恶其声而然也。由是观之，无恻隐之心，非人也；无羞恶之心，非人也；无辞让之心，非人也；无是非之心，非人也。恻隐之心，仁之端也；羞恶之心，义之端也；辞让之心，礼之端也；是非之心，智之端也。人之有是四端也，犹其有四体也。有是四端而自谓不能者，自贼者也；谓其君不能者，贼其君者也。凡有四端于我者，知皆扩而充之矣，若火之始然，泉之始达。苟能充之，足以保四海；苟不充之，不足以事父母。」","b":4,"y":-320,"th":["哲理","性善","仁政"],"ap":1}],"t285":[{"id":"d8be0e992c81","t":"危俊","a":"王褒","d":1,"f":"楚辞","g":"诗","x":"林不容兮鸣蜩，余何留兮中州？","b":5,"y":-300,"th":["远游","孤愤","高洁"],"ap":1},{"id":"86e05e74a4d4","t":"琴曲歌辞 雉朝飞操","a":"李白","d":6,"f":"古体","g":"诗","x":"麦陇青青三月时，白雉朝飞挟两雌。","b":2,"y":736,"th":["咏物","伤老","孤愤"],"ap":1},{"id":"a667258500d7","t":"琴曲歌辞 雉朝飞操","a":"韩愈","d":6,"f":"古体","g":"诗","x":"雉之飞，于朝日。","b":8,"y":800,"th":["咏物","抒怀","孤愤"],"ap":1}],"t304":[{"id":"ae4f96f0efc0","t":"杂曲歌辞 