[{"id":"bc3986158b0e","t":"公刘","a":"佚名","d":1,"f":"诗经","g":"诗","x":"笃公刘，匪居匪康。乃埸乃疆，乃积乃仓；乃裹餱粮，于橐于囊。","b":0,"y":-1050,"th":["史诗","开国","咏人"],"ap":1},{"id":"b98b4f2e6235","t":"思齐","a":"佚名","d":1,"f":"诗经","g":"诗","x":"思齐大任，文王之母，思媚周姜，京室之妇。大姒嗣徽音，则百斯男。","b":0,"y":-1050,"th":["颂古","咏人","哲理"],"ap":1},{"id":"7104bfb7f221","t":"硕人","a":"佚名","d":1,"f":"诗经","g":"诗","x":"硕人其颀，衣锦褧衣。齐侯之子，卫侯之妻。东宫之妹，邢侯之姨，谭公维私。","b":0,"y":-750,"th":["咏人","婚姻","贵族"],"ap":1},{"id":"fb00f627b20f","t":"出其东门","a":"佚名","d":1,"f":"诗经","g":"诗","x":"出其东门，有女如云。虽则如云。匪我思存。缟衣綦巾，聊乐我员。","b":0,"y":-700,"th":["爱情","专一","咏人"],"ap":1},{"id":"e470691a71ea","t":"月出","a":"佚名","d":1,"f":"诗经","g":"诗","x":"月出皎兮。佼人僚兮。舒窈纠兮。劳心悄兮。","b":0,"y":-700,"th":["爱情","相思","咏人"],"ap":1},{"id":"1a465f5bcd6c","t":"有女同车","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有女同车，颜如舜华。将翱将翔，佩玉琼琚。彼美孟姜，洵美且都。","b":0,"y":-700,"th":["爱情","咏人","赞美"],"ap":1},{"id":"bc32f7a8da8a","t":"淇奥","a":"佚名","d":1,"f":"诗经","g":"诗","x":"瞻彼淇奥，绿竹猗猗。有匪君子，如切如磋，如琢如磨，瑟兮僴兮，赫兮咺兮。有匪君子，终不可谖兮。","b":0,"y":-700,"th":["赞美","咏人","修身"],"ap":1},{"id":"543fd246d437","t":"终南","a":"佚名","d":1,"f":"诗经","g":"诗","x":"终南何有？有条有梅。君子至止，锦衣狐裘。颜如渥丹，其君也哉！","b":0,"y":-700,"th":["赞颂","咏人","礼乐"],"ap":1},{"id":"ec64a7a9d8ae","t":"考槃","a":"佚名","d":1,"f":"诗经","g":"诗","x":"考槃在涧，硕人之宽。独寐寤言，永矢弗谖。","b":0,"y":-700,"th":["隐逸","咏人","高洁"],"ap":1},{"id":"760d84fb5107","t":"驺虞","a":"佚名","d":1,"f":"诗经","g":"诗","x":"彼茁者葭，壹发五豝，于嗟乎驺虞！","b":1,"y":-700,"th":["田猎","咏人","赞美"],"ap":1},{"id":"34f7d460708f","t":"君子偕老","a":"佚名","d":1,"f":"诗经","g":"诗","x":"君子偕老，副笄六珈。委委佗佗，如山如河，象服是宜。子之不淑，云如之何？","b":1,"y":-650,"th":["讽刺","咏人","宫廷"],"ap":1},{"id":"f31bfa2bccf5","t":"大学·大学 其4","a":"曾子（传）","d":1,"f":"文","g":"文","x":"《诗》云：「瞻彼淇澳，菉竹猗猗。有斐君子，如切如磋，如琢如磨。瑟兮僩兮，赫兮喧兮。有斐君子，终不可諠兮！」「如切如磋」者，道学也；「如琢如磨」者，自修也；「瑟兮僩兮」者，恂栗也；「赫兮喧兮」者，威仪也；「有斐君子，终不可諠兮」者，道盛德至善，民之不能忘也。《诗》云：「於戏前王不忘！」君子贤其贤而亲其亲，小人乐其乐而利其利，此以没世不忘也。","b":2,"y":-450,"th":["哲理","修身","治学","咏人"],"ap":1},{"id":"f48ce1f7e3cf","t":"论语·泰伯篇 其21","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“禹，吾无间然矣。菲饮食而致孝乎鬼神，恶衣服而致美乎黼冕，卑宫室而尽力乎沟洫。禹，吾无间然矣。”","b":3,"y":-450,"th":["崇古","哲理","咏人"],"ap":1},{"id":"014523303f71","t":"中庸·中庸 其31","a":"子思（传）","d":1,"f":"文","g":"文","x":"仲尼祖述尧、舜，宪章文、武；上律天时，下袭水土。辟如天地之无不持载，无不复帱，辟如四时之错行，如日月之代明。万物并育而不相害，道并行而不相悖，小德川流，大德敦化，此天地之所以为大也。","b":4,"y":-430,"th":["哲理","咏人","天道"],"ap":1},{"id":"7d9493e8762a","t":"杂曲歌辞 东飞伯劳歌","a":"张柬之","d":6,"f":"七古","g":"诗","x":"青田白鹤丹山凤，婺女姮娥两相送。","b":0,"y":700,"th":["咏人","伤时","青春易逝"],"ap":1},{"id":"e801efdc057f","t":"杂曲歌辞 妾薄命","a":"武平一","d":6,"f":"五古","g":"诗","x":"有女妖且丽，裴回湘水湄。","b":0,"y":710,"th":["宫怨","咏人","叹时"],"ap":1},{"id":"1a85d71c6d97","t":"相和歌辞 襄阳曲二首 一","a":"崔国辅","d":6,"f":"五绝","g":"诗","x":"蕙草娇红蕚，时光舞碧鸡。","b":0,"y":740,"th":["春日","乐府","咏人"],"ap":1},{"id":"1b27b0433021","t":"杂曲歌辞 丽人曲","a":"崔国辅","d":6,"f":"五绝","g":"诗","x":"红颜称绝代，欲并真无侣。","b":0,"y":750,"th":["咏人","孤独"],"ap":1},{"id":"389e19934bb4","t":"杂曲歌辞 少年行四首 二","a":"王维","d":6,"f":"七绝","g":"诗","x":"汉家君臣欢宴终，高议云台论战功。","b":0,"y":750,"th":["边塞","建功立业","咏人"],"ap":1},{"id":"1cf82250c686","t":"杂曲歌辞 少年行四首 四","a":"王维","d":6,"f":"七绝","g":"诗","x":"一身能臂两雕弧，虏骑千群只似无。","b":0,"y":750,"th":["边塞","咏人","豪情"],"ap":1},{"id":"9a6256c0b0fa","t":"杂曲歌辞 轻薄篇二首 一","a":"僧贯休","d":6,"f":"古体","g":"诗","x":"绣林锦野，春态相压。","b":1,"y":750,"th":["讽刺","社会批判","咏人"],"ap":1},{"id":"2ec737f1eae4","t":"相和歌辞 三妇艳诗","a":"董思恭","d":6,"f":"五古","g":"诗","x":"大妇裁纨素，中妇弄明珰。","b":1,"y":750,"th":["家庭","闲适","咏人"],"ap":1},{"id":"c8bf815eecb7","t":"相和歌辞 子夜四时歌四首 春歌","a":"李白","d":6,"f":"五古","g":"诗","x":"秦地罗敷女，采桑绿水边。","b":1,"y":750,"th":["爱情","田园","咏人"],"ap":1},{"id":"591cbb3bc8ce","t":"相和歌辞 大堤曲","a":"杨巨源","d":6,"f":"古体","g":"诗","x":"二八婵娟大堤女，开𬬻相对依江渚。","b":3,"y":800,"th":["闺怨","离愁","咏人"],"ap":1},{"id":"03800886943a","t":"舞曲歌辞 霓裳辞十首 五","a":"王建","d":6,"f":"七绝","g":"诗","x":"伴教霓裳有贵妃，从初直到曲成时。","b":3,"y":805,"th":["宫廷","咏人","音乐"],"ap":1},{"id":"aa03ede53306","t":"杂曲歌辞 长安少年行十首 一","a":"李廓","d":6,"f":"五律","g":"诗","x":"金紫少年郎，绕街鞍马光。","b":3,"y":820,"th":["都市生活","咏人","讽刺"],"ap":1},{"id":"0f76a5641393","t":"杂曲歌辞 少年行二首 一","a":"杜牧","d":6,"f":"五古","g":"诗","x":"官为骏马监，职帅羽林儿。","b