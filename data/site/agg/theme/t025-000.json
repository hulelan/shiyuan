[{"id":"0c233e5837a3","t":"大明","a":"佚名","d":1,"f":"诗经","g":"诗","x":"明明在下，赫赫在上。天难忱斯，不易维王。天位殷适，使不挟四方。","b":0,"y":-1046,"th":["咏史","天命","战争","颂德"],"ap":1},{"id":"052e69baaeb5","t":"破斧","a":"佚名","d":1,"f":"诗经","g":"诗","x":"既破我斧，又缺我斨。周公东征，四国是皇。哀我人斯，亦孔之将。","b":0,"y":-1042,"th":["战争","咏史","悲叹"],"ap":1},{"id":"fda945734a98","t":"东山","a":"佚名","d":1,"f":"诗经","g":"诗","x":"我徂东山，慆慆不归。我来自东，零雨其濛。我东曰归，我心西悲。","b":0,"y":-908,"th":["思乡","战争","归家"],"ap":1},{"id":"03280f3e5120","t":"六月","a":"佚名","d":1,"f":"诗经","g":"诗","x":"六月栖栖，戎车既饬。四牡骙骙，载是常服。玁狁孔炽，我是用急。王于出征，以匡王国。","b":0,"y":-823,"th":["边塞","战争","颂功","宴饮"],"ap":1},{"id":"0d5e4d6d7a15","t":"江汉","a":"佚名","d":1,"f":"诗经","g":"诗","x":"江汉浮浮，武夫滔滔。匪安匪游，淮夷来求。既出我车，既设我旟。匪安匪舒，淮夷来铺。","b":0,"y":-820,"th":["战争","颂功","咏史"],"ap":1},{"id":"96a554a213a0","t":"出车","a":"佚名","d":1,"f":"诗经","g":"诗","x":"我出我车，于彼牧矣。自天子所，谓我来矣。召彼仆夫，谓之载矣。王事多难，维其棘矣。","b":0,"y":-800,"th":["战争","思乡","边塞","爱国"],"ap":1},{"id":"71a776b5f918","t":"常武","a":"佚名","d":1,"f":"诗经","g":"诗","x":"赫赫明明。王命卿士，南仲大祖，大师皇父。整我六师，以修我戎。既敬既戒，惠此南国。","b":0,"y":-800,"th":["战争","颂歌","军旅","怀古"],"ap":1},{"id":"274e2c5e8884","t":"采芑","a":"佚名","d":1,"f":"诗经","g":"诗","x":"薄言采芑，于彼新田，呈此菑亩。方叔涖止，其车三千。师干之试，方叔率止。","b":0,"y":-800,"th":["战争","颂赞","边塞"],"ap":1},{"id":"e2a86f29696a","t":"君子于役","a":"佚名","d":1,"f":"诗经","g":"诗","x":"君子于役，不知其期。曷至哉？鸡栖于埘。日之夕矣，羊牛下来。君子于役，如之何勿思！","b":0,"y":-700,"th":["思妇","战争","田园"],"ap":1},{"id":"1a477d2b9b31","t":"渐渐之石","a":"佚名","d":1,"f":"诗经","g":"诗","x":"渐渐之石，维其高矣。山川悠远，维其劳矣。武人东征，不遑朝矣。","b":0,"y":-700,"th":["战争","行役","劳苦"],"ap":1},{"id":"ed0bc22b4565","t":"祈父","a":"佚名","d":1,"f":"诗经","g":"诗","x":"祈父，予王之爪牙。胡转予于恤，靡所止居？","b":0,"y":-700,"th":["战争","怨刺","孝道"],"ap":1},{"id":"6fb100f8a178","t":"酌","a":"佚名","d":1,"f":"诗经","g":"诗","x":"于铄王师，遵养时晦。时纯熙矣，是用大介。我龙受之，蹻蹻王之造。载用有嗣，实维尔公允师。","b":1,"y":-700,"th":["战争","颂歌","怀古"],"ap":1},{"id":"0bac9f63b137","t":"伯兮","a":"佚名","d":1,"f":"诗经","g":"诗","x":"伯兮朅兮，邦之桀兮。伯也执殳，为王前驱。","b":1,"y":-650,"th":["闺怨","战争","相思"],"ap":1},{"id":"1e37209942b8","t":"小戎","a":"佚名","d":1,"f":"诗经","g":"诗","x":"小戎俴收，五楘梁辀。游环胁驱，阴靷鋈续。文茵畅毂，驾我骐馵。","b":1,"y":-650,"th":["思妇","战争","咏物"],"ap":1},{"id":"94d88dfdff79","t":"泮水","a":"佚名","d":1,"f":"诗经","g":"诗","x":"思乐泮水，薄采其芹。鲁侯戾止，言观其旂。其旂茷茷，鸾声哕哕。无小无大，从公于迈。","b":1,"y":-650,"th":["颂功","战争","德化"],"ap":1},{"id":"92d4fea5b7b4","t":"击鼓","a":"佚名","d":1,"f":"诗经","g":"诗","x":"击鼓其镗，踊跃用兵。土国城漕，我独南行。","b":1,"y":-550,"th":["战争","爱情","思乡"],"ap":1},{"id":"6caa7a624c10","t":"国殇","a":"屈原","d":1,"f":"楚辞","g":"诗","x":"操吴戈兮被犀甲，车错毂兮短兵接","b":5,"y":-290,"th":["战争","哀悼","咏怀"],"ap":1},{"id":"f68cc399598b","t":"横吹曲辞 出塞","a":"窦威","d":6,"f":"五律","g":"诗","x":"匈奴屡不平，汉将欲纵横。","b":0,"y":620,"th":["边塞","战争","建功立业"],"ap":1},{"id":"d0066c99dfa2","t":"相和歌辞 从军行二首 二","a":"虞世南","d":6,"f":"五古","g":"诗","x":"爟火发金微，连营出武威。","b":0,"y":620,"th":["边塞","战争","咏怀","壮行"],"ap":1},{"id":"7ac767c79d2b","t":"饮马长城窟行","a":"太宗皇帝","d":6,"f":"五古","g":"诗","x":"塞外悲风切，交河冰已结。","b":0,"y":630,"th":["边塞","战争","咏志"],"ap":1},{"id":"6eebf18a975f","t":"横吹曲辞 陇头水","a":"杨师道","d":6,"f":"五古","g":"诗","x":"陇头秋月明，陇水带关城。","b":0,"y":640,"th":["边塞","战争","思乡","壮志"],"ap":1},{"id":"404f2530ebab","t":"横吹曲辞 紫骝马","a":"卢照邻","d":6,"f":"五律","g":"诗","x":"骝马照金鞍，转战入皐兰。","b":1,"y":670,"th":["边塞","咏物","战争"],"ap":1},{"id":"e36df2ad4fe4","t":"鼓吹曲辞 战城南","a":"卢照邻","d":6,"f":"五律","g":"诗","x":"将军出紫塞，冒顿在乌贪。","b":1,"y":671,"th":["边塞","战争","豪情"],"ap":1},{"id":"8fdd48fb51e6","t":"横吹曲辞 出塞","a":"沈佺期","d":6,"f":"五律","g":"诗","x":"十年通大漠，万里出长平。","b":1,"y":691,"th":["边塞","战争","悲悯"],"ap":1},{"id":"33cd9da2cfe5","t":"凉州词二首 一","a":"王翰","d":6,"f":"七绝","g":"诗","x":"葡萄美酒夜光杯，欲饮琵琶马上催。","b":2,"y":715,"th":["边塞","战争","人生感慨"],"ap":1},{"id":"1696421a34a9","t":"平胡","a":"明皇帝","d":6,"f":"五古","g":"诗","x":"杂虏忽猖狂，无何敢乱常。","b":2,"y":720,"th":["边塞","咏史","帝王","战争"],"ap":1},{"id":"d8e90c60712c","t":"旋师喜捷","a":"明皇帝","d":6,"f":"五律","g":"诗","x":"边服胡尘起，长安汉将飞。","b":2,"y":720,"th":["边塞","战争","凯旋"],"ap":1},{"id":"119010008ce6","t":"塞下曲四首 二","a":"王昌龄","d":6,"f":"五律","g":"诗","x":"饮马渡秋水，水寒风似刀。","b":2,"y":725,"th":["边塞","怀古","战争"],"ap":1},{"id":"f45bd639d8d0","t":"横吹曲辞