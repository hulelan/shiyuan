{"t067":[{"id":"f448546f6df6","t":"扬之水","a":"佚名","d":1,"f":"诗经","g":"诗","x":"扬之水，不流束楚。终鲜兄弟，维予与女。无信人之言，人实诳女。","b":0,"y":-750,"th":["亲情","劝诫","乱世"],"ap":1},{"id":"288f7e9a1a19","t":"行苇","a":"佚名","d":1,"f":"诗经","g":"诗","x":"敦彼行苇，牛羊勿践履。方苞方体，维叶泥泥。","b":1,"y":-700,"th":["宴饮","亲情","礼乐","祈福"],"ap":1},{"id":"46c81de5b94b","t":"棠棣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"棠棣之华，鄂不韡韡。凡今之人，莫如兄弟。","b":0,"y":-700,"th":["亲情","伦理","宴饮"],"ap":1},{"id":"b87e485ae156","t":"杕杜","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有杕之杜，其叶湑湑。独行踽踽。岂无他人？不如我同父。嗟行之人，胡不比焉？人无兄弟，胡不佽焉？","b":0,"y":-700,"th":["孤独","亲情","羁旅"],"ap":1},{"id":"b9d06d59695e","t":"陟岵","a":"佚名","d":1,"f":"诗经","g":"诗","x":"陟彼岵兮，瞻望父兮。父曰：嗟！予子行役，夙夜无已。上慎旃哉，犹来！无止！","b":1,"y":-700,"th":["思乡","行役","亲情"],"ap":1},{"id":"c89cdd66e9c4","t":"葛覃","a":"佚名","d":1,"f":"诗经","g":"诗","x":"葛之覃兮，施于中谷，维叶萋萋。黄鸟于飞，集于灌木，其鸣喈喈。","b":0,"y":-700,"th":["劳动","亲情","归宁"],"ap":1},{"id":"cc47b6ccbed9","t":"頍弁","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有頍者弁，实维伊何？尔酒既旨，尔肴既嘉。岂伊异人？兄弟匪他。","b":1,"y":-700,"th":["宴饮","亲情","伤时","哲理"],"ap":1},{"id":"50ce63a422ba","t":"燕燕","a":"佚名","d":1,"f":"诗经","g":"诗","x":"燕燕于飞，差池其羽。之子于归，远送于野。瞻望弗及，泣涕如雨。","b":1,"y":-650,"th":["送别","亲情","咏物"],"ap":1},{"id":"d62d9f3e3e18","t":"渭阳","a":"佚名","d":1,"f":"诗经","g":"诗","x":"我送舅氏，曰至渭阳。何以赠之？路车乘黄。","b":1,"y":-637,"th":["送别","亲情"],"ap":1},{"id":"8e067c050573","t":"论语·子路篇 其18","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"叶公语孔子曰：“吾党有直躬者，其父攘羊，而子证之。”孔子曰：“吾党之直者异于是。父为子隐，子为父隐，直在其中矣。”","b":2,"y":-490,"th":["哲理","伦理","亲情"],"ap":1},{"id":"4498f9b0e6c2","t":"论语·里仁篇 其21","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“父母之年，不可不知也，一则以喜，一则以惧。”","b":3,"y":-450,"th":["哲理","亲情","孝道"],"ap":1},{"id":"eb6ee2031b2e","t":"黄台瓜辞","a":"章怀太子","d":6,"f":"五古","g":"诗","x":"种瓜黄台下，瓜熟子离离。","b":1,"y":684,"th":["讽喻","亲情","政治"],"ap":1},{"id":"10ebb8308948","t":"鹡鸰颂","a":"明皇帝","d":6,"f":"四言","g":"诗","x":"伊我轩宫，奇树青葱。","b":2,"y":713,"th":["咏物","亲情","自省"],"ap":1},{"id":"b752c3055edf","t":"九月九日忆山东兄弟","a":"王维","d":6,"f":"七绝","g":"诗","x":"独在异乡为异客，每逢佳节倍思亲。","b":2,"y":717,"th":["思乡","亲情","节日"],"ap":1},{"id":"522757532736","t":"句","a":"明皇帝","d":6,"f":"五律","g":"诗","x":"昔见漳滨卧，言将人事违。","b":3,"y":735,"th":["怀人","亲情","咏德"],"ap":1},{"id":"8c90ac2a09e7","t":"过大哥宅探得歌字韵","a":"明皇帝","d":6,"f":"五律","g":"诗","x":"鲁卫情先重，亲贤爱转多。","b":3,"y":740,"th":["亲情","政治哲理","宫廷生活"],"ap":1},{"id":"177c25b29968","t":"月夜忆舍弟","a":"杜甫","d":6,"f":"五律","g":"诗","x":"戍鼓断人行，秋边一雁声。","b":6,"y":759,"th":["思乡","战乱","亲情"],"ap":1},{"id":"02c414381409","t":"喜外弟卢纶见宿","a":"司空曙","d":6,"f":"五律","g":"诗","x":"静夜四无邻，荒居旧业贫。","b":7,"y":775,"th":["羁旅","亲情","感怀"],"ap":1},{"id":"b9a6699aacfa","t":"琴曲歌辞 胡笳十八拍 第十拍","a":"刘商","d":6,"f":"七律","g":"诗","x":"恨凌辱兮恶腥膻，憎胡地兮怨胡天。","b":7,"y":780,"th":["思乡","亲情","边塞"],"ap":1},{"id":"a9a75408100a","t":"送杨氏女","a":"韦应物","d":6,"f":"五古","g":"诗","x":"永日方戚戚，出门复悠悠。","b":7,"y":785,"th":["送别","亲情","伦理"],"ap":1},{"id":"4be69f7b344a","t":"琴曲歌辞 胡笳十八拍 第十四拍","a":"刘商","d":6,"f":"七律","g":"诗","x":"莫以胡儿可羞耻，恩情亦各言其子。","b":7,"y":790,"th":["思乡","亲情","边塞"],"ap":1},{"id":"8462c18a10c7","t":"琴曲歌辞 履霜操","a":"韩愈","d":6,"f":"四言","g":"诗","x":"父兮儿寒，母兮儿饥。","b":8,"y":800,"th":["弃子","亲情","哀怨"],"ap":1},{"id":"c047ab42ad40","t":"自河南经乱关内阻饥兄弟离散各在一处因望月有感聊书所怀寄上浮梁大兄於潜七兄乌江十五兄兼示符离及下邽弟妹","a":"白居易","d":6,"f":"七律","g":"诗","x":"时难年饥世业空，弟兄羇旅各西东。","b":8,"y":800,"th":["思乡","亲情","战乱"],"ap":1},{"id":"d65bc6ecb569","t":"游子吟","a":"孟郊","d":6,"f":"五古","g":"诗","x":"慈母手中线，游子身上衣。","b":8,"y":800,"th":["母爱","亲情"],"ap":1},{"id":"5ebba89cf216","t":"相和歌辞 上留田","a":"僧贯休","d":6,"f":"古体","g":"诗","x":"父不父，兄不兄，上留田，蝥贼生。","b":10,"y":867,"th":["讽喻","亲情","世风"],"ap":1},{"id":"dd8486e90a21","t":"杂曲歌辞 行路难五首 四","a":"僧贯休","d":6,"f":"古体","g":"诗","x":"君不见道傍树有寄生枝，青青郁郁同荣衰。","b":10,"y":867,"th":["讽喻","亲情","伦理"],"ap":1},{"id":"990f11162ef5","t":"杂曲歌辞 行路难","a":"聂夷中","d":6,"f":"五律","g":"诗","x":"莫言行路难，夷狄如中国。","b":10,"y":880,"th":["哲理","世态炎凉","亲情"],"ap":1},{"id":"7964305da81f","t":"示儿子","a":"陆游","d":8,"f":"七律","g":"诗","x":"父子扶携返故乡，欣然击壤咏陶唐。","b":3,"y":1203,"th":["思乡","忠君","田园","亲情"],"ap":1}],"t070":[{"id":"f2ced702f4fa","t":"柏舟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"泛彼柏舟，亦泛其流。耿耿不寐，如有隐忧。微我无酒，以敖以游。","b":1,"y":-650,"th":["闺怨","言志","抒愤"],"ap":1},{"id":"ab8ef31e4668","t":"论语·里仁篇 其8","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“朝闻道，夕死可矣。”","b":1,"y":-500,"th":["哲理","言志"],"ap":1},{"id":"d56e87e79c54","t":"论语·宪问篇 其32","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"微生亩谓孔子曰：“丘何为是栖栖者与？无乃为佞乎？”孔子曰：“非敢为佞也，疾固也。”","b":1,"y":-500,"th":["哲理","言志","济世"],"ap":1},{"id":"b81bf5057bfb","t":"论语·子罕篇 其13","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子贡曰：“有美玉于斯，韫椟而藏诸？求善贾而沽诸？”子曰：“沽之哉，沽之哉！我待贾者也。”","b":1,"y":-490,"th":["哲理","入世","言志"],"ap":1},{"id":"f8d965e9ddd7","t":"论语·先进篇 其26","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子路、曾皙、冉有、公西华侍坐，子曰：“以吾一日长乎尔，毋吾以也。居则曰‘不吾知也’如或知尔，则何以哉？”子路率尔而对曰：“千乘之国，摄乎大国之间，加之以师旅，因之以饥馑，由也为之，比及三年，可使有勇，且知方也。”夫子哂之。“求，尔何如？”对曰：“方六七十，如五六十，求也为之，比及三年，可使足民。如其礼乐，以俟君子。”“赤！尔何如？”对曰：“非曰能之，愿学焉。宗庙之事，如会同，端章甫，愿为小相焉。”“点，尔何如？”鼓瑟希，铿尔，舍瑟而作，对曰：“异乎三子者之撰。”子曰：“何伤乎？亦各言其志也。”曰：“暮春者，春服既成，冠者五六人，童子六七人，浴乎沂，风乎舞雩，咏而归。”夫子喟然叹曰：“吾与点也！”三子者出，曾皙后。曾皙曰：“夫三子者之言何如？”子曰：“亦各言其志也已矣。”曰：“夫子何哂由也？”曰：“为国以礼，其言不让，是故哂之。”“唯求则非邦也与？”“安见方六七十、如五六十而非邦也者？”“唯赤则非邦也与？”“宗庙会同，非诸侯而何？赤也为之小，孰能为之大？”","b":1,"y":-490,"th":["言志","礼乐","哲理","理想"],"ap":1},{"id":"5191f4bf8683","t":"论语·公冶长篇 其7","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“道不行，乘桴浮于海，从我者其由与？”子路闻之喜，子曰：“由也好勇过我，无所取材。”","b":2,"y":-450,"th":["哲理","师生","言志"],"ap":1},{"id":"53ee136817ed","t":"论语·述而篇 其12","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“富而可求也，虽执鞭之士，吾亦为之。如不可求，从吾所好。”","b":3,"y":-450,"th":["哲理","言志","安贫乐道"],"ap":1},{"id":"a7a44979c449","t":"论语·子罕篇 其26","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“三军可夺帅也，匹夫不可夺志也。”","b":2,"y":-450,"th":["哲理","言志","修身"],"ap":1},{"id":"f218ea02f8ac","t":"论语·公冶长篇 其26","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"颜渊、季路侍，子曰：“盍各言尔志？”子路曰：“愿车马、衣轻裘与朋友共，敝之而无憾。”颜渊曰：“愿无伐善，无施劳。”子路曰：“愿闻子之志。”子曰：“老者安之，朋友信之，少者怀之。”","b":2,"y":-450,"th":["哲理","言志","修身"],"ap":1},{"id":"019772e99f35","t":"孟子·滕文公下 其37","a":"孟子","d":1,"f":"文","g":"文","x":"「昔者禹抑洪水而天下平，周公兼夷狄驱猛兽而百姓宁，孔子成《春秋》而乱臣贼子惧。《诗》云：『戎狄是膺，荆舒是惩，则莫我敢承。』无父无君，是周公所膺也。我亦欲正人心，息邪说，距诐行，放淫辞，以承三圣者；岂好辩哉？予不得已也。能言距杨墨者，圣人之徒也。」","b":5,"y":-320,"th":["哲理","言志","怀古"],"ap":1},{"id":"aead4cdcbaf1","t":"橘颂","a":"屈原","d":1,"f":"楚辞","g":"诗","x":"后皇嘉树，橘徕服兮。","b":5,"y":-290,"th":["咏物","言志","爱国","品格"],"ap":1},{"id":"24d71e606b47","t":"咏乌代陈师道","a":"太宗皇帝","d":6,"f":"五律","g":"诗","x":"凌晨丽城去，薄暮上林栖。","b":0,"y":627,"th":["咏物","言志","宫廷"],"ap":1},{"id":"7e8cbc2b5bd7","t":"舞曲歌辞 白鸠辞","a":"李白","d":6,"f":"古体","g":"诗","x":"铿鸣钟，考朗鼓。","b":3,"y":736,"th":["咏物","刺贪","言志"],"ap":1},{"id":"278bc0ff9cae","t":"相和歌辞 猛虎行","a":"储光羲","d":6,"f":"五古","g":"诗","x":"寒亦不忧雪，饥亦不食人。","b":3,"y":742,"th":["咏物","言志","怀才不遇"],"ap":1},{"id":"60c06bf89216","t":"杂曲歌辞 少年行三首 一","a":"李白","d":6,"f":"五律","g":"诗","x":"击筑饮美酒，劒歌易水湄。","b":3,"y":744,"th":["咏史","游侠","言志"],"ap":1},{"id":"80e70721fbf4","t":"杂曲歌辞 侠客行","a":"李白","d":6,"f":"五古","g":"诗","x":"赵客缦胡缨，吴钩霜雪明。","b":3,"y":744,"th":["咏史","游侠","言志"],"ap":1},{"id":"889aa32dab73","t":"行路难三首 一","a":"李白","d":6,"f":"古体","g":"诗","x":"金樽清酒斗十千，玉盘珍羞直万钱。","b":3,"y":744,"th":["抒怀","言志","仕途"],"ap":1},{"id":"a8a53052b855","t":"相和歌辞 日出行","a":"李白","d":6,"f":"古体","g":"诗","x":"日出东方隈，似从地底来。","b":4,"y":750,"th":["哲理","咏物","言志"],"ap":1},{"id":"efe8273f72df","t":"杂曲歌辞 游子吟","a":"李益","d":6,"f":"五古","g":"诗","x":"女羞夫壻荡，客耻主人贱。","b":7,"y":790,"th":["怀才不遇","叹时","言志"],"ap":1},{"id":"81c14f9d5abb","t":"琴曲歌辞 猗兰操","a":"韩愈","d":6,"f":"四言","g":"诗","x":"兰之猗猗，扬扬其香。","b":8,"y":805,"th":["咏物","言志","哲理"],"ap":1},{"id":"1e966159adec","t":"相和歌辞 阳春曲","a":"僧贯休","d":6,"f":"古体","g":"诗","x":"为口莫学阮嗣宗，不言是非非至公。","b":10,"y":867,"th":["咏史","言志","哲理"],"ap":1},{"id":"5a1d1953e1dd","t":"相和歌辞 野田黄雀行","a":"僧齐己","d":6,"f":"五律","g":"诗","x":"双双野田雀，上下同饮啄。","b":10,"y":898,"th":["咏物","哲理","言志"],"ap":1},{"id":"8f60e173060d","t":"相和歌辞 君子行","a":"僧齐己","d":6,"f":"古体","g":"诗","x":"圣人不生，麟龙何瑞？","b":10,"y":898,"th":["哲理","咏物","言志"],"ap":1},{"id":"ff13b324a5f5","t":"尾・我是个蒸不烂、煮不熟、捶不匾、炒不爆响当当一粒铜豌豆，恁子弟","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"每谁教你钻入他锄不断、斫不下、解不开、顿不脱慢腾腾千层锦套头。","b":0,"y":1290,"th":["咏怀","言志","放浪不羁"],"ap":1},{"id":"69d9d8ff86a8","t":"眼儿媚·咏梅","a":"纳兰性德","d":11,"f":"词