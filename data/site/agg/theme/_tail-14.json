,"孝道"],"ap":1},{"id":"d8a940788f15","t":"式微","a":"佚名","d":1,"f":"诗经","g":"诗","x":"式微，式微，胡不归？微君之故，胡为乎中露！","b":1,"y":-650,"th":["劳役","怨刺","思归"],"ap":1},{"id":"1388004d7b5d","t":"杂曲歌辞 蓟门行五首 三","a":"高适","d":6,"f":"五古","g":"诗","x":"蓟门逢古老，独立思氛氲。","b":6,"y":752,"th":["边塞","怀古","怨刺"],"ap":1}],"t135":[{"id":"1d25e90286d7","t":"论语·子路篇 其21","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“不得中行而与之，必也狂狷乎！狂者进取，狷者有所不为也。”","b":3,"y":-450,"th":["哲理","交友","修身"],"ap":1},{"id":"561e04e4b754","t":"论语·颜渊篇 其23","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子贡问友，子曰：“忠告而善道之，不可则止，毋自辱焉。”","b":4,"y":-450,"th":["哲理","交友","处世"],"ap":1},{"id":"637892190bbf","t":"论语·颜渊篇 其24","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"曾子曰：“君子以文会友，以友辅仁。”","b":4,"y":-450,"th":["哲理","交友","修身"],"ap":1},{"id":"a55d2254a493","t":"论语·季氏篇 其4","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"孔子曰：“益者三友，损者三友。友直、友谅、友多闻，益矣；友便辟、友善柔、有便佞，损矣。”","b":3,"y":-450,"th":["哲理","修身","交友"],"ap":1},{"id":"a9b11598227f","t":"论语·子张篇 其3","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子夏之门人问交于子张，子张曰：“子夏云何？”对曰：“子夏曰：‘可者与之，其不可者拒之。’”子张曰：“异乎吾所闻。君子尊贤而容众，嘉善而矜不能。我之大贤与，于人何所不容？我之不贤与，人将拒我，如之何其拒人也？”","b":2,"y":-450,"th":["哲理","修身","交友"],"ap":1},{"id":"c00e25454d22","t":"论语·子罕篇 其25","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“主忠信。毋友不如己者，过，则勿惮改。”","b":2,"y":-450,"th":["哲理","修身","交友"],"ap":1},{"id":"c162c5ca8938","t":"论语·里仁篇 其25","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“德不孤，必有邻。”","b":3,"y":-450,"th":["哲理","修身","交友"],"ap":1},{"id":"db676a894a61","t":"论语·乡党篇 其23","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"朋友之馈，虽车马，非祭肉，不拜。","b":2,"y":-450,"th":["礼制","交友","哲理"],"ap":1},{"id":"f01ae3b7a022","t":"论语·公冶长篇 其17","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“晏平仲善与人交，久而敬之。”","b":2,"y":-450,"th":["哲理","修身","交友"],"ap":1},{"id":"f68f7c4d642e","t":"论语·卫灵公篇 其10","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子贡问为仁，子曰：“工欲善其事，必先利其器。居是邦也，事其大夫之贤者，友其士之仁者。”","b":2,"y":-450,"th":["哲理","修身","交友"],"ap":1},{"id":"746f5d8f7fc3","t":"杂曲歌辞 行路难五首 五","a":"僧贯休","d":6,"f":"古体","g":"诗","x":"君不见山高海深人不测，古往今来转青碧。","b":10,"y":900,"th":["哲理","交友","咏怀"],"ap":1}],"t153":[{"id":"a01a522ee1f0","t":"论语·雍也篇 其5","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"原思为之宰，与之粟九百，辞。子曰：“毋，以与尔邻里乡党乎！”","b":1,"y":-500,"th":["哲理","仁爱","处世之道"],"ap":1},{"id":"d983cf5ba5cc","t":"论语·阳货篇 其1","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"阳货欲见孔子，孔子不见，归孔子豚。孔子时其亡也而往拜之，遇诸涂。谓孔子曰：“来，予与尔言。”曰：“怀其宝而迷其邦，可谓仁乎？”曰：“不可。”“好从事而亟失时，可谓知乎？”曰：“不可！”“日月逝矣，岁不我与！”孔子曰：“诺，吾将仕矣。”","b":1,"y":-500,"th":["哲理","出仕","处世之道"],"ap":1},{"id":"5b5c32f5cc9d","t":"论语·公冶长篇 其21","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“宁武子，邦有道则知，邦无道则愚。其知可及也，其愚不可及也。”","b":1,"y":-490,"th":["哲理","处世之道","怀古"],"ap":1},{"id":"183f4b4d69fc","t":"论语·宪问篇 其3","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“邦有道，危言危行；邦无道，危行言孙。”","b":3,"y":-450,"th":["哲理","处世之道","政治智慧"],"ap":1},{"id":"88b4889b486d","t":"论语·学而篇 其12","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"有子曰：“礼之用，和为贵。先王之道，斯为美，小大由之。有所不行，知和而和，不以礼节之，亦不可行也。”","b":3,"y":-450,"th":["哲理","礼制","处世之道"],"ap":1},{"id":"c0b9a8df30ca","t":"论语·微子篇 其8","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"逸民：伯夷、叔齐、虞仲、夷逸、朱张、柳下惠、少连。子曰：“不降其志，不辱其身，伯夷、叔齐与！”谓：“柳下惠、少连降志辱身矣，言中伦，行中虑，其斯而已矣。”谓：“虞仲、夷逸隐居放言，身中清，废中权。我则异于是，无可无不可。”","b":3,"y":-450,"th":["哲理","隐逸","处世之道"],"ap":1},{"id":"e4fa1863d361","t":"论语·乡党篇 其1","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"孔子于乡党，恂恂如也，似不能言者；其在宗庙朝庭，便便言，唯谨尔。","b":2,"y":-450,"th":["礼仪","修身","处世之道"],"ap":1},{"id":"ff3105cb94b9","t":"论语·泰伯篇 其14","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“不在其位，不谋其政。”","b":3,"y":-450,"th":["哲理","政治","处世之道"],"ap":1},{"id":"46bf7f18e4a4","t":"孟子·公孙丑上 其43","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「伯夷隘，柳下惠不恭。隘与不恭，君子不由也。」","b":4,"y":-320,"th":["哲理","处世之道","中庸"],"ap":1},{"id":"c23495781d7b","t":"孟子·公孙丑上 其42","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「伯夷，非其君不事，非其友不友。不立于恶人之朝，不与恶人言。立于恶人之朝，与恶人言，如以朝衣朝冠坐于涂炭。推恶恶之心，思与乡人立，其冠不正，望望然去之，若将浼焉。是故诸侯虽有善其辞命而至者，不受也。不受也者，是亦不屑就已。柳下惠，不羞污君，不卑小官。进不隐贤，必以其道。遗佚而不怨，阨穷而不悯。故曰：『尔为尔，我为我，虽袒裼裸裎于我侧，尔焉能浼我哉？』故由由然与之偕而不自失焉，援而止之而止。援而止之而止者，是亦不屑去已。」","b":5,"y":-300,"th":["哲理","处世之道","人格修养"],"ap":1}],"t179":[{"id":"5ed04ee8f77d","t":"论语·阳货篇 其15","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“鄙夫可与事君也与哉？其未得之也，患得之；既得之，患失之。苟患失之，无所不至矣。”","b":1,"y":-500,"th":["哲理","人性","官场"],"ap":1},{"id":"8e1d82c3dc44","t":"论语·子张篇 其17","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"曾子曰：“吾闻诸夫子，人未有自致者也，必也亲丧乎！”","b":2,"y":-450,"th":["哲理","孝道","人性"],"ap":1},{"id":"c9827c785225","t":"论语·子罕篇 其18","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“吾未见好德如好色者也。”","b":2,"y":-450,"th":["哲理","修身","人性"],"ap":1},{"id":"eedc5c0f2936","t":"论语·阳货篇 其2","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“性相近也，习相远也。”","b":3,"y":-450,"th":["哲理","人性","教育"],"ap":1},{"id":"f4f6dd8f0a6e","t":"论语·阳货篇 其3","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“唯上知与下愚不移。”","b":3,"y":-450,"th":["哲理","人性","教育"],"ap":1},{"id":"faaca138799c","t":"论语·阳货篇 其25","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“唯女子与小人为难养也，近之则不孙，远之则怨。”","b":3,"y":-450,"th":["哲理","处世","人性"],"ap":1},{"id":"68666bdd8809","t":"孟子·梁惠王下 其28","a":"孟子","d":1,"f":"文","g":"文","x":"王曰：「寡人有疾，寡人好货。」","b":4,"y":-320,"th":["哲理","政治","人性"],"ap":1},{"id":"f55675a45fdd","t":"孟子·梁惠王上 其30","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「是心足以王矣。百姓皆以王为爱也，臣固知王之不忍也。」","b":4,"y":-320,"th":["哲理","仁政","人性"],"ap":1}],"t180":[{"id":"f144196d0fec","t":"论语·为政篇 其4","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“吾十有五而志于学，三十而立，四十而不惑，五十而知天命，六十而耳顺，七十而从心所欲，不逾矩。”","b":2,"y":-480,"th":["哲理","修身","人生"],"ap":1},{"id":"7040315b1681","t":"论语·季氏篇 其7","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"孔子曰：“君子有三戒：少之时，血气未定，戒之在色；及其壮也，血气方刚，戒之在斗；及其老也，血气既衰，戒之在得。”","b":3,"y":-450,"th":["哲理","修身","人生"],"ap":1},{"id":"1d457605e0e3","t":"醉妆词","a":"后主衍","d":6,"f":"古体","g":"诗","x":"者边走，那边走，只是寻花柳。","b":6,"y":750,"th":["宴饮","感伤","人生"],"ap":1},{"id":"c1cb068b1000","t":"观公孙大娘弟子舞劒器行","a":"杜甫","d":6,"f":"古体","g":"诗","x":"昔有佳人公孙氏，一舞劒气动四方。","b":7,"y":767,"th":["怀古","感时","艺术","人生"],"ap":1},{"id":"8eb33e9c39c4","t":"相和歌辞 短歌行","a":"王建","d":6,"f":"古体","g":"诗","x":"人初生，日初出。","b":8,"y":800,"th":["哲理","叹时","人生"],"ap":1},{"id":"3dc8f21f88fa","t":"鹤冲天","a":"柳永","d":8,"f":"词","g":"词","x":"黄金榜上。","b":1,"y":1030,"th":["落第","抒愤","爱情","人生"],"ap":1},{"id":"f4864ace2a8a","t":"前赤壁赋","a":"苏轼","d":8,"f":"赋","g":"赋","x":"壬戌之秋，七月既望，苏子与客泛舟游于赤壁之下。清风徐来，水波不兴。举酒属客，诵明月之诗，歌窈窕之章。少焉，月出于东山之上，徘徊于斗牛之间。白露横江，水光接天。纵一苇之所如，凌万顷之茫然。浩浩乎如冯虚御风，而不知其所止；飘飘乎如遗世独立，羽化而登仙。","b":3,"y":1082,"th":["哲理","怀古","自然","人生"],"ap":1},{"id":"a27c0a7519db","t":"大石调・青杏子骋怀","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"花月酒家楼，可追欢亦可悲秋。","b":0,"y":1290,"th":["哲理","咏怀","人生"],"ap":1}],"t197":[{"id":"4e87892d0e20","t":"叔于田","a":"佚名","d":1,"f":"诗经","g":"诗","x":"叔于田，巷无居人。岂无居人？不如叔也。洵美且仁。","b":0,"y":-700,"th":["爱情","思慕"],"ap":1},{"id":"e5048c24d3e3","t":"蒹葭","a":"佚名","d":1,"f":"诗经","g":"诗","x":"蒹葭苍苍，白露为霜。所谓伊人，在水一方。溯洄从之，道阻且长。溯游从之，宛在水中央。","b":0,"y":-700,"th":["爱情","思慕","求索"],"ap":1},{"id":"b573a3ccec9c","t":"简兮","a":"佚名","d":1,"f":"诗经","g":"诗","x":"简兮简兮，方将万舞。日之方中，在前上处。","b":1,"y":-650,"th":["赞美","怀古","思慕"],"ap":1},{"id":"83084b9e81b9","t":"隰桑","a":"佚名","d":1,"f":"诗经","g":"诗","x":"隰桑有阿，其叶有难。既见君子，其乐如何。","b":1,"y":-550,"th":["爱情","思慕"],"ap":1},{"id":"ed7e37fa9cf2","t":"论语·子罕篇 其31","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"“唐棣之华，偏其反而。岂不尔思？室是远尔。”子曰：“未之思也，夫何远之有。”","b":3,"y":-450,"th":["哲理","修身","思慕"],"ap":1},{"id":"4dd0807e4d46","t":"湘夫人","a":"屈原","d":1,"f":"楚辞","g":"诗","x":"帝子降兮北渚，目眇眇兮愁予","b":5,"y":-290,"th":["爱情","神话","思慕"],"ap":1},{"id":"e95816182567","t":"相和歌辞 善哉行","a":"僧贯休","d":6,"f":"古体","g":"诗","x":"有美一人兮婉如清扬，识曲别音兮令姿煌煌。","b":10,"y":900,"th":["爱情","思慕","音乐"],"ap":1}],"t203":[{"id":"b9735e1e0a67","t":"相和歌辞 长门怨二首 一","a":"李白","d":6,"f":"七绝","g":"诗","x":"天回北斗挂西楼，金屋无人萤火流。","b":3,"y":736,"th":["宫怨","哀愁"],"ap":1},{"id":"31e76b40e171","t":"相和歌辞 长信怨 二","a":"王昌龄","d":6,"f":"七绝","g":"诗","x":"奉帚平明金殿开，暂将团扇共裴回。","b":3,"y":740,"th":["宫怨","咏史","哀愁"],"ap":1},{"id":"9149e4adbd73","t":"相和歌辞 长门怨","a":"刘言史","d":6,"f":"七绝","g":"诗","x":"独坐炉边结夜愁，暂时恩去亦难留。","b":8,"y":800,"th":["宫怨","爱情","哀愁"],"ap":1},{"id":"41c661fde4ef","t":"相和歌辞 乌夜啼","a":"张祜","d":6,"f":"五律","g":"诗","x":"忽忽南飞返，危弦共怨凄。","b":9,"y":827,"th":["咏物","闺怨","哀愁"],"ap":1},{"id":"eb59ef15201e","t":"相和歌辞 长门怨 二","a":"高蟾","d":6,"f":"七绝","g":"诗","x":"天上凤皇休