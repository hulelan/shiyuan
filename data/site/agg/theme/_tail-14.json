《雅》、《颂》各得其所。”","b":2,"y":-484,"th":["哲理","文化","礼乐"],"ap":1}],"t720":[{"id":"89487763e5a4","t":"大学·大学 其13","a":"曾子（传）","d":1,"f":"文","g":"文","x":"《诗》云：「殷之未丧师，克配上帝。仪监于殷，峻命不易。」道得众则得国，失众则失国。是故君子先慎乎德。有德此有人，有人此有土，有土此有财，有财此有用。德者本也，财者末也，外本内末，争民施夺。是故财聚则民散，财散则民聚。是故言悖而出者，亦悖而入；货悖而入者，亦悖而出。《康诰》曰：「惟命不于常！」道善则得之，不善则失之矣。楚书曰：「楚国无以为宝，惟善以为宝。」舅犯曰：「亡人无以为宝，仁亲以为宝。」","b":4,"y":-430,"th":["哲理","治国","重德"],"ap":1}],"t737":[{"id":"a29a64180be2","t":"通路","a":"王褒","d":1,"f":"楚辞","g":"诗","x":"天门兮墬户，孰由兮贤者？","b":5,"y":-300,"th":["怀才不遇","楚辞神游","咏叹命运"],"ap":1}],"t742":[{"id":"a5507f017e4f","t":"孟子·梁惠王上 其52","a":"孟子","d":1,"f":"文","g":"文","x":"王曰：「吾惛，不能进于是矣。愿夫子辅吾志，明以教我。我虽不敏，请尝试之。」","b":4,"y":-320,"th":["哲理","治国","求教"],"ap":1}],"t751":[{"id":"b2a49ab494c4","t":"巧言","a":"佚名","d":1,"f":"诗经","g":"诗","x":"悠悠昊天，曰父母且。无罪无辜，乱如此幠。昊天已威，予慎无罪。昊天大幠，予慎无辜。","b":0,"y":-700,"th":["政治讽喻","忧国忧民","刺谗"],"ap":1}],"t764":[{"id":"bee10689354c","t":"论语·为政篇 其16","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“攻乎异端，斯害也已！”","b":2,"y":-450,"th":["哲理","治学","正道"],"ap":1}],"t786":[{"id":"d715bdd19170","t":"论语·颜渊篇 其8","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"棘子成曰：“君子质而已矣，何以文为？”子贡曰：“惜乎，夫子之说君子也！驷不及舌。文犹质也，质犹文也。虎豹之鞟犹犬羊之鞟。”","b":1,"y":-500,"th":["哲理","文质关系","儒家思想"],"ap":1}],"t795":[{"id":"dd162f7e0b66","t":"思忠","a":"王褒","d":1,"f":"楚辞","g":"诗","x":"登九灵兮游神，静女歌兮微晨。","b":5,"y":-300,"th":["政治抒怀","游仙","刺世"],"ap":1}],"t809":[{"id":"e888c3b15df8","t":"孟子·滕文公上 其33","a":"孟子","d":1,"f":"文","g":"文","x":"徐子以告夷子。夷子怃然为闲曰：「命之矣。」","b":5,"y":-300,"th":["哲理","论辩","受教"],"ap":1}],"t823":[{"id":"f4b4c4867288","t":"疾世","a":"王逸","d":1,"f":"楚辞","g":"诗","x":"周徘徊兮汉渚，求水神兮灵女。","b":5,"y":-150,"th":["怀才不遇","神游求索","忧国伤世"],"ap":1}],"t845":[{"id":"007df2a84a5f","t":"野次喜雪","a":"明皇帝","d":6,"f":"五律","g":"诗","x":"拂曙辟行宫，寒皋野望通。","b":2,"y":720,"th":["咏物","政治关怀","天人感应"],"ap":1}],"t856":[{"id":"05c4cff61eff","t":"郊庙歌辞 禅社首乐章 福和","a":"贺知章、源乾曜","d":6,"f":"四言","g":"诗","x":"穆穆天子，告成岱宗。","b":2,"y":725,"th":["礼乐/祭祀/帝王"],"ap":1}],"t878":[{"id":"143da4ab862d","t":"鼓吹曲辞 鼓吹铙歌 铁山碎","a":"柳宗元","d":6,"f":"