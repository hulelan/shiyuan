{"t067":[{"id":"f448546f6df6","t":"扬之水","a":"佚名","d":1,"f":"诗经","g":"诗","x":"扬之水，不流束楚。终鲜兄弟，维予与女。无信人之言，人实诳女。","b":0,"y":-750,"th":["亲情","劝诫","乱世"],"ap":1},{"id":"288f7e9a1a19","t":"行苇","a":"佚名","d":1,"f":"诗经","g":"诗","x":"敦彼行苇，牛羊勿践履。方苞方体，维叶泥泥。","b":1,"y":-700,"th":["宴饮","亲情","礼乐","祈福"],"ap":1},{"id":"46c81de5b94b","t":"棠棣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"棠棣之华，鄂不韡韡。凡今之人，莫如兄弟。","b":0,"y":-700,"th":["亲情","伦理","宴饮"],"ap":1},{"id":"b87e485ae156","t":"杕杜","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有杕之杜，其叶湑湑。独行踽踽。岂无他人？不如我同父。嗟行之人，胡不比焉？人无兄弟，胡不佽焉？","b":0,"y":-700,"th":["孤独","亲情","羁旅"],"ap":1},{"id":"b9d06d59695e","t":"陟岵","a":"佚名","d":1,"f":"诗经","g":"诗","x":"陟彼岵兮，瞻望父兮。父曰：嗟！予子行役，夙夜无已。上慎旃哉，犹来！无止！","b":1,"y":-700,"th":["思乡","行役","亲情"],"ap":1},{"id":"c89cdd66e9c4","t":"葛覃","a":"佚名","d":1,"f":"诗经","g":"诗","x":"葛之覃兮，施于中谷，维叶萋萋。黄鸟于飞，集于灌木，其鸣喈喈。","b":0,"y":-700,"th":["劳动","亲情","归宁"],"ap":1},{"id":"cc47b6ccbed9","t":"頍弁","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有頍者弁，实维伊何？尔酒既旨，尔肴既嘉。岂伊异人？兄弟匪他。","b":1,"y":-700,"th":["宴饮","亲情","伤时","哲理"],"ap":1},{"id":"50ce63a422ba","t":"燕燕","a":"佚名","d":1,"f":"诗经","g":"诗","x":"燕燕于飞，差池其羽。之子于归，远送于野。瞻望弗及，泣涕如雨。","b":1,"y":-650,"th":["送别","亲情","咏物"],"ap":1},{"id":"d62d9f3e3e18","t":"渭阳","a":"佚名","d":1,"f":"诗经","g":"诗","x":"我送舅氏，曰至渭阳。何以赠之？路车乘黄。","b":1,"y":-637,"th":["送别","亲情"],"ap":1},{"id":"8e067c050573","t":"论语·子路篇 其18","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"叶公语孔子曰：“吾党有直躬者，其父攘羊，而子证之。”孔子曰：“吾党之直者异于是。父为子隐，子为父隐，直在其中矣。”","b":2,"y":-490,"th":["哲理","伦理","亲情"],"ap":1},{"id":"4498f9b0e6c2","t":"论语·里仁篇 其21","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“父母之年，不可不知也，一则以喜，一则以惧。”","b":3,"y":-450,"th":["哲理","亲情","孝道"],"ap":1},{"id":"b9a6699aacfa","t":"琴曲歌辞 胡笳十八拍 第十拍","a":"刘商","d":6,"f":"七律","g":"诗","x":"恨凌辱兮恶腥膻，憎胡地兮怨胡天。","b":7,"y":780,"th":["思乡","亲情","边塞"],"ap":1},{"id":"4be69f7b344a","t":"琴曲歌辞 胡笳十八拍 第十四拍","a":"刘商","d":6,"f":"七律","g":"诗","x":"莫以胡儿可羞耻，恩情亦各言其子。","b":8,"y":790,"th":["思乡","亲情","边塞"],"ap":1},{"id":"8462c18a10c7","t":"琴曲歌辞 履霜操","a":"韩愈","d":6,"f":"四言","g":"诗","x":"父兮儿寒，母兮儿饥。","b":8,"y":800,"th":["弃子","亲情","哀怨"],"ap":1},{"id":"d65bc6ecb569","t":"游子吟","a":"孟郊","d":6,"f":"五古","g":"诗","x":"慈母手中线，游子身上衣。","b":8,"y":800,"th":["母爱","亲情"],"ap":1},{"id":"5ebba89cf216","t":"相和歌辞 上留田","a":"僧贯休","d":6,"f":"古体","g":"诗","x":"父不父，兄不兄，上留田，蝥贼生。","b":10,"y":867,"th":["讽喻","亲情","世风"],"ap":1},{"id":"dd8486e90a21","t":"杂曲歌辞 行路难五首 四","a":"僧贯休","d":6,"f":"古体","g":"诗","x":"君不见道傍树有寄生枝，青青郁郁同荣衰。","b":10,"y":867,"th":["讽喻","亲情","伦理"],"ap":1},{"id":"990f11162ef5","t":"杂曲歌辞 行路难","a":"聂夷中","d":6,"f":"五律","g":"诗","x":"莫言行路难，夷狄如中国。","b":10,"y":880,"th":["哲理","世态炎凉","亲情"],"ap":1}],"t070":[{"id":"286a573d2d41","t":"文王","a":"佚名","d":1,"f":"诗经","g":"诗","x":"文王在上，于昭于天。周虽旧邦，其命维新。有周不显，帝命不时。文王陟降，在帝左右。","b":0,"y":-1050,"th":["颂歌","咏史","哲理"],"ap":1},{"id":"42746c53943d","t":"有瞽","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有瞽有瞽，在周之庭。设业设虡，崇牙树羽。应田县鼓，鞉磬柷圉。既备","b":0,"y":-1050,"th":["祭祀","礼乐","颂歌"],"ap":1},{"id":"a4e2cb5f8f91","t":"噫嘻","a":"佚名","d":1,"f":"诗经","g":"诗","x":"噫嘻成王，既昭假尔。率时农夫，播厥百谷。骏发尔私，终三十里。亦服尔耕，十千维耦。","b":0,"y":-1050,"th":["农事","颂歌","祭祀"],"ap":1},{"id":"c77619529c42","t":"赉","a":"佚名","d":1,"f":"诗经","g":"诗","x":"文王既勤止，我应受之。敷时绎思，我徂维求定。时周之命，于绎思。","b":0,"y":-1046,"th":["祭祀","颂歌","怀古"],"ap":1},{"id":"262be2052fe7","t":"昊天有成命","a":"佚名","d":1,"f":"诗经","g":"诗","x":"昊天有成命，二后受之。成王不敢康，夙夜基命宥密。于缉熙！单厥心，四其靖之。","b":0,"y":-1022,"th":["颂歌","咏史","祭祀"],"ap":1},{"id":"865da1a7e103","t":"车攻","a":"佚名","d":1,"f":"诗经","g":"诗","x":"我车既攻，我马既同。四牡庞庞，驾言徂东。","b":0,"y":-950,"th":["田猎","颂歌","军威"],"ap":1},{"id":"c0708d754559","t":"丝衣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"丝衣其紑，载弁俅俅。自堂徂基，自羊徂牛，鼐鼎及鼒，兕觥其觩。旨酒思柔。不吴不敖，胡考之休。","b":0,"y":-908,"th":["祭祀","颂歌","祈福"],"ap":1},{"id":"71a776b5f918","t":"常武","a":"佚名","d":1,"f":"诗经","g":"诗","x":"赫赫明明。王命卿士，南仲大祖，大师皇父。整我六师，以修我戎。既敬既戒，惠此南国。","b":0,"y":-800,"th":["战争","颂歌","军旅","怀古"],"ap":1},{"id":"5f16bb42f2a9","t":"凫鹥","a":"佚名","d":1,"f":"诗经","g":"诗","x":"凫鹥在泾，公尸在燕来宁。尔酒既清，尔肴既馨。公尸燕饮，福禄来成。","b":0,"y":-771,"th":["祭祀","宴饮","祈福","颂歌"],"ap":1},{"id":"c5c56c5c5e32","t":"载芟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"载芟载柞，其耕泽泽。千耦其耘，徂隰徂畛。侯主侯伯，侯亚侯旅，侯彊侯以。","b":0,"y":-750,"th":["农事","祭祀","颂歌"],"ap":1},{"id":"60c4f34ff75e","t":"丰年","a":"佚名","d":1,"f":"诗经","g":"诗","x":"丰年多黍多稌，亦有高廪，万亿及秭。为酒为醴，烝畀祖妣。以洽百礼，降福孔皆。","b":0,"y":-700,"th":["农事","祭祀","颂歌"],"ap":1},{"id":"6fb100f8a178","t":"酌","a":"佚名","d":1,"f":"诗经","g":"诗","x":"于铄王师，遵养时晦。时纯熙矣，是用大介。我龙受之，蹻蹻王之造。载用有嗣，实维尔公允师。","b":1,"y":-700,"th":["战争","颂歌","怀古"],"ap":1},{"id":"7fdcdb83297b","t":"臣工","a":"佚名","d":1,"f":"诗经","g":"诗","x":"嗟嗟臣工，敬尔在公。王厘尔成，来咨来茹。嗟嗟保介，维莫之春，亦又何求？如何新畲？","b":0,"y":-700,"th":["农事","颂歌","劝农"],"ap":1},{"id":"c668b992327c","t":"绵","a":"佚名","d":1,"f":"诗经","g":"诗","x":"绵绵瓜瓞。民之初生，自土沮漆。古公亶父，陶复陶冗，未有家室。","b":0,"y":-700,"th":["史诗","咏史","颂歌"],"ap":1},{"id":"f0f935800541","t":"潜","a":"佚名","d":1,"f":"诗经","g":"诗","x":"猗与漆沮，潜有多鱼。有鳣有鲔，鲦鲿鰋鲤。以享以祀，以介景福。","b":0,"y":-700,"th":["祭祀","颂歌","咏物"],"ap":1},{"id":"de65697df98a","t":"玄鸟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"天命玄鸟，降而生商，宅殷土芒芒。古帝命武汤，正域彼四方。","b":1,"y":-650,"th":["祭祀","咏史","颂歌"],"ap":1},{"id":"4ac234d595f3","t":"东皇太一","a":"屈原","d":1,"f":"楚辞","g":"诗","x":"吉日兮辰良，穆将愉兮上皇","b":5,"y":-300,"th":["祭祀","神话","颂歌"],"ap":1}],"t089":[{"id":"348b7975abb5","t":"大东","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有饛簋飧，有捄棘匕。周道如砥，其直如矢。君子所履，小人所视。眷言顾之，潸焉出涕。","b":0,"y":-850,"th":["怨刺","民生","讽喻"],"ap":1},{"id":"2ac77723beba","t":"雨无正","a":"佚名","d":1,"f":"诗经","g":"诗","x":"浩浩昊天，不骏其德。降丧饥馑，斩伐四国。旻天疾威，弗虑弗图。舍彼有罪，既伏其辜。若此无罪，沦胥以铺。","b":0,"y":-776,"th":["时政","伤时","怨刺"],"ap":1},{"id":"42f8ba2d2c3b","t":"羔裘","a":"佚名","d":1,"f":"诗经","g":"诗","x":"羔裘豹祛，自我人居居。岂无他人？维子之故。","b":0,"y":-700,"th":["讽刺","怨刺","人情冷暖"],"ap":1},{"id":"472ed91c745e","t":"菀柳","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有菀者柳，不尚息焉。上帝甚蹈，无自暱焉。俾予靖之，后予极焉。","b":0,"y":-700,"th":["怨刺","放逐","忠而被弃"],"ap":1},{"id":"741aae5de011","t":"旄丘","a":"佚名","d":1,"f":"诗经","g":"诗","x":"旄丘之葛兮，何诞之节兮。叔兮伯兮，何多日也？","b":0,"y":-700,"th":["流亡","怨刺","家国"],"ap":1},{"id":"84648cb493fe","t":"谷风","a":"佚名","d":1,"f":"诗经","g":"诗","x":"习习谷风，维风及雨。将恐将惧，维予与女。将安将乐，女转弃予。","b":1,"y":-700,"th":["弃妇","怨刺","爱情"],"ap":1},{"id":"c719391dc722","t":"北山","a":"佚名","d":1,"f":"诗经","g":"诗","x":"陟彼北山，言采其杞。偕偕士子，朝夕从事。王事靡盬，忧我父母。","b":0,"y":-700,"th":["怨刺","劳役","不公"],"ap":1},{"id":"ed0bc22b4565","t":"祈父","a":"佚名","d":1,"f":"诗经","g":"诗","x":"祈父，予王之爪牙。胡转予于恤，靡所止居？","b":0,"y":-700,"th":["战争","怨刺","孝道"],"ap":1},{"id":"f3c18d99ecae","t":"何人斯","a":"佚名","d":1,"f":"诗经","g":"诗","x":"彼何人斯？其心孔艰。胡逝我梁，不入我门？伊谁云从？维暴之云。","b":0,"y":-700,"th":["怨刺","绝交","友情"],"ap":1},{"id":"362bbc16085f","t":"鸨羽","a":"佚名","d":1,"f":"诗经","g":"诗","x":"肃肃鸨羽，集于苞栩。王事靡盬，不能蓺稷黍。父母何怙？悠悠苍天，曷其有所？","b":1,"y":-650,"th":["徭役","怨刺","孝道"],"ap":1},{"id":"d8a940788f15","t":"式微","a":"佚名","d":1,"f":"诗经","g":"诗","x":"式微，式微，胡不归？微君之故，胡为乎中露！","b":1,"y":-650,"th":["劳役","怨刺","思归"],"ap":1},{"id":"1388004d7b5d","t":"杂曲歌辞 蓟门行五首 三","a":"高适","d":6,"f":"五古","g":"诗","x":"蓟门逢古老，独立思氛氲。","b":7,"y":752,"th":["边塞","怀古","怨刺"],"ap":1}],"t108":[{"id":"48f3082a2731","t":"相和歌辞 对酒","a":"崔国辅","d":6,"f":"古体","g":"诗","x":"行行日将夕，荒村古冢无人迹。","b":2,"y":722,"th":["怀古","哲理","饮酒"],"ap":1},{"id":"8ce9c1e17d7e","t":"杂曲歌辞 前有一尊酒行二首 一","a":"李白","d":6,"f":"古体","g":"诗","x":"春风东来忽相过，金尊绿酒生微波。","b":2,"y":736,"th":["惜时","饮酒","咏怀"],"ap":1},{"id":"a4ee030c45c5","t":"相和歌辞 对酒二首 一","a":"李白","d":6,"f":"五古","g":"诗","x":"松子栖金华，安期入蓬海。","b":3,"y":736,"th":["哲理","咏怀","饮酒"],"ap":1},{"id":"00c96490640b","t":"杂曲歌辞 少年行二首 二","a":"王昌龄","d":6,"f":"五律","g":"诗","x":"走马还相寻，西楼下夕阴。","b":3,"y":740,"th":["友情","侠义","饮酒"],"ap":1},{"id":"bf2a6e2eb2f1","t":"杂曲歌辞 少年行三首 二","a":"李白","d":6,"f":"七绝","g":"诗","x":"五陵年少金市东，银鞍白马度春风。","b":3,"y":740,"th":["游侠","少年","饮酒"],"ap":1},{"id":"f5dcae7bf5d4","t":"横吹曲辞 白鼻䯄","a":"李白","d":6,"f":"古体","g":"诗","x":"银鞍白鼻䯄，绿地障泥锦。","b":3,"y":743,"th":["游侠","饮酒","咏物"],"ap":1},{"id":"c3b76185eac0","t":"杂曲歌辞 前有一尊酒行二首 二","a":"李白","d":6,"f":"古体","g":"诗","x":"琴奏龙门之绿桐，玉壶美酒清若空。","b":3,"y":744,"th":["饮酒","乐府","及时行乐"],"ap":1},{"id":"a570201c9e16","t":"杂曲歌辞 行路难五首 一","a":"贺兰进明","d":6,"f":"古体","g":"诗","x":"君不见嵒下井，百尺不及泉。","b":4,"y":750,"th":["哲理","饮酒","叹命"],"ap":1},{"id":"4393a65d8599","t":"杂曲歌辞 少年行三首 一","