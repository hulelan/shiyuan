{"t067":[{"id":"f448546f6df6","t":"扬之水","a":"佚名","d":1,"f":"诗经","g":"诗","x":"扬之水，不流束楚。终鲜兄弟，维予与女。无信人之言，人实诳女。","b":0,"y":-750,"th":["亲情","劝诫","乱世"],"ap":1},{"id":"288f7e9a1a19","t":"行苇","a":"佚名","d":1,"f":"诗经","g":"诗","x":"敦彼行苇，牛羊勿践履。方苞方体，维叶泥泥。","b":1,"y":-700,"th":["宴饮","亲情","礼乐","祈福"],"ap":1},{"id":"46c81de5b94b","t":"棠棣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"棠棣之华，鄂不韡韡。凡今之人，莫如兄弟。","b":0,"y":-700,"th":["亲情","伦理","宴饮"],"ap":1},{"id":"b87e485ae156","t":"杕杜","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有杕之杜，其叶湑湑。独行踽踽。岂无他人？不如我同父。嗟行之人，胡不比焉？人无兄弟，胡不佽焉？","b":0,"y":-700,"th":["孤独","亲情","羁旅"],"ap":1},{"id":"b9d06d59695e","t":"陟岵","a":"佚名","d":1,"f":"诗经","g":"诗","x":"陟彼岵兮，瞻望父兮。父曰：嗟！予子行役，夙夜无已。上慎旃哉，犹来！无止！","b":1,"y":-700,"th":["思乡","行役","亲情"],"ap":1},{"id":"c89cdd66e9c4","t":"葛覃","a":"佚名","d":1,"f":"诗经","g":"诗","x":"葛之覃兮，施于中谷，维叶萋萋。黄鸟于飞，集于灌木，其鸣喈喈。","b":0,"y":-700,"th":["劳动","亲情","归宁"],"ap":1},{"id":"cc47b6ccbed9","t":"頍弁","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有頍者弁，实维伊何？尔酒既旨，尔肴既嘉。岂伊异人？兄弟匪他。","b":1,"y":-700,"th":["宴饮","亲情","伤时","哲理"],"ap":1},{"id":"50ce63a422ba","t":"燕燕","a":"佚名","d":1,"f":"诗经","g":"诗","x":"燕燕于飞，差池其羽。之子于归，远送于野。瞻望弗及，泣涕如雨。","b":1,"y":-650,"th":["送别","亲情","咏物"],"ap":1},{"id":"d62d9f3e3e18","t":"渭阳","a":"佚名","d":1,"f":"诗经","g":"诗","x":"我送舅氏，曰至渭阳。何以赠之？路车乘黄。","b":1,"y":-637,"th":["送别","亲情"],"ap":1},{"id":"8e067c050573","t":"论语·子路篇 其18","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"叶公语孔子曰：“吾党有直躬者，其父攘羊，而子证之。”孔子曰：“吾党之直者异于是。父为子隐，子为父隐，直在其中矣。”","b":2,"y":-490,"th":["哲理","伦理","亲情"],"ap":1},{"id":"4498f9b0e6c2","t":"论语·里仁篇 其21","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“父母之年，不可不知也，一则以喜，一则以惧。”","b":3,"y":-450,"th":["哲理","亲情","孝道"],"ap":1},{"id":"b9a6699aacfa","t":"琴曲歌辞 胡笳十八拍 第十拍","a":"刘商","d":6,"f":"七律","g":"诗","x":"恨凌辱兮恶腥膻，憎胡地兮怨胡天。","b":7,"y":780,"th":["思乡","亲情","边塞"],"ap":1},{"id":"4be69f7b344a","t":"琴曲歌辞 胡笳十八拍 第十四拍","a":"刘商","d":6,"f":"七律","g":"诗","x":"莫以胡儿可羞耻，恩情亦各言其子。","b":8,"y":790,"th":["思乡","亲情","边塞"],"ap":1},{"id":"8462c18a10c7","t":"琴曲歌辞 履霜操","a":"韩愈","d":6,"f":"四言","g":"诗","x":"父兮儿寒，母兮儿饥。","b":8,"y":800,"th":["弃子","亲情","哀怨"],"ap":1},{"id":"d65bc6ecb569","t":"游子吟","a":"孟郊","d":6,"f":"五古","g":"诗","x":"慈母手中线，游子身上衣。","b":8,"y":800,"th":["母爱","亲情"],"ap":1},{"id":"5ebba89cf216","t":"相和歌辞 上留田","a":"僧贯休","d":6,"f":"古体","g":"诗","x":"父不父，兄不兄，上留田，蝥贼生。","b":10,"y":867,"th":["讽喻","亲情","世风"],"ap":1},{"id":"dd8486e90a21","t":"杂曲歌辞 行路难五首 四","a":"僧贯休","d":6,"f":"古体","g":"诗","x":"君不见道傍树有寄生枝，青青郁郁同荣衰。","b":10,"y":867,"th":["讽喻","亲情","伦理"],"ap":1},{"id":"990f11162ef5","t":"杂曲歌辞 行路难","a":"聂夷中","d":6,"f":"五律","g":"诗","x":"莫言行路难，夷狄如中国。","b":10,"y":880,"th":["哲理","世态炎凉","亲情"],"ap":1}],"t070":[{"id":"286a573d2d41","t":"文王","a":"佚名","d":1,"f":"诗经","g":"诗","x":"文王在上，于昭于天。周虽旧邦，其命维新。有周不显，帝命不时。文王陟降，在帝左右。","b":0,"y":-1050,"th":["颂歌","咏史","哲理"],"ap":1},{"id":"42746c53943d","t":"有瞽","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有瞽有瞽，在周之庭。设业设虡，崇牙树羽。应田县鼓，鞉磬柷圉。既备","b":0,"y":-1050,"th":["祭祀","礼乐","颂歌"],"ap":1},{"id":"a4e2cb5f8f91","t":"噫嘻","a":"佚名","d":1,"f":"诗经","g":"诗","x":"噫嘻成王，既昭假尔。率时农夫，播厥百谷。骏发尔私，终三十里。亦服尔耕，十千维耦。","b":0,"y":-1050,"th":["农事","颂歌","祭祀"],"ap":1},{"id":"c77619529c42","t":"赉","a":"佚名","d":1,"f":"诗经","g":"诗","x":"文王既勤止，我应受之。敷时绎思，我徂维求定。时周之命，于绎思。","b":0,"y":-1046,"th":["祭祀","颂歌","怀古"],"ap":1},{"id":"262be2052fe7","t":"昊天有成命","a":"佚名","d":1,"f":"诗经","g":"诗","x":"昊天有成命，二后受之。成王不敢康，夙夜基命宥密。于缉熙！单厥心，四其靖之。","b":0,"y":-1022,"th":["颂歌","咏史","祭祀"],"ap":1},{"id":"865da1a7e103","t":"车攻","a":"佚名","d":1,"f":"诗经","g":"诗","x":"我车既攻，我马既同。四牡庞庞，驾言徂东。","b":0,"y":-950,"th":["田猎","颂歌","军威"],"ap":1},{"id":"c0708d754559","t":"丝衣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"丝衣其紑，载弁俅俅。自堂徂基，自羊徂牛，鼐鼎及鼒，兕觥其觩。旨酒思柔。不吴不敖，胡考之休。","b":0,"y":-908,"th":["祭祀","颂歌","祈福"],"ap":1},{"id":"71a776b5f918","t":"常武","a":"佚名","d":1,"f":"诗经","g":"诗","x":"赫赫明明。王命卿士，南仲大祖，大师皇父。整我六师，以修我戎。既敬既戒，惠此南国。","b":0,"y":-800,"th":["战争","颂歌","军旅","怀古"],"ap":1},{"id":"5f16bb42f2a9","t":"凫鹥","a":"佚名","d":1,"f":"诗经","g":"诗","x":"凫鹥在泾，公尸在燕来宁。尔酒既清，尔肴既馨。公尸燕饮，福禄来成。","b":0,"y":-771,"th":["祭祀","宴饮","祈福","颂歌"],"ap":1},{"id":"c5c56c5c5e32","t":"载芟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"载芟载柞，其耕泽泽。千耦其耘，徂隰徂畛。侯主侯伯，侯亚侯旅，侯彊侯以。","b":0,"y":-750,"th":["农事","祭祀","颂歌"],"ap":1},{"id":"60c4f34ff75e","t":"丰年","a":"佚名","d":1,"f":"诗经","g":"诗","x":"丰年多黍多稌，亦有高廪，万亿及秭。为酒为醴，烝畀祖妣。以洽百礼，降福孔皆。","b":0,"y":-700,"th":["农事","祭祀","颂歌"],"ap":1},{"id":"6fb100f8a178","t":"酌","a":"佚名","d":1,"f":"诗经","g":"诗","x":"于铄王师，遵养时晦。时纯熙矣，是用大介。我龙受之，蹻蹻王之造。载用有嗣，实维尔公允师。","b":1,"y":-700,"th":["战争","颂歌","怀古"],"ap":1},{"id":"7fdcdb83297b","t":"臣工","a":"佚名","d":1,"f":"诗经","g":"诗","x":"嗟嗟臣工，敬尔在公。王厘尔成，来咨来茹。嗟嗟保介，维莫之春，亦又何求？如何新畲？","b":0,"y":-700,"th":["农事","颂歌","劝农"],"ap":1},{"id":"c668b992327c","t":"绵","a":"佚名","d":1,"f":"诗经","g":"诗","x":"绵绵瓜瓞。民之初生，自土沮漆。古公亶父，陶复陶冗，未有家室。","b":0,"y":-700,"th":["史诗","咏史","颂歌"],"ap":1},{"id":"f0f935800541","t":"潜","a":"佚名","d":1,"f":"诗经","g":"诗","x":"猗与漆沮，潜有多鱼。有鳣有鲔，鲦鲿鰋鲤。以享以祀，以介景福。","b":0,"y":-700,"th":["祭祀","颂歌","咏物"],"ap":1},{"id":"de65697df98a","t":"玄鸟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"天命玄鸟，降而生商，宅殷土芒芒。古帝命武汤，正域彼四方。","b":1,"y":-650,"th":["祭祀","咏史","颂歌"],"ap":1},{"id":"4ac234d595f3","t":"东皇太一","a":"屈原","d":1,"f":"楚辞","g":"诗","x":"吉日兮辰良，穆将愉兮上皇","b":5,"y":-300,"th":["祭祀","神话","颂歌"],"ap":1}],"t089":[{"id":"348b7975abb5","t":"大东","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有饛簋飧，有捄棘匕。周道如砥，其直如矢。君子所履，小人所视。眷言顾之，潸焉出涕。","b":0,"y":-850,"th":["怨刺","民生","讽喻"],"ap":1},{"id":"2ac77723beba","t":"雨无正","a":"佚名","d":1,"f":"诗经","g":"诗","x":"浩浩昊天，不骏其德。降丧饥馑，斩伐四国。旻天疾威，弗虑弗图。舍彼有罪，既伏其辜。若此无罪，沦胥以铺。","b":0,"y":-776,"th":["时政","伤时","怨刺"],"ap":1},{"id":"42f8ba2d2c3b","t":"羔裘","a":"佚名","d":1,"f":"诗经","g":"诗","x":"羔裘豹祛，自我人居居。岂无他人？维子之故。","b":0,"y":-700,"th":["讽刺","怨刺","人情冷暖"],"ap":1},{"id":"472ed91c745e","t":"菀柳","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有菀者柳，不尚息焉。上帝甚蹈，无自暱焉。俾予靖之，后予极焉。","b":0,"y":-700,"th":["怨刺","放逐","忠而被弃"],"ap":1},{"id":"741aae5de011","t":"旄丘","a":"佚名","d":1,"f":"诗经","g":"诗","x":"旄丘之葛兮，何诞之节兮。叔兮伯兮，何多日也？","b":0,"y":-700,"th":["流亡","怨刺","家国"],"ap":1},{"id":"84648cb493fe","t":"谷风","a":"佚名","d":1,"f":"诗经","g":"诗","x":"习习谷风，维风及雨。将恐将惧，维予与女。将安将乐，女转弃予。","b":1,"y":-700,"th":["弃妇","怨刺","爱情"],"ap":1},{"id":"c719391dc722","t":"北山","a":"佚名","d":1,"f":"诗经","g":"诗","x":"陟彼北山，言采其杞。偕偕士子，朝夕从事。王事靡盬，忧我父母。","b":0,"y":-700,"th":["怨刺","劳役","不公"],"ap":1},{"id":"ed0bc22b4565","t":"祈父","a":"佚名","d":1,"f":"诗经","g":"诗","x":"祈父，予王之爪牙。胡转予于恤，靡所止居？","b":0,"y":-700,"th":["战争","怨刺","孝道"],"ap":1},{"id":"f3c18d99ecae","t":"何人斯","a":"佚名","d":1,"f":"诗经","g":"诗","x":"彼何人斯？其心孔艰。胡逝我梁，不入我门？伊谁云从？维暴之云。","b":0,"y":-700,"th":["怨刺","绝交","友情"],"ap":1},{"id":"362bbc16085f","t":"鸨羽","a":"佚名","d":1,"f":"诗经","g":"诗","x":"肃肃鸨羽，集于苞栩。王事靡盬，不能蓺稷黍。父母何怙？悠悠苍天，曷其有所？","b":1,"y":-650,"th":["徭役","怨刺","孝道"],"ap":1},{"id":"d8a940788f15","t":"式微","a":"佚名","d":1,"f":"诗经","g":"诗","x":"式微，式微，胡不归？微君之故，胡为乎中露！","b":1,"y":-650,"th":["劳役","怨刺","思归"],"ap":1},{"id":"1388004d7b5d","t":"杂曲歌辞 蓟门行五首 三","a":"高适","d":6,"f":"五古","g":"诗","x":"蓟门逢古老，独立思氛氲。","b":7,"y":752,"th":["边塞","怀古","怨刺"],"ap":1}],"t108":[{"id":"78624365f08e","t":"招隐士","a":"淮南小山","d":1,"f":"楚辞","g":"诗","x":"桂树丛生兮山之幽，偃蹇连蜷兮枝相缭。","b":5,"y":-300,"th":["招隐","山水","忧惧"],"ap":1},{"id":"b7de0f9c1b0c","t":"相和歌辞 蜀道难","a":"张文琮","d":6,"f":"五律","g":"诗","x":"梁山镇地险，积石阻云端。","b":0,"y":650,"th":["行役","山水","咏叹"],"ap":1},{"id":"fb55db6ebd11","t":"相和歌辞 春江花月夜二首 一","a":"张子容","d":6,"f":"五古","g":"诗","x":"林花发岸口，气色动江新。","b":2,"y":730,"th":["山水","咏物","田园"],"ap":1},{"id":"356a216e411b","t":"相和歌辞 櫂歌行","a":"徐坚","d":6,"f":"五古","g":"诗","x":"櫂女饰银钩，新妆下翠楼。","b":4,"y":750,"th":["山水","游乐","咏怀"],"ap":1},{"id":"b2fc50c1397c","t":"相和歌辞 江南弄","a":"李贺","d":6,"f":"古体","g":"诗","x":"江中绿雾起凉波，天上叠𪩘红嵯峨。","b":9,"y":810,"th":["江南","隐逸","山水"],"ap":1},{"id":"100572e0f03b","t":"相和歌辞 江南曲 二","a":"陆龟蒙","d":6,"f":"五绝","g":"诗","x":"鱼戏莲叶东，初霞射红尾。","b":10,"y":875,"th":["田园","咏物","山水"],"ap":1},{"id":"418d2a01bd32","t":"酒泉子","a":"潘阆","d":8,"f":"词","g":"词","x":"长忆钱塘，不是人寰是天上。","b":1,"y":990,"th":["忆旧","山水","思乡"],"ap":1},{"id":"4b426a3fa9ba","t":"酒泉子","a":"潘阆","d":8,"f":"词","g":"词","x":"长忆孤山，山在湖心如黛簇。","b":1,"y":990,"th":["忆旧","山水","隐逸"],"ap":1},{"id":"e7468eed14f1","t":"酒泉子","a":"潘阆","d":8,"f":"词","g":"词","x":"长忆西山，灵隐寺前三竺后。","b":1,"y":990,"th":["山水","忆旧","思乡"],"ap":1},{"id":"53d4a9d2e52a","t":"后赤壁赋","a":"苏轼","d":8,"f":"赋","g":"赋","x":"是岁十月之望，步自雪堂，将归于临皋。二客从予过黄泥之阪。霜露既降，木叶尽脱，人影在地，仰见明月，顾而乐之，行歌相答。已而叹曰：“有客无酒，有酒无肴，月白风清，如此良夜何！”客曰：“今者薄暮，举网得鱼，巨口细鳞，状如松江之鲈。顾安所得酒乎？”归而谋诸妇。妇曰：“我有斗酒，藏之久矣，以待子不时之需。”于是携酒与鱼，复游于赤壁之下。江流有声，断岸千尺；山高月小，水落石出。曾日月之几何，而江山不可复识矣。予乃摄衣而上，履巉岩，披蒙茸，踞虎豹，登虬龙，攀栖鹘之危巢，俯冯夷之幽宫。盖二客不能从焉。划然长啸，草木震动，山鸣谷应，风起水涌。予亦悄然而悲，肃然而恐，凛乎其不可留也。反而登舟，放乎中流，听其所止而休焉。时夜将半，四顾寂寥。适有孤鹤，横江东来。翅如车轮，玄裳缟衣，戛然长鸣，掠予舟而西也。","b":3,"y":1082,"th":["哲理","山水","梦境"],"ap":1}],"t126":[{"id":"529aadffb57b","t":"敬之","a":"佚名","d":1,"f":"诗经","g":"诗","x":"敬之敬之，天维显思，命不易哉。无曰高高在上，陟降厥士，日监在兹。","b":0,"y":-908,"th":["哲理","咏志","敬天"],"ap":1},{"id":"6bb224cfa2ea","t":"论语·卫灵公篇 其9","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“志士仁人无求生以害仁，有杀身以成仁。”","b":2,"y":-450,"th":["哲理","家国","咏志"],"ap":1},{"id":"7ac767c79d2b","t":"饮马长城窟行","a":"太宗皇帝","d":6,"f":"五古","g":"诗","x":"塞外悲风切，交河冰已结。","b":0,"y":630,"th":["边塞","战争","咏志"],"ap":1},{"id":"5cedac9278ce","t":"杂曲歌辞 少年行四首 三","a":"王维","d":6,"f":"七绝","g":"诗","x":"出身仕汉羽林郎，初随骠骑战渔阳。","b":2,"y":730,"th":["边塞","咏志","侠义"],"ap":1},{"id":"7c84fa2df677","t":"相和歌辞 湖边采莲妇","a":"李白","d":6,"f":"五律","g":"诗","x":"小姑织白纻，未解将人语。","b":3,"y":736,"th":["田园","女性","咏志"],"ap":1},{"id":"7dc4bab2440f","t":"相和歌辞 从军行三首 二","a":"王涯","d":6,"f":"五绝","g":"诗","x":"燕颔多奇相，狼头敢犯边。","b":8,"y":800,"th":["边塞","建功立业","咏志"],"ap":1},{"id":"df28877be351","t":"相和歌辞 雁门太守行","a":"李贺","d":6,"f":"七律","g":"诗","x":"黑云压城城欲摧，甲光向月金鳞开。","b":9,"y":814,"th":["边塞","咏志","战争"],"ap":1},{"id":"93d0c1e895bf","t":"相和歌辞 胡无人行","a":"聂夷中","d":6,"f":"五古","g":"诗","x":"男儿徇大义，立节不沽名。","b":10,"y":892,"th":["边塞","咏志","怀古"],"ap":1}],"t135":[{"id":"3469cf1b3e66","t":"武","a":"佚名","d":1,"f":"诗经","g":"诗","x":"于皇武王！无竞维烈。允文文王，克开厥后。嗣武受之，胜殷遏刘，耆定尔功。","b":0,"y":-1046,"th":["咏史","颂功","祭祀"],"ap":1},{"id":"03280f3e5120","t":"六月","a":"佚名","d":1,"f":"诗经","g":"诗","x":"六月栖栖，戎车既饬。四牡骙骙，载是常服。玁狁孔炽，我是用急。王于出征，以匡王国。","b":0,"y":-823,"th":["边塞","战争","颂功","宴饮"],"ap":1},{"id":"0d5e4d6d7a15","t":"江汉","a":"佚名","d":1,"f":"诗经","g":"诗","x":"江汉浮浮，武夫滔滔。匪安匪游，淮夷来求。既出我车，既设我旟。匪安匪舒，淮夷来铺。","b":0,"y":-820,"th":["战争","颂功","咏史"],"ap":1},{"id":"fd04af5cee6f","t":"黍苗","a":"佚名","d":1,"f":"诗经","g":"诗","x":"芃芃黍苗，阴雨膏之。悠悠南行，召伯劳之。","b":0,"y":-800,"th":["颂功","劳役","思归"],"ap":1},{"id":"94d88dfdff79","t":"泮水","a":"佚名","d":1,"f":"诗经","g":"诗","x":"思乐泮水，薄采其芹。鲁侯戾止，言观其旂。其旂茷茷，鸾声哕哕。无小无大，从公于迈。","b":1,"y":-650,"th":["颂功","战争","德化"],"ap":1},{"id":"c4d0f21ef875","t":"相和歌辞 饮马长城窟行","a":"袁朗","d":6,"f":"五古","g":"诗","x":"朔风动秋草，清跸长安道。","b":0,"y":630,"th":["边塞","咏史","颂功"],"ap":1},{"id":"2ba62172d08f","t":"相和歌辞 从军行 四","a":"僧皎然","d":6,"f":"五律","g":"诗","x":"飞将下天来，奇谋阃外裁。","b":7,"y":780,"th":["边塞","咏战","颂功"],"ap":1}],"t153":[{"id":"96a554a213a0","t":"出车","a":"佚名","d":1,"f":"诗经","g":"诗","x":"我出我车，于彼牧矣。自天子所，谓我来矣。召彼仆夫，谓之载矣。王事多难，维其棘矣。","b":0,"y":-800,"th":["战争","思乡","边塞","爱国"],"ap":1},{"id":"282da55caa58","t":"载驰","a":"佚名","d":1,"f":"诗经","g":"诗","x":"载驰载驱，归唁卫侯。驱马悠悠，言至于漕。大夫跋涉，我心则忧。","b":1,"y":-700,"th":["爱国","咏怀","政治抱负"],"ap":1},{"id":"e3ba8e24627e","t":"无衣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"岂曰无衣？与子同袍。王于兴师，修我戈矛。与子同仇！","b":0,"y":-700,"th":["边塞","爱国","战歌"],"ap":1},{"id":"7e3d76b583fd","t":"论语·微子篇 其2","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"柳下惠为士师，三黜。人曰：“子未可以去乎？”曰：“直道而事人，焉往而不三黜？枉道而事人，何必去父母之邦？”","b":1,"y":-550,"th":["哲理","品格","爱国"],"ap":1},{"id":"aead4cdcbaf1","t":"橘颂","a":"屈原","d":1,"f":"楚辞","g":"诗","x":"后皇嘉树，橘徕服兮。","b":5,"y":-290,"th":["咏物","言志","爱国","品格"],"ap":1},{"id":"781e1858597c","t":"相和歌辞 从军行 四","a":"王昌龄","d":6,"f":"七绝","g":"诗","x":"青海长云暗雪山，孤城遥望雁门关。","b":2,"y":724,"th":["边塞","壮志","爱国"],"ap":1}],"t179":[{"id":"02af8d1c39a1","t":"论语·宪问篇 其39","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子击磬于卫，有荷蒉而过孔氏之门者，曰：“有心哉，击磬乎！”既而曰：“鄙哉，硁硁乎！莫己知也，斯己而已矣。深则厉，浅则揭。”子曰：“果哉！末之难矣。”","b":1,"y":-492,"th":["哲理","入世","隐逸","知音"],"ap":1},{"id":"d7353da75a0f","t":"玉蝴蝶","a":"柳永","d":8,"f":"词","g":"词","x":"是处小街斜巷，烂游花馆，连醉瑶卮。","b":1,"y":1025,"th":["爱情","知音","青楼"],"ap":1},{"id":"03f33b069e0a","t":"惜春郎","a":"柳永","d":8,"f":"词","g":"词","x":"玉肌琼艳新妆饰。","b":2,"y":1030,"th":["爱情","咏人","知音"],"