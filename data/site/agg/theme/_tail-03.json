["哲理","仁政","性善"],"ap":1},{"id":"dff588c3313c","t":"孟子·公孙丑上 其39","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「人皆有不忍人之心。先王有不忍人之心，斯有不忍人之政矣。以不忍人之心，行不忍人之政，治天下可运之掌上。所以谓人皆有不忍人之心者，今人乍见孺子将入于井，皆有怵惕恻隐之心。非所以内交于孺子之父母也，非所以要誉于乡党朋友也，非恶其声而然也。由是观之，无恻隐之心，非人也；无羞恶之心，非人也；无辞让之心，非人也；无是非之心，非人也。恻隐之心，仁之端也；羞恶之心，义之端也；辞让之心，礼之端也；是非之心，智之端也。人之有是四端也，犹其有四体也。有是四端而自谓不能者，自贼者也；谓其君不能者，贼其君者也。凡有四端于我者，知皆扩而充之矣，若火之始然，泉之始达。苟能充之，足以保四海；苟不充之，不足以事父母。」","b":4,"y":-320,"th":["哲理","性善","仁政"],"ap":1}],"t374":[{"id":"1beee48d9e35","t":"郊庙歌辞 五郊乐章 黑帝羽音 肃和","a":"魏征","d":6,"f":"四言","g":"诗","x":"律回玉琯，星周金度。","b":0,"y":630,"th":["节令","农事","天象"],"ap":1},{"id":"02b7cf7c9aed","t":"郊庙歌辞 祀九宫贵神乐章 豫和 二","a":"不详","d":6,"f":"四言","g":"诗","x":"黑帝旋驭，青躔导日。","b":6,"y":750,"th":["祭祀","天象","礼乐"],"ap":1},{"id":"c12004f45bbb","t":"郊庙歌辞 祀九宫贵神乐章 豫和 三","a":"不详","d":6,"f":"四言","g":"诗","x":"帝临中坛，受厘元神。","b":6,"y":750,"th":["祭祀","天象","神权"],"ap":1}],"t389":[{"id":"ac3022ed6b9a","t":"西施咏","a":"王维","d":6,"f":"五古","g":"诗","x":"艳色天下重，西施宁久微。","b":3,"y":736,"th":["咏史","讽喻","命运"],"ap":1},{"id":"2c41fd4eb3d2","t":"横吹曲辞 前出塞九首 五","a":"杜甫","d":6,"f":"五律","g":"诗","x":"迢迢万余里，领我赴三军。","b":6,"y":756,"th":["边塞","战争","命运"],"ap":1},{"id":"90bfd0b1aa5b","t":"梦李白二首 二","a":"杜甫","d":6,"f":"五古","g":"诗","x":"浮云终日行，游子久不至。","b":6,"y":759,"th":["怀人","感慨","命运"],"ap":1}],"t424":[{"id":"a75886a4f7e3","t":"剑门道中遇微雨","a":"陆游","d":8,"f":"七绝","g":"诗","x":"衣上征尘杂酒痕，远游无处不消魂。","b":3,"y":1172,"th":["羁旅","自嘲","人生感慨"],"ap":1},{"id":"1b3395f3e0ff","t":"诈妮子调风月・收尾","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"大刚来\"主人有福牙推胜\"，不似这调风月媒人背厅。","b":0,"y":1250,"th":["爱情","自嘲","世态人情"],"ap":1},{"id":"897975fb8119","t":"钱大尹智宠谢天香・南吕/一枝花","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"往常时唤官身可早眉黛舒，今日个叫祗候喉咙响。","b":0,"y":1290,"th":["杂剧曲词","自嘲","市井风情"],"ap":1}],"t433":[{"id":"0c604dfa955a","t":"硕鼠","a":"佚名","d":1,"f":"诗经","g":"诗","x":"硕鼠硕鼠，无食我黍！三岁贯女，莫我肯顾。逝将去女，适彼乐土。乐土乐土，爰得我所。","b":1,"y":-550,"th":["讽谕","反抗","田园"],"ap":1},{"id":"c3301885f117","t":"诈妮子调风月・调笑令","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"这厮短命，没前程，做得个\"轻人还自轻\"，横死口里栽排定。","b":0,"y":1280,"th":["闺怨","讽刺","反抗"],"ap":1}],"t442":[{"id":"219510d03ce6","t":"孟子·公孙丑上 其13","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「有。北宫黝之养勇也，不肤挠，不目逃，思以一豪挫于人，若挞之于市朝。不受于褐宽博，亦不受于万乘之君。视刺万乘之君，若刺褐夫。无严诸侯。恶声至，必反之。孟施舍之所养勇也，曰：『视不胜犹胜也。量敌而后进，虑胜而后会，是畏三军者也。舍岂能为必胜哉？能无惧而已矣。』孟施舍似曾子，北宫黝似子夏。夫二子之勇，未知其孰贤，然而孟施舍守约也。昔者曾子谓子襄曰：『子好勇乎？吾尝闻大勇于夫子矣：自反而不缩，虽褐宽博，吾不惴焉；自反而缩，虽千万人，吾往矣。』孟施舍之守气，又不如曾子之守约也。」","b":4,"y":-320,"th":["哲理","修养","道义"],"ap":1},{"id":"fbfe34336e1a","t":"孟子·公孙丑上 其10","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「若是，则夫子过孟贲远矣。」","b":4,"y":-320,"th":["哲理","修养","勇德"],"ap":1}],"t451":[{"id":"2e7662f7b719","t":"论语·卫灵公篇 其41","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“辞达而已矣。”","b":2,"y":-450,"th":["哲理","言辞","修辞"],"ap":1},{"id":"4419a7be46d7","t":"孟子·公孙丑下 其40","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「不知也。」","b":4,"y":-320,"th":["哲理","修辞"],"ap":1}],"t468":[{"id":"63b222f22950","t":"论语·先进篇 其5","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“孝哉闵子骞！人不间于其父母昆弟之言。”","b":2,"y":-450,"th":["孝道","哲理","品评"],"ap":1},{"id":"57feced00d02","t":"论语·子张篇 其16","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"曾子曰：“堂堂乎张也，难与并为仁矣。”","b":4,"y":-440,"th":["哲理","修身","品评"],"ap":1}],"t477":[{"id":"759476f5e1d9","t":"孟子·滕文公上 其3","a":"孟子","d":1,"f":"文","g":"文","x":"滕定公薨。世子谓然友曰：「昔者孟子尝与我言于宋，于心终不忘。今也不幸至于大故，吾欲使子问于孟子，然后行事。」","b":5,"y":-320,"th":["哲理","尊师重道","孝道"],"ap":1},{"id":"ed7c1299c44c","t":"孟子·公孙丑上 其35","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「宰我、子贡、有若智足以知圣人。污，不至阿其所好。宰我曰：『以予观于夫子，贤于尧舜远矣。』子贡曰：『见其礼而知其政，闻其乐而知其德。由百世之后，等百世之王，莫之能违也。自生民以来，未有夫子也。』有若曰：『岂惟民哉？麒麟之于走兽，凤凰之于飞鸟，太山之于丘垤，河海之于行潦，类也。圣人之于民，亦类也。出于其类，拔乎其萃，自生民以来，未有盛于孔子也。』」","b":4,"y":-320,"th":["尊师重道","儒家道统","哲理"],"ap":1}],"t486":[{"id":"93356732abbf","t":"论语·雍也篇 其24","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“齐一变至于鲁，鲁一变至于道。”","b":1,"y":-500,"th":["哲理","政治","理想"],"ap":1},{"id":"f8d965e9ddd7","t":"论语·先进篇 其26","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子路、曾皙、冉有、公西华侍坐，子曰：“以吾一日长乎尔，毋吾以也。居则曰‘不吾知也’如或知尔，则何以哉？”子路率尔而对曰：“千乘之国，摄乎大国之间，加之以师旅，因之以饥馑，由也为之，比及三年，可使有勇，且知方也。”夫子哂之。“求，尔何如？”对曰：“方六七十，如五六十，求也为之，比及三年，可使足民。如其礼乐，以俟君子。”“赤！尔何如？”对曰：“非曰能之，愿学焉。宗庙之事，如会同，端章甫，愿为小相焉。”“点，尔何如？”鼓瑟希，铿尔，舍瑟而作，对曰：“异乎三子者之撰。”子曰：“何伤乎？亦各言其志也。”曰：“暮春者，春服既成，冠者五六人，童子六七人，浴乎沂，风乎舞雩，咏而归。”夫子喟然叹曰：“吾与点也！”三子者出，曾皙后。曾皙曰：“夫三子者之言何如？”子曰：“亦各言其志也已矣。”曰：“夫子何哂由也？”曰：“为国以礼，其言不让，是故哂之。”“唯求则非邦也与？”“安见方六七十、如五六十而非邦也者？”“唯赤则非邦也与？”“宗庙会同，非诸侯而何？赤也为之小，孰能为之大？”","b":1,"y":-490,"th":["言志","礼乐","哲理","理想"],"ap":1}],"t495":[{"id":"d63a23981ffd","t":"论语·雍也篇 其28","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子见南子，子路不说，夫子矢之曰：“予所否者，天厌之！天厌之！”","b":1,"y":-492,"th":["师生情谊","哲理","权变"],"ap":1},{"id":"d241beb85e58","t":"论语·子罕篇 其3","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“麻冕，礼也；今也纯，俭，吾从众。拜下，礼也；今拜乎上，泰也；虽违众，吾从下。”","b":2,"y":-450,"th":["哲理","礼制","权变"],"ap":1}],"t507":[{"id":"12bd9dbdea9e","t":"相和歌辞 蛾眉怨","a":"王翰","d":6,"f":"古体","g":"诗","x":"君不见宜春苑中九华殿，飞阁连连直如发。","b":3,"y":740,"th":["宫怨","求仙","咏史","哲理"],"ap":1},{"id":"d16979e63603","t":"杂曲歌辞 行路难三首 一","a":"顾况","d":6,"f":"古体","g":"诗","x":"君不见古来烧水银，变作北邙山上尘。","b":7,"y":790,"th":["咏史","哲理","求仙"],"ap":1}],"t518":[{"id":"202793323f92","t":"相和歌辞 怨歌行","a":"吴少微","d":6,"f":"古体","g":"诗","x":"城南有怨妇，含怨倚兰丛。","b":4,"y":750,"th":["宫怨","咏史","美人迟暮"],"ap":1},{"id":"ff8a45920604","t":"春宫怨","a":"杜荀鹤","d":6,"f":"五律","g":"诗","x":"早被婵娟误，欲妆临镜慵。","b":10,"y":881,"th":["宫怨","美人迟暮","对比反衬"],"ap":1}],"t521":[{"id":"8006491d04f7","t":"句","a":"后主衍","d":6,"f":"五古","g":"诗","x":"不缘朝阙去，好此结茅庐。","b":4,"y":750,"th":["隐逸","仕隐矛盾"],"ap":1},{"id":"234c6197dff9","t":"秋日赴阙题潼关驿楼","a":"许浑","d":6,"f":"五律","g":"诗","x":"红叶晚萧萧，长亭酒一瓢。","b":9,"y":830,"th":["羁旅","隐逸","仕隐矛盾"],"ap":1}],"t532":[{"id":"39ff51e618fc","t":"郊庙歌辞 祀风师乐章 迎神","a":"包佶","d":6,"f":"四言","g":"诗","x":"太皞御气，句芒肇功。","b":7,"y":762,"th":["礼乐","祭祀","自然崇拜"],"ap":1},{"id":"8814196e124f","t":"郊庙歌辞 祀风师乐章 迎俎酌献","a":"包佶","d":6,"f":"四言","g":"诗","x":"德盛昭临，迎拜巽方。","b":7,"y":770,"th":["祭祀","礼乐","自然崇拜"],"ap":1}],"t543":[{"id":"53b2eb2bf6b9","t":"郊庙歌辞 武后大享拜洛乐章 昭和","a":"不详","d":6,"f":"四言","g":"诗","x":"舒阴致养，合大资生。","b":1,"y":690,"th":["礼乐/颂德/祥瑞"],"ap":1},{"id":"89c48d1fbed1","t":"唐大飨拜洛乐章 昭和","a":"则天皇后","d":6,"f":"四言","g":"诗","x":"舒云致养，合大资生。","b":1,"y"