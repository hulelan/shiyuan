{"t046":[{"id":"2ac77723beba","t":"雨无正","a":"佚名","d":1,"f":"诗经","g":"诗","x":"浩浩昊天，不骏其德。降丧饥馑，斩伐四国。旻天疾威，弗虑弗图。舍彼有罪，既伏其辜。若此无罪，沦胥以铺。","b":0,"y":-776,"th":["时政","伤时","怨刺"],"ap":1},{"id":"aac59adf28c6","t":"都人士","a":"佚名","d":1,"f":"诗经","g":"诗","x":"彼都人士，狐裘黄黄。其容不改，出言有章。行归于周，万民所望。","b":0,"y":-770,"th":["怀古","故国之思","伤时"],"ap":1},{"id":"632cdfaa598a","t":"鼓钟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鼓钟将将，淮水汤汤，忧心且伤。淑人君子，怀允不忘。","b":1,"y":-700,"th":["伤时","怀古","咏乐"],"ap":1},{"id":"cc47b6ccbed9","t":"頍弁","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有頍者弁，实维伊何？尔酒既旨，尔肴既嘉。岂伊异人？兄弟匪他。","b":1,"y":-700,"th":["宴饮","亲情","伤时","哲理"],"ap":1},{"id":"5e4d4fe17a0f","t":"兔爰","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有兔爰爰，雉离于罗。我生之初，尚无为；我生之后，逢此百罹。尚寐无吪。","b":1,"y":-650,"th":["伤时","乱世","哀怨"],"ap":1},{"id":"c76e6765b9b2","t":"下泉","a":"佚名","d":1,"f":"诗经","g":"诗","x":"冽彼下泉，浸彼苞稂。忾我寤叹，念彼周京。","b":1,"y":-550,"th":["怀古","伤时","思治"],"ap":1},{"id":"4078cdb57567","t":"论语·子罕篇 其9","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“凤鸟不至，河不出图，吾已矣夫！”","b":1,"y":-500,"th":["怀古","哲理","伤时"],"ap":1},{"id":"6f9d99c903b3","t":"伤时","a":"王逸","d":1,"f":"楚辞","g":"诗","x":"惟昊天兮昭灵，阳气发兮清明。","b":5,"y":-300,"th":["伤时","游仙","怀古","去国"],"ap":1},{"id":"a2ef10f40147","t":"尊嘉","a":"王褒","d":1,"f":"楚辞","g":"诗","x":"季春兮阳阳，列草兮成行。","b":5,"y":-300,"th":["怀古","咏物","羁旅","伤时"],"ap":1},{"id":"e064417ec3f7","t":"陶壅","a":"王褒","d":1,"f":"楚辞","g":"诗","x":"览杳杳兮世惟，余惆怅兮何归。","b":5,"y":-300,"th":["游仙","怀古","伤时"],"ap":1},{"id":"7d9493e8762a","t":"杂曲歌辞 东飞伯劳歌","a":"张柬之","d":6,"f":"七古","g":"诗","x":"青田白鹤丹山凤，婺女姮娥两相送。","b":1,"y":700,"th":["咏人","伤时","青春易逝"],"ap":1},{"id":"6aa6493e47a5","t":"舞曲歌辞 白纻辞二首 二","a":"杨衡","d":6,"f":"古体","g":"诗","x":"蹑珠履，步琼筵。","b":5,"y":750,"th":["乐舞","闺怨","伤时"],"ap":1},{"id":"8456c860b827","t":"琴曲歌辞  秋思二首 一","a":"李白","d":6,"f":"五律","g":"诗","x":"春阳如昨日，碧树鸣黄鹂。","b":4,"y":750,"th":["悲秋","伤时","咏物"],"ap":1},{"id":"126b79257ee6","t":"相和歌辞 莫愁曲","a":"李贺","d":6,"f":"五古","g":"诗","x":"草生陇坂下，鵶噪城堞头。","b":9,"y":812,"th":["闺怨","咏怀","伤时"],"ap":1},{"id":"268c9aa3b7cb","t":"杂曲歌辞 轻薄篇二首 