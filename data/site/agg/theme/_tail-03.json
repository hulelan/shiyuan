,"回忆"],"ap":1}],"t217":[{"id":"bccd51e0850a","t":"假乐","a":"佚名","d":1,"f":"诗经","g":"诗","x":"假乐君子，显显令德，宜民宜人。受禄于天，保右命之，自天申之。","b":0,"y":-908,"th":["颂赞","德政","天命"],"ap":1},{"id":"5d7dbfb796bb","t":"论语·颜渊篇 其13","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“听讼，吾犹人也。必也使无讼乎。”","b":3,"y":-450,"th":["哲理","治国","德政"],"ap":1},{"id":"186e9410a406","t":"中庸·中庸 其17","a":"子思（传）","d":1,"f":"文","g":"文","x":"子曰：「舜其大孝也与！德为圣人，尊为天子，富有四海之内。宗庙飨之，子孙保之。故大德必得其位，必得其禄，必得其名，必得其寿。故天之生物，必因其材而笃焉。故栽者培之，倾者覆之。《诗》曰：『嘉乐君子，宪宪令德！宜民宜人，受禄于天。保佑命之，自天申之！』故大德者必受命。」","b":4,"y":-430,"th":["哲理","孝道","德政"],"ap":1},{"id":"984f2121984d","t":"中庸·中庸 其18","a":"子思（传）","d":1,"f":"文","g":"文","x":"子曰：「无忧者其惟文王乎！以王季为父，以武王为子，父作之，子述之。武王缵大王、王季、文王之绪，壹戎衣而有天下，身不失天下之显名；尊为天子，富有四海之内。宗庙飨之，子孙保之。武王末受命，周公成文、武之德，追王大王、王季，上祀先公以天子之礼。斯礼也，达乎诸侯、大夫及士、庶人。父为大夫，子为士，葬以大夫，祭以士。父为士，子为大夫，葬以士，祭以大夫。期之丧，达乎大夫；三年之丧，达乎天子；父母之丧，无贵贱，一也。」","b":4,"y":-430,"th":["礼制","孝道","宗法","德政"],"ap":1}],"t222":[{"id":"226ef8b89cdf","t":"论语·子路篇 其28","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子路问曰：“何如斯可谓之士矣？”子曰：“切切偲偲，怡怡如也，可谓士矣。朋友切切偲偲，兄弟怡怡。”","b":3,"y":-450,"th":["哲理","修身","人伦"],"ap":1},{"id":"429e712dbf42","t":"论语·子张篇 其14","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子游曰：“丧致乎哀而止。”","b":2,"y":-450,"th":["哲理","礼制","人伦"],"ap":1},{"id":"f4b526e21457","t":"论语·为政篇 其6","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"孟武伯问孝。子曰：“父母唯其疾之忧。”","b":2,"y":-450,"th":["哲理","人伦","孝道"],"ap":1},{"id":"24f2890c9b22","t":"孟子·公孙丑下 其25","a":"孟子","d":1,"f":"文","g":"文","x":"充虞请曰：「前日不知虞之不肖，使虞敦匠事。严，虞不敢请。今愿窃有请也，木若以美然。」","b":4,"y":-320,"th":["哲理","孝道","人伦"],"ap":1}],"t231":[{"id":"54bf3a35586f","t":"逢尤","a":"王逸","d":1,"f":"楚辞","g":"诗","x":"悲兮愁，哀兮忧！","b":5,"y":-300,"th":["悲愤","怀古","抒怀"],"ap":1},{"id":"554c000832fe","t":"哀命","a":"东方朔","d":1,"f":"楚辞","g":"诗","x":"哀时命之不合兮，伤楚国之多忧。","b":5,"y":-300,"th":["怀古","忠贞","悲愤"],"ap":1},{"id":"6e71c4d759f2","t":"琴曲歌辞 胡笳十八拍 第三拍","a":"刘商","d":6,"f":"七律","g":"诗","x":"如羇囚兮在缧绁，忧虑万端无处说。","b":8,"y":790,"th":["思乡","边塞","悲愤"],"ap":1},{"id":"8ede71fd8f6a","t":"杂曲歌辞 游侠行","a":"孟郊","d":6,"f":"五律","g":"诗","x":"壮士