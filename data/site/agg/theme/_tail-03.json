c83","t":"玉楼春","a":"柳永","d":8,"f":"词","g":"词","x":"凤楼郁郁呈嘉瑞。","b":1,"y":1020,"th":["应制","颂圣","节庆"],"ap":1},{"id":"759e23f7ea19","t":"喜迁莺","a":"晏殊","d":8,"f":"词","g":"词","x":"风转蕙，露催莲。","b":2,"y":1032,"th":["节庆","颂祝","宫廷"],"ap":1},{"id":"54a37ff68817","t":"双韵子","a":"张先","d":8,"f":"词","g":"词","x":"鸣鞘电过晓闱静。","b":3,"y":1050,"th":["宫廷","节庆","颂圣"],"ap":1}],"t327":[{"id":"0c604dfa955a","t":"硕鼠","a":"佚名","d":1,"f":"诗经","g":"诗","x":"硕鼠硕鼠，无食我黍！三岁贯女，莫我肯顾。逝将去女，适彼乐土。乐土乐土，爰得我所。","b":1,"y":-550,"th":["讽谕","反抗","田园"],"ap":1},{"id":"c3301885f117","t":"诈妮子调风月・调笑令","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"这厮短命，没前程，做得个\"轻人还自轻\"，横死口里栽排定。","b":0,"y":1280,"th":["闺怨","讽刺","反抗"],"ap":1}],"t338":[{"id":"ae5fa8015092","t":"论语·雍也篇 其9","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"季氏使闵子骞为费宰，闵子骞曰：“善为我辞焉。如有复我者，则吾必在汶上矣。”","b":1,"y":-500,"th":["气节","辞官","守道"],"ap":1},{"id":"25329edcb9f0","t":"论语·宪问篇 其36","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"公伯寮愬子路于季孙。子服景伯以告，曰：“夫子固有惑志于公伯寮，吾力犹能肆诸市朝。”子曰：“道之将行也与，命也；道之将废也与，命也。公伯寮其如命何？”","b":3,"y":-450,"th":["哲理","天命","守道"],"ap":1}],"t363":[{"id":"50873c8b03a1","t":"论语·述而篇 其18","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子所雅言，《诗》、《书》、执礼，皆雅言也。","b":3,"y":-450,"th":["哲理","礼乐","崇古"],"ap":1},{"id":"f48ce1f7e3cf","t":"论语·泰伯篇 其21","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“禹，吾无间然矣。菲饮食而致孝乎鬼神，恶衣服而致美乎黼冕，卑宫室而尽力乎沟洫。禹，吾无间然矣。”","b":3,"y":-450,"th":["崇古","哲理","咏人"],"ap":1}],"t374":[{"id":"67d5bc528dbd","t":"论语·颜渊篇 其22","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"樊迟问仁，子曰：“爱人。”问知，子曰：“知人。”樊迟未达，子曰：“举直错诸枉，能使枉者直。”樊迟退，见子夏，曰：“乡也吾见于夫子而问知，子曰：‘举直错诸枉，能使枉者直’，何谓也？”子夏曰：“富哉言乎！舜有天下，选于众，举皋陶，不仁者远矣。汤有天下，选于众，举伊尹，不仁者远矣。”","b":1,"y":-500,"th":["哲理","用人之道","仁政"],"ap":1},{"id":"6bde0cec7b4f","t":"论语·子路篇 其25","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“君子易事而难说也，说之不以道不说也，及其使人也器之；小人难事而易说也，说之虽不以道说也，及其使人也求备焉。”","b":3,"y":-450,"th":["哲理","修身","用人之道"],"ap":1}],"t389":[{"id":"a7a8f73cd9ce","t":"论语·阳货篇 其9","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“小子何莫学夫《诗》？《诗》可以兴，可以观，可以群，可以怨。迩之事父，远之事君，多识于鸟兽草木之名。”","b":1,"y":-500,"th":["诗教","哲理","修身"],"ap":1},{"id":"973d8232b53c","t":"论语·为政篇 其2","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“《诗》三百，一言以蔽之，曰：‘思无邪’。”","b":2,"y":-450,"th":["哲理","诗教"],"ap":1}],"t424":[{"id":"a533b961e2f2","t":"相和歌辞 采莲曲二首 一","a":"戎昱","d":6,"f":"五律","g":"诗","x":"虽听采莲曲，讵识采莲心。","b":7,"y":780,"th":["闺怨","采莲","江南风光"],"ap":1},{"id":"a7fbd0e85ad1","t":"泛清苕","a":"张先","d":8,"f":"词","g":"词","x":"绿净无痕，过晓霁清苕，镜里游人。","b":3,"y":1050,"th":["宴饮","游赏","江南风光"],"ap":1}],"t433":[{"id":"44d8a41cc251","t":"两同心","a":"柳永","d":8,"f":"词","g":"词","x":"伫立东风，断魂南国。","b":2,"y":1035,"th":["爱情","羁旅","思人"],"ap":1},{"id":"39e7be529aa2","t":"望汉月・忆汉月","a":"柳永","d":8,"f":"词","g":"词","x":"明月明月明月。","b":4,"y":1100,"th":["爱情","离别","咏物","思人"],"ap":1}],"t442":[{"id":"02981019418b","t":"钱大尹智宠谢天香・醉中天","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"初相见呼你为学士，谨厚不因而；今遍回身嘱付尔，相公也冷眼儿频偷视。","b":0,"y":1250,"th":["爱情","世情","戏曲"],"ap":1},{"id":"cc73b45d2f49","t":"诈妮子调风月・寄生草","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"卧地观经史，坐地对圣人。","b":0,"y":1290,"th":["爱情","世情"],"ap":1}],"t451":[{"id":"bf94454ef66f","t":"草桥店梦莺莺(第四本)・秃厮儿","a":"王实甫","d":9,"f":"曲","g":"曲","x":"我则道神针法灸，谁承望燕侣莺俦。","b":0,"y":1300,"th":["爱情","喜剧","反礼教"],"ap":1},{"id":"c0adf30f1afb","t":"草桥店梦莺莺(第四本)・络丝娘","a":"王实甫","d":9,"f":"曲","g":"曲","x":"不争和张解元参辰卯酉，便是与崔相国出乖弄丑。","b":0,"y":1301,"th":["爱情","喜剧","伦理"],"ap":1}],"t468":[{"id":"11c1126c83b8","t":"论语·子罕篇 其5","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子畏于匡，曰：“文王既没，文不在兹乎？天之将丧斯文也，后死者不得与于斯文也；天之未丧斯文也，匡人其如予何？”","b":1,"y":-495,"th":["哲理","天命","文化传承"],"ap":1}],"t477":[{"id":"1518a0af89c3","t":"孟子·公孙丑上 其29","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「不同道。非其君不事，非其民不使；治则进，乱则退，伯夷也。何事非君，何使非民；治亦进，乱亦进，伊尹也。可以仕则仕，可以止则止，可以久则久，可以速则速，孔子也。皆古圣人也，吾未能有行焉；乃所愿，则学孔子也。」","b":5,"y":-300,"th":["哲理","圣贤之道","处世哲学"],"ap":1}],"t486":[{"id":"1df8877a5438","t":"匪风","a":"佚名","d":1,"f":"诗经","g":"诗","x":"匪风发兮，匪车偈兮。顾瞻周道，中心怛兮。","b":0,"y":-750,"th":["思乡","伤国","怀古"],"ap":1}],"t495":[{"id":"268e9320006c","t":"论语·八佾篇 其11","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"或问禘之说。子曰：“不知也。知其说者之于天下也，其如示诸斯乎！”指其掌。","b":2,"y":-450,"th":["哲理","礼治","治国"],"ap":1}],"t507":[{"id":"2eb5eea6dbef","t":"孟子·梁惠王上 其40","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「挟太山以超北海，语人曰『我不能』，是诚不能也。为长者折枝，语人曰『我不能』，是不为也，非不能也。故王之不王，非挟太山以超北海之类也；王之不王，是折枝之类也。老吾老，以及人之老；幼吾幼，以及人之幼。天下可运于掌。《诗》云：『刑于寡妻，至于兄弟，以御于家邦。』言举斯心加诸彼而已。故推恩足以保四海，不推恩无以保妻子。古之人所以大过人者无他焉，善推其所为而已矣。今恩足以及禽兽，而功不至于百姓者，独何与？权，然后知轻重；度，然后知长短。物皆然，心为甚。王请度之！抑王兴甲兵，危士臣，构怨于诸侯，然后快于心与？」","b":4,"y":-320,"th":["仁政","推恩","民本","哲理"],"ap":1}],"t518":[{"id":"3a97bf49258d","t":"孟子·公孙丑上 其8","a":"孟子","d":1,"f":"文","g":"文","x":"公孙丑问曰：「夫子加齐之卿相，得行道焉，虽由此霸王不异矣。如此，则动心否乎？」","b":4,"y":-320,"th":["哲理","政治","心性修养"],"ap":1}],"t521":[{"id":"3d5d1696557c","t":"礼魂","a":"屈原","d":1,"f":"楚辞","g":"诗","x":"成礼兮会鼓，","b":5,"y":-290,"th":["祭祀","祈福","咏神"],"ap":1}],"t532":[{"id":"458a0c6020bf","t":"墙有茨","a":"佚名","d":1,"f":"诗经","g":"诗","x":"墙有茨，不可扫也。中冓之言，不可道也。所可道也，言之丑也。","b":1,"y":-650,"th":["讽刺","政治","宫闱"],"ap":1}],"t543":[{"id":"4e6590a142a7","t":"论语·述而篇 其29","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"互乡难与言，童子见，门人惑。子曰：“与其进也，不与其退也，唯何甚？人洁己以进，与其洁也，不保其往也。”","b":3,"y":-450,"th":["哲理","教育","包容"],"ap":1}],"t554":[{"id":"5c20e922c293","t":"论语·子路篇 其15","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"定公问：“一言而可以兴邦，有诸？”孔子对曰：“言不可以若是其几也。人之言曰：‘为君难，为臣不易。’如知为君之难也，不几乎一言而兴邦乎？”曰：“一言而丧邦，有诸？”孔子对曰：“言不可以若是其几也。人之言曰：‘予无乐乎为君，唯其言而莫予违也。’如其善而莫之违也，不亦善乎？如不善而莫之违也，不几乎一言而丧邦乎？”","b":1,"y":-500,"th":["哲理","治国","纳谏"],"ap":1}],"t590":[{"id":"8f36377effb9","t":"孟子·公孙丑上 其2","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「子诚齐人也，知管仲、晏子而已矣。或问乎曾西曰；『吾子与子路孰贤？』曾西蹴然曰：『吾先子之所畏也。』曰：『然则吾子与管仲孰贤？』曾西艴然不悦，曰：『尔何曾比予于管仲？管仲得君，如彼其专也；行乎国政，如彼其久也；功烈，如彼其卑也。尔何曾比予于是？』」曰：「管仲，曾西之所不为也，而子为我愿之乎？」","b":4,"y":-320,"th":["哲理","王霸之辩","儒家理想"],"ap":1}],"t626":[{"id":"b4eb088461cc","t":"孟子·梁惠王下 其53","a":"孟子","d":1,"f":"文","g":"文","x":"滕文公问曰：「滕，小国也，间于齐楚。事齐乎？事楚乎？」","b":5,"y":-320,"th":["政治","哲理","生存困境"],"ap":1}],"t635":[{"id":"bbde12927306","t":"论语·泰伯篇 其4","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"曾子有疾，孟敬子问之。曾子言曰：“鸟之将死，其鸣也哀；人之将死，其言也善。君子所贵乎道者三：动容貌，斯远暴慢矣；正颜色，斯近信矣；出辞气，斯远鄙倍矣。笾豆之事，则有司存。”","b":3,"y":-450,"th":["修身","哲理","临终遗言"],"ap":1}],"t640":[{"id":"c0cf584b273f","t":"孟子·公孙丑下 其47","a":"孟子","d":1,"f":"文","g":"文","x":"有欲为王留行者，坐而言。不应，隐几而卧。客不悦曰：「弟子齐宿而后敢言，夫子卧而不听，请勿复敢见矣。」","b":4,"y":-320,"th":["哲理","傲骨","辞行"],"ap":1}],"t679":[{"id":"e4f26c165293","t":"守志","a":"王逸","d":1,"f":"楚辞","g":"诗","x":"陟玉峦兮逍遥，览高冈兮峣峣。","b":5,"y":-300,"th":["忠贞","神游","咏怀","政治抱负"],"ap":1}],"t684":[{"id":"e7c5d2fccf1e","t":"论语·卫灵公篇 其11","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"颜渊问为邦，子曰：“行夏之时，乘殷之辂，服周之冕，乐则《韶》、《舞》；放郑声，远佞人。郑声淫，佞人殆。”","b":2,"y":-450,"th":["治国理政","礼乐文明","儒家哲理"],"ap":1}],"t693":[{"id":"ebaf6cf527cb","t":"北风","a":"佚名","d":1,"f":"诗经","g":"诗","x":"北风其凉，雨雪其雱。惠而好我，携手同行。其虚其邪？既亟只且！","b":0,"y":-700,"th":["政治怨刺","逃亡避祸","友谊"],"ap":1}],"t705":[{"id":"f63924c313c2","t":"素冠","a":"佚名","d":1,"f":"诗经","g":"诗","x":"庶见素冠兮，棘人栾栾兮。劳心慱慱兮。","b":0,"y":-750,"th":["悼亡","丧礼","情义"],"ap":1}],"t716":[{"id":"fca864b1d628","t":"孟子·公孙丑下 其52","a":"孟子","d":1,"f":"文","g":"文","x":"孟子去齐。充虞路问曰：「夫子若有不豫色然。前日虞闻诸夫子曰：『君子不怨天，不尤人。』」","b":4,"y":-320,"th":["哲理","抱负","忧民"],"ap":1}],"t749":[{"id":"34ce2d34e575","t":"相和歌辞 子夜春歌","a":"王翰","d":6,"f":"五律","g":"诗","x":"春气满林香，春游不可忘。","b":4,"y":750,"th":["春怨","闺思","边塞"],"ap":1}],"t770":[{"id":"6eb986709f8d","t":"舞曲歌辞 冬白纻歌","a":"元稹","d":6,"f":"古体","g":"诗","x":"吴宫夜长宫漏款，帘幕四垂灯焰暖。","b":9,"y":810,"th":["咏史","讽喻","荒淫"],"ap":1}],"t802":[{"id":"c1ce40d098d6","t":"杂曲歌辞 壮士行","a":"鲍溶","d":6,"f":"五古","g":"诗","x":"西方太白高，壮士羞病死。","b":9,"y":815,"th":["报恩","边塞","咏怀"],"ap":1}],"t811":[{"id":"d5b6cb5adfd9","t":"江雪","a":"柳宗元","d":6,"f":"五绝","g":"诗","x":"千山鸟飞绝，万径人踪灭。","b":8,"y":807,"th":["贬谪","孤高","冬景"],"ap":1}],"t828":[{"id":"0cdea2848118","t":"定风波令・定风波","a":"张先","d":8,"f":"词","g":"词","x":"西阁明呈奉诏行。","b":3,"y":1050,"th":["宴饮","酬赠","颂才","贺寿"],"ap":1}],"t837":[{"id":"3dc8f21f88fa","t":"鹤冲天","a":"柳永","d":8,"f":"词","g":"词","x":"黄金榜上。","b":2,"y":1030,"th":["落第","抒愤","爱情","人生"],"ap":1}],"t864":[{"id":"ae36ba56c7a7","t":"郭郎儿近拍","a":"柳永","d":8,"f":"词","g":"词","x":"帝里。","b":2,"y":1030,"th":["闲居","寂寞","羁旅"],"ap":1}],"t873":[{"id":"cd787798b625","t":"迷仙引","a":"柳永","d":8,"f":"词","g":"词","x":"才过笄年，初绾云鬟，便学歌舞。","b":3,"y":1045,"th":["爱情","女性命运","从良归隐"],"ap":1}],"t899":[{"id":"49aec99825a1","t":"诈妮子调风月・小桃红","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"燕燕上复传示煞曾经，谁会甚儿女成婚聘？甚的是许出羞、下红定？问这洛阳城，少甚么能言快语官媒证？燕燕怎敢假名托姓？但教我一权为政，情取\"火上等冬凌\"。","b":0,"y":1290,"th":["爱情","婚嫁","女性意识"],"ap":1}],"t925":[{"id":"d5c85a4bd561","t":"草桥店梦莺莺(第四本)・调笑令","a":"王实甫","d":9,"f":"曲","g":"曲","x":"你绣帏里效绸缪，倒凤颠鸾百事有。","b":0,"y":1301,"th":["爱情","委屈","调侃"],"ap":1}],"t936":[{"id":"ff13b324a5f5","t":"尾・我是个蒸不烂、煮不熟、捶不匾、炒不爆响当当一粒铜豌豆，恁子弟","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"每谁教你钻入他锄不断、斫不下、解不开、顿不脱慢腾腾千层锦套头。","b":0,"y":1290,"th":["咏怀","言志","放浪不羁"],"ap":1}],"t950":[{"id":"cb5d3e7cb63b","t":"忆秦娥·长飘泊","a":"纳兰性德","d":11,"f":"词","g":"词","x":"长飘泊，多愁多病心情恶","b":0,"y":1680,"th":["羁旅","愁病","伤叹"],"ap":1}]}