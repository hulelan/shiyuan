x":"者稀。","b":0,"y":1290,"th":["哲理","叹时","生死"],"ap":1}],"t161":[{"id":"dba33dcb8da7","t":"论语·阳货篇 其19","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“予欲无言。”子贡曰：“子如不言，则小子何述焉？”子曰：“天何言哉？四时行焉，百物生焉，天何言哉？”","b":1,"y":-500,"th":["哲理","教育","天道","自然"],"ap":1},{"id":"014523303f71","t":"中庸·中庸 其31","a":"子思（传）","d":1,"f":"文","g":"文","x":"仲尼祖述尧、舜，宪章文、武；上律天时，下袭水土。辟如天地之无不持载，无不复帱，辟如四时之错行，如日月之代明。万物并育而不相害，道并行而不相悖，小德川流，大德敦化，此天地之所以为大也。","b":4,"y":-430,"th":["哲理","咏人","天道"],"ap":1},{"id":"37fe6c039c07","t":"中庸·中庸 其12","a":"子思（传）","d":1,"f":"文","g":"文","x":"君子之道费而隐。夫妇之愚，可以与知焉，及其至也，虽圣人亦有所不知焉；夫妇之不肖，可以能行焉，及其至也，虽圣人亦有所不能焉。天地之大也，人犹有所憾，故君子语大，天下莫能载焉；语小，天下莫能破焉。《诗》云：『鸢飞戾天，鱼跃于渊。』言其上下察也。君子之道，造端乎夫妇，及其至也，察乎天地。」","b":4,"y":-430,"th":["哲理","修身","天道"],"ap":1},{"id":"cf8bc113ba19","t":"中庸·中庸 其25","a":"子思（传）","d":1,"f":"文","g":"文","x":"至诚之道，可以前知。国家将兴，必有祯祥；国家将亡，必有妖孽。见乎蓍龟，动乎四体。祸福将至：善，必先知之；不善，必先知之。故至诚如神。","b":4,"y":-430,"th":["哲理","修身","天道"],"ap":1},{"id":"8f62ec2271c9","t":"中庸·中庸 其27","a":"子思（传）","d":1,"f":"文","g":"文","x":"天地之道，可壹言而尽也。其为物不贰，则其生物不测。天地之道，博也厚也，高也明也，悠也久也。今夫天，斯昭昭之多，及其无穷也，日月星辰系焉，万物覆焉。今夫地，一撮土之多，及其广厚，载华岳而不重，振河海而不泄，万物载焉。今夫山，一拳石之多，及其广大，草木生之，禽兽居之，宝藏兴焉。今夫水，一勺之多，及其不测，鼋鼍、蛟龙、鱼鳖生焉，货财殖焉。《诗》云：「维天之命，於穆不已！」盖曰天之所以为天也。「於乎不显！文王之德之纯！」盖曰文王之所以为文也，纯亦不已。","b":4,"y":-400,"th":["哲理","天道","至诚无息","天人合一"],"ap":1},{"id":"7411bc9f22fd","t":"中庸·中庸 其33","a":"子思（传）","d":1,"f":"文","g":"文","x":"唯天下至诚，为能经纶天下之大经，立天下之大本，知天地之化育。夫焉有所倚？肫肫其仁！渊渊其渊！浩浩其天！苟不固聪明圣知达天德者，其孰能知之？","b":5,"y":-300,"th":["哲理","修身","天道"],"ap":1},{"id":"ff717278137a","t":"中庸·中庸 其26","a":"子思（传）","d":1,"f":"文","g":"文","x":"诚者自成也，而道自道也。诚者物之终始，不诚无物。是故君子诚之为贵。诚者非自成己而已也，所以成物也。成己，仁也；成物，知也。性之德也，合外内之道也，故时措之宜也。故至诚无息。不息则久，久则征，征则悠远，悠远则博厚，博厚则高明。博厚，所以载物也；高明，所以覆物也；悠久，所以成物也。博厚配地，高明配天，悠久无疆。如此者，不见而章，不动而变，无为而成。","b":5,"y":-300,"th":["哲理","修身","天道"],"ap":1},{"id":"148e845ca565","t":"唐享昊天乐 第三","a":"则天皇后","d":6,"f":"古体","g":"诗","x":"干仪混成冲邃，天道下济高明。","b":1,"y":690,"th":["祭祀","天道","虔诚"],"ap":1},{"id":"6ede075b5913","t":"郊庙歌辞 中宗祀昊天乐章 肃和","a":"不详","d":6,"f":"四言","g":"诗","x":"悠哉广覆，大矣曲成。","b":1,"y":705,"th":["祭祀","礼乐","天道"],"ap":1}],"t172":[{"id":"0b133ee67d65","t":"论语·述而篇 其2","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“默而识之，学而不厌，诲人不倦，何有于我哉？”","b":3,"y":-450,"th":["哲理","求学","教育"],"ap":1},{"id":"14b53516ad77","t":"论语·述而篇 其20","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“我非生而知之者，好古，敏以求之者也。”","b":3,"y":-450,"th":["哲理","修身","求学"],"ap":1},{"id":"2a28e64353a8","t":"论语·泰伯篇 其5","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"曾子曰：“以能问于不能；以多问于寡；有若无，实若虚，犯而不校。昔者吾友尝从事于斯矣。”","b":3,"y":-450,"th":["哲理","修身","求学"],"ap":1},{"id":"35cd7753ab81","t":"论语·子张篇 其22","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"卫公孙朝问于子贡曰：“仲尼焉学？”子贡曰：“文武之道未坠于地，在人。贤者识其大者，不贤者识其小者，莫不有文武之道焉，夫子焉不学？而亦何常师之有？”","b":2,"y":-450,"th":["哲理","求学","师道"],"ap":1},{"id":"456846ac3da7","t":"论语·泰伯篇 其12","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“三年学，不至于谷，不易得也。”","b":3,"y":-450,"th":["哲理","求学","修身"],"ap":1},{"id":"7db196508ada","t":"论语·学而篇 其14","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“君子食无求饱，居无求安，敏于事而慎于言，就有道而正焉。可谓好学也已。”","b":3,"y":-450,"th":["修身","哲理","求学"],"ap":1},{"id":"9f3031b8e7dd","t":"论语·子罕篇 其30","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“可与共学，未可与适道；可与适道，未可与立；可与立，未可与权。”","b":3,"y":-450,"th":["哲理","修身","求学"],"ap":1},{"id":"b5a2369519d8","t":"论语·为政篇 其17","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“由，诲汝知之乎！知之为知之，不知为不知，是知也。”","b":2,"y":-450,"th":["哲理","求学","修身"],"ap":1}],"t208":[{"id":"84d80e57b1ef","t":"近试上张籍水部","a":"朱庆余","d":6,"f":"七绝","g":"诗","x":"洞房昨夜停红烛，待晓堂前拜舅姑。","b":9,"y":826,"th":["爱情","科举","隐喻"],"ap":1},{"id":"07ddd944ac83","t":"长寿乐","a":"柳永","d":8,"f":"词","g":"词","x":"尤红殢翠。","b":1,"y":1020,"th":["爱情","科举","市井生活"],"ap":1},{"id":"267399190f69","t":"柳初新","a":"柳永","d":8,"f":"词","g":"词","x":"东郊向晓星杓亚。","b":0,"y":1020,"th":["春景","科举","咏都城"],"ap":1},{"id":"c6ba6b6c6ca9","t":"征部乐","a":"柳永","d":8,"f":"词","g":"词","x":"雅欢幽会，良辰可惜虚抛掷。","b":1,"y":1030,"th":["爱情","相思","科举"],"ap":1},{"id":"c424a4c41aa3","t":"感皇恩","a":"张先","d":8,"f":"词","g":"词","x":"万乘靴袍御紫宸。","b":2,"y":1040,"th":["科举","贺人","入仕"],"ap":1},{"id":"de9bd1ae8ab3","t":"少年游慢","a":"张先","d":8,"f":"词","g":"词","x":"春城三二月。","b":2,"y":1045,"th":["科举","得意","春景","纪游"],"ap":1},{"id":"f20cea14900a","t":"生查子","a":"陈亚","d":8,"f":"词","g":"词","x":"小院雨馀凉，石竹风生砌。","b":3,"y":1100,"th":["闺怨","思念","科举"],"ap":1}],"t217":[{"id":"282da55caa58","t":"载驰","a":"佚名","d":1,"f":"诗经","g":"诗","x":"载驰载驱，归唁卫侯。驱马悠悠，言至于漕。大夫跋涉，我心则忧。","b":1,"y":-700,"th":["爱国","咏怀","政治抱负"],"ap":1},{"id":"b61399d8abf6","t":"孟子·公孙丑下 其50","a":"孟子","d":1,"f":"文","g":"文","x":"高子以告。曰：「夫尹士恶知予哉？千里而见王，是予所欲也；不遇故去，岂予所欲哉？予不得已也。予三宿而出昼，于予心犹以为速。王庶几改之。王如改诸，则必反予。夫出昼而王不予追也，予然后浩然有归志。予虽然，岂舍王哉？王由足用为善。王如用予，则岂徒齐民安，天下之民举安。王庶几改之，予日望之。予岂若是小丈夫然哉？谏于其君而不受，则怒，悻悻然见于其面。去则穷日之力而后宿哉？」","b":4,"y":-320,"th":["政治抱负","进退之道","儒家人格","家国情怀"],"ap":1},{"id":"f5f084b62cc0","t":"孟子·公孙丑下 其23","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「夫既或治之，予何言哉？」","b":4,"y":-320,"th":["哲理","出处进退","政治抱负"],"ap":1},{"id":"e4f26c165293","t":"守志","a":"王逸","d":1,"f":"楚辞","g":"诗","x":"陟玉峦兮逍遥，览高冈兮峣峣。","b":5,"y":-300,"th":["忠贞","神游","咏怀","政治抱负"],"ap":1},{"id":"f36ab234fcd1","t":"相和歌辞 长歌续短歌","a":"李贺","d":6,"f":"五古","g":"诗","x":"长歌破衣襟，短歌断白发。","b":8,"y":810,"th":["怀才不遇","时光流逝","政治抱负"],"ap":1},{"id":"5c7d2b6c2b64","t":"沁园春","a":"张先","d":8,"f":"词","g":"词","x":"心膂良臣，帷幄元勋，左右万几。","b":2,"y":1050,"th":["赠别","政治抱负","归隐"],"ap":1}],"t222":[{"id":"7a6236de9176","t":"论语·八佾篇 其12","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"祭如在，祭神如神在。子曰：“吾不与祭，如不祭。”","b":2,"y":-450,"th":["哲理","礼制","诚敬"],"ap":1},{"id":"7af99eb9d497","t":"中庸·中庸 其16","a":"子思（传）","d":1,"f":"文","g":"文","x":"子曰：「鬼神之为德，其盛矣乎！视之而弗见，听之而弗闻，体物而不可遗。使天下之人齐明盛服，以承祭祀，洋洋乎如在其上，如在其左右。《诗》曰：『神之格思，不可度思！矧可射思！』夫微之显，诚之不可掩如此夫。」","b":4,"y":-400,"th":["哲理","祭祀","诚敬"],"ap":1},{"id":"66eaad58da7a","t":"郊庙歌辞 享惠昭太子庙乐章 请神","a":"归登","d":6,"f":"四言","g":"诗","x":"嘉荐既陈，祀事孔明。","b":5,"y":750,"th":["祭祀","礼乐","诚敬"],"ap":1},{"id":"7789b2fbb011","t":"郊庙歌辞 享太庙乐章 诚敬","a":"不详","d":6,"f":"四言","g":"诗","x":"顾惟菲质，忝位椒宫。","b":5,"y":750,"th":["祭祀","诚敬","宗法"],"ap":1},{"id":"78f3d9c2e183","t":"郊庙歌辞 享隐太子庙乐章 诚和","a":"不详","d":6,"f":"四言","g":"诗","x":"道閟鹤关，运缠鸠里。","b":5,"y":750,"th":["祭祀","天命","诚敬"],