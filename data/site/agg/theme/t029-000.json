[{"id":"a4e2cb5f8f91","t":"噫嘻","a":"佚名","d":1,"f":"诗经","g":"诗","x":"噫嘻成王，既昭假尔。率时农夫，播厥百谷。骏发尔私，终三十里。亦服尔耕，十千维耦。","b":0,"y":-1050,"th":["农事","颂歌","祭祀"],"ap":1},{"id":"fb0c7b5a8a5f","t":"天作","a":"佚名","d":1,"f":"诗经","g":"诗","x":"天作高山，大王荒之。彼作矣，文王康之。彼徂矣，岐有夷之行。子孙保之。","b":0,"y":-1050,"th":["咏史","颂祖","祭祀"],"ap":1},{"id":"401913f5e551","t":"思文","a":"佚名","d":1,"f":"诗经","g":"诗","x":"思文后稷，克配彼天。立我烝民，莫菲尔极。贻我来牟，帝命率育，无此疆尔界。陈常于时夏。","b":0,"y":-1050,"th":["咏物","怀古","祭祀"],"ap":1},{"id":"c7bd5c39d38c","t":"我将","a":"佚名","d":1,"f":"诗经","g":"诗","x":"我将我享，维羊维牛，维天其右之。仪式刑文王之典，日靖四方。","b":0,"y":-1050,"th":["祭祀","敬天法祖","治国"],"ap":1},{"id":"f9899ae6856d","t":"执竞","a":"佚名","d":1,"f":"诗经","g":"诗","x":"执竞武王，无竞维烈。不显成康，上帝是皇。自彼成康，奄有四方，斤斤其明。","b":0,"y":-1050,"th":["祭祀","咏史","颂德"],"ap":1},{"id":"42746c53943d","t":"有瞽","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有瞽有瞽，在周之庭。设业设虡，崇牙树羽。应田县鼓，鞉磬柷圉。既备","b":0,"y":-1050,"th":["祭祀","礼乐","颂歌"],"ap":1},{"id":"445be98712f9","t":"清庙","a":"佚名","d":1,"f":"诗经","g":"诗","x":"于穆清庙，肃雍显相。济济多士，秉文之德。对越在天，骏奔走在庙。不显不承，无射于人斯。","b":0,"y":-1050,"th":["祭祀","颂德","宗庙"],"ap":1},{"id":"78c759ab3d67","t":"维天之命","a":"佚名","d":1,"f":"诗经","g":"诗","x":"维天之命，于穆不已。于乎不显，文王之德之纯。假以溢我，我其收之。骏惠我文王，曾孙笃之。","b":0,"y":-1050,"th":["祭祀","颂德","天命"],"ap":1},{"id":"350284adda79","t":"维清","a":"佚名","d":1,"f":"诗经","g":"诗","x":"维清缉熙，文王之典。肇禋，迄用有成，维周之祯。","b":0,"y":-1050,"th":["祭祀","颂德","怀古"],"ap":1},{"id":"1c75e52d670f","t":"雝","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有来雝雝，至止肃肃。相维辟公，天子穆穆。于荐广牡，相予四祀。假哉皇考！绥予孝子。","b":0,"y":-1050,"th":["祭祀","颂祖","礼乐"],"ap":1},{"id":"bb978f1e6e19","t":"时迈","a":"佚名","d":1,"f":"诗经","g":"诗","x":"时迈其邦，昊天其子之，实右序有周。薄言震之，莫不震叠。怀柔百神，及河乔岳，允王维后。","b":0,"y":-1046,"th":["祭祀","咏史","治国"],"ap":1},{"id":"3469cf1b3e66","t":"武","a":"佚名","d":1,"f":"诗经","g":"诗","x":"于皇武王！无竞维烈。允文文王，克开厥后。嗣武受之，胜殷遏刘，耆定尔功。","b":0,"y":-1046,"th":["咏史","颂功","祭祀"],"ap":1},{"id":"c77619529c42","t":"赉","a":"佚名","d":1,"f":"诗经","g":"诗","x":"文王既勤止，我应受之。敷时绎思，我徂维求定。时周之命，于绎思。","b":0,"y":-1046,"th":["祭祀","颂歌","怀古"],"ap":1},{"id":"9e65cab984a0","t":"访落","a":"佚名","d":1,"f":"诗经","g":"诗","x":"访予落止，率时昭考。于乎悠哉，朕未有艾。将予就之，继犹判涣。","b":0,"y":-1042,"th":["咏史","政治","祭祀"],"ap":1},{"id":"262be2052fe7","t":"昊天有成命","a":"佚名","d":1,"f":"诗经","g":"诗","x":"昊天有成命，二后受之。成王不敢康，夙夜基命宥密。于缉熙！单厥心，四其靖之。","b":0,"y":-1022,"th":["颂歌","咏史","祭祀"],"ap":1},{"id":"c0708d754559","t":"丝衣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"丝衣其紑，载弁俅俅。自堂徂基，自羊徂牛，鼐鼎及鼒，兕觥其觩。旨酒思柔。不吴不敖，胡考之休。","b":0,"y":-908,"th":["祭祀","颂歌","祈福"],"ap":1},{"id":"7c1da9f91fce","t":"信南山","a":"佚名","d":1,"f":"诗经","g":"诗","x":"信彼南山，维禹甸之。畇畇原隰，曾孙田之。我疆我理，南东其亩。","b":0,"y":-908,"th":["农事","祭祀","颂祖"],"ap":1},{"id":"9cdbe00ccda7","t":"般","a":"佚名","d":1,"f":"诗经","g":"诗","x":"于皇时周！陟其高山，嶞山乔岳，允犹翕河。敷天之下，裒时之对。时周之命。","b":0,"y":-908,"th":["咏史","祭祀","家国"],"ap":1},{"id":"53c120efc59e","t":"载见","a":"佚名","d":1,"f":"诗经","g":"诗","x":"载见辟王，曰求厥章。龙旂阳阳，和铃央央。鞗革有鸧，休有烈光。率见昭考，以孝以享。","b":0,"y":-908,"th":["祭祀","朝会","礼乐"],"ap":1},{"id":"479166f7eb7a","t":"楚茨","a":"佚名","d":1,"f":"诗经","g":"诗","x":"楚楚者茨，言抽其棘，自昔何为？我蓺黍稷。我黍与与，我稷翼翼。","b":0,"y":-836,"th":["祭祀","宗族","祈福"],"ap":1},{"id":"5f16bb42f2a9","t":"凫鹥","a":"佚名","d":1,"f":"诗经","g":"诗","x":"凫鹥在泾，公尸在燕来宁。尔酒既清，尔肴既馨。公尸燕饮，福禄来成。","b":0,"y":-771,"th":["祭祀","宴饮","祈福","颂歌"],"ap":1},{"id":"290e3a99c65e","t":"大田","a":"佚名","d":1,"f":"诗经","g":"诗","x":"大田多稼，既种既戒，既备乃事。以我覃耜，俶载南亩。","b":0,"y":-771,"th":["田园","农事","祭祀"],"ap":1},{"id":"93974184a46d","t":"天保","a":"佚名","d":1,"f":"诗经","g":"诗","x":"天保定尔，亦孔之固。俾尔单厚，何福不除？俾尔多益，以莫不庶。","b":0,"y":-771,"th":["祝颂","祭祀","宴饮"],"ap":1},{"id":"4d276f2ca195","t":"既醉","a":"佚名","d":1,"f":"诗经","g":"诗","x":"既醉以酒，既饱以德。君子万年，介尔景福。","b":0,"y":-771,"th":["祭祀","宴饮","祝颂","祈福"],"ap":1},{"id":"b9b5bb5b76b7","t":"旱麓","a":"佚名","d":1,"f":"诗经","g":"诗","x":"瞻彼旱麓，榛楛济济。岂弟君子，干禄岂弟。","b":0,"y":-771,"th":["祭祀","颂德","咏物","哲理"],"ap":1},{"id":"6b6c68bdbae3","t":"良耜","a":"佚名","d":1,"f":"诗经","g":"诗","x":"畟畟良耜，俶载南亩。播厥百谷，实函斯活。或来瞻女，载筐及莒，其饟伊黍。","b":0,"y":-771,"th":["农事","祭祀","丰收"],"ap":1},{"id":"c5c56c5c5e32","t":"载芟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"载芟载柞，其耕泽泽。千耦其耘，徂隰徂畛。侯主侯伯，侯亚侯旅，侯彊侯以。","b":0,"y":-750,"th":["农事","祭祀","颂歌"],"ap":1},{"id":"60c4f34ff75e","t":"丰年","a":"佚名","d":1,"f":"诗经","g":"诗","x":"丰年多黍多稌，亦有高廪，万亿及秭。为酒为醴，烝畀祖妣。以洽百礼，降福孔皆。","b":0,"y":-700,"th":["农事","祭祀","颂歌"],"ap":1},{"id":"d864ea04d259","t":"殷武","a":"佚名","d":1,"f":"诗经","g":"诗","x":"挞彼殷武，奋伐荆楚。深入其阻，裒荆之旅。有截其所，汤孙之绪。","b":0,"y":-700,"th":["颂赞","咏史","祭祀"],"ap":1},{"id":"f0f935800541","t":"潜","a":"佚名","d":1,"f":"诗经","g":"诗","x":"猗与漆沮，潜有多鱼。有鳣有鲔，鲦鲿鰋鲤。以享以祀，以介景福。","b":0,"y":-700,"th":["祭祀","颂歌","咏物"],"ap":1},{"id":"d77c15e5c598","t":"烈文","a":"佚名","d":1,"f":"诗经","g":"诗","x":"烈文辟公，锡兹祉福。惠我无疆，子孙保之。无封靡于尔邦，维王其崇之。","b":0,"y":-700,"th":["祭祀","颂德","诫勉"],"ap":1},{"id":"6b53fdd4fd3d","t":"烈祖","a":"佚名","d":1,"f":"诗经","g":"诗","x":"嗟嗟烈祖！有秩斯祜。申锡无疆，及尔斯所。既载清酤，赉我思成。","b":0,"y":-700,"th":["祭祀","颂祖","祈福"],"ap":1},{"id":"5c92bd3bc35f","t":"甫田","a":"佚名","d":1,"f":"诗经","g":"诗","x":"倬彼甫田，岁取十千。我取其陈，食我农人。自古有年。","b":0,"y":-700,"th":["农事","祭祀","丰收"],"ap":1},{"id":"9dab1d281e8e","t":"那","a":"佚名","d":1,"f":"诗经","g":"诗","x":"猗与那与！置我鞉鼓。奏鼓简简，衎我烈祖。汤孙奏假，绥我思成。","b":1,"y":-700,"th":["祭祀","颂祖","礼乐"],"ap":1},{"id":"31530680e02a","t":"采蘋","a":"佚名","d":1,"f":"诗经","g":"诗","x":"于以采蘋？南涧之滨。于以采藻？于彼行潦。","b":1,"y":-700,"th":["祭祀","礼制","民俗"],"ap":1},{"id":"1656605a2d0d","t":"采蘩","a":"佚名","d":1,"f":"诗经","g":"诗","x":"于以采蘩？于沼于沚。于以用之？公侯之事。","b":1,"y":-700,"th":["祭祀","劳作","宫廷"],"ap":1},{"id":"0ea59649a955","t":"长发","a":"佚名","d":1,"f":"诗经","g":"诗","x":"浚哲维商，长发其祥。洪水芒芒，禹敷下土方。外大国是疆，幅陨既长。有娀方将，帝立子生商。","b":1,"y":-700,"th":["史诗","祭祀","咏史","颂德"],"ap":1},{"id":"de65697df98a","t":"玄鸟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"天命玄鸟，降而生商，宅殷土芒芒。古帝命武汤，正域彼四方。","b":1,"y":-650,"th":["祭祀","咏史","颂歌"],"ap":1},{"id":"b7290e300cd8","t":"论语·乡党篇 其7","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"齐，必有明衣，布。齐必变食，居必迁坐。","b":2,"y":-450,"th":["礼制","修身","祭祀"],"ap":1},{"id":"7af99eb9d497","t":"中庸·中庸 其16","a":"子思（传）","d":1,"f":"文","g":"文","x":"子曰：「鬼神之为德，其盛矣乎！视之而弗见，听之而弗闻，体物而不可遗。使天下之人齐明盛服，以承祭祀，洋洋乎如在其上，如在其左右。《诗》曰：『神之格思，不可度思！矧可射思！』夫微之显，诚之不可掩如此夫。」","b":4,"y":-400,"th":["哲理","祭祀","诚敬"],"ap":1},{"id":"4ac234d595f3","t":"东皇太一","a":"屈原","d":1,"f":"楚辞","g":"诗","x":"吉日兮辰良，穆将愉兮上皇","b":5,"y":-300,"th":["祭祀","神话","颂歌"],"ap":1},{"id":"e87c3601c056","t":"少司命","a":"屈原","d":1,"f":"楚辞","g":"诗","x":"秋兰兮麋芜，罗生兮堂下","b":5,"y":-300,"th":["祭祀","爱情","神话","离别"],"ap":1},{"id":"ff907b3fa0b6","t":"东君","a":"屈原","d":1,"f":"楚辞","g":"诗","x":"暾将出兮东方，照吾槛兮扶桑","b":5,"y":-290,"th":["神话","祭祀","咏物","英雄"],"ap":1},{"id":"aca59589abea","t":"云中君","a":"屈原","d":1,"f":"楚辞","g":"诗","x":"浴兰汤兮沐芳，华采衣兮若英","b":5,"y":-290,"th":["祭祀","咏物","神灵","抒怀"],"ap":1},{"id":"7248eddc19da","t":"河伯","a":"屈原","d":1,"f":"楚辞","g":"诗","x":"与女游兮九河，冲风起兮水扬波","b":5,"y":-290,"th":["祭祀","送别","神话"],"ap":1},{"id":"626d074802f7","t":"湘君","a":"屈原","d":1,"f":"楚辞","g":"诗","x":"君不行兮夷犹，蹇谁留兮中洲","b":5,"y":-290,"th":["爱情","祭祀","怀人"],"ap":1},{"id":"3d5d1696557c","t":"礼魂","a":"屈原","d":1,"f":"楚辞","g":"诗","x":"成礼兮会鼓，","b":5,"y":-290,"th":["祭祀","祈福","咏神"],"ap":1},{"id":"16b25935727a","t":"相和歌辞 祠渔山神女歌 迎神","a":"王维","d":6,"f":"古体","g":"诗","x":"坎坎击鼓，渔山之下。","b":1,"y":750,"th":["祭祀","楚辞体","期盼"],"ap":1},{"id":"d199b749c5ca","t":"相和歌辞 祠渔山神女歌 送神","a":"王维","d":6,"f":"古体","g":"诗","x":"纷进舞兮堂前，目眷眷兮琼筵。","b":1,"y":750,"th":["祭祀","送别","神话"],"ap":1},{"id":"6931c980b835","t":"相和歌辞 祠神歌 迎神","a":"王叡","d":6,"f":"七绝","g":"诗","x":"蓪草头花椰叶裙，蒲葵树下舞蛮云。","b":1,"y":750,"th":["祭祀","民俗","南国风光"],"ap":1},{"id":"93775392589b","t":"舞曲歌辞 章和二年中","a":"李贺","d":6,"f":"古体","g":"诗","x":"云萧素，风拂拂，麦芒如篲黍和粟。","b":3,"y":810,"th":["田园","盛世","祭祀"],"ap":1},{"id":"78c662b326bb","t":"导引","a":"和岘","d":8,"f":"词","g":"词","x":"气和玉烛，睿化著鸿明。","b":0,"y":965,"th":["颂圣","祭祀","盛世"],"ap":1},{"id":"4b37c93ad5fb","t":"六州","a":"和岘","d":8,"f":"词","g":"词","x":"严夜警，铜莲漏迟迟。","b":2,"y":1100,"th":["祭祀","颂德","宫廷乐章"],"ap":1},{"id":"5c977b44194c","t":"十二时・忆少年","a":"和岘","d":8,"f":"词","g":"词","x":"承宝运，驯致隆平。","b":2,"y":1100,"th":["宫廷","祭祀","颂德","太平"],"ap":1}]