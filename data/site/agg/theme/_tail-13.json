:6,"f":"七绝","g":"诗","x":"霜满中庭月过楼，金尊玉柱对清秋。","b":8,"y":801,"th":["行乐","少年游侠","秋夜"],"ap":1},{"id":"3cf4f38e1a6e","t":"女冠子","a":"柳永","d":8,"f":"词","g":"词","x":"断云残雨。","b":2,"y":1030,"th":["爱情","秋夜","相思"],"ap":1},{"id":"4a6aadccc2ed","t":"佳人醉","a":"柳永","d":8,"f":"词","g":"词","x":"暮景萧萧雨霁。","b":2,"y":1035,"th":["爱情","相思","秋夜","怀人"],"ap":1},{"id":"cd2ace190ebc","t":"天仙子·渌水亭秋夜","a":"纳兰性德","d":11,"f":"词","g":"词","x":"水浴凉蟾风入袂，鱼鳞蹙损金波碎","b":0,"y":1670,"th":["秋夜","愁绪","咏景"],"ap":1},{"id":"0bbde0fb41cc","t":"采桑子·彤霞久绝飞琼字","a":"纳兰性德","d":11,"f":"词","g":"词","x":"彤霞久绝飞琼字，人在谁边","b":0,"y":1680,"th":["爱情","相思","秋夜"],"ap":1},{"id":"5d36a4eba0ff","t":"采桑子·拨灯书尽红笺也","a":"纳兰性德","d":11,"f":"词","g":"词","x":"拨灯书尽红笺也，依旧无聊","b":0,"y":1680,"th":["爱情","相思","秋夜"],"ap":1},{"id":"c19bf8dc6294","t":"中元前一夕枕上偶成","a":"纳兰性德","d":11,"f":"词","g":"词","x":"酒醒池塘耿不眠，帐纹漠漠隔轻烟","b":0,"y":1680,"th":["思乡","羁旅","秋夜","边塞"],"ap":1},{"id":"cf85d13c428e","t":"虞美人·秋夕信步","a":"纳兰性德","d":11,"f":"词","g":"词","x":"愁痕满地无人省，露湿琅玕影","b":0,"y":1680,"th":["爱情","悼亡","秋夜","孤独"],"ap":1}],"t149":[{"id":"2204cfdfaef0","t":"中庸·中庸 其1","a":"子思（传）","d":1,"f":"文","g":"文","x":"天命之谓性，率性之谓道，修道之谓教。道也者，不可须臾离也，可离非道也。是故君子戒慎乎其所不睹，恐惧乎其所不闻。莫见乎隐，莫显乎微。故君子慎其独也。喜怒哀乐之未发，谓之中；发而皆中节，谓之和；中也者，天下之大本也；和也者，天下之达道也。致中和，天地位焉，万物育焉。","b":4,"y":-400,"th":["哲理","修身","心性"],"ap":1},{"id":"7103836bb75d","t":"中庸·中庸 其24","a":"子思（传）","d":1,"f":"文","g":"文","x":"其次致曲。曲能有诚，诚则形，形则著，著则明，明则动，动则变，变则化。唯天下至诚为能化。","b":4,"y":-400,"th":["哲理","修身","心性"],"ap":1},{"id":"15cbad4f0c75","t":"孟子·梁惠王上 其35","a":"孟子","d":1,"f":"文","g":"文","x":"王说曰：「《诗》云：『他人有心，予忖度之。』夫子之谓也。夫我乃行之，反而求之，不得吾心。夫子言之，于我心有戚戚焉。此心之所以合于王者，何也？」","b":4,"y":-320,"th":["哲理","仁政","心性"],"ap":1},{"id":"196f32aa83c6","t":"孟子·公孙丑上 其14","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「敢问夫子之不动心，与告子之不动心，可得闻与？」","b":4,"y":-320,"th":["哲理","心性","师道"],"ap":1},{"id":"6b4ee9cdd85b","t":"孟子·公孙丑上 其16","a":"孟子","d":1,"f":"文","g":"文","x":"「既曰『志至焉，气次焉』，又曰『持其志无暴其气』者，何也？」","b":4,"y":-320,"th":["哲理","修身","心性"],"ap":1},{"id":"77ab591309e6","t":"孟子·公孙丑上 其15","a":"孟子","d":1,"f":"文","g":"文","x":"「告子曰：『不得于言，勿求于心；不得于心，勿求于气。』不得于心，勿求于气，可；不得于言，勿求于心，不可。夫志，气之帅也；气，体之充也。夫志至焉，气次焉。故曰：『持其志，无暴其气。』」","b":4,"y":-320,"th":["哲理","心性","修身"],"ap":1}],"t156":[{"id":"aa860bc62b54","t":"民劳","a":"佚名","d":1,"f":"诗经","g":"诗","x":"民亦劳止，汔可小康。惠此中国，以绥四方。无纵诡随，以谨无良。","b":0,"y":-850,"th":["忧国忧民","政治讽喻","劝谏"],"ap":1},{"id":"a7f33f9f9e0d","t":"孟子·梁惠王上 其6","a":"孟子","d":1,"f":"文","g":"文","x":"孟子对曰：「王好战，请以战喻。填然鼓之，兵刃既接，弃甲曳兵而走。或百步而后止，或五十步而后止。以五十步笑百步，则何如？」","b":4,"y":-320,"th":["哲理","政治","劝谏"],"ap":1},{"id":"b13a3223ffd9","t":"孟子·梁惠王下 其21","a":"孟子","d":1,"f":"文","g":"文","x":"「昔者齐景公问于晏子曰：『吾欲观于转附、朝儛，遵海而南，放于琅邪。吾何修而可以比于先王观也？』晏子对曰：『善哉问也！天子适诸侯曰巡狩，巡狩者巡所守也；诸侯朝于天子曰述职，述职者述所职也。无非事者。春省耕而补不足，秋省敛而助不给。夏谚曰：「吾王不游，吾何以休？吾王不豫，吾何以助？一游一豫，为诸侯度。」今也不然：师行而粮食，饥者弗食，劳者弗息。睊睊胥谗，民乃作慝。方命虐民，饮食若流。流连荒亡，为诸侯忧。从流下而忘反谓之流，从流上而忘反谓之连，从兽无厌谓之荒，乐酒无厌谓之亡。先王无流连之乐，荒亡之行。惟君所行也。』景公说，大戒于国，出舍于郊。于是始兴发补不足。召大师曰：『为我作君臣相说之乐！』盖征招角招是也。其诗曰：『畜君何尤？』畜君者，好君也。」","b":4,"y":-320,"th":["仁政","民本","劝谏","哲理"],"ap":1},{"id":"fadd444ae47d","t":"孟子·梁惠王上 其28","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「臣闻之胡龁曰，王坐于堂上，有牵牛而过堂下者，王见之，曰：『牛何之？』对曰：『将以衅钟。』王曰：『舍之！吾不忍其觳觫，若无罪而就死地。』对曰：『然则废衅钟与？』曰：『何可废也？以羊易之！』不识有诸？」","b":4,"y":-320,"th":["哲理","仁政","劝谏"],"ap":1},{"id":"ea2957cda954","t":"孟子·公孙丑下 其17","a":"孟子","d":1,"f":"文","g":"文","x":"他日，见于王曰：「王之为都者，臣知五人焉。知其罪者，惟孔距心。为王诵之。」王曰：「此则寡人之罪也。」","b":5,"y":-317,"th":["哲理","政治","劝谏"],"ap":1},{"id":"437a6779be95","t":"孟子·滕文公下 其1","a":"孟子","d":1,"f":"文","g":"文","x":"陈代曰：「不见诸侯，宜若小然；今一见之，大则以王，小则以霸。且志曰：『枉尺而直寻』，宜若可为也。」","b":5,"y":-300,"th":["哲理","劝谏","义利之辨"],"ap":1}],"t185":[{"id":"1880fd93de30","t":"何草不黄","a":"佚名","d":1,"f":"诗经","g":"诗","x":"何草不黄？何日不行？何人不将？经营四方。","b":0,"y":-908,"th":["征役","哀怨","民生疾苦"],"ap":1},{"id":"31faf5e433ba","t":"苕之华","a":"佚名","d":1,"f":"诗经","g":"诗","x":"苕之华，芸其黄矣。心之忧矣，维其伤矣！","b":0,"y":-700,"th":["哀怨","纪实","民生疾苦"],"ap":1},{"id":"785956f62569","t":"鸿雁","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鸿雁于飞，肃肃其羽。之子于征，劬劳于野。爰及矜人，哀此鳏寡。","b":1,"y":-700,"th":["劳役","咏物","民生疾苦","怀才不遇"],"ap":1},{"id":"b7c784d8c527","t":"候人","a":"佚名","d":