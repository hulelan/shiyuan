29","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“知者不惑，仁者不忧，勇者不惧。”","b":2,"y":-450,"th":["哲理","修身","人格"],"ap":1},{"id":"92468485305b","t":"中庸·中庸 其10","a":"子思（传）","d":1,"f":"文","g":"文","x":"子路问强。子曰：「南方之强与？北方之强与？抑而强与？宽柔以教，不报无道，南方之强也，君子居之。衽金革，死而不厌，北方之强也，而强者居之。故君子和而不流，强哉矫！中立而不倚，强哉矫！国有道，不变塞焉，强哉矫！国无道，至死不变，强哉矫！」","b":4,"y":-350,"th":["哲理","修身","人格"],"ap":1}],"t387":[{"id":"e1ba1a701afe","t":"郊庙歌辞 享太庙乐章 凯安四章 三","a":"张说","d":6,"f":"四言","g":"诗","x":"总总干戚，填填鼓钟。","b":2,"y":725,"th":["礼乐/颂德/宫廷"],"ap":1},{"id":"1c37d9b90675","t":"郊庙歌辞 中宗祀昊天乐章 中宫助祭升坛","a":"不详","d":6,"f":"五律","g":"诗","x":"坤元光至德，柔训阐皇风。","b":5,"y":750,"th":["礼乐/颂德/宫廷"],"ap":1},{"id":"bc14de325efa","t":"郊庙歌辞 朝日乐章 舒和","a":"不详","d":6,"f":"七绝","g":"诗","x":"崇牙树羽延调露，旋宫扣律掩承云。","b":5,"y":750,"th":["礼乐/颂德/宫廷"],"ap":1}],"t394":[{"id":"b12a86b2a47e","t":"相和歌辞 江南曲","a":"丁仙芝","d":6,"f":"五古","g":"诗","x":"长干斜路北，近浦是儿家。","b":3,"y":730,"th":["爱情","水乡","民歌"],"ap":1},{"id":"4edff2df72ef","t":"相和歌辞 栖乌曲二首 二","a":"刘方平","d":6,"f":"七绝","g":"诗","x":"画舸双艚锦为缆，芙蓉花发莲叶暗。","b":7,"y":790,"th":["爱情","月夜","水乡"],"ap":1},{"id":"48a07412c98e","t":"武陵春","a":"张先","d":8,"f":"词","g":"词","x":"秋染青溪天外水，风棹采菱还。","b":2,"y":1050,"th":["爱情","田园","水乡"],"ap":1}],"t400":[{"id":"b5a534316840","t":"横吹曲辞 前出塞九首 二","a":"杜甫","d":6,"f":"五律","g":"诗","x":"出门日已远，不受徒旅欺。","b":4,"y":747,"th":["边塞","忠勇","战争"],"ap":1},{"id":"7e8c90201d45","t":"横吹曲辞 入塞曲 二","a":"沈彬","d":6,"f":"七律","g":"诗","x":"苦战沙间卧箭痕，戍楼闲上望星文。","b":4,"y":750,"th":["边塞","忠勇","悲悯"],"ap":1},{"id":"eba76c5d0b61","t":"横吹曲辞 入塞曲 一","a":"沈彬","d":6,"f":"古体","g":"诗","x":"欲为皇王服远戎，万人金甲鼓鼙中。","b":4,"y":750,"th":["边塞","战争","忠勇","悲悯"],"ap":1}],"t413":[{"id":"f8658c80e772","t":"琴曲歌辞 明月引","a":"卢照邻","d":6,"f":"古体","g":"诗","x":"洞庭波起兮鸿鴈翔，风瑟瑟兮野苍苍。","b":0,"y":665,"th":["羁旅思乡","边塞","闺怨"],"ap":1},{"id":"a4a7beca221e","t":"水龙吟·夜来风雨匆匆","a":"程垓","d":8,"f":"词","g":"词","x":"夜来风雨匆匆，故园定是花无几。","b":0,"th":["感时伤逝","羁旅思乡","人生感慨"],"ap":1},{"id":"dfe600ba9429","t":"水龙吟·楚天千里清秋","a":"辛弃疾","d":8,"f":"词","g":"词","x":"楚天千里清秋，水随天去秋无际。","b":3,"y":1174,"th":["怀古","壮志难酬","羁旅思乡"],"ap":1}],"t466":[{"id":"5db44bed695e","t":"论语·卫灵公篇 其36","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“当仁不让于师。”","b":2,"y":-450,"th":["哲理","仁道","担当"],"ap":1},{"id":"52111429e4b5","t":"孟子·公孙丑下 其53","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「彼一时，此一时也。五百年必有王者兴，其间必有名世者。由周而来，七百有余岁矣。以其数则过矣，以其时考之则可矣。夫天，未欲平治天下也；如欲平治天下，当今之世，舍我其谁也？吾何为不豫哉？」","b":4,"y":-320,"th":["哲理","抱负","担当"],"ap":1}],"t479":[{"id":"824cee8e2ba3","t":"谷风","a":"佚名","d":1,"f":"诗经","g":"诗","x":"习习谷风，以阴以雨。黾勉同心，不宜有怒。采葑采菲，无以下体？德音莫违，及尔同死。","b":0,"y":-1050,"th":["弃妇","婚姻","怨情","对比"],"ap":1},{"id":"7fa17daa2b49","t":"论语·卫灵公篇 其21","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“君子求诸己，小人求诸人。”","b":2,"y":-480,"th":["哲理","修身","对比"],"ap":1}],"t488":[{"id":"a7a8f73cd9ce","t":"论语·阳货篇 其9","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“小子何莫学夫《诗》？《诗》可以兴，可以观，可以群，可以怨。迩之事父，远之事君，多识于鸟兽草木之名。”","b":1,"y":-500,"th":["诗教","哲理","修身"],"ap":1},{"id":"973d8232b53c","t":"论语·为政篇 其2","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“《诗》三百，一言以蔽之，曰：‘思无邪’。”","b":2,"y":-450,"th":["哲理","诗教"],"ap":1}],"t509":[{"id":"76e8592e46fa","t":"郊庙歌辞 仪坤庙乐章 安和","a":"刘子玄","d":6,"f":"五律","g":"诗","x":"妙筭申帷幄，神谋及庙庭。","b":5,"y":750,"th":["颂德","军功","盛世"],"ap":1},{"id":"135c05227487","t":"鼓吹曲辞 鼓吹铙歌 东蛮","a":"柳宗元","d":6,"f":"古体","g":"诗","x":"东蛮有谢氏，冠带理海中。","b":8,"y":809,"th":["边塞","颂德","民族","军功"],"ap":1}],"t516":[{"id":"1e97cd4f6642","t":"夜月","a":"刘方平","d":6,"f":"七绝","g":"诗","x":"更深月色半人家，北斗阑干南斗斜。","b":7,"y":790,"th":["春夜","田园","物候"],"ap":1},{"id":"6ccde2b4c934","t":"秦楼月・忆秦娥·楼阴缺","a":"范成大","d":8,"f":"词","g":"词","x":"楼阴缺。","b":0,"th":["思乡","春夜","梦境"],"ap":1}],"t563":[{"id":"f6fe0229ac60","t":"郊庙歌辞 武后明堂乐章 商音","a":"武则天","d":6,"f":"四言","g":"诗","x":"律中夷则，序应收成。","b":1,"y":696,"th":["礼乐/祭祀","时序/农事","政治颂德"],"ap":1},{"id":"a374506affd5","t":"郊庙歌辞 祭神州乐章 迎神","a":"不详","d":6,"f":"四言","g":"诗","x":"黄舆厚载，赤寰归德。","b":6,"y":750,"th":["祭祀","礼乐","政治颂德"],"ap":1}],"t570":[{"id":"cf7754000fc3","t":"横吹曲辞 入塞曲","a":"耿[𣲗]","d":6,"f":"五古","g":"诗","x":"将军带十围，重锦制戎衣。","b":4,"y":750,"th":["边塞","怀才不遇","英雄迟暮"],"ap":1},{"id":"f250dcbedb58","t":"相和歌辞 燕歌行","a":"陶翰","d":6,"f":"古体","g":"诗","x":"请君留楚调，听我吟燕歌。","b":4,"y":750,"th":["边塞","怀才不遇","世态炎凉","英雄迟暮"],"ap":1}],"t581":[{"id":"6d6255bd63ac","t":"菩萨蛮","a":"张先","d":8,"f":"词","g":"词","x":"夜深不至春蟾见。","b":2,"y":1040,"th":["爱情","闺怨","等待"],"ap":1},{"id":"9ffe7573e733","t":"幺・铜壶玉漏催凄切，正更阑人静也。金闺潇洒转伤嗟，莲步轻移呼侍妾：","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"“把香桌儿安排打快些。","b":0,"y":1290,"th":["闺怨","夜思","等待"],"ap":1}],"t602":[{"id":"0e2e3a746b3f","t":"论语·乡党篇 其5","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"执圭，鞠躬如也，如不胜。上如揖，下如授。勃如战色，足蹜蹜如有循。享礼，有容色。私觌，愉愉如也。","b":2,"y":-450,"th":["礼仪","外交","修身"],"ap":1}],"t615":[{"id":"1518a0af89c3","t":"孟子·公孙丑上 其29","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「不同道。非其君不事，非其民不使；治则进，乱则退，伯夷也。何事非君，何使非民；治亦进，乱亦进，伊尹也。可以仕则仕，可以止则止，可以久则久，可以速则速，孔子也。皆古圣人也，吾未能有行焉；乃所愿，则学孔子也。」","b":5,"y":-300,"th":["哲理","圣贤之道","处世哲学"],"ap":1}],"t628":[{"id":"2595647f9177","t":"论语·雍也篇 其26","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"宰我问曰：“仁者，虽告之曰：‘井有仁焉。’其从之也？”子曰：“何为其然也？君子可逝也，不可陷也；可欺也，不可罔也。”","b":3,"y":-450,"th":["哲理","仁智","修身"],"ap":1}],"t651":[{"id":"33f5c0bf1a7a","t":"论语·子张篇 其25","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"陈子禽谓子贡曰：“子为恭也，仲尼岂贤于子乎？”子贡曰：“君子一言以为知，一言以为不知，言不可不慎也。夫子之不可及也，犹天之不可阶而升也。夫子之得邦家者，所谓立之斯立，道之斯行，绥之斯来，动之斯和。其生也荣，其死也哀，如之何其可及也？”","b":2,"y":-450,"th":["哲理","尊师","崇儒"],"ap":1}],"t664":[{"id":"44a2b31cf11c","t":"论语·先进篇 其23","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子畏于匡，颜渊后。子曰：“吾以女为死矣！”曰：“子在，回何敢死！”","b":1,"y":-496,"th":["师生情谊","哲理","患难"],"ap":1}],"t677":[{"id":"4c4bc11dcc4e","t":"君子阳阳","a":"佚名","d":1,"f":"诗经","g":"诗","x":"君子阳阳，左执簧，右招我由房，其乐只且！","b":0,"y":-700,"th":["燕乐","欢舞","友谊"],"ap":1}],"t718":[{"id":"865da1a7e103","t":"车攻","a":"佚名","d":1,"f":"诗经","g":"诗","x":"我车既攻，我马既同。四牡庞庞，驾言徂东。","b":0,"y":-950,"th":["田猎","颂歌","军威"],"ap":1}],"t725":[{"id":"8f62ec2271c9","t":"中庸·中庸 其27","a":"子思（传）","d":1,"f":"文","g":"文","x":"天地之道，可壹言而尽也。其为物不贰，则其生物不测。天地之道，博也厚也，高也明也，悠也久也。今夫天，斯昭昭之多，及其无穷也，日月星辰系焉，万物覆焉。今夫地，一撮土之多，及其广厚，载华岳而不重，振河海而不泄，万物载焉。今夫山，一拳石之多，及其广大，草木生之，禽兽居之，宝藏兴焉。今夫水，一勺之多，及其不测，鼋鼍、蛟龙、鱼鳖生焉，货财殖焉。《诗》云：「维天之命，於穆不已！」盖曰天之所以为天也。「於乎不显！文王之德之纯！」盖曰文王之所以为文也，纯亦不已。","b":4,"y":-400,"th":["哲理","天道","至诚无息","天人合一"],"ap":1}],"t732":[{"id":"9f62f1c54479","t":"孟子·离娄上 其5","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「规矩，方员之至也；圣人，人伦之至也。欲为君尽君道，欲为臣尽臣道，二者皆法尧舜而已矣。不以舜之所以事尧事君，不敬其君者也；不以尧之所以治民治民，贼其民者也。孔子曰：『道二：仁与不仁而已矣。』暴其民甚，则身弑国亡；不甚，则身危国削。名之曰『幽厉』，虽孝子慈孙，百世不能改也。《诗》云『殷鉴不远，在夏后之世』，此之谓也。」","b":5,"y":-320,"th":["哲理","治国","仁政","重民"],"ap":1}],"t747":[{"id":"acad1f0f2ca0","t":"论语·八佾篇 其25","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子谓《韶》：“尽美矣，又尽善也。”谓《武》：“尽美矣，未尽善也。”","b":2,"y":-450,"th":["哲理","文艺","仁政"],"ap":1}],"t754":[{"id":"b61399d8abf6","t":"孟子·公孙丑下 其50","a":"孟子","d":1,"f":"文","g":"文","x":"高子以告。曰：「夫尹士恶知予哉？千里而见王，是予所欲也；不遇故去，岂予所欲哉？予不得已也。予三宿而出昼，于予心犹以为速。王庶几改之。王如改诸，则必反予。夫出昼而王不予追也，予然后浩然有归志。予虽然，岂舍王哉？王由足用为善。王如用予，则岂徒齐民安，天下之民举安。王庶几改之，予日望之。予岂若是小丈夫然哉？谏于其君而不受，则怒，悻悻然见于其面。去则穷日之力而后宿哉？」","b":4,"y":-320,"th":["政治抱负","进退之道","儒家人格","家国情怀"],"ap":1}],"t761":[{"id":"bbde12927306","t":"论语·泰伯篇 其4","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"曾子有疾，孟敬子问之。曾子言曰：“鸟之将死，其鸣也哀；人之将死，其言也善。君子所贵乎道者三：动容貌，斯远暴慢矣；正颜色，斯近信矣；出辞气，斯远鄙倍矣。笾豆之事，则有司存。”","b":3,"y":-450,"th":["修身","哲理","临终遗言"],"ap":1}],"t783":[{"id":"d0ab6773a88c","t":"孟子·公孙丑上 其9","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「否。我四十不动心。」","b":4,"y":-320,"th":["哲理","修身","境界"],"ap":1}],"t790":[{"id":"d9687b54afca","t":"孟子·公孙丑下 其5","a":"孟子","d":1,"f":"文","g":"文","x":"不得已而之景丑氏宿焉。景子曰：「内则父子，外则君臣，人之大伦也。父子主恩，君臣主敬。丑见王之敬子也，未见所以敬王也。」","b":4,"y":-320,"th":["哲理","君臣","人格独立"],"ap":1}],"t826":[{"id":"f63924c313c2","t":"素冠","a":"佚名","d":1,"f":"诗经","g":"诗","x":"庶见素冠兮，棘人栾栾兮。劳心慱慱兮。","b":0,"y":-750,"th":["悼亡","丧礼","情义"],"ap":1}],"t839":[{"id":"fee982b24535","t":"四月","a":"佚名","d":1,"f":"诗经","g":"诗","x":"四月维夏，六月徂署。先祖匪人，胡宁忍予？","b":0,"y":-700,"th":["乱离之苦","仕途之怨","告哀"],"ap":1}],"t840":[{"id":"fee982b24535","t":"四月","a":"佚名","d":1,"f":"诗经","g":"诗","x":"四月维夏，六月徂署。先祖匪人，胡宁忍予？","b":0,"y":-700,"th":["乱离之苦","仕途之怨","告哀"],"ap":1}],"t853":[{"id":"04a95e7c57ea","t":"郊庙歌辞 封泰山乐章 舒和","a":"张说","d":6,"f":"七绝","g":"诗","x":"六钟翕协六变成，八佾倘佯八风生。","b":