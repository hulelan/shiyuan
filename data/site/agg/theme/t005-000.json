[{"id":"401913f5e551","t":"思文","a":"佚名","d":1,"f":"诗经","g":"诗","x":"思文后稷，克配彼天。立我烝民，莫菲尔极。贻我来牟，帝命率育，无此疆尔界。陈常于时夏。","b":0,"y":-1050,"th":["咏物","怀古","祭祀"],"ap":1},{"id":"9bf2cc165731","t":"甘棠","a":"佚名","d":1,"f":"诗经","g":"诗","x":"蔽芾甘棠，勿翦勿伐，召伯所茇。","b":0,"y":-1050,"th":["怀古","咏物"],"ap":1},{"id":"350284adda79","t":"维清","a":"佚名","d":1,"f":"诗经","g":"诗","x":"维清缉熙，文王之典。肇禋，迄用有成，维周之祯。","b":0,"y":-1050,"th":["祭祀","颂德","怀古"],"ap":1},{"id":"5b1f97faba9a","t":"桓","a":"佚名","d":1,"f":"诗经","g":"诗","x":"绥万邦，屡丰年。天命匪解，桓桓武王。保有厥士，于以四方，克定厥家。于昭于天，皇以间之。","b":0,"y":-1046,"th":["颂赞","怀古","军旅"],"ap":1},{"id":"c77619529c42","t":"赉","a":"佚名","d":1,"f":"诗经","g":"诗","x":"文王既勤止，我应受之。敷时绎思，我徂维求定。时周之命，于绎思。","b":0,"y":-1046,"th":["祭祀","颂歌","怀古"],"ap":1},{"id":"66818a17e489","t":"荡","a":"佚名","d":1,"f":"诗经","g":"诗","x":"荡荡上帝，下民之辟。疾威上帝，其命多辟。","b":0,"y":-908,"th":["咏史","怀古","哲理"],"ap":1},{"id":"be5438d7322d","t":"小宛","a":"佚名","d":1,"f":"诗经","g":"诗","x":"宛彼鸣鸠，翰飞戾天。我心忧伤，念昔先人。明发不寐，有怀二人。","b":0,"y":-800,"th":["怀古","教子","忧患","哲理"],"ap":1},{"id":"71a776b5f918","t":"常武","a":"佚名","d":1,"f":"诗经","g":"诗","x":"赫赫明明。王命卿士，南仲大祖，大师皇父。整我六师，以修我戎。既敬既戒，惠此南国。","b":0,"y":-800,"th":["战争","颂歌","军旅","怀古"],"ap":1},{"id":"aac59adf28c6","t":"都人士","a":"佚名","d":1,"f":"诗经","g":"诗","x":"彼都人士，狐裘黄黄。其容不改，出言有章。行归于周，万民所望。","b":0,"y":-770,"th":["怀古","故国之思","伤时"],"ap":1},{"id":"1df8877a5438","t":"匪风","a":"佚名","d":1,"f":"诗经","g":"诗","x":"匪风发兮，匪车偈兮。顾瞻周道，中心怛兮。","b":0,"y":-750,"th":["思乡","伤国","怀古"],"ap":1},{"id":"a7576cb8dcf0","t":"召旻","a":"佚名","d":1,"f":"诗经","g":"诗","x":"旻天疾威，天笃降丧。瘨我饥馑，民卒流亡。我居圉卒荒。","b":0,"y":-750,"th":["忧国","怀古","讽谏"],"ap":1},{"id":"fb883494b4f4","t":"黍离","a":"佚名","d":1,"f":"诗经","g":"诗","x":"彼黍离离，彼稷之苗。行迈靡靡，中心摇摇。知我者，谓我心忧；不知我者，谓我何求。悠悠苍天，此何人哉？","b":0,"y":-750,"th":["怀古","咏史","家国"],"ap":1},{"id":"6fb100f8a178","t":"酌","a":"佚名","d":1,"f":"诗经","g":"诗","x":"于铄王师，遵养时晦。时纯熙矣，是用大介。我龙受之，蹻蹻王之造。载用有嗣，实维尔公允师。","b":1,"y":-700,"th":["战争","颂歌","怀古"],"ap":1},{"id":"632cdfaa598a","t":"鼓钟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鼓钟将将，淮水汤汤，忧心且伤。淑人君子，怀允不忘。","b":1,"y":-700,"th":["伤时","怀古","咏乐"],"ap":1},{"id":"b33bdc927c62","t":"清人","a":"佚名","d":1,"f":"诗经","g":"诗","x":"清人在彭，驷介旁旁。二矛重英，河上乎翱翔。","b":1,"y":-650,"th":["讽刺","军旅","怀古"],"ap":1},{"id":"17172b59b2f7","t":"竹竿","a":"佚名","d":1,"f":"诗经","g":"诗","x":"籊籊竹竿，以钓于淇。岂不尔思？远莫致之。","b":1,"y":-650,"th":["思乡","闺怨","怀古"],"ap":1},{"id":"b573a3ccec9c","t":"简兮","a":"佚名","d":1,"f":"诗经","g":"诗","x":"简兮简兮，方将万舞。日之方中，在前上处。","b":1,"y":-650,"th":["赞美","怀古","思慕"],"ap":1},{"id":"c76e6765b9b2","t":"下泉","a":"佚名","d":1,"f":"诗经","g":"诗","x":"冽彼下泉，浸彼苞稂。忾我寤叹，念彼周京。","b":1,"y":-550,"th":["怀古","伤时","思治"],"ap":1},{"id":"0df0e586e5db","t":"论语·先进篇 其2","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“从我于陈、蔡者，皆不及门也。”","b":1,"y":-500,"th":["怀古","哲理","忆旧"],"ap":1},{"id":"4078cdb57567","t":"论语·子罕篇 其9","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“凤鸟不至，河不出图，吾已矣夫！”","b":1,"y":-500,"th":["怀古","哲理","伤时"],"ap":1},{"id":"6236b29bc4ff","t":"论语·季氏篇 其2","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"孔子曰：“天下有道，则礼乐征伐自天子出；天下无道，则礼乐征伐自诸侯出。自诸侯出，盖十世希不失矣；自大夫出，五世希不失矣；陪臣执国命，三世希不失矣。天下有道，则政不在大夫；天下有道，则庶人不议。”","b":1,"y":-500,"th":["哲理","政治","怀古"],"ap":1},{"id":"e3993d5fd674","t":"论语·宪问篇 其21","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"陈成子弑简公，孔子沐浴而朝，告于哀公曰：“陈恒弑其君，请讨之。”公曰：“告夫三子。”,孔子曰：“以吾从大夫之后，不敢不告也，君曰‘告夫三子’者！”之三子告，不可。孔子曰：“以吾从大夫之后，不敢不告也。”","b":1,"y":-500,"th":["哲理","怀古"],"ap":1},{"id":"5bf1b198422d","t":"论语·微子篇 其3","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"齐景公待孔子曰：“若季氏，则吾不能。”以季、孟之间待之，曰：“吾老矣，不能用也。”孔子行。","b":1,"y":-500,"th":["哲理","怀古"],"ap":1},{"id":"8ec80b863804","t":"论语·雍也篇 其25","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“觚不觚，觚哉！觚哉！”","b":1,"y":-500,"th":["哲理","咏物","怀古"],"ap":1},{"id":"ef2e9d088de7","t":"论语·微子篇 其4","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"齐人归女乐，季桓子受之，三日不朝，孔子行。”","b":1,"y":-497,"th":["哲理","政治理想","怀古"],"ap":1},{"id":"5b5c32f5cc9d","t":"论语·公冶长篇 其21","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“宁武子，邦有道则知，邦无道则愚。其知可及也，其愚不可及也。”","b":1,"y":-490,"th":["哲理","处世之道","怀古"],"ap":1},{"id":"717ab4ec61e9","t":"论语·季氏篇 其1","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"季氏将伐颛臾，冉有、季路见于孔子，曰：“季氏将有事于颛臾。”孔子曰：“求，无乃尔是过与？夫颛臾，昔者先王以为东蒙主，且在邦域之中矣，是社稷之臣也。何以伐为？”冉有曰：“夫子欲之，吾二臣者皆不欲也。”孔子曰：“求，周任有言曰：‘陈力就列，不能者止。’危而不持，颠而不扶，则将焉用彼相矣？且尔言过矣，虎兕出于柙，龟玉毁于椟中，是谁之过与？”冉有曰：“今夫颛臾固而近于费，今不取，后世必为子孙忧。”孔子曰：“求，君子疾夫舍曰欲之而必为之辞。丘也闻，有国有家者，不患寡而患不均，不患贫而患不安。盖均无贫，和无寡，安无倾。夫如是，故远人不服则修文德以来之，既来之，则安之。今由与求也相夫子，远人不服而不能来也，邦分崩离析而不能守也，而谋动干戈于邦内。吾恐季孙之忧不在颛臾，而在萧墙之内也。”","b":2,"y":-490,"th":["哲理","治国","怀古"],"ap":1},{"id":"53dcf67ca3db","t":"论语·微子篇 其1","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"微子去之，箕子为之奴，比干谏而死。孔子曰：“殷有三仁焉。”","b":2,"y":-480,"th":["哲理","怀古"],"ap":1},{"id":"aedae0a62849","t":"论语·微子篇 其11","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"周有八士：伯达、伯适、仲突、仲忽、叔夜、叔夏、季随、季騧。","b":2,"y":-480,"th":["咏史","怀古","哲理"],"ap":1},{"id":"e392f53dce40","t":"论语·八佾篇 其10","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“禘自既灌而往者，吾不欲观之矣。”","b":2,"y":-450,"th":["礼制","哲理","怀古"],"ap":1},{"id":"b3b1c765d52b","t":"论语·八佾篇 其14","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“周监于二代，郁郁乎文哉！吾从周。”","b":2,"y":-450,"th":["哲理","怀古"],"ap":1},{"id":"6546cb3402a9","t":"论语·八佾篇 其9","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“夏礼吾能言之，杞不足征也；殷礼吾能言之，宋不足征也。文献不足故也，足则吾能征之矣。”","b":2,"y":-450,"th":["哲理","怀古","礼乐"],"ap":1},{"id":"bab8c991b305","t":"论语·公冶长篇 其23","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“伯夷、叔齐不念旧恶，怨是用希。”","b":2,"y":-450,"th":["哲理","修身","怀古"],"ap":1},{"id":"a21234b14f17","t":"论语·卫灵公篇 其26","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“吾犹及史之阙文也，有马者借人乘之，今亡矣夫！”","b":2,"y":-450,"th":["怀古","哲理","世风"],"ap":1},{"id":"77431c550145","t":"论语·子张篇 其20","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子贡曰：“纣之不善，不如是之甚也。是以君子恶居下流，天下之恶皆归焉。”","b":2,"y":-450,"th":["哲理","修身","怀古"],"ap":1},{"id":"d59a35e976d7","t":"论语·子路篇 其7","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“鲁卫之政，兄弟也。”","b":3,"y":-450,"th":["哲理","怀古"],"ap":1},{"id":"7682445cd0fb","t":"论语·季氏篇 其3","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"孔子曰：“禄之去公室五世矣，政逮于大夫四世矣，故夫三桓之子孙微矣。”","b":3,"y":-450,"th":["哲理","怀古","政治"],"ap":1},{"id":"42aa1c95294d","t":"论语·宪问篇 其15","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“晋文公谲而不正，齐桓公正而不谲。”","b":3,"y":-450,"th":["哲理","怀古","治国"],"ap":1},{"id":"0da01fce3012","t":"论语·宪问篇 其17","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子贡曰：“管仲非仁者与？桓公杀公子纠，不能死，又相之。”子曰：“管仲相桓公霸诸侯，一匡天下，民到于今受其赐。微管仲，吾其被发左衽矣。岂若匹夫匹妇之为谅也，自经于沟渎而莫之知也。”","b":3,"y":-450,"th":["哲理","怀古","家国"],"ap":1},{"id":"46ede394f88d","t":"论语·微子篇 其9","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"太师挚适齐，亚饭干适楚，三饭缭适蔡，四饭缺适秦，鼓方叔入于河，播鼗武入于汉，少师阳、击磬襄入于海。","b":3,"y":-450,"th":["礼崩乐坏","怀古","文化凋零"],"ap":1},{"id":"2d18a57987f9","t":"论语·泰伯篇 其20","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"舜有臣五人而天下治。武王曰：“予有乱臣十人。”孔子曰：“才难，不其然乎？唐虞之际，于斯为盛；有妇人焉，九人而已。三分天下有其二，以服事殷。周之德，其可谓至德也已矣。”","b":3,"y":-450,"th":["哲理","怀古","尚德"],"ap":1},{"id":"1ab4c0e28854","t":"论语·述而篇 其1","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“述而不作，信而好古，窃比于我老彭。”","b":3,"y":-450,"th":["哲理","怀古","治学"],"ap":1},{"id":"6724bd9460d6","t":"论语·述而篇 其5","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“甚矣吾衰也！久矣吾不复梦见周公。”","b":3,"y":-450,"th":["哲理","咏怀","怀古"],"ap":1},{"id":"f611c97e3e19","t":"论语·阳货篇 其16","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“古者民有三疾，今也或是之亡也。古之狂也肆，今之狂也荡；古之矜也廉，今之矜也忿戾；古之愚也直，今之愚也诈而已矣。”","b":3,"y":-450,"th":["哲理","怀古","世道人心"],"ap":1},{"id":"dfccaefdb762","t":"孟子·公孙丑上 其28","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「伯夷、伊尹何如？」","b":4,"y":-320,"th":["哲理","怀古"],"ap":1},{"id":"6c6351825feb","t":"孟子·公孙丑上 其3","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「管仲以其君霸，晏子以其君显。管仲、晏子犹不足为与？」","b":4,"y":-320,"th":["哲理","怀古"],"ap":1},{"id":"53d5b454aaf4","t":"孟子·公孙丑上 其5","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「若是，则弟子之惑滋甚。且以文王之德，百年而后崩，犹未洽于天下；武王、周公继之，然后大行。今言王若易然，则文王不足法与？」","b":4,"y":-320,"th":["哲理","怀古","政治"],"ap":1},{"id":"e061f8ca1c26","t":"孟子·公孙丑下 其32","a":"孟子","d":1,"f":"文","g":"文","x":"陈贾曰：「王无患焉。王自以为与周公，孰仁且智？」","b":4,"y":-320,"th":["哲理","政治","怀古"],"ap":1},{"id":"d237c3cfb2c0","t":"孟子·公孙丑下 其34","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「周公使管叔监殷，管叔以殷畔。知而使之，是不仁也；不知而使之，是不智也。仁智，周公未之尽也，而况于王乎？贾请见而解之。」","b":4,"y":-320,"th":["哲理","论辩","怀古"],"ap":1},{"id":"d8898aefe1b6","t":"孟子·公孙丑下 其36","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「古圣人也。」","b":4,"y":-320,"th":["哲理","怀古"],"ap":1},{"id":"e2e77f97e3ce","t":"孟子·公孙丑下 其37","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「使管叔监殷，管叔以殷畔也，有诸？」","b":4,"y":-320,"th":["哲理","怀古","历史"],"ap":1},{"id":"8d2c540ee757","t":"孟子·公孙丑下 其39","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「周公知其将畔而使之与？」","b":4,"y":-320,"th":["哲理","怀古","论辩"],"ap":1},{"id":"21adfc76fbcc","t":"孟子·公孙丑下 其46","a":"孟子","d":1,"f":"文","g":"文","x":"孟子去齐，宿于昼。","b":4,"y":-320,"th":["哲理","纪行","怀古"],"ap":1},{"id":"e4157d708ef3","t":"孟子·公孙丑下 其49","a":"孟子","d":1,"f":"文","g":"文","x":"孟子去齐。尹士语人曰：「不识王之不可以为汤武，则是不明也；识其不可，然且至，则是干泽也。千里而见王，不遇故去。三宿而后出昼，是何濡滞也？士则兹不悦。」","b":4,"y":-320,"th":["哲理","政治","怀古"],"ap":1},{"id":"c0924d5a15a3","t":"孟子·梁惠王上 其16","a":"孟子","d":1,"f":"文","g":"文","x":"梁惠王曰：「晋国，天下莫强焉，叟之所知也。及寡人之身，东败于齐，长子死焉；西丧地于秦七百里；南辱于楚。寡人耻之，愿比死者一洒之，如之何则可？」","b":4,"y":-320,"th":["怀古","哲理","家国"],"ap":1},{"id":"e5f23b27867d","t":"孟子·梁惠王下 其41","a":"孟子","d":1,"f":"文","g":"文","x":"齐宣王问曰：「汤放桀，武王伐纣，有诸？」","b":5,"y":-320,"th":["哲理","民本","怀古"],"ap":1},{"id":"9f2f18c58307","t":"孟子·梁惠王下 其59","a":"孟子","d":1,"f":"文","g":"文","x":"鲁平公将出。嬖人臧仓者请曰：「他日君出，则必命有司所之。今乘舆已驾矣，有司未知所之。敢请。」公曰：「将见孟子。」曰：「何哉？君所为轻身以先于匹夫者，以为贤乎？礼义由贤者出。而孟子之后丧逾前丧。君无见焉！」公曰：「诺。」","b":5,"y":-320,"th":["哲理","怀古"],"ap":1},{"id":"4b0149713212","t":"孟子·梁惠王下 其9","a":"孟子","d":1,"f":"文","g":"文","x":"齐宣王问曰：「文王之囿方七十里，有诸？」","b":5,"y":-320,"th":["哲理","怀古","政治"],"ap":1},{"id":"d0886a12079d","t":"孟子·滕文公下 其3","a":"孟子","d":1,"f":"文","g":"文","x":"景春曰：「公孙衍、张仪岂不诚大丈夫哉？一怒而诸侯惧，安居而天下熄。」","b":5,"y":-320,"th":["哲理","怀古","政治"],"ap":1},{"id":"c72cf91ebc54","t":"孟子·滕文公下 其34","a":"孟子","d":1,"f":"文","g":"文","x":"「尧、舜既没，圣人之道衰。暴君代作，坏宫室以为污池，民无所安息；弃田以为园囿，使民不得衣食。邪说暴行又作，园囿、污池、沛泽多而禽兽至。及纣之身，天下又大乱。周公相武王，诛纣伐奄，三年讨其君，驱飞廉于海隅而戮之。灭国者五十，驱虎、豹、犀、象而远之。天下大悦。《书》曰：『丕显哉，文王谟！丕承哉，武王烈！佑启我后人，咸以正无缺。』","b":5,"y":-320,"th":["哲理","怀古","仁政","历史"],"ap":1},{"id":"019772e99f35","t":"孟子·滕文公下 其37","a":"孟子","d":1,"f":"文","g":"文","x":"「昔者禹抑洪水而天下平，周公兼夷狄驱猛兽而百姓宁，孔子成《春秋》而乱臣贼子惧。《诗》云：『戎狄是膺，荆舒是惩，则莫我敢承。』无父无君，是周公所膺也。我亦欲正人心，息邪说，距诐行，放淫辞，以承三圣者；岂好辩哉？予不得已也。能言距杨墨者，圣人之徒也。」","b":5,"y":-320,"th":["哲理","言志","怀古"],"ap":1},{"id":"c172634deda0","t":"孟子·公孙丑下 其31","a":"孟子","d":1,"f":"文","g":"文","x":"燕人畔。王曰：「吾甚惭于孟子。」","b":5,"y":-314,"th":["哲理","仁政","怀古"],"ap":1},{"id":"baff72e593c3","t":"孟子·梁惠王下 其48","a":"孟子","d":1,"f":"文","g":"文","x":"齐人伐燕，取之。诸侯将谋救燕。宣王曰：「诸侯多谋伐寡人者，何以待之？」","b":5,"y":-314,"th":["哲理","怀古","政治"],"ap":1},{"id":"6f9d99c903b3","t":"伤时","a":"王逸","d":1,"f":"楚辞","g":"诗","x":"惟昊天兮昭灵，阳气发兮清明。","b":5,"y":-300,"th":["伤时","游仙","怀古","去国"],"ap":1},{"id":"554c000832fe","t":"哀命","a":"东方朔","d":1,"f":"楚辞","g":"诗","x":"哀时命之不合兮，伤楚国之多忧。","b":5,"y":-300,"th":["怀古","忠贞","悲愤"],"ap":1},{"id":"f2af8d31f1d9","t":"孟子·公孙丑下 其35","a":"孟子","d":1,"f":"文","g":"文","x":"见孟子，问曰：「周公何人也？」","b":5,"y":-300,"th":["哲理","怀古","问对"],"ap":1},{"id":"ca9bf101074b","t":"孟子·滕文公下 其33","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「予岂好辩哉？予不得已也。天下之生久矣，一治一乱。当尧之时，水逆行，泛滥于中国。蛇龙居之，民无所定。下者为巢，上者为营窟。《书》曰：『洚水警余。』洚水者，洪水也。使禹治之，禹掘地而注之海，驱蛇龙而放之菹。水由地中行，江、淮、河、汉是也。险阻既远，鸟兽之害人者消，然后人得平土而居之。","b":5,"y":-300,"th":["哲理","怀古","家国"],"ap":1},{"id":"acfb5f63eaf8","t":"孟子·滕文公下 其35","a":"孟子","d":1,"f":"文","g":"文","x":"「世衰道微，邪说暴行有作，臣弑其君者有之，子弑其父者有之。孔子惧，作《春秋》。《春秋》，天子之事也。是故孔子曰：『知我者其惟春秋乎！罪我者其惟春秋乎！』","b":5,"y":-300,"th":["哲理","怀古","政治"],"ap":1},{"id":"a2ef10f40147","t":"尊嘉","a":"王褒","d":1,"f":"楚辞","g":"诗","x":"季春兮阳阳，列草兮成行。","b":5,"y":-300,"th":["怀古","咏物","羁旅","伤时"],"ap":1},{"id":"118c4e01b127","t":"悼乱","a":"王逸","d":1,"f":"楚辞","g":"诗","x":"嗟嗟兮悲夫，殽乱兮纷挐。","b":5,"y":-300,"th":["乱世之悲","孤臣之愤","隐逸","怀古"],"ap":1},{"id":"f92b1b2f51d3","t":"昭世","a":"王褒","d":1,"f":"楚辞","g":"诗","x":"世溷兮冥昏，违君兮归真。","b":5,"y":-300,"th":["游仙","怀古","政治感慨"],"ap":1},{"id":"54bf3a35586f","t":"逢尤","a":"王逸","d":1,"f":"楚辞","g":"诗","x":"悲兮愁，哀兮忧！","b":5,"y":-300,"th":["悲愤","怀古","抒怀"],"ap":1},{"id":"bc2c98b833d9","t":"遭厄","a":"王逸","d":1,"f":"楚辞","g":"诗","x":"悼屈子兮遭厄，沉王躬兮湘汨。","b":5,"y":-300,"th":["咏史","怀古","游仙","政治"],"ap":1},{"id":"e064417ec3f7","t":"陶壅","a":"王褒","d":1,"f":"楚辞","g":"诗","x":"览杳杳兮世惟，余惆怅兮何归。","b":5,"y":-300,"th":["游仙","怀古","伤时"],"ap":1},{"id":"fc7706dea687","t":"权舆","a":"佚名","d":1,"f":"诗经","g"