[{"id":"c0708d754559","t":"丝衣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"丝衣其紑，载弁俅俅。自堂徂基，自羊徂牛，鼐鼎及鼒，兕觥其觩。旨酒思柔。不吴不敖，胡考之休。","b":0,"y":-908,"th":["祭祀","颂歌","祈福"],"ap":1},{"id":"4c6c56271264","t":"斯干","a":"佚名","d":1,"f":"诗经","g":"诗","x":"秩秩斯干，幽幽南山。如竹苞矣，如松茂矣。兄及弟矣，式相好矣，无相犹矣。","b":0,"y":-908,"th":["宴饮","咏物","祈福"],"ap":1},{"id":"479166f7eb7a","t":"楚茨","a":"佚名","d":1,"f":"诗经","g":"诗","x":"楚楚者茨，言抽其棘，自昔何为？我蓺黍稷。我黍与与，我稷翼翼。","b":0,"y":-836,"th":["祭祀","宗族","祈福"],"ap":1},{"id":"5f16bb42f2a9","t":"凫鹥","a":"佚名","d":1,"f":"诗经","g":"诗","x":"凫鹥在泾，公尸在燕来宁。尔酒既清，尔肴既馨。公尸燕饮，福禄来成。","b":0,"y":-771,"th":["祭祀","宴饮","祈福","颂歌"],"ap":1},{"id":"4d276f2ca195","t":"既醉","a":"佚名","d":1,"f":"诗经","g":"诗","x":"既醉以酒，既饱以德。君子万年，介尔景福。","b":0,"y":-771,"th":["祭祀","宴饮","祝颂","祈福"],"ap":1},{"id":"6b53fdd4fd3d","t":"烈祖","a":"佚名","d":1,"f":"诗经","g":"诗","x":"嗟嗟烈祖！有秩斯祜。申锡无疆，及尔斯所。既载清酤，赉我思成。","b":0,"y":-700,"th":["祭祀","颂祖","祈福"],"ap":1},{"id":"85747689802c","t":"蓼萧","a":"佚名","d":1,"f":"诗经","g":"诗","x":"蓼彼萧斯，零露湑兮。既见君子，我心写兮。燕笑语兮，是以有誉处兮。","b":0,"y":-700,"th":["宴饮","颂德","祈福"],"ap":1},{"id":"288f7e9a1a19","t":"行苇","a":"佚名","d":1,"f":"诗经","g":"诗","x":"敦彼行苇，牛羊勿践履。方苞方体，维叶泥泥。","b":1,"y":-700,"th":["宴饮","亲情","礼乐","祈福"],"ap":1},{"id":"6b9c1e0d07f4","t":"有駜","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有駜有駜，駜彼乘黄。夙夜在公，在公明明。振振鹭，鹭于下。鼓咽咽，醉言舞。于胥乐兮！","b":1,"y":-650,"th":["颂赞","宴饮","祈福"],"ap":1},{"id":"3d5d1696557c","t":"礼魂","a":"屈原","d":1,"f":"楚辞","g":"诗","x":"成礼兮会鼓，","b":5,"y":-290,"th":["祭祀","祈福","咏神"],"ap":1},{"id":"8fd39e62e469","t":"郊庙歌辞 享先农乐章 肃和","a":"褚亮","d":6,"f":"四言","g":"诗","x":"樽彝既列，瑚簋方荐。","b":0,"y":595,"th":["祭祀","祈福","礼乐"],"ap":1},{"id":"414685335bd0","t":"郊庙歌辞 祭[太]社乐章 雍和","a":"褚亮","d":6,"f":"四言","g":"诗","x":"美报崇本，严恭展事。","b":0,"y":595,"th":["祭祀","礼乐","祈福"],"ap":1},{"id":"b78141620820","t":"郊庙歌辞 祭方丘乐章 肃和","a":"褚亮","d":6,"f":"四言","g":"诗","x":"至矣坤德，皇哉地祇。","b":0,"y":595,"th":["祭祀","颂德","祈福"],"ap":1},{"id":"8bd1d6c76465","t":"郊庙歌辞 祭方丘乐章 雍和","a":"褚亮","d":6,"f":"四言","g":"诗","x":"柔而能方，直而能敬。","b":0,"y":595,"th":["祭祀","礼乐","祈福"],"ap":1},{"id":"ebd0534