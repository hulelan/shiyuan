[{"id":"eade14751870","t":"论语·为政篇 其15","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“学而不思则罔，思而不学则殆。”","b":1,"y":-500,"th":["哲理","教育","修身"],"ap":1},{"id":"970eb5915bc6","t":"论语·公冶长篇 其5","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"或曰：“雍也仁而不佞。”子曰：“焉用佞？御人以口给，屡憎于人。不知其仁，焉用佞？”","b":1,"y":-500,"th":["哲理","修身","教育"],"ap":1},{"id":"d7a0a66a4fed","t":"论语·公冶长篇 其8","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"孟武伯问：“子路仁乎？”子曰：“不知也。”又问，子曰：“由也，千乘之国，可使治其赋也，不知其仁也。”“求也何如？”子曰：“求也，千室之邑、百乘之家，可使为之宰也，不知其仁也。”“赤也何如？”子曰：“赤也，束带立于朝，可使与宾客言也，不知其仁也。”","b":1,"y":-500,"th":["哲理","教育","人才"],"ap":1},{"id":"29c7c7a484ab","t":"论语·述而篇 其34","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“若圣与仁，则吾岂敢？抑为之不厌，诲人不倦，则可谓云尔已矣。”公西华曰：“正唯弟子不能学也。”","b":1,"y":-500,"th":["谦逊","教育","哲理"],"ap":1},{"id":"dba33dcb8da7","t":"论语·阳货篇 其19","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“予欲无言。”子贡曰：“子如不言，则小子何述焉？”子曰：“天何言哉？四时行焉，百物生焉，天何言哉？”","b":1,"y":-500,"th":["哲理","教育","天道","自然"],"ap":1},{"id":"3f6cddaba61c","t":"论语·阳货篇 其8","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“由也，女闻六言六蔽矣乎？”对曰：“未也。”“居！吾语女。好仁不好学，其蔽也愚；好知不好学，其蔽也荡；好信不好学，其蔽也贼；好直不好学，其蔽也绞；好勇不好学，其蔽也乱；好刚不好学，其蔽也狂。”","b":1,"y":-500,"th":["哲理","教育","修身"],"ap":1},{"id":"7d26d2548f10","t":"论语·雍也篇 其21","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“中人以上，可以语上也；中人以下，不可以语上也。”","b":1,"y":-500,"th":["哲理","教育"],"ap":1},{"id":"22a0f9e9ee4d","t":"论语·公冶长篇 其22","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子在陈，曰：“归与！归与！吾党之小子狂简，斐然成章，不知所以裁之。”","b":1,"y":-492,"th":["思乡","哲理","教育"],"ap":1},{"id":"5b26d799a1c9","t":"论语·先进篇 其22","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子路问：“闻斯行诸？”子曰：“有父兄在，如之何其闻斯行之？”冉有问：“闻斯行诸？”子曰：“闻斯行之。公西华曰：“由也问闻斯行诸，子曰‘有父兄在’；求也问闻斯行诸，子曰‘闻斯行之’。赤也惑，敢问。”子曰：“求也退，故进之；由也兼人，故退之。”","b":1,"y":-490,"th":["哲理","教育"],"ap":1},{"id":"2f6e7e7128eb","t":"论语·公冶长篇 其10","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"宰予昼寝，子曰：“朽木不可雕也，粪土之墙不可杇也，于予与何诛？”子曰：“始吾于人也，听其言而信其行；今吾于人也，听其言而观其行。于予与改是。”","b":1,"y":-490,"th":["哲理","教育","识人"],"ap":1},{"id":"99e982d4a219","t":"论语·颜渊篇 其21","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"樊迟从游于舞雩之下，曰：“敢问崇德、修慝、辨惑。”子曰：“善哉问！先事后得，非崇德与？攻其恶，无攻人之恶，非修慝与？一朝之忿，忘其身，以及其亲，非惑与？”","b":2,"y":-490,"th":["哲理","修身","教育"],"ap":1},{"id":"522d435f0567","t":"论语·先进篇 其4","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“回也非助我者也，于吾言无所不说。”","b":2,"y":-480,"th":["哲理","师生","教育"],"ap":1},{"id":"1b0014545bfa","t":"论语·为政篇 其11","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“温故而知新，可以为师矣。”","b":2,"y":-450,"th":["哲理","治学","教育"],"ap":1},{"id":"7dc1f94cd6fe","t":"论语·为政篇 其12","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“君子不器。”","b":2,"y":-450,"th":["哲理","修身","教育"],"ap":1},{"id":"6545c56cbf09","t":"论语·为政篇 其9","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“吾与回言终日，不违，如愚。退而省其私，亦足以发，回也不愚。”","b":2,"y":-450,"th":["哲理","教育","师生"],"ap":1},{"id":"13a0ed01dfe2","t":"论语·先进篇 其1","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“先进于礼乐，野人也；后进于礼乐，君子也。如用之，则吾从先进。”","b":2,"y":-450,"th":["哲理","用人","教育"],"ap":1},{"id":"38c42a44b3f5","t":"论语·先进篇 其15","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“由之瑟奚为于丘之门？”门人不敬子路，子曰：“由也升堂矣，未入于室也。”","b":2,"y":-450,"th":["哲理","教育","师生"],"ap":1},{"id":"cfb46e6baa7b","t":"论语·先进篇 其16","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子贡问：“师与商也孰贤？”子曰：“师也过，商也不及。”曰：“然则师愈与？”子曰：“过犹不及。”","b":2,"y":-450,"th":["哲理","中庸","教育"],"ap":1},{"id":"360fcebaa688","t":"论语·先进篇 其18","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"柴也愚，参也鲁，师也辟，由也喭。","b":2,"y":-450,"th":["哲理","教育","人物"],"ap":1},{"id":"58958920ab23","t":"论语·先进篇 其20","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子张问善人之道，子曰：“不践迹，亦不入于室。”","b":2,"y":-450,"th":["哲理","修身","教育"],"ap":1},{"id":"5931f5d0bf13","t":"论语·先进篇 其25","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子路使子羔为费宰，子曰：“贼夫人之子。”子路曰：“有民人焉，有社稷焉，何必读书然后为学。”子曰：“是故恶夫佞者。”","b":2,"y":-450,"th":["哲理","教育"],"ap":1},{"id":"0528fca45eb5","t":"论语·先进篇 其3","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"德行：颜渊，闵子骞，冉伯牛，仲弓。言语：宰我，子贡。政事：冉有，季路。文学：子游，子夏。","b":2,"y":-450,"th":["哲理","教育","人物品评"],"ap":1},{"id":"b3631a7ec307","t":"论语·八佾篇 其8","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子夏问曰：“‘巧笑倩兮，美目盼兮，素以为绚兮’何谓也？”子曰：“绘事后素。”曰：“礼后乎？”子曰：“起予者商也，始可与言《诗》已矣。”","b":2,"y":-450,"th":["哲理","教育","礼乐"],"ap":1},{"id":"d32362c0efb1","t":"论语·公冶长篇 其13","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子贡曰：“夫子之文章，可得而闻也；夫子之言性与天道，不可得而闻也。”","b":2,"y":-450,"th":["哲理","教育","师道"],"ap":1},{"id":"c5632aa12579","t":"论语·公冶长篇 其4","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子贡问曰：“赐也何如？”子曰：“女器也。”曰：“何器也？”曰：“瑚琏也。”","b":2,"y":-450,"th":["哲理","教育","人物品评"],"ap":1},{"id":"645ff4723610","t":"论语·公冶长篇 其6","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子使漆雕开仕，对曰：“吾斯之未能信。”子说。","b":2,"y":-450,"th":["哲理","教育","修身"],"ap":1},{"id":"6c6904c62d70","t":"论语·公冶长篇 其9","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子谓子贡曰：“女与回也孰愈？”对曰：“赐也何敢望回？回也闻一以知十，赐也闻一以知二。”子曰：“弗如也，吾与女弗如也！”","b":2,"y":-450,"th":["哲理","教育","师生情"],"ap":1},{"id":"54ad6faa2def","t":"论语·卫灵公篇 其16","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“不曰‘如之何、如之何’者，吾末如之何也已矣。”","b":2,"y":-450,"th":["哲理","教育","修身"],"ap":1},{"id":"987a4ca1ef27","t":"论语·卫灵公篇 其3","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“赐也，女以予为多学而识之者与？”对曰：“然，非与？”曰：“非也，予一以贯之。”","b":2,"y":-450,"th":["哲理","教育","修身"],"ap":1},{"id":"5eb6938f3719","t":"论语·卫灵公篇 其31","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“吾尝终日不食、终夜不寝以思，无益，不如学也。”","b":2,"y":-450,"th":["哲理","治学","教育"],"ap":1},{"id":"7b003026df03","t":"论语·卫灵公篇 其39","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“有教无类。”","b":2,"y":-450,"th":["哲理","教育"],"ap":1},{"id":"6c04dbdf0293","t":"论语·子张篇 其12","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子游曰：“子夏之门人小子，当洒扫应对进退则可矣。抑末也，本之则无，如之何？”子夏闻之，曰：“噫，言游过矣！君子之道，孰先传焉？孰后倦焉？譬诸草木，区以别矣。君子之道焉可诬也？有始有卒者，其惟圣人乎！”","b":2,"y":-450,"th":["哲理","教育"],"ap":1},{"id":"1e1be69f804d","t":"论语·子罕篇 其11","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"颜渊喟然叹曰：“仰之弥高，钻之弥坚。瞻之在前，忽焉在后。夫子循循然善诱人，博我以文，约我以礼，欲罢不能。既竭吾才，如有所立卓尔，虽欲从之，末由也已。”","b":2,"y":-450,"th":["哲理","教育","尊师"],"ap":1},{"id":"eb2df907a1a5","t":"论语·子罕篇 其23","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“后生可畏，焉知来者之不如今也？四十、五十而无闻焉，斯亦不足畏也已。”","b":2,"y":-450,"th":["哲理","教育","勉学"],"ap":1},{"id":"10b000bd70eb","t":"论语·子罕篇 其24","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“法语之言，能无从乎？改之为贵。巽与之言，能无说乎？绎之为贵。说而不绎，从而不改，吾末如之何也已矣。”","b":2,"y":-450,"th":["哲理","修身","教育"],"ap":1},{"id":"be659d3a6033","t":"论语·子罕篇 其27","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“衣敝缊袍，与衣狐貉者立而不耻者，其由也与！‘不忮不求，何用不臧？’”子路终身诵之，子曰：“是道也，何足以臧？”","b":2,"y":-450,"th":["哲理","修身","教育"],"ap":1},{"id":"dad39de0a69e","t":"论语·子罕篇 其8","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“吾有知乎哉？无知也。有鄙夫问于我，空空如也。我叩其两端而竭焉。”","b":3,"y":-450,"th":["哲理","教育","修身"],"ap":1},{"id":"e9268a44ec51","t":"论语·子路篇 其4","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"樊迟请学稼，子曰：“吾不如老农。”请学为圃，曰：“吾不如老圃。”樊迟出，子曰：“小人哉樊须也！上好礼，则民莫敢不敬；上好义，则民莫敢不服；上好信，则民莫敢不用情。夫如是，则四方之民襁负其子而至矣，焉用稼？”","b":3,"y":-450,"th":["哲理","治国","教育"],"ap":1},{"id":"76bd4be8a1dc","t":"论语·子路篇 其5","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“诵《诗》三百，授之以政，不达；使于四方，不能专对；虽多，亦奚以为？”","b":3,"y":-450,"th":["哲理","教育","学以致用"],"ap":1},{"id":"c8123cdb2181","t":"论语·季氏篇 其13","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"陈亢问于伯鱼曰：“子亦有异闻乎？”对曰：“未也。尝独立，鲤趋而过庭，曰：‘学《诗》乎？’对曰：‘未也。’‘不学《诗》，无以言。’鲤退而学《诗》。他日，又独立，鲤趋而过庭，曰：‘学《礼》乎？’对曰：‘未也。’‘不学《礼》，无以立。’鲤退而学《礼》。闻斯二者。”陈亢退而喜曰：“问一得三，闻《诗》，闻《礼》，又闻君子之远其子也。”","b":3,"y":-450,"th":["哲理","教育","伦理"],"ap":1},{"id":"1960ca202b1d","t":"论语·学而篇 其15","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子贡曰：“贫而无谄，富而无骄，何如？”子曰：“可也。未若贫而乐，富而好礼者也。”子贡曰：“《诗》云：‘如切如磋，如琢如磨’，其斯之谓与？”子曰：“赐也，始可与言《诗》已矣，告诸往而知来者。”","b":3,"y":-450,"th":["哲理","修身","教育"],"ap":1},{"id":"0a7fc4ae33a8","t":"论语·学而篇 其6","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“弟子入则孝，出则弟，谨而信，泛爱众，而亲仁，行有余力，则以学文。”","b":3,"y":-450,"th":["哲理","修身","教育"],"ap":1},{"id":"7ac589af2fa9","t":"论语·学而篇 其8","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“君子不重则不威，学则不固。主忠信，无友不如己者，过，则勿惮改。”","b":3,"y":-450,"th":["修身","哲理","教育"],"ap":1},{"id":"97319a34c5da","t":"论语·宪问篇 其7","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“爱之，能勿劳乎？忠焉，能勿诲乎？”","b":3,"y":-450,"th":["哲理","修身","教育"],"ap":1},{"id":"334d4095ca12","t":"论语·泰伯篇 其11","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“如有周公之才之美，使骄且吝，其余不足观也已。”","b":3,"y":-450,"th":["哲理","修身","教育"],"ap":1},{"id":"53180e641df3","t":"论语·泰伯篇 其8","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“兴于《诗》，立于礼，成于乐。”","b":3,"y":-450,"th":["哲理","教育","修身"],"ap":1},{"id":"4933772ab887","t":"论语·述而篇 其11","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子谓颜渊曰：“用之则行，舍之则藏，惟我与尔有是夫！”子路曰：“子行三军，则谁与？”子曰：“暴虎冯河，死而无悔者，吾不与也。必也临事而惧，好谋而成者也。”","b":3,"y":-450,"th":["哲理","教育","处世"],"ap":1},{"id":"0b133ee67d65","t":"论语·述而篇 其2","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“默而识之，学而不厌，诲人不倦，何有于我哉？”","b":3,"y":-450,"th":["哲理","求学","教育"],"ap":1},{"id":"d4da2d4a0c4d","t":"论语·述而篇 其25","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子以四教：文，行，忠，信。","b":3,"y":-450,"th":["哲理","教育","修身"],"ap":1},{"id":"4e6590a142a7","t":"论语·述而篇 其29","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"互乡难与言，童子见，门人惑。子曰：“与其进也，不与其退也，唯何甚？人洁己以进，与其洁也，不保其往也。”","b":3,"y":-450,"th":["哲理","教育","包容"],"ap":1},{"id":"d7139b4ad4c9","t":"论语·述而篇 其3","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“德之不修，学之不讲，闻义不能徙，不善不能改，是吾忧也。”","b":3,"y":-450,"th":["哲理","修身","教育"],"ap":1},{"id":"4a121194dc21","t":"论语·述而篇 其6","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“志于道，据于德，依于仁，游于艺。”","b":3,"y":-450,"th":["哲理","修身","教育"],"ap":1},{"id":"cda08c2b295a","t":"论语·述而篇 其7","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“自行束修以上，吾未尝无诲焉。”","b":3,"y":-450,"th":["哲理","教育"],"ap":1},{"id":"6d6999a949ab","t":"论语·述而篇 其8","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“不愤不启，不悱不发，举一隅不以三隅反，则不复也。”","b":3,"y":-450,"th":["哲理","教育"],"ap":1},{"id":"dcb5c2f93517","t":"论语·里仁篇 其15","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“参乎！吾道一以贯之。”曾子曰：“唯。”子出，门人问曰：“何谓也？”曾子曰：“夫子之道，忠恕而已矣。”","b":3,"y":-450,"th":["哲理","教育","伦理"],"ap":1},{"id":"a775c4170b17","t":"论语·里仁篇 其6","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“我未见好仁者，恶不仁者。好仁者，无以尚之；恶不仁者，其为仁矣，不使不仁者加乎其身。有能一日用其力于仁矣乎？我未见力不足者。盖有之矣，我未见也。”","b":3,"y":-450,"th":["哲理","修身","教育"],"ap":1},{"id":"eedc5c0f2936","t":"论语·阳货篇 其2","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“性相近也，习相远也。”","b":3,"y":-450,"th":["哲理","人性","教育"],"ap":1},{"id":"571cd5ebe51c","t":"论语·阳货篇 其20","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"孺悲欲见孔子，孔子辞以疾。将命者出户，取瑟而歌，使之闻之。","b":3,"y":-450,"th":["哲理","教育"],"ap":1},{"id":"f4f6dd8f0a6e","t":"论语·阳货篇 其3","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“唯上知与下愚不移。”","b":3,"y":-450,"th":["哲理","人性","教育"],"ap":1},{"id":"d7b7bf0fc85e","t":"论语·雍也篇 其12","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"冉求曰：“非不说子之道，力不足也。”子曰：“力不足者，中道而废，今女画。”","b":3,"y":-450,"th":["哲理","教育","励志"],"ap":1},{"id":"488d83e6d39a","t":"论语·雍也篇 其13","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子谓子夏曰：“女为君子儒，无为小人儒。”","b":3,"y":-450,"th":["哲理","修身","教育"],"ap":1},{"id":"b2f2e47d79b3","t":"论语·雍也篇 其6","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子谓仲弓曰：“犁牛之子骍且角，虽欲勿用，山川其舍诸？”","b":3,"y":-450,"th":["哲理","人才","教育"],"ap":1},{"id":"b1b514b6484e","t":"论语·雍也篇 其7","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“回也，其心三月不违仁，其余则日月至焉而已矣。”","b":3,"y":-450,"th":["哲理","修身","教育"],"ap":1},{"id":"45636bf21ab5","t":"论语·颜渊篇 其3","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"司马牛问仁，子曰：“仁者，其言也讱。”曰：“其言也讱，斯谓之仁已乎？”子曰：“为之难，言之得无讱乎？”","b":4,"y":-450,"th":["哲理","教育"],"ap":1},{"id":"c8a71ec32488","t":"孟子·公孙丑上 其25","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「恶！是何言也？昔者子贡、问于孔子曰：『夫子圣矣乎？』孔子曰：『圣则吾不能，我学不厌而教不倦也。』子贡曰：『学不厌，智也；教不倦，仁也。仁且智，夫子既圣矣！』夫圣，孔子不居，是何言也？」","b":5,"y":-300,"th":["哲理","谦逊","教育"],"ap":1},{"id":"3a42d62d1cc8","t":"孟子·公孙丑上 其27","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「姑舍是。」","b":5,"y":-300,"th":["哲理","教育"],"ap":1},{"id":"0cad5c65811f","t":"孟子·滕文公下 其26","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「使齐人傅之。」","b":5,"y":-300,"th":["哲理","教育","环境"],"ap":1}]