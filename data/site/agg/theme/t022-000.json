[{"id":"59c9880e8892","t":"灵台","a":"佚名","d":1,"f":"诗经","g":"诗","x":"经始灵台，经之营之。庶民攻之，不日成之。经始勿亟，庶民子来。","b":0,"y":-1050,"th":["颂德","田园","咏物"],"ap":1},{"id":"290e3a99c65e","t":"大田","a":"佚名","d":1,"f":"诗经","g":"诗","x":"大田多稼，既种既戒，既备乃事。以我覃耜，俶载南亩。","b":0,"y":-771,"th":["田园","农事","祭祀"],"ap":1},{"id":"6b1bc0f2e970","t":"无羊","a":"佚名","d":1,"f":"诗经","g":"诗","x":"谁谓尔无羊？三百维群。谁谓尔无牛？九十其犉。尔羊来思，其角濈濈。尔牛来思，其耳湿湿。","b":0,"y":-750,"th":["田园","咏物","劳作"],"ap":1},{"id":"e2a86f29696a","t":"君子于役","a":"佚名","d":1,"f":"诗经","g":"诗","x":"君子于役，不知其期。曷至哉？鸡栖于埘。日之夕矣，羊牛下来。君子于役，如之何勿思！","b":0,"y":-700,"th":["思妇","战争","田园"],"ap":1},{"id":"ea756c25a962","t":"瓠叶","a":"佚名","d":1,"f":"诗经","g":"诗","x":"幡幡瓠叶，采之亨之。君子有酒，酌言尝之。","b":0,"y":-700,"th":["宴饮","尚礼","田园"],"ap":1},{"id":"d0545c8ffd1c","t":"甫田","a":"佚名","d":1,"f":"诗经","g":"诗","x":"无田甫田，维莠骄骄。无思远人，劳心忉忉。","b":0,"y":-700,"th":["思念","田园","怀人"],"ap":1},{"id":"b558a45cc894","t":"芣苡","a":"佚名","d":1,"f":"诗经","g":"诗","x":"采采芣苡，薄言采之。采采芣苡，薄言有之。","b":0,"y":-700,"th":["田园","劳动","咏物"],"ap":1},{"id":"2f799ba8d005","t":"丘中有麻","a":"佚名","d":1,"f":"诗经","g":"诗","x":"丘中有麻，彼留子嗟。彼留子嗟，将其来施施。","b":1,"y":-650,"th":["爱情","田园"],"ap":1},{"id":"3afca3179b59","t":"东门之池","a":"佚名","d":1,"f":"诗经","g":"诗","x":"东门之池，可以沤麻。彼美淑姬，可与晤歌。","b":1,"y":-650,"th":["爱情","劳动","田园"],"ap":1},{"id":"7fd375f09fb5","t":"衡门","a":"佚名","d":1,"f":"诗经","g":"诗","x":"衡门之下，可以栖迟。泌之洋洋，可以乐饥。","b":1,"y":-650,"th":["哲理","安贫乐道","田园"],"ap":1},{"id":"a2a234e23dea","t":"駉","a":"佚名","d":1,"f":"诗经","g":"诗","x":"駉駉牡马，在坰之野。薄言駉者，有驈有皇，有骊有黄，以车彭彭。思无疆思，马斯臧。","b":1,"y":-650,"th":["咏物","颂德","田园"],"ap":1},{"id":"91bcaf2a2b04","t":"十亩之间","a":"佚名","d":1,"f":"诗经","g":"诗","x":"十亩之间兮，桑者闲闲兮，行与子还兮。","b":1,"y":-550,"th":["田园","劳作","友情"],"ap":1},{"id":"1d610d21048e","t":"女曰鸡鸣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"女曰鸡鸣，士曰昧旦。子兴视夜，明星有烂。将翱将翔，弋凫与雁。","b":1,"y":-550,"th":["爱情","家庭","田园"],"ap":1},{"id":"0c604dfa955a","t":"硕鼠","a":"佚名","d":1,"f":"诗经","g":"诗","x":"硕鼠硕鼠，无食我黍！三岁贯女，莫我肯顾。逝将去女，适彼乐土。乐土乐土，爰得我所。","b":1,"y":-550,"th":["讽谕","反抗","田园"],"ap":1},{"id":"397a