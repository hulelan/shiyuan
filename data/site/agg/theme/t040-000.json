[{"id":"78c759ab3d67","t":"维天之命","a":"佚名","d":1,"f":"诗经","g":"诗","x":"维天之命，于穆不已。于乎不显，文王之德之纯。假以溢我，我其收之。骏惠我文王，曾孙笃之。","b":0,"y":-1050,"th":["祭祀","颂德","天命"],"ap":1},{"id":"0c233e5837a3","t":"大明","a":"佚名","d":1,"f":"诗经","g":"诗","x":"明明在下，赫赫在上。天难忱斯，不易维王。天位殷适，使不挟四方。","b":0,"y":-1046,"th":["咏史","天命","战争","颂德"],"ap":1},{"id":"bccd51e0850a","t":"假乐","a":"佚名","d":1,"f":"诗经","g":"诗","x":"假乐君子，显显令德，宜民宜人。受禄于天，保右命之，自天申之。","b":0,"y":-908,"th":["颂赞","德政","天命"],"ap":1},{"id":"11c1126c83b8","t":"论语·子罕篇 其5","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子畏于匡，曰：“文王既没，文不在兹乎？天之将丧斯文也，后死者不得与于斯文也；天之未丧斯文也，匡人其如予何？”","b":1,"y":-495,"th":["哲理","天命","文化传承"],"ap":1},{"id":"a15a295bd2d4","t":"论语·述而篇 其23","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“天生德于予，桓魋其如予何？”","b":1,"y":-492,"th":["哲理","天命","临危不惧"],"ap":1},{"id":"3d3c7befc5e9","t":"论语·子罕篇 其1","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子罕言利与命与仁。","b":2,"y":-450,"th":["哲理","义利之辨","天命","仁德"],"ap":1},{"id":"25329edcb9f0","t":"论语·宪问篇 其36","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"公伯寮愬子路于季孙。子服景伯以告，曰：“夫子固有惑志于公伯寮，吾力犹能肆诸市朝。”子曰：“道之将行也与，命也；道之将废也与，命也。公伯寮其如命何？”","b":3,"y":-450,"th":["哲理","天命","守道"],"ap":1},{"id":"12f3033a10e5","t":"论语·尧曰篇 其1","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"尧曰：“咨！尔舜，天之历数在尔躬，允执其中。四海困穷，天禄永终。”舜亦以命禹。曰：“予小子履，敢用玄牡，敢昭告于皇皇后帝：有罪不敢赦，帝臣不蔽，简在帝心。朕躬有罪，无以万方；万方有罪，罪在朕躬。”周有大赉，善人是富。“虽有周亲，不如仁人。百姓有过，在予一人。”谨权量，审法度，修废官，四方之政行焉。兴灭国，继绝世，举逸民，天下之民归心焉。所重：民、食、丧、祭。宽则得众，信则民任焉，敏则有功，公则说。","b":3,"y":-450,"th":["天命","民本","仁政","道统"],"ap":1},{"id":"8e44a8a6dea7","t":"论语·述而篇 其35","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子疾病，子路请祷。子曰：“有诸？”子路对曰：“有之。《诔》曰：‘祷尔于上下神祇。’”子曰：“丘之祷久矣。”","b":3,"y":-450,"th":["哲理","天命","师生情谊"],"ap":1},{"id":"48d13474693a","t":"论语·雍也篇 其10","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"伯牛有疾，子问之，自牖执其手，曰：“亡之，命矣夫！斯人也而有斯疾也！斯人也而有斯疾也！”","b":3,"y":-450,"th":["师生情谊","天命","悲叹"],"ap":1},{"id":"eaa7924a5185","t":"孟子·梁惠王下 其56","a":"孟子","d":1,"f":"文","g":"文","x":"孟子对曰：「昔者大王居邠，狄人侵之，去之岐山之下居焉。非择而取之，不得已也。苟为善，后世子孙必有王者矣。君子创业垂统，为可继也。若夫成功，则天也。君如彼何哉？彊为善而已矣。」","b":5,"y":-320,"th":["哲理","治国","天命"],"ap":1},{"id":"2c1a0243b13b","t":"孟子·梁惠王下 其61","a":"孟子","d":1,"f":"文","g":"文","x":"乐正子见孟子，曰：「克告于君，君为来见也。嬖人有臧仓者沮君，君是以不果来也。」曰：「行或使之，止或尼之。行止，非人所能也。吾之不遇鲁侯，天也。臧氏之子焉能使予不遇哉？」","b":5,"y":-320,"th":["天命","哲理","修身","出处进退"],"ap":1},{"id":"15080faf3f36","t":"郊庙歌辞 祀圜丘乐章 凯安","a":"褚亮","d":6,"f":"五律","g":"诗","x":"昔在炎运终，中华乱无象。","b":0,"y":620,"th":["咏史","颂德","天命"],"ap":1},{"id":"8ca22d6271a4","t":"郊庙歌辞 享太庙乐章 永和","a":"魏征、褚亮","d":6,"f":"四言","g":"诗","x":"於穆烈祖，弘此丕基。","b":0,"y":630,"th":["祭祀","颂祖","天命"],"ap":1},{"id":"4f9c2c2acfb4","t":"郊庙歌辞 祀圜丘乐章 豫和","a":"褚亮","d":6,"f":"七绝","g":"诗","x":"上灵睠命膺会昌，盛德殷荐叶辰良。","b":0,"y":630,"th":["颂德","祭祀","天命"],"ap":1},{"id":"b0a75b1e8f07","t":"郊庙歌辞 享太庙乐章 大明舞","a":"魏征、褚亮","d":6,"f":"四言","g":"诗","x":"五纪更运，三正递升。","b":0,"y":640,"th":["颂圣","天命","祥瑞"],"ap":1},{"id":"9dcfa2cfb748","t":"郊庙歌辞 享太庙乐章 长发舞","a":"魏征、褚亮","d":6,"f":"四言","g":"诗","x":"睿哲维唐，长发其祥。","b":0,"y":640,"th":["颂德","天命","宗法"],"ap":1},{"id":"9d06dc78d0da","t":"唐享昊天乐 第二","a":"则天皇后","d":6,"f":"古体","g":"诗","x":"瞻紫极，望玄穹。","b":1,"y":690,"th":["祭祀","天命","虔诚"],"ap":1},{"id":"d852217fd5fd","t":"唐享昊天乐 第十二","a":"则天皇后","d":6,"f":"古体","g":"诗","x":"式干路，辟天扉。","b":1,"y":690,"th":["祭祀","颂圣","天命"],"ap":1},{"id":"d72a8f124cd2","t":"唐享昊天乐 第四","a":"则天皇后","d":6,"f":"五古","g":"诗","x":"巍巍叡业广，赫赫圣基隆。","b":1,"y":690,"th":["咏物","颂德","天命"],"ap":1},{"id":"da56cd460f10","t":"唐大飨拜洛乐章 归和","a":"则天皇后","d":6,"f":"古体","g":"诗","x":"言旋云洞兮蹑烟涂，永宁中宇兮安下都。","b":1,"y":690,"th":["颂德","天命","治国"],"ap":1},{"id":"f4f519c4f546","t":"唐大飨拜洛乐章 显和","a":"则天皇后","d":6,"f":"古体","g":"诗","x":"顾德有慙虚菲，明祇屡降祯符。","b":1,"y":690,"th":["颂圣","天命","祥瑞"],"ap":1},{"id":"84d79c6fd584","t":"唐大飨拜洛乐章 致和","a":"则天皇后","d":6,"f":"古体","g":"诗","x":"神功不测兮运阴阳，包藏万宇兮孕八荒。","b":1,"y":690,"th":["颂德","天命","祭祀"],"ap":1},{"id":"a9b75f60e174","t":"曳鼎歌","a":"则天皇后","d":6,"f":"四言","g":"诗","x":"羲农首出，轩昊膺期。","b":1,"y":690,"th":["咏史","政治","天命"],"ap":1},{"id":"ba732c91db25","t":"郊庙歌辞 武后享清庙乐章十首 第二","a":"不详","d":6,"f":"四言","g":"诗","x":"隆周创业，宝命惟新。","b":1,"y":690,"th":["祭祀","礼乐","天命"],"ap":1},{"id":"5c7a2055ac16",