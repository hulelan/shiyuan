[{"id":"42746c53943d","t":"有瞽","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有瞽有瞽，在周之庭。设业设虡，崇牙树羽。应田县鼓，鞉磬柷圉。既备","b":0,"y":-1050,"th":["祭祀","礼乐","颂歌"],"ap":1},{"id":"1c75e52d670f","t":"雝","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有来雝雝，至止肃肃。相维辟公，天子穆穆。于荐广牡，相予四祀。假哉皇考！绥予孝子。","b":0,"y":-1050,"th":["祭祀","颂祖","礼乐"],"ap":1},{"id":"53c120efc59e","t":"载见","a":"佚名","d":1,"f":"诗经","g":"诗","x":"载见辟王，曰求厥章。龙旂阳阳，和铃央央。鞗革有鸧，休有烈光。率见昭考，以孝以享。","b":0,"y":-908,"th":["祭祀","朝会","礼乐"],"ap":1},{"id":"214da9858e2f","t":"鹿鸣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"呦呦鹿鸣，食野之苹。我有嘉宾，鼓瑟吹笙。吹笙鼓簧，承筐是将。人之好我，示我周行。","b":0,"y":-771,"th":["宴饮","礼乐","求贤"],"ap":1},{"id":"96bc9355fda3","t":"彤弓","a":"佚名","d":1,"f":"诗经","g":"诗","x":"彤弓弨兮，受言藏之。我有嘉宾，中心贶之。钟鼓既设，一朝飨之。","b":0,"y":-700,"th":["宴饮","赏赐","礼乐"],"ap":1},{"id":"cf9b1085ec99","t":"桑扈","a":"佚名","d":1,"f":"诗经","g":"诗","x":"交交桑扈，有莺其羽。君子乐胥，受天之祜。","b":0,"y":-700,"th":["宴饮","颂赞","礼乐"],"ap":1},{"id":"543fd246d437","t":"终南","a":"佚名","d":1,"f":"诗经","g":"诗","x":"终南何有？有条有梅。君子至止，锦衣狐裘。颜如渥丹，其君也哉！","b":0,"y":-700,"th":["赞颂","咏人","礼乐"],"ap":1},{"id":"288f7e9a1a19","t":"行苇","a":"佚名","d":1,"f":"诗经","g":"诗","x":"敦彼行苇，牛羊勿践履。方苞方体，维叶泥泥。","b":1,"y":-700,"th":["宴饮","亲情","礼乐","祈福"],"ap":1},{"id":"9dab1d281e8e","t":"那","a":"佚名","d":1,"f":"诗经","g":"诗","x":"猗与那与！置我鞉鼓。奏鼓简简，衎我烈祖。汤孙奏假，绥我思成。","b":1,"y":-700,"th":["祭祀","颂祖","礼乐"],"ap":1},{"id":"f8d965e9ddd7","t":"论语·先进篇 其26","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子路、曾皙、冉有、公西华侍坐，子曰：“以吾一日长乎尔，毋吾以也。居则曰‘不吾知也’如或知尔，则何以哉？”子路率尔而对曰：“千乘之国，摄乎大国之间，加之以师旅，因之以饥馑，由也为之，比及三年，可使有勇，且知方也。”夫子哂之。“求，尔何如？”对曰：“方六七十，如五六十，求也为之，比及三年，可使足民。如其礼乐，以俟君子。”“赤！尔何如？”对曰：“非曰能之，愿学焉。宗庙之事，如会同，端章甫，愿为小相焉。”“点，尔何如？”鼓瑟希，铿尔，舍瑟而作，对曰：“异乎三子者之撰。”子曰：“何伤乎？亦各言其志也。”曰：“暮春者，春服既成，冠者五六人，童子六七人，浴乎沂，风乎舞雩，咏而归。”夫子喟然叹曰：“吾与点也！”三子者出，曾皙后。曾皙曰：“夫三子者之言何如？”子曰：“亦各言其志也已矣。”曰：“夫子何哂由也？”曰：“为国以礼，其言不让，是故哂之。”“唯求则非邦也与？”“安见方六七十、如五六十而非邦也者？”“唯赤则非邦也与？”“宗庙会同，非诸侯而何？赤也为之小，孰能为之大？”","b":1,"y":-490,"th":["言志","礼乐","哲理","理想"],"ap":1},{"id":"69965ccd8665","t":"论语·子罕篇 其15","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“吾自卫反鲁，然后乐正，《雅》、《颂》各得其所。”","b":2,"y":-484,"th":["哲理","文化","礼乐"],"ap":1},{"id":"393800565adc","t":"论语·八佾篇 其16","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“射不主皮，为力不同科，古之道也。”","b":2,"y":-450,"th":["哲理","礼乐"],"ap":1},{"id":"b636b6fc552f","t":"论语·八佾篇 其2","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"三家者以《雍》彻,子曰：“‘相维辟公，天子穆穆’，奚取于三家之堂？”","b":2,"y":-450,"th":["礼乐","哲理","政治"],"ap":1},{"id":"c96f6425e4f3","t":"论语·八佾篇 其20","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“《关睢》，乐而不淫，哀而不伤。”","b":2,"y":-450,"th":["哲理","爱情","礼乐"],"ap":1},{"id":"e26d35802a1b","t":"论语·八佾篇 其3","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“人而不仁，如礼何？人而不仁，如乐何？”","b":2,"y":-450,"th":["哲理","礼乐","仁德"],"ap":1},{"id":"b3631a7ec307","t":"论语·八佾篇 其8","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子夏问曰：“‘巧笑倩兮，美目盼兮，素以为绚兮’何谓也？”子曰：“绘事后素。”曰：“礼后乎？”子曰：“起予者商也，始可与言《诗》已矣。”","b":2,"y":-450,"th":["哲理","教育","礼乐"],"ap":1},{"id":"6546cb3402a9","t":"论语·八佾篇 其9","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“夏礼吾能言之，杞不足征也；殷礼吾能言之，宋不足征也。文献不足故也，足则吾能征之矣。”","b":2,"y":-450,"th":["哲理","怀古","礼乐"],"ap":1},{"id":"16031e5d2080","t":"论语·泰伯篇 其15","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“师挚之始，《关雎》之乱，洋洋乎盈耳哉！”","b":3,"y":-450,"th":["音乐","礼乐","哲理"],"ap":1},{"id":"50873c8b03a1","t":"论语·述而篇 其18","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子所雅言，《诗》、《书》、执礼，皆雅言也。","b":3,"y":-450,"th":["哲理","礼乐","崇古"],"ap":1},{"id":"b8e791ba382c","t":"论语·阳货篇 其11","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“礼云礼云，玉帛云乎哉？乐云乐云，钟鼓云乎哉？”","b":3,"y":-450,"th":["哲理","道德","礼乐"],"ap":1},{"id":"2b715356c682","t":"论语·阳货篇 其18","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“恶紫之夺朱也，恶郑声之乱雅乐也，恶利口之覆邦家者。”","b":3,"y":-450,"th":["哲理","政治","礼乐"],"ap":1},{"id":"8fd39e62e469","t":"郊庙歌辞 享先农乐章 肃和","a":"褚亮","d":6,"f":"四言","g":"诗","x":"樽彝既列，瑚簋方荐。","b":0,"y":595,"th":["祭祀","祈福","礼乐"],"ap":1},{"id":"6534dd015d6e","t":"郊庙歌辞 享先农乐章 舒和","a":"褚亮","d":6,"f":"七绝","g":"诗","x":"羽籥低昂文缀已，干戚蹈厉武行初。","b":0,"y":595,"th":["祭祀","祈农","礼乐"],"ap":1},{"id":"414685335bd0","t":"郊庙歌辞 祭[太]社乐章 雍和","a":"褚亮","d":6,"f":"四言","g":"诗","x":"美报崇本，严恭展事。","b":0,"y":595,"th":["祭祀","礼乐","祈福"],"ap":1},{"id":"8bd1d6c764