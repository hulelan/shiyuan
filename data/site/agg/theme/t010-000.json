[{"id":"9e65cab984a0","t":"访落","a":"佚名","d":1,"f":"诗经","g":"诗","x":"访予落止，率时昭考。于乎悠哉，朕未有艾。将予就之，继犹判涣。","b":0,"y":-1042,"th":["咏史","政治","祭祀"],"ap":1},{"id":"01dfda4aec15","t":"羔羊","a":"佚名","d":1,"f":"诗经","g":"诗","x":"羔羊之皮，素丝五紽。退食自公，委蛇委蛇。","b":0,"y":-823,"th":["咏物","政治","哲理"],"ap":1},{"id":"744083df86ee","t":"扬之水","a":"佚名","d":1,"f":"诗经","g":"诗","x":"扬之水，白石凿凿。素衣朱襮，从子于沃。既见君子，云何不乐？","b":0,"y":-745,"th":["政治","纪事","咏怀"],"ap":1},{"id":"2c040c6ce664","t":"无衣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"岂曰无衣七兮？不如子之衣，安且吉兮！","b":0,"y":-700,"th":["感恩","咏物","政治"],"ap":1},{"id":"a60570ff024e","t":"狼跋","a":"佚名","d":1,"f":"诗经","g":"诗","x":"狼跋其胡，载疐其尾。公孙硕肤，赤舄几几。","b":0,"y":-700,"th":["讽刺","咏物","政治"],"ap":1},{"id":"08b6b4adb2fa","t":"羔裘","a":"佚名","d":1,"f":"诗经","g":"诗","x":"羔裘如濡，洵直且侯。彼其之子，舍命不渝。","b":0,"y":-700,"th":["咏物","赞颂","政治"],"ap":1},{"id":"6a92a8432d58","t":"采菽","a":"佚名","d":1,"f":"诗经","g":"诗","x":"采菽采菽，筐之莒之。君子来朝，何锡予之？虽无予之？路车乘马。又何予之？玄衮及黼。","b":1,"y":-700,"th":["朝会","颂赞","政治","祝颂"],"ap":1},{"id":"13993fa28fb3","t":"青蝇","a":"佚名","d":1,"f":"诗经","g":"诗","x":"营营青蝇，止于樊。岂弟君子，无信谗言。","b":1,"y":-700,"th":["咏物","讽喻","政治"],"ap":1},{"id":"74d23b1c9afe","t":"南山","a":"佚名","d":1,"f":"诗经","g":"诗","x":"南山崔崔，雄狐绥绥。鲁道有荡，齐子由归。既曰归止，曷又怀止？","b":1,"y":-694,"th":["讽刺","政治","伦理"],"ap":1},{"id":"55a2cd4e75ff","t":"载驱","a":"佚名","d":1,"f":"诗经","g":"诗","x":"载驱薄薄，簟茀朱鞹。鲁道有荡，齐子发夕。","b":1,"y":-694,"th":["讽刺","史事","政治"],"ap":1},{"id":"458a0c6020bf","t":"墙有茨","a":"佚名","d":1,"f":"诗经","g":"诗","x":"墙有茨，不可扫也。中冓之言，不可道也。所可道也，言之丑也。","b":1,"y":-650,"th":["讽刺","政治","宫闱"],"ap":1},{"id":"fd285bc59340","t":"敝笱","a":"佚名","d":1,"f":"诗经","g":"诗","x":"敝笱在梁，其鱼鲂鳏。齐子归止，其从如云。","b":1,"y":-650,"th":["讽刺","政治","咏物"],"ap":1},{"id":"51672a83c681","t":"株林","a":"佚名","d":1,"f":"诗经","g":"诗","x":"胡为乎株林？从夏南！匪适株林，从夏南！","b":1,"y":-600,"th":["讽刺","政治","咏史"],"ap":1},{"id":"143e95957f81","t":"论语·先进篇 其24","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"季子然问：“仲由、冉求可谓大臣与？”子曰：“吾以子为异之问，曾由与求之问。所谓大臣者，以道事君，不可则止。今由与求也，可谓具臣矣。”曰：“然则从之者与？”子曰：“弑父与君，亦不从也。”","b":1,"y":-500,"th":["哲理","政治","伦理"],"ap":1},{"id":"0d05713f5c0f","t":"论语·八佾篇 其19","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"定公问：“君使臣，臣事君，如之何？”孔子对曰：“君使臣以礼，臣事君以忠。”","b":1,"y":-500,"th":["哲理","政治","伦理"],"ap":1},{"id":"3d89863a00d4","t":"论语·子张篇 其10","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子夏曰：“君子信而后劳其民，未信，则以为厉己也；信而后谏，未信，则以为谤己也。”","b":1,"y":-500,"th":["哲理","政治","信任"],"ap":1},{"id":"6236b29bc4ff","t":"论语·季氏篇 其2","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"孔子曰：“天下有道，则礼乐征伐自天子出；天下无道，则礼乐征伐自诸侯出。自诸侯出，盖十世希不失矣；自大夫出，五世希不失矣；陪臣执国命，三世希不失矣。天下有道，则政不在大夫；天下有道，则庶人不议。”","b":1,"y":-500,"th":["哲理","政治","怀古"],"ap":1},{"id":"ef40959bc92e","t":"论语·泰伯篇 其13","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“笃信好学，守死善道。危邦不入，乱邦不居。天下有道则见，无道则隐。邦有道，贫且贱焉，耻也；邦无道，富且贵焉，耻也。”","b":1,"y":-500,"th":["哲理","政治","操守"],"ap":1},{"id":"38dc55c8e0d3","t":"论语·述而篇 其15","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"冉有曰：“夫子为卫君乎？”子贡曰：“诺，吾将问之。”入，曰：“伯夷、叔齐何人也？”曰：“古之贤人也。”曰：“怨乎？”曰：“求仁而得仁，又何怨？”出，曰：“夫子不为也。”","b":1,"y":-500,"th":["哲理","政治","道德"],"ap":1},{"id":"2c1295dd3112","t":"论语·阳货篇 其5","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"公山弗扰以费畔，召，子欲往。子路不说，曰：“末之也已，何必公山氏之之也？”子曰：“夫召我者而岂徒哉？如有用我者，吾其为东周乎！”","b":1,"y":-500,"th":["哲理","政治","抱负"],"ap":1},{"id":"93356732abbf","t":"论语·雍也篇 其24","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“齐一变至于鲁，鲁一变至于道。”","b":1,"y":-500,"th":["哲理","政治","理想"],"ap":1},{"id":"92a9cc94d80f","t":"论语·颜渊篇 其14","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子张问政，子曰：“居之无倦，行之以忠。”","b":1,"y":-500,"th":["哲理","政治","修身"],"ap":1},{"id":"4b3157e4a39a","t":"论语·八佾篇 其13","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"王孙贾问曰：“‘与其媚于奥，宁媚于灶’，何谓也？”子曰：“不然，获罪于天，无所祷也。”","b":1,"y":-492,"th":["哲理","道德","政治"],"ap":1},{"id":"4c53929609aa","t":"论语·卫灵公篇 其14","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“臧文仲其窃位者与！知柳下惠之贤而不与立也。”","b":1,"y":-490,"th":["哲理","举贤","政治"],"ap":1},{"id":"df715e95efd3","t":"论语·卫灵公篇 其5","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“无为而治者其舜也与！夫何为哉？恭己正南面而已矣。”","b":1,"y":-490,"th":["哲理","政治","修身"],"ap":1},{"id":"ff2bbafbc285","t":"论语·子路篇 其16","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"叶公问政，子曰：“近者说，远者来。”","b":2,"y":-490,"th":["哲理","政治"],"ap":1},{"id":"4754a83c301e","t":"论语·颜渊篇 其19","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"季康子问政于孔子曰：“如杀无道以就有道，何如？”孔子对曰：“子为政，焉用杀？子欲善而民善矣。君子之德风，小人之德草，草上之风必偃。”","b":2,"y":-490,"th":["哲理","政治","德行"],"ap":1},{"id":"719d776f6257","t":"论语·子路篇 其3","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子路曰：“卫君待子而为政，子将奚先？”子曰：“必也正名乎！”子路曰：“有是哉，子之迂也！奚其正？”子曰：“野哉由也！君子于其所不知，盖阙如也。名不正，则言不顺；言不顺，则事不成；事不成，则礼乐不兴；礼乐不兴，则刑罚不中；刑罚不中，则民无所错手足。故君子名之必可言也，言之必可行也。君子于其言，无所苟而已矣。”","b":2,"y":-488,"th":["哲理","政治","师生问答"],"ap":1},{"id":"1ae1bc1e1a11","t":"论语·为政篇 其1","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“为政以德，譬如北辰，居其所而众星共之。”","b":2,"y":-450,"th":["哲理","政治","德治"],"ap":1},{"id":"735ddeb537c3","t":"论语·为政篇 其21","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"或谓孔子曰：“子奚不为政？”子曰：“《书》云：‘孝乎惟孝，友于兄弟，施于有政。’是亦为政，奚其为为政？”","b":2,"y":-450,"th":["哲理","政治","伦理"],"ap":1},{"id":"99654e1bbcd5","t":"论语·为政篇 其3","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“道之以政，齐之以刑，民免而无耻。道之以德，齐之以礼，有耻且格。”","b":2,"y":-450,"th":["哲理","政治","教化"],"ap":1},{"id":"c6f31d2b9bbf","t":"论语·先进篇 其14","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"鲁人为长府，闵子骞曰：“仍旧贯如之何？何必改作？”子曰：“夫人不言，言必有中。”","b":2,"y":-450,"th":["哲理","政治","为人处世"],"ap":1},{"id":"bab3cde298fd","t":"论语·八佾篇 其1","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"孔子谓季氏:“八佾舞于庭，是可忍也，孰不可忍也?”","b":2,"y":-450,"th":["礼制","哲理","政治"],"ap":1},{"id":"b636b6fc552f","t":"论语·八佾篇 其2","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"三家者以《雍》彻,子曰：“‘相维辟公，天子穆穆’，奚取于三家之堂？”","b":2,"y":-450,"th":["礼乐","哲理","政治"],"ap":1},{"id":"29d6872d0c72","t":"论语·八佾篇 其5","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“夷狄之有君，不如诸夏之亡也。”","b":2,"y":-450,"th":["哲理","礼制","政治"],"ap":1},{"id":"12475a625bed","t":"论语·子路篇 其20","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子贡问曰：“何如斯可谓之士矣？”子曰：“行己有耻，使于四方不辱君命，可谓士矣。”曰：“敢问其次。”曰：“宗族称孝焉，乡党称弟焉。”曰：“敢问其次。”曰：“言必信，行必果，踁踁然小人哉！抑亦可以为次矣。”曰：“今之从政者何如？”子曰：“噫！斗筲之人，何足算也！”","b":3,"y":-450,"th":["哲理","修身","政治"],"ap":1},{"id":"7682445cd0fb","t":"论语·季氏篇 其3","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"孔子曰：“禄之去公室五世矣，政逮于大夫四世矣，故夫三桓之子孙微矣。”","b":3,"y":-450,"th":["哲理","怀古","政治"],"ap":1},{"id":"5de7114d3fc9","t":"论语·宪问篇 其14","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“臧武仲以防求为后于鲁，虽曰不要君，吾不信也。”","b":3,"y":-450,"th":["哲理","政治","礼制"],"ap":1},{"id":"aca19d3abc5c","t":"论语·宪问篇 其41","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“上好礼，则民易使也。”","b":3,"y":-450,"th":["哲理","政治","德治"],"ap":1},{"id":"3367b82fed0b","t":"论语·尧曰篇 其2","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子张问于孔子曰：“何如斯可以从政矣？”子曰：“尊五美，屏四恶，斯可以从政矣。”子张曰：“何谓五美？”子曰：“君子惠而不费，劳而不怨，欲而不贪，泰而不骄，威而不猛。”子张曰：“何谓惠而不费？”子曰：“因民之所利而利之，斯不亦惠而不费乎？择可劳而劳之，又谁怨？欲仁而得仁，又焉贪？君子无众寡，无小大，无敢慢，斯不亦泰而不骄乎？君子正其衣冠，尊其瞻视，俨然人望而畏之，斯不亦威而不猛乎？”子张曰：“何谓四恶？”子曰：“不教而杀谓之虐；不戒视成谓之暴；慢令致期谓之贼；犹之与人也，出纳之吝谓之有司。”","b":3,"y":-450,"th":["哲理","政治","修身"],"ap":1},{"id":"ff3105cb94b9","t":"论语·泰伯篇 其14","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“不在其位，不谋其政。”","b":3,"y":-450,"th":["哲理","政治","处世之道"],"ap":1},{"id":"cd762b8ae3b7","t":"论语·泰伯篇 其18","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“巍巍乎！舜、禹之有天下也而不与焉。”","b":3,"y":-450,"th":["哲理","咏史","政治"],"ap":1},{"id":"273fe3c02184","t":"论语·泰伯篇 其19","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“大哉尧之为君也！巍巍乎，唯天为大，唯尧则之。荡荡乎，民无能名焉。巍巍乎其有成功也，焕乎其有文章！”","b":3,"y":-450,"th":["哲理","咏史","政治"],"ap":1},{"id":"2b715356c682","t":"论语·阳货篇 其18","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“恶紫之夺朱也，恶郑声之乱雅乐也，恶利口之覆邦家者。”","b":3,"y":-450,"th":["哲理","政治","礼乐"],"ap":1},{"id":"77ec52565d9f","t":"中庸·中庸 其20","a":"子思（传）","d":1,"f":"文","g":"文","x":"哀公问政。子曰：「文、武之政，布在方策，其人存，则其政举；其人亡，则其政息。人道敏政，地道敏树。夫政也者，蒲卢也。故为政在人，取人以身，修身以道，修道以仁。仁者人也，亲亲为大；义者宜也，尊贤为大。亲亲之杀，尊贤之等，礼所生也。在下位不获乎上，民不可得而治矣！故君子不可以不修身；思修身，不可以不事亲；思事亲，不可以不知人；思知人，不可以不知天。天下之达道五，所以行之者三，曰：君臣也，父子也，夫妇也，昆弟也，朋友之交也，五者天下之达道也。知仁勇三者，天下之达德也，所以行之者一也。或生而知之，或学而知之，或困而知之，及其知之，一也；或安而行之，或利而行之，或勉强而行之，及其成功，一也。」","b":4,"y":-400,"th":["哲理","政治","修身"],"ap":1},{"id":"609bb55666c3","t":"孟子·梁惠王下 其51","a":"孟子","d":1,"f":"文","g":"文","x":"邹与鲁哄。穆公问曰：「吾有司死者三十三人，而民莫之死也。诛之，则不可胜诛；不诛，则疾视其长上之死而不救，如之何则可也？」","b":4,"y":-350,"th":["哲理","民本","政治"],"ap":1},{"id":"730c67303756","t":"孟子·公孙丑上 其1","a":"孟子","d":1,"f":"文","g":"文","x":"公孙丑问曰：「夫子当路于齐，管仲、晏子之功，可复许乎？」","b":4,"y":-320,"th":["哲理","政治","王道"],"ap":1},{"id":"fb5583c44827","t":"孟子·公孙丑上 其23","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「诐辞知其所蔽，淫辞知其所陷，邪辞知其所离，遁辞知其所穷。生于其心，害于其政；发于其政，害于其事。圣人复起，必从吾言矣。」","b":4,"y":-320,"th":["哲理","政治","言辞"],"ap":1},{"id":"ff11206e9d4a","t":"孟子·公孙丑上 其36","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「以力假仁者霸，霸必有大国，以德行仁者王，王不待大。汤以七十里，文王以百里。以力服人者，非心服也，力不赡也；以德服人者，中心悦而诚服也，如七十子之服孔子也。《诗》云：『自西自东，自南自北，无思不服。』此之谓也。」","b":4,"y":-320,"th":["哲理","政治","仁政"],"ap":1},{"id":"034975773c6f","t":"孟子·公孙丑上 其4","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「以齐王，由反手也。」","b":4,"y":-320,"th":["哲理","政治","仁政"],"ap":1},{"id":"53d5b454aaf4","t":"孟子·公孙丑上 其5","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「若是，则弟子之惑滋甚。且以文王之德，百年而后崩，犹未洽于天下；武王、周公继之，然后大行。今言王若易然，则文王不足法与？」","b":4,"y":-320,"th":["哲理","怀古","政治"],"ap":1},{"id":"cedb54aaedf9","t":"孟子·公孙丑上 其6","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「文王何可当也？由汤至于武丁，贤圣之君六七作。天下归殷久矣，久则难变也。武丁朝诸侯有天下，犹运之掌也。纣之去武丁未久也，其故家遗俗，流风善政，犹有存者；又有微子、微仲、王子比干、箕子、胶鬲皆贤人也，相与辅相之，故久而后失之也。尺地莫非其有也，一民莫非其臣也，然而文王犹方百里起，是以难也。齐人有言曰：『虽有智慧，不如乘势；虽有镃基，不如待时。』","b":4,"y":-320,"th":["哲理","历史","政治"],"ap":1},{"id":"3a97bf49258d","t":"孟子·公孙丑上 其8","a":"孟子","d":1,"f":"文","g":"文","x":"公孙丑问曰：「夫子加齐之卿相，得行道焉，虽由此霸王不异矣。如此，则动心否乎？」","b":4,"y":-320,"th":["哲理","政治","心性修养"],"ap":1},{"id":"b27d51d42531","t":"孟子·公孙丑下 其15","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「今有受人之牛羊而为之牧之者，则必为之求牧与刍矣。求牧与刍而不得，则反诸其人乎？抑亦立而视其死与？」","b":4,"y":-320,"th":["哲理","政治","比喻"],"ap":1},{"id":"b643c8d124aa","t":"孟子·公孙丑下 其18","a":"孟子","d":1,"f":"文","g":"文","x":"孟子谓蚔鼃曰：「子之辞灵丘而请士师，似也，为其可以言也。今既数月矣，未可以言与？」","b":4,"y":-320,"th":["哲理","政治","进谏"],"ap":1},{"id":"27125a682168","t":"孟子·公孙丑下 其19","a":"孟子","d":1,"f":"文","g":"文","x":"蚔鼃谏于王而不用，致为臣而去。齐人曰：「所以为蚔鼃，则善矣；所以自为，则吾不知也。」","b":4,"y":-320,"th":["哲理","出处进退","政治"],"ap":1},{"id":"5942aefb1615","t":"孟子·公孙丑下 其2","a":"孟子","d":1,"f":"文","g":"文","x":"孟子将朝王，王使人来曰：「寡人如就见者也，有寒疾，不可以风。朝将视朝，不识可使寡人得见乎？」对曰：「不幸而有疾，不能造朝。」","b":4,"y":-320,"th":["哲理","政治","品格"],"ap":1},{"id":"a6117ce8d1af","t":"孟子·公孙丑下 其22","a":"孟子","d":1,"f":"文","g":"文","x":"公孙丑曰：「齐卿之位，不为小矣；齐滕之路，不为近矣。反之而未尝与言行事，何也？」","b":4,"y":-320,"th":["哲理","师生","政治"],"ap":1},{"id":"32b2d1570616","t":"孟子·公孙丑下 其27","a":"孟子","d":1,"f":"文","g":"文","x":"沈同以其私问曰：「燕可伐与？」","b":4,"y":-320,"th":["哲理","政治","伦理"],"ap":1},{"id":"dba87f7fe0d5","t":"孟子·公孙丑下 其28","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「可。子哙不得与人燕，子之不得受燕于子哙。有仕于此，而子悦之，不告于王而私与之吾子之禄爵；夫士也，亦无王命而私受之于子，则可乎？何以异于是？」","b":4,"y":-320,"th":["哲理","政治","论辩"],"ap":1},{"id":"777e959335e7","t":"孟子·公孙丑下 其29","a":"孟子","d":1,"f":"文","g":"文","x":"齐人伐燕。或问曰：「劝齐伐燕，有诸？」","b":4,"y":-320,"th":["哲理","民本","政治"],"ap":1},{"id":"e061f8ca1c26","t":"孟子·公孙丑下 其32","a":"孟子","d":1,"f":"文","g":"文","x":"陈贾曰：「王无患焉。王自以为与周公，孰仁且智？」","b":4,"y":-320,"th":["哲理","政治","怀古"],"ap":1},{"id":"05629eed8f32","t":"孟子·公孙丑下 其4","a":"孟子","d":1,"f":"文","g":"文","x":"王使人问疾，医来。孟仲子对曰：「昔者有王命，有采薪之忧，不能造朝。今病小愈，趋造于朝，我不识能至否乎？」使数人要于路，曰：「请必无归，而造于朝！」","b":4,"y":-320,"th":["哲理","政治"],"ap":1},{"id":"4aef990145da","t":"孟子·公孙丑下 其44","a":"孟子","d":1,"f":"文","g":"文","x":"他日，王谓时子曰：「我欲中国而授孟子室，养弟子以万锺，使诸大夫国人皆有所矜式。子盍为我言之？」","b":4,"y":-320,"th":["哲理","政治","品格"],"ap":1},{"id":"e0ef052a03bb","t":"孟子·公孙丑下 其45","a":"孟子","d":1,"f":"文","g":"文","x":"时子因陈子而以告孟子，陈子以时子之言告孟子。孟子曰：「然。夫时子恶知其不可也？如使予欲富，辞十万而受万，是为欲富乎？季孙曰：『异哉子叔疑！使己为政，不用，则亦已矣，又使其子弟为卿。人亦孰不欲富贵？而独于富贵之中，有私龙断焉。』古之为市也，以其所有易其所无者，有司者治之耳。有贱丈夫焉，必求龙断而登之，以左右望而罔市利。人皆以为贱，故从而征之。征商，自此贱丈夫始矣。","b":4,"y":-320,"th":["哲理","义利之辨","政治"],"ap":1},{"id":"e4157d708ef3","t":"孟子·公孙丑下 其49","a":"孟子","d":1,"f":"文","g":"文","x":"孟子去齐。尹士语人曰：「不识王之不可以为汤武，则是不明也；识其不可，然且至，则是干泽也。千里而见王，不遇故去。三宿而后出昼，是何濡滞也？士则兹不悦。」","b":4,"y":-320,"th":["哲理","政治","怀古"],"ap":1},{"id":"34a52859b415","t":"孟子·公孙丑下 其6","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「恶！是何言也！齐人无以仁义与王言者，岂以仁义为不美也？其心曰『是何足与言仁义也』云尔，则不敬莫大乎是。我非尧舜之道，不敢以陈于王前，故齐人莫如我敬王也。」","b":4,"y":-320,"th":["哲理","政治","仁义"]},{"id":"025280f81360","t":"孟子·梁惠王上 其12","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「无以异也。」","b":4,"y":-320,"th":["哲理","政治","论辩"],"ap":1},{"id":"37e8c09428ee","t":"孟子·梁惠王上 其2","a":"孟子","d":1,"f":"文","g":"文","x":"孟子对曰：「王何必曰利？亦有仁义而已矣。王曰『何以利吾国』？大夫曰『何以利吾家』？士庶人曰『何以利吾身』？上下交征利而国危矣。万乘之国弑其君者，必千乘之家；千乘之国弑其君者，必百乘之家。万取千焉，千取百焉，不为不多矣。苟为后义而先利，不夺不餍。未有仁而遗其亲者也，未有义而后其君者也。王亦曰仁义而已矣，何必曰利？」","b":4,"y":-320,"th":["哲理","政治","仁义"],"ap":1},{"id":"aac44ab70b35","t":"孟子·梁惠王上 其23","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「德何如，则可以王矣？」","b":4,"y":-320,"th":["哲理","政治","仁政"],"ap":1},{"id":"e62a5b5027da","t":"孟子·梁惠王上 其24","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「保民而王，莫之能御也。」","b":4,"y":-320,"th":["哲理","政治","仁政"],"ap":1},{"id":"0b920f82e83d","t":"孟子·梁惠王上 其27","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「何由知吾可也？」","b":4,"y":-320,"th":["哲理","政治","对话"],"ap":1},{"id":"aa5c9b1ba1b6","t":"孟子·梁惠王上 其36","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「有复于王者曰：『吾力足以举百钧』，而不足以举一羽；『明足以察秋毫之末』，而不见舆薪，则王许之乎？」","b":4,"y":-320,"th":["哲理","政治","辩论"],"ap":1},{"id":"098b107016d6","t":"孟子·梁惠王上 其38","a":"孟子","d":1,"f":"文","g":"文","x":"「今恩足以及禽兽，而功不至于百姓者，独何与？然则一羽之不举，为不用力焉；舆薪之不见，为不用明焉，百姓之不见保，为不用恩焉。故王之不王，不为也，非不能也。」","b":4,"y":-320,"th":["哲理","民本","政治"],"ap":1},{"id":"2fbfc4d76321","t":"孟子·梁惠王上 其39","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「不为者与不能者之形何以异？」","b":4,"y":-320,"th":["哲理","政治","辩论"],"ap":1},{"id":"b2f6d9cee659","t":"孟子·梁惠王上 其41","a":"孟子","d":1,"f":"文","g":"文","x":"王曰：「否。吾何快于是？将以求吾所大欲也。」","b":4,"y":-320,"th":["哲理","政治","对话"],"ap":1},{"id":"2a5597e36409","t":"孟子·梁惠王上 其42","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「王之所大欲可得闻与？」王笑而不言。","b":4,"y":-320,"th":["哲理","政治","心理"],"ap":1},{"id":"33dbfd97ef62","t":"孟子·梁惠王上 其43","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「为肥甘不足于口与？轻煖不足于体与？抑为采色不足视于目与？声音不足听于耳与？便嬖不足使令于前与？王之诸臣皆足以供之，而王岂为是哉？」","b":4,"y":-320,"th":["哲理","政治","辩说"],"ap":1},{"id":"b78f8e76ede6","t":"孟子·梁惠王上 其45","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「然则王之所大欲可知已。欲辟土地，朝秦楚，莅中国而抚四夷也。以若所为求若所欲，犹缘木而求鱼也。」","b":4,"y":-320,"th":["哲理","政治","雄辩"],"ap":1},{"id":"fb76ce39788c","t":"孟子·梁惠王上 其47","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「殆有甚焉。缘木求鱼，虽不得鱼，无后灾。以若所为，求若所欲，尽心力而为之，后必有灾。」","b":4,"y":-320,"th":["哲理","政治","说理"],"ap":1},{"id":"d72ca22a7591","t":"孟子·梁惠王上 其48","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「可得闻与？」","b":4,"y":-320,"th":["哲理","政治","论辩"],"ap":1},{"id":"745f5e081e5d","t":"孟子·梁惠王上 其49","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「邹人与楚人战，则王以为孰胜？」","b":4,"y":-320,"th":["哲理","政治"],"ap":1},{"id":"2e2d1883aa87","t":"孟子·梁惠王上 其5","a":"孟子","d":1,"f":"文","g":"文","x":"梁惠王曰：「寡人之于国也，尽心焉耳矣。河内凶，则移其民于河东，移其粟于河内。河东凶亦然。察邻国之政，无如寡人之用心者。邻国之民不加少，寡人之民不加多，何也？」","b":4,"y":-320,"th":["哲理","政治","仁政"],"ap":1},{"id":"3c17821a1077","t":"孟子·梁惠王上 其50","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「楚人胜。」","b":4,"y":-320,"th":["哲理","政治"],"ap":1},{"id":"65bccf689c41","t":"孟子·梁惠王上 其51","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「然则小固不可以敌大，寡固不可以敌众，弱固不可以敌彊。海内之地方千里者九，齐集有其一。以一服八，何以异于邹敌楚哉？盖亦反其本矣。今王发政施仁，使天下仕者皆欲立于王之朝，耕者皆欲耕于王之野，商贾皆欲藏于王之市，行旅皆欲出于王之涂，天下之欲疾其君者皆欲赴愬于王。其若是，孰能御之？」","b":4,"y":-320,"th":["哲理","政治","仁政"],"ap":1},{"id":"a7f33f9f9e0d","t":"孟子·梁惠王上 其6","a":"孟子","d":1,"f":"文","g":"文","x":"孟子对曰：「王好战，请以战喻。填然鼓之，兵刃既接，弃甲曳兵而走。或百步而后止，或五十步而后止。以五十步笑百步，则何如？」","b":4,"y":-320,"th":["哲理","政治","劝谏"],"ap":1},{"id":"48e79bda4e66","t":"孟子·梁惠王上 其7","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「不可，直不百步耳，是亦走也。」","b":4,"y":-320,"th":["哲理","政治","讽喻"],"ap":1},{"id":"2fd6370051e1","t":"孟子·梁惠王下 其10","a":"孟子","d":1,"f":"文","g":"文","x":"孟子对曰：「于传有之。」","b":4,"y":-320,"th":["哲理","论辩","政治"],"ap":1},{"id":"b6b7c1426378","t":"孟子·梁惠王下 其13","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「寡人之囿方四十里，民犹以为大，何也？」","b":4,"y":-320,"th":["哲理","民本","政治"],"ap":1},{"id":"5f3647478f00","t":"孟子·梁惠王下 其15","a":"孟子","d":1,"f":"文","g":"文","x":"齐宣王问曰：「交邻国有道乎？」","b":4,"y":-320,"th":["哲理","政治","邦交"],"ap":1},{"id":"4ab6eff1f432","t":"孟子·梁惠王下 其23","a":"孟子","d":1,"f":"文","g":"文","x":"孟子对曰：「夫明堂者，王者之堂也。王欲行王政，则勿毁之矣。」","b":4,"y":-320,"th":["哲理","政治","仁政"],"ap":1},{"id":"c03f2718e86b","t":"孟子·梁惠王下 其24","a":"孟子","d":1,"f":"文","g":"文","x":"王曰：「王政可得闻与？」","b":4,"y":-320,"th":["哲理","政治","仁政"],"ap":1},{"id":"68666bdd8809","t":"孟子·梁惠王下 其28","a":"孟子","d":1,"f":"文","g":"文","x":"王曰：「寡人有疾，寡人好货。」","b":4,"y":-320,"th":["哲理","政治","人性"],"ap":1},{"id":"1f854b46d3e4","t":"孟子·梁惠王下 其29","a":"孟子","d":1,"f":"文","g":"文","x":"对曰：「昔者公刘好货，《诗》云：『乃积乃仓，乃裹糇粮，于橐于囊。思戢用光。弓矢斯张，干戈戚扬，爰方启行。』故居者有积仓，行者有裹粮也，然后可以爰方启行。王如好货，与百姓同之，于王何有？」","b":4,"y":-320,"th":["哲理","政治","民本"],"ap":1},{"id":"bab292a63343","t":"孟子·梁惠王下 其30","a":"孟子","d":1,"f":"文","g":"文","x":"王曰：「寡人有疾，寡人好色。」","b":4,"y":-320,"th":["哲理","政治","仁政"],"ap":1},{"id":"e585882b7203","t":"孟子·梁惠王下 其32","a":"孟子","d":1,"f":"文","g":"文","x":"孟子谓齐宣王曰：「王之臣有托其妻子于其友，而之楚游者。比其反也，则冻馁其妻子，则如之何？」","b":5,"y":-320,"th":["哲理","政治","论辩"],"ap":1},{"id":"5eceb90f8f03","t":"孟子·梁惠王下 其34","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「士师不能治士，则如之何？」","b":5,"y":-320,"th":["哲理","政治","问答"],"ap":1},{"id":"cae0d464bcd5","t":"孟子·梁惠王下 其37","a":"孟子","d":1,"f":"文","g":"文","x":"王顾左右而言他。","b":5,"y":-320,"th":["哲理","讽刺","政治"],"ap":1},{"id":"acabc55d5359","t":"孟子·梁惠王下 其38","a":"孟子","d":1,"f":"文","g":"文","x":"孟子见齐宣王曰：「所谓故国者，非谓有乔木之谓也，有世臣之谓也。王无亲臣矣，昔者所进，今日不知其亡也。」","b":5,"y":-320,"th":["哲理","政治","用人"],"ap":1},{"id":"c98e23907e6b","t":"孟子·梁惠王下 其39","a":"孟子","d":1,"f":"文","g":"文","x":"王曰：「吾何以识其不才而舍之？」","b":5,"y":-320,"th":["哲理","政治","用人"],"ap":1},{"id":"968c762c776b","t":"孟子·梁惠王下 其43","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「臣弑其君可乎？」","b":5,"y":-320,"th":["哲理","民本","政治"],"ap":1},{"id":"ac720a45f8e5","t":"孟子·梁惠王下 其44","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「贼仁者谓之贼，贼义者谓之残，残贼之人谓之一夫。闻诛一夫纣矣，未闻弑君也。」","b":5,"y":-320,"th":["民本","哲理","仁政","政治"],"ap":1},{"id":"ff0d29e53054","t":"孟子·梁惠王下 其50","a":"孟子","d":1,"f":"文","g":"文","x":"「今燕虐其民，王往而征之。民以为将拯己于水火之中也，箪食壶浆，以迎王师。若杀其父兄，系累其子弟，毁其宗庙，迁其重器，如之何其可也？天下固畏齐之彊也。今又倍地而不行仁政，是动天下之兵也。王速出令，反其旄倪，止其重器，谋于燕众，置君而后去之，则犹可及止也。」","b":5,"y":-320,"th":["仁政","民本","哲理","政治"],"ap":1},{"id":"b4eb088461cc","t":"孟子·梁惠王下 其53","a":"孟子","d":1,"f":"文","g":"文","x":"滕文公问曰：「滕，小国也，间于齐楚。事齐乎？事楚乎？」","b":5,"y":-320,"th":["政治","哲理","生存困境"],"ap":1},{"id":"4b0149713212","t":"孟子·梁惠王下 其9","a":"孟子","d":1,"f":"文","g":"文","x":"齐宣王问曰：「文王之囿方七十里，有诸？」","b":5,"y":-320,"th":["哲理","怀古","政治"],"ap":1},{"id":"fcb3e9e6116a","t":"孟子·滕文公下 其23","a":"孟子","d":1,"f":"文","g":"文","x":"万章问曰：「宋，小国也。今将行王政，齐楚恶而伐之，则如之何？」","b":5,"y":-320,"th":["哲理","政治","仁政"],"ap":1},{"id":"d0886a12079d","t":"孟子·滕文公下 其3","a":"孟子","d":1,"f":"文","g":"文","x":"景春曰：「公孙衍、张仪岂不诚大丈夫哉？一怒而诸侯惧，安居而天下熄。」","b":5,"y":-320,"th":["哲理","怀古","政治"],"ap":1},{"id":"fac5f3511918","t":"孟子·滕文公下 其30","a":"孟子","d":1,"f":"文","g":"文","x":"戴盈之曰：「什一，去关市之征，今兹未能。请轻之，以待来年，然后已，何如？」","b":5,"y":-320,"th":["哲理","政治","民本"],"ap":1},{"id":"ab248f821dda","t":"孟子·滕文公下 其7","a":"孟子","d":1,"f":"文","g":"文","x":"「三月无君则吊，不以急乎？」","b":5,"y":-320,"th":["哲理","入世","政治"],"ap":1},{"id":"e8eec9b8066d","t":"孟子·离娄上 其1","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「离娄之明，公输子之巧，不以规矩，不能成方员：师旷之聪，不以六律，不能正五音；尧舜之道，不以仁政，不能平治天下。今有仁心仁闻而民不被其泽，不可法于后世者，不行先王之道也。","b":5,"y":-320,"th":["哲理","政治","仁政"],"ap":1},{"id":"ae4eb16cc38b","t":"孟子·离娄上 其10","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「天下有道，小德役大德，小贤役大贤；天下无道，小役大，弱役强。斯二者天也。顺天者存，逆天者亡。齐景公曰：『既不能令，又不受命，是绝物也。』涕出而女于吴。","b":5,"y":-320,"th":["哲理","政治","历史兴亡"],"ap":1},{"id":"689b9e03f3e0","t":"孟子·离娄上 其13","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「桀纣之失天下也，失其民也；失其民者，失其心也。得天下有道：得其民，斯得天下矣；得其民有道：得其心，斯得民矣；得其心有道：所欲与之聚之，所恶勿施尔也。民之归仁也，犹水之就下、兽之走圹也。故为渊敺鱼者，獭也；为丛敺爵者，鹯也；为汤武敺民者，桀与纣也。今天下之君有好仁者，则诸侯皆为之敺矣。虽欲无王，不可得已。今之欲王者，犹七年之病求三年之艾也。苟为不畜，终身不得。苟不志于仁，终身忧辱，以陷于死亡。《诗》云『其何能淑，载胥及溺』，此之谓也。」","b":5,"y":-320,"th":["哲理","政治","民本"],"ap":1},{"id":"88eb026b3ee8","t":"孟子·离娄上 其20","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「恭者不侮人，俭者不夺人。侮夺人之君，惟恐不顺焉，恶得为恭俭？恭俭岂可以声音笑貌为哉？」","b":5,"y":-320,"th":["哲理","政治","修德"],"ap":1},{"id":"c073810038d6","t":"孟子·梁惠王上 其18","a":"孟子","d":1,"f":"文","g":"文","x":"孟子见梁襄王。出，语人曰：「望之不似人君，就之而不见所畏焉。卒然问曰：『天下恶乎定？』吾对曰：『定于一。』","b":5,"y":-319,"th":["哲理","政治","王道"],"ap":1},{"id":"ea2957cda954","t":"孟子·公孙丑下 其17","a":"孟子","d":1,"f":"文","g":"文","x":"他日，见于王曰：「王之为都者，臣知五人焉。知其罪者，惟孔距心。为王诵之。」王曰：「此则寡人之罪也。」","b":5,"y":-317,"th":["哲理","政治","劝谏"],"ap":1},{"id":"853d67fc0fb2","t":"孟子·公孙丑下 其30","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「未也。沈同问『燕可伐与』？吾应之曰『可』，彼然而伐之也。彼如曰『孰可以伐之』？则将应之曰：『为天吏，则可以伐之。』今有杀人者，或问之曰『人可杀与』？则将应之曰『可』。彼如曰『孰可以杀之』？则将应之曰：『为士师，则可以杀之。』今以燕伐燕，何为劝之哉？」","b":5,"y":-314,"th":["哲理","政治","仁政"],"ap":1},{"id":"9b0ad8615b56","t":"孟子·梁惠王下 其46","a":"孟子","d":1,"f":"文","g":"文","x":"齐人伐燕，胜之。宣王问曰：「或谓寡人勿取，或谓寡人取之。以万乘之国伐万乘之国，五旬而举之，人力不至于此。不取，必有天殃。取之，何如？」","b":5,"y":-314,"th":["哲理","政治","军事"],"ap":1},{"id":"baff72e593c3","t":"孟子·梁惠王下 其48","a":"孟子","d":1,"f":"文","g":"文","x":"齐人伐燕，取之。诸侯将谋救燕。宣王曰：「诸侯多谋伐寡人者，何以待之？」","b":5,"y":-314,"th":["哲理","怀古","政治"],"ap":1},{"id":"0af08f6baea2","t":"中庸·中庸 其29","a":"子思（传）","d":1,"f":"文","g":"文","x":"子曰：「愚而好自用，贱而好自专，生乎今之世，反古之道。如此者，灾及其身者也。」非天子，不议礼，不制度，不考文。今天下车同轨，书同文，行同伦。虽有其位，苟无其德，不敢作礼乐焉；虽有其德，苟无其位，亦不敢作礼乐焉。","b":5,"y":-300,"th":["哲理","政治","礼制"],"ap":1},{"id":"511dc2e455da","t":"初放","a":"东方朔","d":1,"f":"楚辞","g":"诗","x":"平生于国兮，长于原野。","b":5,"y":-300,"th":["抒怀","政治","咏物"],"ap":1},{"id":"6b3136c40d3b","t":"孟子·公孙丑下 其42","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「周公，弟也；管叔，兄也。周公之过，不亦宜乎？且古之君子，过则改之；今之君子，过则顺之。古之君子，其过也，如日月之食，民皆见之；及其更也，民皆仰之。今之君子，岂徒顺之，又从为之辞。」","b":5,"y":-300,"th":["哲理","修身","政治"],"ap":1},{"id":"acfb5f63eaf8","t":"孟子·滕文公下 其35","a":"孟子","d":1,"f":"文","g":"文","x":"「世衰道微，邪说暴行有作，臣弑其君者有之，子弑其父者有之。孔子惧，作《春秋》。《春秋》，天子之事也。是故孔子曰：『知我者其惟春秋乎！罪我者其惟春秋乎！』","b":5,"y":-300,"th":["哲理","怀古","政治"],"ap":1},{"id":"d6f64e16d777","t":"孟子·离娄上 其11","a":"孟子","d":1,"f":"文","g":"文","x":"今也小国师大国而耻受命焉，是犹弟子而耻受命于先师也。如耻之，莫若师文王。师文王，大国五年，小国七年，必为政于天下矣。《诗》云：『商之孙子，其丽不亿。上帝既命，侯于周服。侯服于周，天命靡常。殷士肤敏，祼将于京。』孔子曰：『仁不可为众也。夫国君好仁，天下无敌。』今也欲无敌于天下而不以仁，是犹执热而不以濯也。《诗》云：『谁能执热，逝不以濯？』」","b":5,"y":-300,"th":["哲理","政治","仁政"],"ap":1},{"id":"5e25e7e8d937","t":"孟子·离娄上 其9","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「为政不难，不得罪于巨室。巨室之所慕，一国慕之；一国之所慕，天下慕之；故沛然德教溢乎四海。」","b":5,"y":-300,"th":["哲理","政治","仁政"],"ap":1},{"id":"6756fce1f995","t":"悯上","a":"王逸","d":1,"f":"楚辞","g":"诗","x":"哀世兮睩睩，諓諓兮嗌喔。","b":5,"y":-300,"th":["抒怀","咏物","政治","羁旅"],"ap":1},{"id":"3b1a746b2773","t":"株昭","a":"王褒","d":1,"f":"楚辞","g":"诗","x":"悲哉于嗟兮，心内切磋。","b":5,"y":-300,"th":["咏怀","政治","神话"],"ap":1},{"id":"bc2c98b833d9","t":"遭厄","a":"王逸","d":1,"f":"楚辞","g":"诗","x":"悼屈子兮遭厄，沉王躬兮湘汨。","b":5,"y":-300,"th":["咏史","怀古","游仙","政治"],"ap":1},{"id":"af833e99f759","t":"杂曲歌辞 行路难","a":"鲍溶","d":6,"f":"七古","g":"诗","x":"玉堂向夕如无人，丝竹俨然宫商死。","b":2,"y":750,"th":["咏怀","仕途","政治"],"ap":1},{"id":"805677c1a5a9","t":"相和歌辞 君道曲","a":"李白","d":6,"f":"古体","g":"诗","x":"大君若天覆，广运无不至。","b":4,"y":750,"th":["咏史","哲理","政治"],"ap":1},{"id":"57dee9390fea","t":"相和歌辞 猛虎行","a":"僧齐己","d":6,"f":"古体","g":"诗","x":"磨尔牙，错尔爪，狐莫威，兔莫狡，饮来吞噬取肠饱。","b":4,"y":750,"th":["咏物","讽刺","政治"],"ap":1},{"id":"563b626bf283","t":"琴曲歌辞 越裳操","a":"韩愈","d":6,"f":"古体","g":"诗","x":"雨之施，物以孳，我何意于彼为。","b":10,"y":810,"th":["咏史","哲理","政治"],"ap":1},{"id":"078d9eb66b7d","t":"相和歌辞 东门行","a":"柳宗元","d":6,"f":"七古","g":"诗","x":"汉家三十六将军，东方雷动横阵云。","b":10,"y":810,"th":["咏史","政治","讽刺"],"ap":1}]