[{"id":"52c34cd21d24","t":"论语·季氏篇 其6","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"孔子曰：“侍于君子有三愆：言未及之而言谓之躁，言及之而不言谓之隐，未见颜色而言谓之瞽。”","b":1,"y":-500,"th":["哲理","修身","处世"],"ap":1},{"id":"1392eb247c8f","t":"论语·宪问篇 其34","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"或曰：“以德报怨，何如？”子曰：“何以报德？以直报怨，以德报德。”","b":1,"y":-500,"th":["哲理","处世","伦理"],"ap":1},{"id":"a6a1d38660e0","t":"论语·里仁篇 其26","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子游曰：“事君数，斯辱矣；朋友数，斯疏矣。”","b":1,"y":-500,"th":["哲理","处世"],"ap":1},{"id":"c080eae47b2c","t":"论语·为政篇 其18","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子张学干禄。子曰：“多闻阙疑，慎言其余，则寡尤；多见阙殆，慎行其余，则寡悔。言寡尤，行寡悔，禄在其中矣。”","b":2,"y":-450,"th":["哲理","修身","处世"],"ap":1},{"id":"fadf2942e8f0","t":"论语·乡党篇 其16","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"康子馈药，拜而受之。曰：“丘未达，不敢尝。”","b":2,"y":-450,"th":["礼仪","哲理","处世"],"ap":1},{"id":"89efa399c44d","t":"论语·乡党篇 其24","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"寝不尸，居不客。","b":2,"y":-450,"th":["哲理","礼仪","处世"],"ap":1},{"id":"7b3f615a6042","t":"论语·卫灵公篇 其15","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“躬自厚而薄责于人，则远怨矣。”","b":2,"y":-450,"th":["哲理","修身","处世"],"ap":1},{"id":"e25d22b606e7","t":"论语·卫灵公篇 其17","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“群居终日，言不及义，好行小慧，难矣哉！”","b":2,"y":-450,"th":["哲理","修身","处世"],"ap":1},{"id":"32d139596e20","t":"论语·卫灵公篇 其22","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“君子矜而不争，群而不党。”","b":2,"y":-450,"th":["哲理","修身","处世"],"ap":1},{"id":"bf4d4db6f7a9","t":"论语·卫灵公篇 其24","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子贡问曰：“有一言而可以终身行之者乎？”子曰：“其恕乎！己所不欲，勿施于人。”","b":2,"y":-450,"th":["哲理","修身","处世"],"ap":1},{"id":"09c9aaa7b9dd","t":"论语·卫灵公篇 其27","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“巧言乱德，小不忍，则乱大谋。”","b":2,"y":-450,"th":["哲理","修身","处世"],"ap":1},{"id":"1d082700e68b","t":"论语·卫灵公篇 其37","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“君子贞而不谅。”","b":2,"y":-450,"th":["哲理","修身","处世"],"ap":1},{"id":"198ad9d2f33c","t":"论语·卫灵公篇 其40","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“道不同，不相为谋。”","b":2,"y":-450,"th":["哲理","处世"],"ap":1},{"id":"56127c9c7b60","t":"论语·卫灵公篇 其6","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子张问行，子曰：“言忠信，行笃敬，虽蛮貊之邦行矣；言不忠信，行不笃敬，虽州里行乎哉？立则见其参于前也；在舆则见其倚于衡也，夫然后行。”子张书诸绅。","b":2,"y":-450,"th":["哲理","修身","处世"],"ap":1},{"id":"e2140c95e7ac","t":"论语·卫灵公篇 其7","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“直哉史鱼！邦有道如矢，邦无道如矢。君子哉蘧伯玉！邦有道则仕，邦无道则可卷而怀之。”","b":2,"y":-450,"th":["哲理","处世","君子"],"ap":1},{"id":"2f0c0eac5075","t":"论语·子张篇 其11","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子夏曰：“大德不逾闲，小德出入可也。”","b":2,"y":-450,"th":["哲理","修身","处世"],"ap":1},{"id":"336675073c90","t":"论语·子罕篇 其7","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"牢曰：“子云：‘吾不试，故艺。’”","b":3,"y":-450,"th":["哲理","修身","处世"],"ap":1},{"id":"becf6ee669fb","t":"论语·子路篇 其19","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"樊迟问仁，子曰：“居处恭，执事敬，与人忠。虽之夷狄，不可弃也。”","b":3,"y":-450,"th":["哲理","修身","处世"],"ap":1},{"id":"a1acca0af1db","t":"论语·子路篇 其23","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“君子和而不同，小人同而不和。”","b":3,"y":-450,"th":["哲理","修身","处世"],"ap":1},{"id":"3a77eeead721","t":"论语·季氏篇 其5","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"孔子曰：“益者三乐，损者三乐。乐节礼乐、乐道人之善、乐多贤友，益矣；乐骄乐、乐佚游、乐宴乐，损矣。”","b":3,"y":-450,"th":["哲理","修身","处世"],"ap":1},{"id":"1d0e069021bf","t":"论语·学而篇 其13","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"有子曰：“信近于义，言可复也。恭近于礼，远耻辱也。因不失其亲，亦可宗也。”","b":3,"y":-450,"th":["哲理","修身","处世"],"ap":1},{"id":"c1e52d6981e6","t":"论语·宪问篇 其10","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“贫而无怨难，富而无骄易。”","b":3,"y":-450,"th":["哲理","修身","处世"],"ap":1},{"id":"f0e8739aa589","t":"论语·宪问篇 其13","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子问公叔文子于公明贾曰：“信乎，夫子不言，不笑，不取乎？”公明贾对曰：“以告者过也。夫子时然后言，人不厌其言；乐然后笑，人不厌其笑；义然后取，人不厌其取。”子曰：“其然？岂其然乎？”","b":3,"y":-450,"th":["哲理","修身","处世"],"ap":1},{"id":"cdfe3e14f7b7","t":"论语·宪问篇 其31","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“不逆诈，不亿不信，抑亦先觉者，是贤乎！”","b":3,"y":-450,"th":["哲理","处世","修身"],"ap":1},{"id":"7642000fb808","t":"论语·尧曰篇 其3","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"孔子曰：“不知命，无以为君子也；不知礼，无以立也；不知言，无以知人也。”","b":3,"y":-450,"th":["哲理","修身","处世"],"ap":1},{"id":"4933772ab887","t":"论语·述而篇 其11","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子谓颜渊曰：“用之则行，舍之则藏，惟我与尔有是夫！”子路曰：“子行三军，则谁与？”子曰：“暴虎冯河，死而无悔者，吾不与也。必也临事而惧，好谋而成者也。”","b":3,"y":-450,"th":["哲理","教育","处世"],"ap":1},{"id":"1a2e3f798c0d","t":"论语·述而篇 其36","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“奢则不孙，俭则固。与其不孙也，宁固。”","b":3,"y":-450,"th":["哲理","修身","处世"],"ap":1},{"id":"c0e175b34bd8","t":"论语·里仁篇 其12","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“放于利而行，多怨。”","b":3,"y":-450,"th":["哲理","修身","处世"],"ap":1},{"id":"faaca138799c","t":"论语·阳货篇 其25","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“唯女子与小人为难养也，近之则不孙，远之则怨。”","b":3,"y":-450,"th":["哲理","处世","人性"],"ap":1},{"id":"746a1f48d9e4","t":"论语·雍也篇 其22","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"樊迟问知，子曰：“务民之义，敬鬼神而远之，可谓知矣。”问仁，曰：“仁者先难而后获，可谓仁矣。”","b":3,"y":-450,"th":["哲理","修身","处世"],"ap":1},{"id":"561e04e4b754","t":"论语·颜渊篇 其23","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子贡问友，子曰：“忠告而善道之，不可则止，毋自辱焉。”","b":4,"y":-450,"th":["哲理","交友","处世"],"ap":1},{"id":"cf0574eab42b","t":"中庸·中庸 其14","a":"子思（传）","d":1,"f":"文","g":"文","x":"君子素其位而行，不愿乎其外。素富贵，行乎富贵；素贫贱，行乎贫贱；素夷狄，行乎夷狄；素患难，行乎患难：君子无入而不自得焉。在上位不陵下，在下位不援上，正己而不求于人，则无怨。上不怨天，下不尤人。故君子居易以俟命，小人行险以徼幸。」","b":4,"y":-430,"th":["哲理","修身","处世"],"ap":1},{"id":"d44db7c79680","t":"中庸·中庸 其11","a":"子思（传）","d":1,"f":"文","g":"文","x":"子曰：「素隐行怪，后世有述焉，吾弗为之矣。君子遵道而行，半涂而废，吾弗能已矣。君子依乎中庸，遁世不见知而不悔，唯圣者能之。","b":4,"y":-400,"th":["哲理","修身","处世"],"ap":1},{"id":"f51965782d5e","t":"孟子·公孙丑下 其3","a":"孟子","d":1,"f":"文","g":"文","x":"明日，出吊于东郭氏，公孙丑曰：「昔者辞以病，今日吊，或者不可乎！」曰：「昔者疾，今日愈，如之何不吊？」","b":4,"y":-320,"th":["哲理","处世","气节"],"ap":1},{"id":"367c8be25e6a","t":"孟子·梁惠王下 其57","a":"孟子","d":1,"f":"文","g":"文","x":"滕文公问曰：「滕，小国也。竭力以事大国，则不得免焉。如之何则可？」","b":5,"y":-320,"th":["哲理","治国","处世"],"ap":1},{"id":"56a7f9b46e96","t":"中庸·中庸 其28","a":"子思（传）","d":1,"f":"文","g":"文","x":"大哉，圣人之道！洋洋乎发育万物，峻极于天。优优大哉！礼仪三百，威仪三千，待其人然后行。故曰：苟不至德，至道不凝焉。故君子尊德性而道问学，致广大而尽精微，极高明而中庸。温故而知新，敦厚以崇礼。是故居上不骄，为下不倍；国有道，其言足以兴，国无道，其默足以容。《诗》曰：「既明且哲，以保其身。」其此之谓与！","b":5,"y":-300,"th":["哲理","修身","处世"],"ap":1},{"id":"51136e00f12b","t":"孟子·公孙丑下 其21","a":"孟子","d":1,"f":"文","g":"文","x":"孟子为卿于齐，出吊于滕，王使盖大夫王驩为辅行。王驩朝暮见，反齐滕之路，未尝与之言行事也。","b":5,"y":-300,"th":["哲理","品格","处世"],"ap":1}]