"治国"],"ap":1}],"t504":[{"id":"2b619a0cd945","t":"防有鹊巢","a":"佚名","d":1,"f":"诗经","g":"诗","x":"防有鹊巢，邛有旨苕。谁侜予美？心焉忉忉。","b":1,"y":-700,"th":["爱情","忧惧","谗言"],"ap":1}],"t522":[{"id":"3d5d1696557c","t":"礼魂","a":"屈原","d":1,"f":"楚辞","g":"诗","x":"成礼兮会鼓，","b":5,"y":-290,"th":["祭祀","祈福","咏神"],"ap":1}],"t531":[{"id":"44aeefea0069","t":"论语·微子篇 其6","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"长沮、桀溺耦而耕，孔子过之，使子路问津焉。长沮曰：“夫执舆者为谁？”子路曰：“为孔丘。”曰：“是鲁孔丘与？”曰：“是也。”曰：“是知津矣。”问于桀溺，桀溺曰：“子为谁？”曰：“为仲由。”曰：“是鲁孔丘之徒与？”对曰：“然。”曰：“滔滔者天下皆是也，而谁以易之？且而与其从辟人之士也，岂若从辟世之士？”耰而不辍。子路行以告，夫子怃然曰：“鸟兽不可与同群，吾非斯人之徒与而谁与？天下有道，丘不与易也。”","b":2,"y":-490,"th":["哲理","入世与避世","知其不可而为之"],"ap":1}],"t540":[{"id":"4aee3287e36d","t":"怨上","a":"王逸","d":1,"f":"楚辞","g":"诗","x":"令尹兮謷謷，群司兮譨譨。","b":5,"y":-300,"th":["政治讽喻","孤高自伤","羁旅抒怀"],"ap":1}],"t557":[{"id":"5f902be54015","t":"孟子·滕文公下 其36","a":"孟子","d":1,"f":"文","g":"文","x":"「圣王不作，诸侯放恣，处士横议，杨朱、墨翟之言盈天下。天下之言，不归杨，则归墨。杨氏为我，是无君也；墨氏兼爱，是无父也。无父无君，是禽兽也。公明仪曰：『庖有肥肉，厩有肥马，民有饥色，野有饿莩，此率兽而食人也。』杨墨之道不息，孔子之道不著，是邪说诬民，充塞仁义也。仁义充塞，则率兽食人，人将相食。吾为此惧，闲先圣之道，距杨墨，放淫辞，邪说者不得作。作于其心，害于其事；作于其事，害于其政。圣人复起，不易吾言矣。","b":5,"y":-320,"th":["卫道","仁义","辟异端","哲理"],"ap":1}],"t593":[{"id":"8f3dc7374f41","t":"论语·乡党篇 其10","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"食不语，寝不言。","b":2,"y":-450,"th":["礼仪","修身","养生"],"ap":1}],"t618":[{"id":"aac59adf28c6","t":"都人士","a":"佚名","d":1,"f":"诗经","g":"诗","x":"彼都人士，狐裘黄黄。其容不改，出言有章。行归于周，万民所望。","b":0,"y":-770,"th":["怀古","故国之思","伤时"],"ap":1}],"t625":[{"id":"b2a49ab494c4","t":"巧言","a":"佚名","d":1,"f":"诗经","g":"诗","x":"悠悠昊天，曰父母且。无罪无辜，乱如此幠。昊天已威，予慎无罪。昊天大幠，予慎无辜。","b":0,"y":-700,"th":["政治讽喻","忧国忧民","刺谗"],"ap":1}],"t636":[{"id":"bbde12927306","t":"论语·泰伯篇 其4","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"曾子有疾，孟敬子问之。曾子言曰：“鸟之将死，其鸣也哀；人之将死，其言也善。君子所贵乎道者三：动容貌，斯远暴慢矣；正颜色，斯近信矣；出辞气，斯远鄙倍矣。笾豆之事，则有司存。”","b":3,"y":-450,"th":["修身","哲理","临终遗言"],"ap":1}],"t643":[{"id":"c23495781d7b","t":"孟子·公孙丑上 其42","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「伯夷，非其君不事，非其友不友。不立于恶人之朝，不与恶人言。立于恶人之朝，与恶人言，如以朝衣朝冠坐于涂炭。推恶恶之心，思与乡人立，其冠不正，望望然去之，若将浼焉。是故诸侯虽有善其辞命而至者，不受也。不受也者，是亦不屑就已。柳下惠，不羞污君，不卑小官。进不隐贤，必以其道。遗佚而不怨，阨穷而不悯。故曰：『尔为尔，我为我，虽袒裼裸裎于我侧，尔焉能浼我哉？』故由由然与之偕而不自失焉，援而止之而止。援而止之而止者，是亦不屑去已。」","b":5,"y":-300,"th":["哲理","处世之道","人格修养"],"ap":1}],"t669":[{"id":"dc0426a3a5e4","t":"论语·公冶长篇 其11","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“吾未见刚者。”或对曰：“申枨。”子曰：“枨也欲，焉得刚。”","b":2,"y":-450,"th":["哲理","修身","无欲则刚"],"ap":1}],"t687":[{"id":"e888c3b15df8","t":"孟子·滕文公上 其33","a":"孟子","d":1,"f":"文","g":"文","x":"徐子以告夷子。夷子怃然为闲曰：「命之矣。」","b":5,"y":-300,"th":["哲理","论辩","受教"],"ap":1}],"t690":[{"id":"ea756c25a962","t":"瓠叶","a":"佚名","d":1,"f":"诗经","g":"诗","x":"幡幡瓠叶，采之亨之。君子有酒，酌言尝之。","b":0,"y":-700,"th":["宴饮","尚礼","田园"],"ap":1}],"t706":[{"id":"f6d39a636461","t":"论语·先进篇 其6","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"南容三复白圭，孔子以其兄之子妻之。","b":2,"y":-480,"th":["哲理","修身","择偶"],"ap":1}],"t715":[{"id":"fc97c19cc0ff","t":"论语·泰伯篇 其1","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“泰伯，其可谓至德也已矣。三以天下让，民无得而称焉。”","b":3,"y":-450,"th":["哲理","咏史","让德"],"ap":1}],"t728":[{"id":"09c1cc4a50c2","t":"相和歌辞 大堤行","a":"孟浩然","d":6,"f":"五律","g":"诗","x":"大堤行乐处，车马相驰突。","b":2,"y":724,"th":["怀人","伤春","即景抒情"],"ap":1}],"t759":[{"id":"56cd24fef05c","t":"相和歌辞 大子夜歌二首 一","a":"陆龟蒙","d":6,"f":"五绝","g":"诗","x":"歌谣数百种，子夜最可怜。","b":10,"y":880,"th":["乐府民歌","咏歌","艺术美学"],"ap":1}],"t773":[{"id":"7574cc6b2c4c","t":"杂曲歌辞 壮士行","a":"施肩吾","d":6,"f":"七律","g":"诗","x":"一斗之胆撑脏腑，如磥之筋碍臂骨。","b":9,"y":820,"th":["壮志难酬","咏怀","豪侠"],"ap":1}],"t801":[{"id":"c08f3be4b4b5","t":"琴曲歌辞 胡笳十八拍 第一拍","a":"刘商","d":6,"f":"古体","g":"诗","x":"汉室将衰兮四夷不宾，动干戈兮征战频。","b":8,"y":790,"th":["边塞","离乱","悲怨"],"ap":1}],"t812":[{"id":"d5b6cb5adfd9","t":"江雪","a":"柳宗元","d":6,"f":"五绝","g":"诗","x":"千山鸟飞绝，万径人踪灭。","b":8,"y":807,"th":["贬谪","孤高","冬景"],"ap":1}],"t834":[{"id":"2b58d7b5cf70","t":"西江月","a":"张先","d":8,"f":"词","g":"词","x":"肃肃秺侯清慎，温温契苾知诗。","b":4,"y":1100,"th":["颂赞","应酬","用典"],"ap":1}],"t867":[{"id":"b6fafa361f36","t":"滴滴金","a":"李遵","d":8,"f":"词","g":"词","x":"帝城五夜宴游歇。","b":4,"y":1100,"th":["节序","哲理","闲适"],"ap":1}],"t870":[{"id":"c424a4c41aa3","t":"感皇恩","a":"张先","d":8,"f":"词","g":"词","x":"万乘靴袍御紫宸。"