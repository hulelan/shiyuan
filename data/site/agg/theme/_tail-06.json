,"礼乐","追思"],"ap":1},{"id":"9c56327e3967","t":"郊庙歌辞 享节愍太子庙乐章 迎神","a":"不详","d":6,"f":"四言","g":"诗","x":"储后望崇，元良寄切。","b":5,"y":750,"th":["祭祀","追思","礼乐"],"ap":1},{"id":"c1d12787dba6","t":"郊庙歌辞 享惠昭太子庙乐章 迎俎酌献","a":"李逢吉","d":6,"f":"四言","g":"诗","x":"既洁酒醴，聿陈熟腥。","b":5,"y":750,"th":["祭祀","礼乐","追思"],"ap":1},{"id":"f45133870781","t":"郊庙歌辞 昭德皇后庙乐章 雍和","a":"不详","d":6,"f":"四言","g":"诗","x":"我将我享，尽明而诚。","b":5,"y":750,"th":["祭祀","颂德","追思"],"ap":1},{"id":"bef9d0b9131c","t":"郊庙歌辞 享惠昭太子庙乐章 送神","a":"王涯","d":6,"f":"四言","g":"诗","x":"威仪毕陈，备乐将阕。","b":8,"y":799,"th":["祭祀","礼乐","追思"],"ap":1}],"t092":[{"id":"286a573d2d41","t":"文王","a":"佚名","d":1,"f":"诗经","g":"诗","x":"文王在上，于昭于天。周虽旧邦，其命维新。有周不显，帝命不时。文王陟降，在帝左右。","b":0,"y":-1050,"th":["颂歌","咏史","哲理"],"ap":1},{"id":"42746c53943d","t":"有瞽","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有瞽有瞽，在周之庭。设业设虡，崇牙树羽。应田县鼓，鞉磬柷圉。既备","b":0,"y":-1050,"th":["祭祀","礼乐","颂歌"],"ap":1},{"id":"a4e2cb5f8f91","t":"噫嘻","a":"佚名","d":1,"f":"诗经","g":"诗","x":"噫嘻成王，既昭假尔。率时农夫，播厥百谷。骏发尔私，终三十里。亦服尔耕，十千维耦。","b":0,"y":-1050,"th":["农事","颂歌","祭祀"],"ap":1},{"id":"c77619529c42","t":"赉","a":"佚名","d":1,"f":"诗经","g":"诗","x":"文王既勤止，我应受之。敷时绎思，我徂维求定。时周之命，于绎思。","b":0,"y":-1046,"th":["祭祀","颂歌","怀古"],"ap":1},{"id":"262be2052fe7","t":"昊天有成命","a":"佚名","d":1,"f":"诗经","g":"诗","x":"昊天有成命，二后受之。成王不敢康，夙夜基命宥密。于缉熙！单厥心，四其靖之。","b":0,"y":-1022,"th":["颂歌","咏史","祭祀"],"ap":1},{"id":"865da1a7e103","t":"车攻","a":"佚名","d":1,"f":"诗经","g":"诗","x":"我车既攻，我马既同。四牡庞庞，驾言徂东。","b":0,"y":-950,"th":["田猎","颂歌","军威"],"ap":1},{"id":"c0708d754559","t":"丝衣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"丝衣其紑，载弁俅俅。自堂徂基，自羊徂牛，鼐鼎及鼒，兕觥其觩。旨酒思柔。不吴不敖，胡考之休。","b":0,"y":-908,"th":["祭祀","颂歌","祈福"],"ap":1},{"id":"71a776b5f918","t":"常武","a":"佚名","d":1,"f":"诗经","g":"诗","x":"赫赫明明。王命卿士，南仲大祖，大师皇父。整我六师，以修我戎。既敬既戒，惠此南国。","b":0,"y":-800,"th":["战争","颂歌","军旅","怀古"],"ap":1},{"id":"5f16bb42f2a9","t":"凫鹥","a":"佚名","d":1,"f":"诗经","g":"诗","x":"凫鹥在泾，公尸在燕来宁。尔酒既清，尔肴既馨。公尸燕饮，福禄来成。","b":0,"y":-771,"th":["祭祀","宴饮","祈福","颂歌"],"ap":1},{"id":"c5c56c5c5e32","t":"载芟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"载芟载柞，其耕泽泽。千耦其耘，徂隰徂畛。侯主侯伯，侯亚侯旅，侯彊侯以。","b":0,"y":-750,"th":["农事","祭祀","颂歌"],"ap":1},{"id":"60c4f34ff75e","t":"丰年","a":"佚名","d":1,"f":"诗经","g":"诗","x":"丰年多黍多稌，亦有高廪，万亿及秭。为酒为醴，烝畀祖妣。以洽百礼，降福孔皆。","b":0,"y":-700,"th":["农事","祭祀","颂歌"],"ap":1},{"id":"6fb100f8a178","t":"酌","a":"佚名","d":1,"f":"诗经","g":"诗","x":"于铄王师，遵养时晦。时纯熙矣，是用大介。我龙受之，蹻蹻王之造。载用有嗣，实维尔公允师。","b":1,"y":-700,"th":["战争","颂歌","怀古"],"ap":1},{"id":"7fdcdb83297b","t":"臣工","a":"佚名","d":1,"f":"诗经","g":"诗","x":"嗟嗟臣工，敬尔在公。王厘尔成，来咨来茹。嗟嗟保介，维莫之春，亦又何求？如何新畲？","b":0,"y":-700,"th":["农事","颂歌","劝农"],"ap":1},{"id":"c668b992327c","t":"绵","a":"佚名","d":1,"f":"诗经","g":"诗","x":"绵绵瓜瓞。民之初生，自土沮漆。古公亶父，陶复陶冗，未有家室。","b":0,"y":-700,"th":["史诗","咏史","颂歌"],"ap":1},{"id":"f0f935800541","t":"潜","a":"佚名","d":1,"f":"诗经","g":"诗","x":"猗与漆沮，潜有多鱼。有鳣有鲔，鲦鲿鰋鲤。以享以祀，以介景福。","b":0,"y":-700,"th":["祭祀","颂歌","咏物"],"ap":1},{"id":"de65697df98a","t":"玄鸟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"天命玄鸟，降而生商，宅殷土芒芒。古帝命武汤，正域彼四方。","b":1,"y":-650,"th":["祭祀","咏史","颂歌"],"ap":1},{"id":"4ac234d595f3","t":"东皇太一","a":"屈原","d":1,"f":"楚辞","g":"诗","x":"吉日兮辰良，穆将愉兮上皇","b":5,"y":-300,"th":["祭祀","神话","颂歌"],"ap":1}],"t100":[{"id":"824cee8e2ba3","t":"谷风","a":"佚名","d":1,"f":"诗经","g":"诗","x":"习习谷风，以阴以雨。黾勉同心，不宜有怒。采葑采菲，无以下体？德音莫违，及尔同死。","b":0,"y":-1050,"th":["弃妇","婚姻","怨情","对比"],"ap":1},{"id":"f6e0757d7a39","t":"伐柯","a":"佚名","d":1,"f":"诗经","g":"诗","x":"伐柯如何？匪斧不克。取妻如何？匪媒不得。","b":0,"y":-908,"th":["婚姻","哲理"],"ap":1},{"id":"7104bfb7f221","t":"硕人","a":"佚名","d":1,"f":"诗经","g":"诗","x":"硕人其颀，衣锦褧衣。齐侯之子，卫侯之妻。东宫之妹，邢侯之姨，谭公维私。","b":0,"y":-750,"th":["咏人","婚姻","贵族"],"ap":1},{"id":"cf25f99cc376","t":"新台","a":"佚名","d":1,"f":"诗经","g":"诗","x":"新台有泚，河水瀰瀰。燕婉之求，蘧篨不鲜。","b":0,"y":-718,"th":["讽刺","婚姻","怨愤"],"ap":1},{"id":"03efd1f8ea43","t":"柏舟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"泛彼柏舟，在彼中河。髧彼两髦，实维我仪。之死矢靡它。母也天只，不谅人只！","b":0,"y":-700,"th":["爱情","婚姻","抗争"],"ap":1},{"id":"2ad5cefed45b","t":"丰","a":"佚名","d":1,"f":"诗经","g":"诗","x":"子之丰兮，俟我乎巷兮，悔予不送兮。","b":0,"y":-700,"th":["爱情","悔恨","婚姻"],"ap":1},{"id":"3133eab68715","t":"绸缪","a":"佚名","d":1,"f":"诗经","g":"诗","x":"绸缪束薪，三星在天。今夕何夕，见此良人？子兮子兮，如此良人何？","b":0,"y":-700,"th":["爱情","婚姻","喜悦"],"ap":1},{"id":"ad61f1dd1739","t":"行露","a":"佚名","d":1,"f":"诗经","g":"诗","x":"厌浥行露，岂不夙夜，谓行多露。","b":1,"y":-700,"th":["婚姻","抗争","咏物"],"ap":1},{"id":"e0f794d59720","t":"蝃蝀","a":"佚名","d":1,"f":"诗经","g":"诗","x":"蝃蝀在东，莫之敢指。女子有行，远父母兄弟。","b":0,"y":-700,"th":["婚姻","讽刺","礼教"],"ap":1},{"id":"e6e83b8cc14a","t":"我行其野","a":"佚名","d":1,"f":"诗经","g":"诗","x":"我行其野，蔽芾其樗。婚姻之故，言就尔居。尔不我畜，复我邦家。","b":0,"y":-700,"th":["弃妇","怨情","婚姻"],"ap":1},{"id":"f8a050cc7294","t":"日月","a":"佚名","d":1,"f":"诗经","g":"诗","x":"日居月诸，照临下土。乃如之人兮，逝不古处？胡能有定？宁不我顾。","b":0,"y":-700,"th":["弃妇","怨情","婚姻"],"ap":1},{"id":"1fddd3a8bef6","t":"氓","a":"佚名","d":1,"f":"诗经","g":"诗","x":"氓之蚩蚩，抱布贸丝。匪来贸丝，来即我谋。送子涉淇，至于顿丘。匪我愆期，子无良媒。将子无怒，秋以为期。","b":1,"y":-650,"th":["弃妇","婚姻","爱情","怨情"],"ap":1},{"id":"ea82013a0991","t":"钱大尹智宠谢天香・滚绣球","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"到早起过洗面水，到晚来又索铺床叠被，我服侍的都入罗帏，我恰才舒铺盖似孤鬼，少不的足恋蜷寝睡，整三年有名无实。","b":0,"y":1280,"th":["闺怨","幽怨","婚姻","戏曲"],"ap":1},{"id":"69e1f642626a","t":"诈妮子调风月・挂玉钩","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"是个破败家私铁扫帚，没些儿发旺夫家处，可更绝子嗣、妨公婆、克丈夫，脸上承泪靥无重数。","b":0,"y":1290,"th":["市井","女性","婚姻"],"ap":1},{"id":"acc13813e2c2","t":"诈妮子调风月・胜葫芦","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"怕不依随蒙君一夜恩，争奈忒达地、忒知根，兼上亲上成亲好对门。","b":0,"y":1290,"th":["爱情","婚姻","闺怨"],"ap":1}],"t117":[{"id":"3d3c7befc5e9","t":"论语·子罕篇 其1","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子罕言利与命与仁。","b":2,"y":-450,"th":["哲理","义利之辨","天命","仁德"],"ap":1},{"id":"7b9481e703d7","t":"大学·大学 其16","a":"曾子（传）","d":1,"f":"文","g":"文","x":"孟献子曰：「畜马乘，不察于鸡豚；伐冰之家，不畜牛羊；百乘之家，不畜聚敛之臣。与其有聚敛之臣，宁有盗臣。」此谓国不以利为利，以义为利也。长国家而务财用者，必自小人矣。彼为善之，小人之使为国家，灾害并至。虽有善者，亦无如之何矣！此谓国不以利为利，以义为利也。","b":2,"y":-450,"th":["哲理","治国","义利之辨","民本"],"ap":1},{"id":"7d7b5df344eb","t":"论语·里仁篇 其16","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“君子喻于义，小人喻于利。”","b":3,"y":-450,"th":["哲理","修身","义利之辨"],"ap":1},{"id":"a932560dee8b","t":"论语·先进篇 其19","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“回也其庶乎，屡空。赐不受命而货殖焉，亿则屡中。”","b":2,"y":-450,"th":["哲理","人物评骘","义利之辨"],"ap":1},{"id":"0196c108a286","t":"孟子·滕文公下 其14","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「非其道，则一箪食不可受于人；如其道，则舜受尧之天下，不以为泰，子以为泰乎？」","b":5,"y":-320,"th":["哲理","义利之辨","道德操守"],"ap":1},{"id":"0f9444526673","t":"孟子·公孙丑下 其55","a":"孟子","d":1,"f":"文","g":"文","x":"公孙丑问曰：「仕而不受禄，古之道乎？」","b":4,"y":-320,"th":["哲理","义利之辨","出仕之道"],"ap":1},{"id":"4ed55d77c1c7","t":"孟子·滕文公下 其17","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「梓匠轮舆，其志将以求食也；君子之为道也，其志亦将以求食与？」","b":5,"y":-320,"th":["哲理","义利之辨","君子之道"],"ap":1},{"id":"681c479b0451","t":"孟子·滕文公下 其22","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「然则子非食志也，食功也。」","b":5,"y":-320,"th":["哲理","义利之辨","治国理政"],"ap":1},{"id":"a31f197241a1","t":"孟子·公孙丑下 其10","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「皆是也。当在宋也，予将有远行。行者必以赆，辞曰：『餽赆。』予何为不受？当在薛也，予有戒心。辞曰：『闻戒。』故为兵餽之，予何为不受？若于齐，则未有处也。无处而餽之，是货之也。焉有君子而可以货取乎？」","b":4,"y":-320,"th":["哲理","人格气节","义利之辨"],"ap":1},{"id":"b06f102870dd","t":"孟子·滕文公下 其20","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「有人于此，毁瓦画墁，其志将以求食也，则子食之乎？」","b":5,"y":-320,"th":["哲理","论辩","义利之辨"],"ap":1},{"id":"e0ef052a03bb","t":"孟子·公孙丑下 其45","a":"孟子","d":1,"f":"文","g":"文","x":"时子因陈子而以告孟子，陈子以时子之言告孟子。孟子曰：「然。夫时子恶知其不可也？如使予欲富，辞十万而受万，是为欲富乎？季孙曰：『异哉子叔疑！使己为政，不用，则亦已矣，又使其子弟为卿。人亦孰不欲富贵？而独于富贵之中，有私龙断焉。』古之为市也，以其所有易其所无者，有司者治之耳。有贱丈夫焉，必求龙断而登之，以左右望而罔市利。人皆以为贱，故从而征之。征商，自此贱丈夫始矣。","b":4,"y":-320,"th":["哲理","义利之辨","政治"],"ap":1},{"id":"f1b8f5d24350","t":"孟子·滕文公下 其13","a":"孟子","d":1,"f":"文","g":"文","x":"彭更问曰：「后车数十乘，从者数百人，以传食于诸侯，不以泰乎？」","b":5,"y":-320,"th":["哲理","义利之辨"],"ap":1},{"id":"437a6779be95","t":"孟子·滕文公下 其1","a":"孟子","d":1,"f":"文","g":"文","x":"陈代曰：「不见诸侯，宜若小然；今一见之，大则以王，小则以霸。且志曰：『枉尺而直寻』，宜若可为也。」","b":5,"y":-300,"th":["哲理","劝谏","义利之辨"],"ap":1}],"t144":[{"id":"1fc3ab63ef7f","t":"夜梦","a":"萧妃","d":6,"f":"五古","g":"诗","x":"昨日梦君归，贱妾下鸣机。","b":4,"y":750,"th":["爱情","闺怨","梦境"],"ap":1},{"id":"dcca9e510ac7","t":"梦李白二首 一","a":"杜甫","d":6,"f":"五古","g":"诗","x":"死别已吞声，生别常恻恻。","b":6,"y":759,"th":["友情","怀人","梦境"],"ap":1},{"id":"b2a509e01336","t":"相和歌辞 从军行五首 四","a":"令狐楚","d":6,"f":"五绝","g":"诗","x":"胡风千里惊，汉月五更明。","b":8,"y":801,"th":["边塞","思乡","梦境"],"ap":1},{"id":"0f4c93bf26f3","t":"蝶恋花·梦入江南烟水路","a":"晏几道","d":8,"f":"词","g":"词","x":"梦入江南烟水路。","b":0,"th":["爱情","离别","梦境"],"ap":1},{"id":"6ccde2b4c934","t":"秦楼月・忆秦娥·楼阴缺","a":"范成大","d":8,"f":"词","g":"词","x":"楼阴缺。","b":0,"th":["思乡","春夜","梦境"],"ap":1},{"id":"908c44cde191","t":"小镇西・小镇西犯","a":"柳永","d":8,"f":"词","g":"词","x":"意中有个人，芳颜二八。","b":1,"y":1035,"th":["爱情","相思","梦境"],"ap":1},{"id":"53d4a9d2e52a","t":"后赤壁赋","a":"苏轼","d":8,"f":"赋","g":"赋","x":"是岁十月之望，步自雪堂，将归于临皋。二客从予过黄泥之阪。霜露既降，木叶尽脱，人影在地，仰见明月，顾而乐之，行歌相答。已而叹曰：“有客无酒，有酒无肴，月白风清，如此良夜何！”客曰：“今者薄暮，举网得鱼，巨口细鳞，状如松江之鲈。顾安所得酒乎？”归而谋诸妇。妇曰：“我有斗酒，藏之久矣，以待子不时之需。”于是携酒与鱼，复游于赤壁之下。江流有声，断岸千尺；山高月小，水落石出。曾日月之几何，而江山不可复识矣。予乃摄衣而上，履巉岩，披蒙茸，踞虎豹，登虬龙，攀栖鹘之危巢，俯冯夷之幽宫。盖二客不能从焉。划然长啸，草木震动，山鸣谷应，风起水涌。予亦悄然而悲，肃然而恐，凛乎其不可留也。反而登舟，放乎中流，听其所止而休焉。时夜将半，四顾寂寥。适有孤鹤，横江东来。翅如车轮，玄裳缟衣，戛然长鸣，掠予舟而西也。","b":3,"y":1082,"th":["哲理","山水","梦境"],"ap":1},{"id":"3ed94cbf8c5d","t":"踏莎行·燕燕轻盈","a":"姜夔","d":8,"f":"词","g":"词","x":"燕燕轻盈，莺莺娇软。","b":3,"y":1190,"th":["爱情","相思","梦境"],"ap":1},{"id":"b5c3d3468160","t":"草桥店梦莺莺(第四本)・寄生草","a":"王实甫","d":9,"f":"曲","g":"曲","x":"多丰韵，忒稔色。","b":0,"y":1295,"th":["爱情","梦境","相思"],"ap":1},{"id":"0d2e276b7157","t":"遐方怨·欹角枕","a":"纳兰性德","d":11,"f":"词","g":"词","x":"欹角枕，掩红窗","b":0,"y":1680,"th":["爱情","思乡","梦境"],"ap":1},{"id":"56d172a236b1","t":"菩萨蛮·朔风吹散三更雪","a":"纳兰性德","d":11,"f":"词","g":"词","x":"朔风吹散三更雪，倩魂犹恋桃花月","b":1,"y":1682,"th":["边塞","思乡","梦境"],"ap":1}],"t162":[{"id":"1880fd93de30","t":"何草不黄","a":"佚名","d":1,"f":"诗经","g":"诗","x":"何草不黄？何日不行？何人不将？经营四方。","b":0,"y":-908,"th":["征役","哀怨","民生疾苦"],"ap":1},{"id":"31faf5e433ba","t":"苕之华","a":"佚名","d":1,"f":"诗经","g":"诗","x":"苕之华，芸其黄矣。心之忧矣，维其伤矣！","b":0,"y":-700,"th":["哀怨","纪实","民生疾苦"],"ap":1},{"id":"785956f62569","t":"鸿雁","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鸿雁于飞，肃肃其羽。之子于征，劬劳于野。爰及矜人，哀此鳏寡。","b":1,"y":-700,"th":["劳役","咏物","民生疾苦","怀才不遇"],"ap":1},{"id":"b7c784d8c527","t":"候人","a":"佚名","d":1,"f":"诗经","g":"诗","x":"彼候人兮，何戈与祋。彼其之子，三百赤芾。","b":1,"y":-650,"th":["政治讽刺","民生疾苦","咏物"],"ap":1},{"i