x":"蓼彼萧斯，零露湑兮。既见君子，我心写兮。燕笑语兮，是以有誉处兮。","b":0,"y":-700,"th":["宴饮","颂德","祈福"],"ap":1},{"id":"6b9c1e0d07f4","t":"有駜","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有駜有駜，駜彼乘黄。夙夜在公，在公明明。振振鹭，鹭于下。鼓咽咽，醉言舞。于胥乐兮！","b":1,"y":-650,"th":["颂赞","宴饮","祈福"],"ap":1},{"id":"3d5d1696557c","t":"礼魂","a":"屈原","d":1,"f":"楚辞","g":"诗","x":"成礼兮会鼓，","b":5,"y":-290,"th":["祭祀","祈福","咏神"],"ap":1},{"id":"460425cbac7e","t":"相和歌辞 子夜四时歌六首 秋歌二首 二","a":"郭元振","d":6,"f":"五古","g":"诗","x":"辟恶茱萸囊，延年菊花酒。","b":1,"y":691,"th":["节令","风俗","祈福"],"ap":1}],"t104":[{"id":"13a0ed01dfe2","t":"论语·先进篇 其1","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“先进于礼乐，野人也；后进于礼乐，君子也。如用之，则吾从先进。”","b":2,"y":-450,"th":["哲理","用人","教育"],"ap":1},{"id":"154f578e8235","t":"论语·宪问篇 其8","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“为命，裨谌草创之，世叔讨论之，行人子羽修饰之，东里子产润色之。”","b":3,"y":-450,"th":["为政","用人","治学"],"ap":1},{"id":"2663f4a36c46","t":"论语·公冶长篇 其19","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子张问曰：“令尹子文三仕为令尹，无喜色，三已之无愠色，旧令尹之政必以告新令尹，何如？”子曰：“忠矣。”曰：“仁矣乎？”曰：“未知，焉得仁？”“崔子弑齐君，陈文子有马十乘，弃而违之。至于他邦，则曰：‘犹吾大夫崔子也。’违之。之一邦，则又曰：‘犹吾大夫崔子也。’违之，何如？”子曰：“清矣。”曰：“仁矣乎？”曰：“未知，焉得仁？”","b":2,"y":-450,"th":["哲理","品德","用人"],"ap":1},{"id":"3ac9ed40fd89","t":"论语·子路篇 其2","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"仲弓为季氏宰，问政，子曰：“先有司，赦小过，举贤才。”曰：“焉知贤才而举之？”曰：“举尔所知。尔所不知，人其舍诸？”","b":3,"y":-450,"th":["哲理","治国","用人"],"ap":1},{"id":"44d07bd475b9","t":"论语·微子篇 其10","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"周公谓鲁公曰：“君子不施其亲，不使大臣怨乎不以，故旧无大故则不弃也，无求备于一人。”","b":3,"y":-450,"th":["哲理","治国","用人"],"ap":1},{"id":"c45c8cbc6980","t":"论语·为政篇 其19","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"哀公问曰：“何为则民服？”孔子对曰：“举直错诸枉，则民服；举枉错诸直，则民不服。”","b":2,"y":-450,"th":["哲理","治国","用人"],"ap":1},{"id":"f955b794c3f5","t":"论语·宪问篇 其19","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子言卫灵公之无道也，康子曰：“夫如是，奚而不丧？”孔子曰：“仲叔圉治宾客，祝鮀治宗庙，王孙贾治军旅，夫如是，奚其丧？”","b":3,"y":-450,"th":["哲理","治国","用人"],"ap":1},{"id":"8a45392244d8","t":"孟子·梁惠王下 其45","a":"孟子","d":1,"f":"文","g":"文","x":"孟子见齐宣王曰：「为巨室，则必使工师求大木。工师得大木。则王喜，以为能胜其任也。匠人斵而小之，则王怒，以为不胜其任矣。夫人幼而学之，壮而欲行之。王曰『姑舍女所学而从我』，则何如？今有璞玉于此，虽万镒，必使玉人雕琢之。至于治国家，则曰『姑舍女所学而从我』，则何以异于教玉人雕琢玉哉？」","b":5,"y":-320,"th":["哲理","治国","用人"],"ap":1},{"id":"acabc55d5359","t":"孟子·梁惠王下 其38","a":"孟子","d":1,"f":"文","g":"文","x":"孟子见齐宣王曰：「所谓故国者，非谓有乔木之谓也，有世臣之谓也。王无亲臣矣，昔者所进，今日不知其亡也。」","b":5,"y":-320,"th":["哲理","政治","用人"],"ap":1},{"id":"c98e23907e6b","t":"孟子·梁惠王下 其39","a":"孟子","d":1,"f":"文","g":"文","x":"王曰：「吾何以识其不才而舍之？」","b":5,"y":-320,"th":["哲理","政治","用人"],"ap":1}],"t113":[{"id":"0185b0c161dd","t":"葛生","a":"佚名","d":1,"f":"诗经","g":"诗","x":"葛生蒙楚，蔹蔓于野。予美亡此，谁与？独处？","b":0,"y":-700,"th":["悼亡","爱情","生死"],"ap":1},{"id":"6cef2b5753c3","t":"论语·先进篇 其12","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"季路问事鬼神，子曰：“未能事人，焉能事鬼？”,曰：“敢问死。”曰：“未知生，焉知死？”","b":2,"y":-450,"th":["哲理","入世","生死"],"ap":1},{"id":"6b5b3f05910d","t":"相和歌辞 挽歌","a":"赵微明","d":6,"f":"五古","g":"诗","x":"寒日蒿上明，凄凄郭东路。","b":4,"y":750,"th":["悼亡","生死","离别"],"ap":1},{"id":"375ad9d7efb5","t":"相和歌辞 挽歌二首 二","a":"于鹄","d":6,"f":"五古","g":"诗","x":"双辙出郭门，緜緜东西道。","b":7,"y":780,"th":["哲理","生死","挽歌"],"ap":1},{"id":"63b713108a51","t":"相和歌辞 短歌行","a":"僧皎然","d":6,"f":"古体","g":"诗","x":"古人若不死，吾亦何所悲。","b":7,"y":780,"th":["哲理","怀古","生死"],"ap":1},{"id":"729c00493781","t":"相和歌辞 挽歌二首 一","a":"于鹄","d":6,"f":"五绝","g":"诗","x":"阴风吹黄蒿，挽歌渡秋水。","b":8,"y":790,"th":["悼亡","生死","秋思"],"ap":1},{"id":"db6f2c73884d","t":"相和歌辞 挽歌","a":"白居易","d":6,"f":"古体","g":"诗","x":"丹旐何飞扬，素骖亦悲鸣。","b":8,"y":807,"th":["挽歌","生死","哲理"],"ap":1},{"id":"dd2455319a88","t":"杂曲歌辞 悲哉行","a":"鲍溶","d":6,"f":"五古","g":"诗","x":"促促晨复昏，死生同一源。","b":9,"y":815,"th":["哲理","生死","怀古"],"ap":1},{"id":"c637cbd0b877","t":"幺・到头这一身，难逃那一日。受用了一朝，一朝便宜。百岁光阴，七十","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"者稀。","b":0,"y":1290,"th":["哲理","叹时","生死"],"ap":1}],"t139":[{"id":"824cee8e2ba3","t":"谷风","a":"佚名","d":1,"f":"诗经","g":"诗","x":"习习谷风，以阴以雨。黾勉同心，不宜有怒。采葑采菲，无以下体？德音莫违，及尔同死。","b":0,"y":-1050,"th":["弃妇","婚姻","怨情","对比"],"ap":1},{"id":"e6e83b8cc14a","t":"我行其野","a":"佚名","d":1,"f":"诗经","g":"诗","x":"我行其野，蔽芾其樗。婚姻之故，言就尔居。尔不我畜，复我邦家。","b":0,"y":-700,"th":["弃妇","怨情","婚姻"],"ap":1},{"id":"f8a050cc7294","t":"日月","a":"佚名","d":1,"f":"诗经","g":"诗","x":"日居月诸，照临下土。乃如之人兮，逝不古处？胡能有定？宁不我顾。","b":0,"y":-700,"th":["弃妇","怨情","婚姻"],"ap":1},{"id":"1fddd3a8bef6","t":"氓","a":"佚名","d":1,"f":"诗经","g":"诗","x":"氓之蚩蚩，抱布贸丝。匪来贸丝，来即我谋。送子涉淇，至于顿丘。匪我愆期，子无良媒。将子无怒，秋以为期。","b":1,"y":-650,"th":["弃妇","婚姻","爱情","怨情"],"ap":1},{"id":"55f14d7491b5","t":"东门之杨","a":"佚名","d":1,"f":"诗经","g":"诗","x":"东门之杨，其叶牂牂。昏以为期，明星煌煌。","b":1,"y":-650,"th":["爱情","怨情"],"ap":1},{"id":"d985c781d2da","t":"琴曲歌辞 湘妃怨","a":"陈羽","d":6,"f":"七绝","g":"诗","x":"二妃怨处云沈沈，二妃哭处湘水深。","b":8,"y":800,"th":["怀古","爱情","怨情"],"ap":1},{"id":"f4798fd93787","t":"相和歌辞 懊恼曲","a":"温庭筠","d":6,"f":"七古","g":"诗","x":"藕丝作线难胜针，蘂粉染黄那得深。","b":10,"y":850,"th":["爱情","咏物","怀古","怨情"],"ap":1}],"t140":[{"id":"ae5fa8015092","t":"论语·雍也篇 其9","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"季氏使闵子骞为费宰，闵子骞曰：“善为我辞焉。如有复我者，则吾必在汶上矣。”","b":1,"y":-500,"th":["气节","辞官","守道"],"ap":1},{"id":"551fbf9cdf81","t":"论语·卫灵公篇 其2","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"在陈绝粮，从者病莫能兴。子路愠见曰：“君子亦有穷乎？”子曰：“君子固穷，小人穷斯滥矣。”","b":2,"y":-489,"th":["哲理","气节","修身"],"ap":1},{"id":"ef6ee2c8e508","t":"孟子·公孙丑下 其56","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「非也。于崇，吾得见王。退而有去志，不欲变，故不受也。继而有师命，不可以请。久于齐，非我志也。」","b":4,"y":-320,"th":["哲理","气节","家国"],"ap":1},{"id":"f51965782d5e","t":"孟子·公孙丑下 其3","a":"孟子","d":1,"f":"文","g":"文","x":"明日，出吊于东郭氏，公孙丑曰：「昔者辞以病，今日吊，或者不可乎！」曰：「昔者疾，今日愈，如之何不吊？」","b":4,"y":-320,"th":["哲理","处世","气节"],"ap":1},{"id":"29d18072c69b","t":"孟子·滕文公下 其2","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「昔齐景公田，招虞人以旌，不至，将杀之。志士不忘在沟壑，勇士不忘丧其元。孔子奚取焉？取非其招不往也，如不待其招而往，何哉？且夫枉尺而直寻者，以利言也。如以利，则枉寻直尺而利，亦可为与？昔者赵简子使王良与嬖奚乘，终日而不获一禽。嬖奚反命曰：『天下之贱工也。』或以告王良。良曰：『请复之。』彊而后可，一朝而获十禽。嬖奚反命曰：『天下之良工也。』简子曰：『我使掌与女乘。』谓王良。良不可，曰：『吾为之范我驰驱，终日不获一；为之诡遇，一朝而获十。《诗》云：「不失其驰，舍矢如破。」我不贯与小人乘，请辞。』御者且羞与射者比。比而得禽兽，虽若丘陵，弗为也。如枉道而从彼，何也？且子过矣，枉己者，未有能直人者也。」","b":5,"y":-300,"th":["哲理","气节","守正"],"ap":1},{"id":"4aa58a78dc7b","t":"孟子·滕文公下 其29","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「古者不为臣不见。段干木逾垣而辟之，泄柳闭门而不内，是皆已甚。迫，斯可以见矣。阳货欲见孔子而恶无礼，大夫有赐于士，不得受于其家，则往拜其门。阳货矙孔子之亡也，而馈孔子蒸豚；孔子亦矙其亡也，而往拜之。当是时，阳货先，岂得不见？曾子曰：『胁肩谄笑，病于夏畦。』子路曰：『未同而言，观其色赧赧然，非由之所知也。』由是观之，则君子之所养可知已矣。」","b":5,"y":-300,"th":["哲理","气节","礼制"],"ap":1},{"id":"ca84ba05cee0","t":"孟子·公孙丑下 其12","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「不待三。」","b":5,"y":-300,"th":["哲理","治国","气节"],"ap":1}],"t166":[{"id":"6ac30ba4f106","t":"相和歌辞 采莲归","a":"王勃","d":6,"f":"古体","g":"诗","x":"采莲归，绿水芙蓉衣，秋风起浪凫雁飞。","b":1,"y":660,"th":["闺怨","采莲","边塞","爱情"],"ap":1},{"id":"5cf8978c55c5","t":"子夜吴歌 夏歌","a":"李白","d":6,"f":"五古","g":"诗","x":"镜湖三百里，菡萏发荷花。","b":4,"y":750,"th":["咏史","人物","采莲"],"ap":1},{"id":"8a0a87ea1497","t":"相和歌辞 采莲女","a":"阎朝隐","d":6,"f":"古体","g":"诗","x":"采莲女，采莲舟，春日春江碧水流。","b":4,"y":750,"th":["田园","采莲","江南","女性"],"ap":1},{"id":"a533b961e2f2","t":"相和歌辞 采莲曲二首 一","a":"戎昱","d":6,"f":"五律","g":"诗","x":"虽听采莲曲，讵识采莲心。","b":7,"y":780,"th":["闺怨","采莲","江南风光"],"ap":1},{"id":"591c21817d19","t":"相和歌辞 采莲曲二首 一","a":"鲍溶","d":6,"f":"七古","g":"诗","x":"弄舟朅来南塘水，荷叶映身摘莲子。","b":8,"y":800,"th":["田园","采莲","咏物"],"ap":1},{"id":"7476a0ae23cc","t":"相和歌辞 江南曲 四","a":"陆龟蒙","d":6,"f":"五绝","g":"诗","x":"鱼戏莲叶南，欹危午烟叠。","b":10,"y":880,"th":["江南水乡","自然风物","采莲"],"ap":1}],"t175":[{"id":"12dcdc243913","t":"诈妮子调风月・那吒令","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"等不得水温，一声要面盆；恰递与面盆，一声要手巾；却执与手巾，一声解纽门。","b":0,"y":1250,"th":["爱情","生活","杂剧"],"ap":1},{"id":"2d241bf2255e","t":"诈妮子调风月・甜水令","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"姐姐骨甜肉净，堪描堪塑。","b":0,"y":1250,"th":["闺阁","咏人","杂剧"],"ap":1},{"id":"ac82b2255f51","t":"钱大尹智宠谢天香・煞尾","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"则今番文诌诌的施才艺，从来个扑籁籁没气力。","b":0,"y":1250,"th":["爱情","杂剧","女性心理"],"ap":1},{"id":"e9520f6dca9b","t":"诈妮子调风月・仙吕/点绛唇","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"半世为人，不曾教大人心困。","b":0,"y":1250,"th":["爱情","女性","杂剧"],"ap":1},{"id":"b2caf4cc2d4a","t":"钱大尹智宠谢天香・倘秀才","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"幺四五骰着个撮十，二三二趁着个夹七；一面打个色儿，也当得幺二三是鼠尾。","b":0,"y":1280,"th":["市井","游戏","杂剧"],"ap":1},{"id":"f891c41549e3","t":"诈妮子调风月・幺","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"更做道你好处打唤来的，却怎看得非轻，看得值钱，待得尊贵？这两下里捻捎的，有多少功绩，到重如细搀绒绣来胸背？。","b":0,"y":1280,"th":["世态","讽刺","杂剧"],"ap":1}],"t210":[{"id":"043f3d9ea2ee","t":"论语·八佾篇 