司命","a":"屈原","d":1,"f":"楚辞","g":"诗","x":"广开兮天门，纷吾乘兮玄云","b":5,"y":-300,"th":["神话祭祀","生死哲理","离愁别绪"],"ap":1}],"t500":[{"id":"2a2335ed3a8f","t":"论语·阳货篇 其7","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"佛肸召，子欲往。子路曰：“昔者由也闻诸夫子曰：‘亲于其身为不善者，君子不入也。’佛肸以中牟畔，子之往也，如之何？”子曰：“然，有是言也。不曰坚乎，磨而不磷；不曰白乎，涅而不缁。吾岂匏瓜也哉？焉能系而不食？”","b":1,"y":-500,"th":["哲理","用世","操守"],"ap":1}],"t526":[{"id":"42f8ba2d2c3b","t":"羔裘","a":"佚名","d":1,"f":"诗经","g":"诗","x":"羔裘豹祛，自我人居居。岂无他人？维子之故。","b":0,"y":-700,"th":["讽刺","怨刺","人情冷暖"],"ap":1}],"t535":[{"id":"46ede394f88d","t":"论语·微子篇 其9","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"太师挚适齐，亚饭干适楚，三饭缭适蔡，四饭缺适秦，鼓方叔入于河，播鼗武入于汉，少师阳、击磬襄入于海。","b":3,"y":-450,"th":["礼崩乐坏","怀古","文化凋零"],"ap":1}],"t544":[{"id":"4e97a5754ed3","t":"论语·先进篇 其13","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"闵子侍侧，訚訚如也；子路，行行如也；冉有、子贡，侃侃如也。子乐。“若由也，不得其死然。”","b":2,"y":-450,"th":["人物刻画","哲理"],"ap":1}],"t553":[{"id":"57ba712d65ae","t":"论语·述而篇 其10","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子于是日哭，则不歌。","b":3,"y":-450,"th":["哲理","仁礼","修身"],"ap":1}],"t579":[{"id":"7b14c6cd71ac","t":"孟子·梁惠王上 其21","a":"孟子","d":1,"f":"文","g":"文","x":"齐宣王问曰：「齐桓、晋文之事可得闻乎？」","b":4,"y":-320,"th":["王道霸业","仁政","哲学思辨"],"ap":1}],"t588":[{"id":"89487763e5a4","t":"大学·大学 其13","a":"曾子（传）","d":1,"f":"文","g":"文","x":"《诗》云：「殷之未丧师，克配上帝。仪监于殷，峻命不易。」道得众则得国，失众则失国。是故君子先慎乎德。有德此有人，有人此有土，有土此有财，有财此有用。德者本也，财者末也，外本内末，争民施夺。是故财聚则民散，财散则民聚。是故言悖而出者，亦悖而入；货悖而入者，亦悖而出。《康诰》曰：「惟命不于常！」道善则得之，不善则失之矣。楚书曰：「楚国无以为宝，惟善以为宝。」舅犯曰：「亡人无以为宝，仁亲以为宝。」","b":4,"y":-430,"th":["哲理","治国","重德"],"ap":1}],"t597":[{"id":"96548d363bf8","t":"论语·宪问篇 其35","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“莫我知也夫！”子贡曰：“何为其莫知子也？”子曰：“不怨天，不尤人，下学而上达。知我者其天乎！”","b":2,"y":-490,"th":["哲理","修身","知命"],"ap":1}],"t621":[{"id":"ae506d0e721a","t":"论语·子罕篇 其2","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"达巷党人曰：“大哉孔子！博学而无所成名。”子闻之，谓门弟子曰：“吾何执？执御乎，执射乎？吾执御矣。”","b":1,"y":-500,"th":["哲理","自谦","修身"],"ap":1}],"t632":[{"id":"b80e9482e5ae","t":"皇皇者华","a":"佚名","d":1,"f":"诗经","g":"诗","x":"皇皇者华，于彼原隰。駪駪征夫，每怀靡及。","b":0,"y":-700,"th":["使臣","出使","咏物","勤勉"],"ap":1}],"t647":[{"id":"c5bee6a12ac0","t":"杕杜","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有杕之杜，有睆其实。王事靡盬，继嗣我日。日月阳止，女心伤止，征夫遑止。","b":0,"y":-700,"th":["思妇","怀远","战争徭役"],"ap":1}],"t658":[{"id":"cfcc4e7b50fa","t":"论语·先进篇 其7","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"季康子问：“弟子孰为好学？”孔子对曰：“有颜回者好学，不幸短命死矣，今也则亡。”","b":2,"y":-480,"th":["哲理","追思","师生"],"ap":1}],"t683":[{"id":"e721284acc7d","t":"孟子·离娄上 其4","a":"孟子","d":1,"f":"文","g":"文","x":"「故曰，城郭不完，兵甲不多，非国之灾也；田野不辟，货财不聚，非国之害也。上无礼，下无学，贼民兴，丧无日矣。《诗》曰：『天之方蹶，无然泄泄。』泄泄，犹沓沓也。事君无义，进退无礼，言则非先王之道者，犹沓沓也。故曰：责难于君谓之恭，陈善闭邪谓之敬，吾君不能谓之贼。」","b":5,"y":-320,"th":["哲理","政论","治国"],"ap":1}],"t694":[{"id":"ebaf6cf527cb","t":"北风","a":"佚名","d":1,"f":"诗经","g":"诗","x":"北风其凉，雨雪其雱。惠而好我，携手同行。其虚其邪？既亟只且！","b":0,"y":-700,"th":["政治怨刺","逃亡避祸","友谊"],"ap":1}],"t702":[{"id":"f4b4c4867288","t":"疾世","a":"王逸","d":1,"f":"楚辞","g":"诗","x":"周徘徊兮汉渚，求水神兮灵女。","b":5,"y":-150,"th":["怀才不遇","神游求索","忧国伤世"],"ap":1}],"t711":[{"id":"fb5365dd5df8","t":"论语·述而篇 其14","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子在齐闻《韶》，三月不知肉味，曰：“不图为乐之至于斯也。”","b":1,"y":-517,"th":["艺术","审美","哲理"],"ap":1}],"t768":[{"id":"6d70a1676fb9","t":"横吹曲辞 长安道","a":"崔颢","d":6,"f":"七古","g":"诗","x":"长安甲第高入云，谁家居住霍将军。","b":2,"y":730,"th":["咏史","哲理","劝世"],"ap":1}],"t777":[{"id":"847882ee8e21","t":"舞曲歌辞 霓裳辞十首 四","a":"王建","d":6,"f":"七绝","g":"诗","x":"旋翻新谱声初足，除却梨园未教人。","b":8,"y":800,"th":["宫廷生活","音乐","皇恩"],"ap":1}],"t799":[{"id":"baeaff4af25e","t":"相和歌辞 东武吟","a":"李白","d":6,"f":"五古","g":"诗","x":"好古笑流俗，素闻贤达风。","b":3,"y":744,"th":["咏怀","干谒","归隐"],"ap":1}],"t805":[{"id":"c41332fd0b4e","t":"舞曲歌辞 吴俞儿舞歌 劒俞","a":"陆龟蒙","d":6,"f":"古体","g":"诗","x":"枝月喉，櫂霜脊，北斗离离在寒碧。","b":10,"y":855,"th":["乐舞","咏武","壮美"],"ap":1}],"t816":[{"id":"e4faa9239d49","t":"琴曲歌辞 雉朝飞操","a":"张祜","d":6,"f":"古体","g":"诗","x":"朝阳陇东泛暖景，双啄双飞双顾影。","b":9,"y":825,"th":["咏物","孤怨","讽喻"],"ap":1}],"t830":[{"id":"2607116f2f59","t":"蝶恋花","a":"张先","d":8,"f":"词","g":"词","x":"移得绿杨栽后院。","b":3,"y":1040,"th":["咏物","送别","离怨"],"ap":1}],"t849":[{"id":"5ec58e74deef","t":"酒泉子","a":"晏殊","d":8,"f":"词","g":"词","x":"三月暖风，开却好花无限了，当年丛下落纷纷。