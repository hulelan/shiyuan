th":["送别","离愁","惜别"],"ap":1},{"id":"717090a0283a","t":"曲游春·楚苑东风外","a":"周密","d":8,"f":"词","g":"词","x":"楚苑东风外，暖丝情絮，春思如织。","b":4,"y":1270,"th":["春景","惜别","闺怨"],"ap":1}],"t434":[{"id":"7dd0b5072ea0","t":"孟子·滕文公下 其27","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「一齐人傅之，众楚人咻之，虽日挞而求其齐也，不可得矣；引而置之庄岳之间数年，虽日挞而求其楚，亦不可得矣。子谓薛居州，善士也。使之居于王所。在于王所者，长幼卑尊，皆薛居州也，王谁与为不善？在王所者，长幼卑尊，皆非薛居州也，王谁与为善？一薛居州，独如宋王何？」","b":5,"y":-320,"th":["哲理","教化","环境"],"ap":1},{"id":"0cad5c65811f","t":"孟子·滕文公下 其26","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「使齐人傅之。」","b":5,"y":-300,"th":["哲理","教育","环境"],"ap":1}],"t445":[{"id":"a2b2a4f2e7a1","t":"东方未明","a":"佚名","d":1,"f":"诗经","g":"诗","x":"东方未明，颠倒衣裳。颠之倒之，自公召之。","b":0,"y":-700,"th":["徭役","批判","疾苦"],"ap":1},{"id":"2654a9d4f4df","t":"论语·公冶长篇 其18","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“臧文仲居蔡，山节藻棁，何如其知也？”","b":2,"y":-450,"th":["哲理","礼制","批判"],"ap":1}],"t456":[{"id":"3a7e8a50139f","t":"小星","a":"佚名","d":1,"f":"诗经","g":"诗","x":"嘒彼小星，三五在东。肃肃宵征，夙夜在公。寔命不同！","b":0,"y":-700,"th":["劳役","咏物","叹命"],"ap":1},{"id":"a570201c9e16","t":"杂曲歌辞 行路难五首 一","a":"贺兰进明","d":6,"f":"古体","g":"诗","x":"君不见嵒下井，百尺不及泉。","b":4,"y":750,"th":["哲理","饮酒","叹命"],"ap":1}],"t470":[{"id":"59d9f17f9c7d","t":"论语·公冶长篇 其3","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子谓子贱：“君子哉若人！鲁无君子者，斯焉取斯？”","b":2,"y":-450,"th":["品评人物","教化","哲理"],"ap":1},{"id":"ba984054346a","t":"论语·宪问篇 其9","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"或问子产，子曰：“惠人也。”问子西，曰：“彼哉，彼哉！”问管仲，曰：“人也。夺伯氏骈邑三百，饭疏食，没齿无怨言。”","b":3,"y":-450,"th":["品评人物","知人论世","为政"],"ap":1}],"t481":[{"id":"7fdcdb83297b","t":"臣工","a":"佚名","d":1,"f":"诗经","g":"诗","x":"嗟嗟臣工，敬尔在公。王厘尔成，来咨来茹。嗟嗟保介，维莫之春，亦又何求？如何新畲？","b":0,"y":-700,"th":["农事","颂歌","劝农"],"ap":1},{"id":"765eac46b83f","t":"郊庙歌辞 享先蚕乐章 昭庆","a":"不详","d":6,"f":"五律","g":"诗","x":"仙坛礼既毕，神驾俨将升。","b":5,"y":750,"th":["祭祀","劝农","祈福"],"ap":1}],"t492":[{"id":"dd7530e714cc","t":"论语·子张篇 其18","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"曾子曰：“吾闻诸夫子，孟庄子之孝也，其他可能也；其不改父之臣与父之政，是难能也。”","b":2,"y":-450,"th":["孝道","哲理","政治伦理"],"ap":1},{"id":"ad244a3ab530","t":"孟子·滕文公上 其24","a":"孟子","d":1,"f":"文","g":"文","x":"「然则治天下独可耕且为与？有大人之事，有小人之事。且一人之身，而百工之所为备。如必自为而后用之，是率天下而路也。故曰：或劳心，或劳力；劳心者治人，劳力者治于人；治于人者食人，治人者食于人：天下之通义也。","b":5,"y":-320,"th":["哲理","社会分工","政治伦理"],"ap":1}],"t500":[{"id":"fb5365dd5df8","t":"论语·述而篇 其14","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子在齐闻《韶》，三月不知肉味，曰：“不图为乐之至于斯也。”","b":1,"y":-517,"th":["艺术","审美","哲理"],"ap":1},{"id":"c1cb068b1000","t":"观公孙大娘弟子舞劒器行","a":"杜甫","d":6,"f":"古体","g":"诗","x":"昔有佳人公孙氏，一舞劒气动四方。","b":7,"y":767,"th":["怀古","感时","艺术","人生"],"ap":1}],"t526":[{"id":"2a1f044eed75","t":"竹枝词二首 一","a":"刘禹锡","d":6,"f":"七绝","g":"诗","x":"杨柳青青江水平，闻郎江上唱歌声。","b":9,"y":822,"th":["爱情","民歌","双关"],"ap":1},{"id":"352d5753f55a","t":"南吕・一枝花赠朱帘秀","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"轻裁虾万须，巧织珠千串；金钩光错落，绣带舞蹁跹。","b":0,"y":1280,"th":["咏物","赠答","双关"],"ap":1}],"t535":[{"id":"8cf07a05d851","t":"杂曲歌辞 少年行三首 二","a":"李嶷","d":6,"f":"五古","g":"诗","x":"侍猎长杨下，承恩更射飞。","b":4,"y":750,"th":["边塞","咏物","少年游"],"ap":1},{"id":"41206f6c8227","t":"杂曲歌辞 少年乐","a":"李贺","d":6,"f":"七律","g":"诗","x":"芳草落花如锦地，二十长游醉乡里。","b":8,"y":810,"th":["少年游","宴饮","爱情"],"ap":1}],"t544":[{"id":"5ecb4ba4b240","t":"仪鸾殿早秋","a":"太宗皇帝","d":6,"f":"五律","g":"诗","x":"寒惊蓟门叶，秋发小山枝。","b":0,"y":645,"th":["咏物","时序","闲适"],"ap":1},{"id":"56675412d6a1","t":"郊庙歌辞 享龙池乐章 第二章","a":"蔡孚","d":6,"f":"七律","g":"诗","x":"帝宅王家大道边，神马龙龟涌圣泉。","b":2,"y":710,"th":["颂圣","咏物","时序"],"ap":1}],"t553":[{"id":"fbfaf8bde021","t":"咏司马彪续汉志","a":"太宗皇帝","d":6,"f":"五古","g":"诗","x":"二仪初创象，三才乃分位。","b":0,"y":645,"th":["咏史","哲理","文治"],"ap":1},{"id":"78bbbd0460be","t":"集贤书院成送张说上集贤学士赐宴得珍字","a":"明皇帝","d":6,"f":"五古","g":"诗","x":"广学开书院，崇儒引席珍。","b":2,"y":725,"th":["颂德","送别","宴饮","文治"],"ap":1}],"t579":[{"id":"3f86c10af48c","t":"应天长","a":"柳永","d":8,"f":"词","g":"词","x":"残蝉渐绝。","b":1,"y":1035,"th":["悲秋","重阳","哲理"],"ap":1},{"id":"3100233587b8","t":"玉蝴蝶","a":"柳永","d":8,"f":"词","g":"词","x":"淡荡素商行暮，远空雨歇，平野烟收。","b":3,"y":1100,"th":["秋景","羁旅","重阳","旷达"],"ap":1}],"t588":[{"id":"3fb7e1c7dc85","t":"钱大尹智宠谢天香・金盏儿","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"猛觑了那容姿，不觉的下阶址，下场头少不的跟官长厅前死；往常觑品官宣使似小孩儿。","b":0,"y":1250,"th":["戏曲","官场","心理刻画"],"ap":1},{"id":"a8752a7c64ac","t":"诈妮子调风月・二煞","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"出门来一脚高一脚低，自不觉鞋底儿着田地。","b":0,"y":1280,"th":["爱情","闺怨","心理刻画"],"ap":1}],"t597":[{"id":"06c18dc57a53","t":"孟子·梁惠王上 其32","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「王无异于百姓之以王为爱也。以小易大，彼恶知之？王若隐其无罪而就死地，则牛羊何择焉？」","b":4,"y":-320,"th":["哲理","仁政","辩理"],"ap":1}],"t621":[{"id":"1b55816d777a","t":"凯风","a":"佚名","d":1,"f":"诗经","g":"诗","x":"凯风自南，吹彼棘心。棘心夭夭，母氏劬劳。","b":0,"y":-700,"th":["孝道","感恩","自责"],"ap":1}],"t632":[{"id":"268e9320006c","t":"论语·八佾篇 其11","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"或问禘之说。子曰：“不知也。知其说者之于天下也，其如示诸斯乎！”指其掌。","b":2,"y":-450,"th":["哲理","礼治","治国"],"ap":1}],"t647":[{"id":"31bccfb89af5","t":"论语·雍也篇 其8","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"季康子问：“仲由可使从政也与？”子曰：“由也果，于从政乎何有？”曰：“赐也可使从政也与？”曰：“赐也达，于从政乎何有？”曰：“求也可使从政也与？”曰：“求也艺，于从政乎何有？”","b":2,"y":-490,"th":["知人善任","因材施教","治国理政"],"ap":1}],"t658":[{"id":"3d89863a00d4","t":"论语·子张篇 其10","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子夏曰：“君子信而后劳其民，未信，则以为厉己也；信而后谏，未信，则以为谤己也。”","b":1,"y":-500,"th":["哲理","政治","信任"],"ap":1}],"t683":[{"id":"4fc516c18189","t":"孟子·滕文公上 其11","a":"孟子","d":1,"f":"文","g":"文","x":"使毕战问井地。孟子曰：「子之君将行仁政，选择而使子，子必勉之！夫仁政，必自经界始。经界不正，井地不钧，谷禄不平。是故暴君污吏必慢其经界。经界既正，分田制禄可坐而定也。夫滕壤地褊小，将为君子焉，将为野人焉。无君子莫治野人，无野人莫养君子。请野九一而助，国中什一使自赋。卿以下必有圭田，圭田五十亩。余夫二十五亩。死徙无出乡，乡田同井。出入相友，守望相助，疾病相扶持，则百姓亲睦。方里而井，井九百亩，其中为公田。八家皆私百亩，同养公田。公事毕，然后敢治私事，所以别野人也。此其大略也。若夫润泽之，则在君与子矣。」","b":5,"y":-320,"th":["仁政","井田制","经界","社会理想"],"ap":1}],"t694":[{"id":"635e99b441f7","t":"大学·大学 其7","a":"曾子（传）","d":1,"f":"文","g":"文","x":"《诗》云：「邦畿千里，惟民所止。」《诗》云：「缗蛮黄鸟，止于丘隅。」子曰：「于止，知其所止，可以人而不如鸟乎？」《诗》云：「穆穆文王，于缉熙敬止！」为人君，止于仁；为人臣，止于敬；为人子，止于孝；为人父，止于慈；与国人交，止于信。","b":4,"y":-430,"th":["哲理","伦理","修齐治平"],"ap":1}],"t702":[{"id":"6dcad0375229","t":"孟子·滕文公下 其31","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「今有人日攘其邻之鸡者，或告之曰：『是非君子之道。』曰：『请损之，月攘一鸡，以待来年，然后已。』如知其非义，斯速已矣，何待来年。」","b":5,"y":-300,"th":["哲理","修身","寓言"],"ap":1}],"t711":[{"id":"77628e185c7c","t":"采苓","a":"佚名","d":1,"f":"诗经","g":"诗","x":"采苓采苓，首阳之巅。人之为言，苟亦无信。舍旃舍旃，苟亦无然。人之为言，胡得焉？","b":1,"y":-650,"th":["哲理","劝诫","讥讽"],"ap":1}],"t768":[{"id":"c3347489a10c","t":"孟子·滕文公下 其5","a":"孟子","d":1,"f":"文","g":"文","x":"周霄问曰：「古之君子仕乎？」","b":5,"y":-320,"th":["哲理","出处之道","士人精神"],"ap":1}],"t777":[{"id":"c89cdd66e9c4","t":"葛覃","a":"佚名","d":1,"f":"诗经","g":"诗","x":"葛之覃兮，施于中谷，维叶萋萋。黄鸟于飞，集于灌木，其鸣喈喈。","b":0,"y":-700,"th":["劳动","亲情","归宁"],"ap":1}],"t799":[{"id":"e318e8fa0f9b","t":"大车","a":"佚名","d":1,"f":"诗经","g":"诗","x":"大车槛槛，毳衣如菼。岂不尔思？畏子不敢。","b":0,"y":-700,"th":["爱情","誓言"],"ap":1}],"t805":[{"id":"e721284acc7d","t":"孟子·离娄上 其4","a":"孟子","d":1,"f":"文","g":"文","x":"「故曰，城郭不完，兵甲不多，非国之灾也；田野不辟，货财不聚，非国之害也。上无礼，下无学，贼民兴，丧无日矣。《诗》曰：『天之方蹶，无然泄泄。』泄泄，犹沓沓也。事君无义，进退无礼，言则非先王之道者，犹沓沓也。故曰：责难于君谓之恭，陈善闭邪谓之敬，吾君不能谓之贼。」","b":5,"y":-320,"th":["哲理","政论","治国"],"ap":1}],"t816":[{"id":"ebaf6cf527cb","t":"北风","a":"佚名","d":1,"f":"诗经","g":"诗","x":"北风其凉，雨雪其雱。惠而好我，携手同行。其虚其邪？既亟只且！","b":0,"y":-700,"th":["政治怨刺","逃亡避祸","友谊"],"ap":1}],"t830":[{"id":"fb00f627b20f","t":"出其东门","a":"佚名","d":1,"f":"诗经","g":"诗","x":"出其东门，有女如云。虽则如云。匪我思存。缟衣綦巾，聊乐我员。","b":0,"y":-700,"th":["爱情","专一","咏人"],"ap":1}],"t849":[{"id":"01cb2d26137a","t":"巡衣锦军制还乡歌","a":"吴越王钱镠","d":6,"f":"古体","g":"诗","x":"三节还乡兮挂锦衣，碧天朗朗兮爱日晖。","b":10,"y":902,"th":["功业","思乡","庆典","王者气象"],"ap":1}],"t863":[{"id":"09806096a318","t":"郊庙歌辞 中宗祀昊天乐章 舒和","a":"不详","d":6,"f":"七绝","g":"诗","x":"已陈粢盛敷严祀，更奏笙镛协雅声。","b":2,"y":705,"th":["礼乐/太平/颂圣"],"ap":1}],"t874":[{"id":"112eb54e6521","t":"重阳日即事","a":"德宗皇帝","d":6,"f":"五古","g":"诗","x":"令节晓澄霁，四郊烟霭空。","b":7,"y":785,"th":["节令/政治/民生"],"ap":1}],"t922":[{"id":"2e2a8576e489","t":"端午","a":"明皇帝","d":6,"f":"五古","g":"诗","x":"端午临中夏，时清日复长。","b":2,"y":720,"th":["节令/咏物/颂德"],"ap":1}],"t931":[{"id":"3325c032425b","t":"游长宁公主流杯池二十五首 十四","a":"上官昭容","d":6,"f":"五绝","g":"诗","x":"攀藤招逸客，偃桂协幽情。","b":1,"y":699,"th":["山水/隐逸/闲适"],"ap":1}],"t948":[{"id":"3f91d4fb86e7","t":"横吹曲辞 关山月","a":"耿[𣲗]","d":6,"f":"五律","g":"诗","x":"月明边徼静，戍客望乡时。","b":4,"y":750,"th":["边塞","思乡","离情"],"ap":1}],"t957":[{"id":"45173fe45a81","t":"巡省途