x":"蓼彼萧斯，零露湑兮。既见君子，我心写兮。燕笑语兮，是以有誉处兮。","b":0,"y":-700,"th":["宴饮","颂德","祈福"],"ap":1},{"id":"6b9c1e0d07f4","t":"有駜","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有駜有駜，駜彼乘黄。夙夜在公，在公明明。振振鹭，鹭于下。鼓咽咽，醉言舞。于胥乐兮！","b":1,"y":-650,"th":["颂赞","宴饮","祈福"],"ap":1},{"id":"3d5d1696557c","t":"礼魂","a":"屈原","d":1,"f":"楚辞","g":"诗","x":"成礼兮会鼓，","b":5,"y":-290,"th":["祭祀","祈福","咏神"],"ap":1},{"id":"460425cbac7e","t":"相和歌辞 子夜四时歌六首 秋歌二首 二","a":"郭元振","d":6,"f":"五古","g":"诗","x":"辟恶茱萸囊，延年菊花酒。","b":1,"y":691,"th":["节令","风俗","祈福"],"ap":1}],"t104":[{"id":"13a0ed01dfe2","t":"论语·先进篇 其1","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“先进于礼乐，野人也；后进于礼乐，君子也。如用之，则吾从先进。”","b":2,"y":-450,"th":["哲理","用人","教育"],"ap":1},{"id":"154f578e8235","t":"论语·宪问篇 其8","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“为命，裨谌草创之，世叔讨论之，行人子羽修饰之，东里子产润色之。”","b":3,"y":-450,"th":["为政","用人","治学"],"ap":1},{"id":"2663f4a36c46","t":"论语·公冶长篇 其19","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子张问曰：“令尹子文三仕为令尹，无喜色，三已之无愠色，旧令尹之政必以告新令尹，何如？”子曰：“忠矣。”曰：“仁矣乎？”曰：“未知，焉得仁？”“崔子弑齐君，陈文子有马十乘，弃而违之。至于他邦，则曰：‘犹吾大夫崔子也。’违之。之一邦，则又曰：‘犹吾大夫崔子也。’违之，何如？”子曰：“清矣。”曰：“仁矣乎？”曰：“未知，焉得仁？”","b":2,"y":-450,"th":["哲理","品德","用人"],"ap":1},{"id":"3ac9ed40fd89","t":"论语·子路篇 其2","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"仲弓为季氏宰，问政，子曰：“先有司，赦小过，举贤才。”曰：“焉知贤才而举之？”曰：“举尔所知。尔所不知，人其舍诸？”","b":3,"y":-450,"th":["哲理","治国","用人"],"ap":1},{"id":"44d07bd475b9","t":"论语·微子篇 其10","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"周公谓鲁公曰：“君子不施其亲，不使大臣怨乎不以，故旧无大故则不弃也，无求备于一人。”","b":3,"y":-450,"th":["哲理","治国","用人"],"ap":1},{"id":"c45c8cbc6980","t":"论语·为政篇 其19","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"哀公问曰：“何为则民服？”孔子对曰：“举直错诸枉，则民服；举枉错诸直，则民不服。”","b":2,"y":-450,"th":["哲理","治国","用人"],"ap":1},{"id":"f955b794c3f5","t":"论语·宪问篇 其19","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子言卫灵公之无道也，康子曰：“夫如是，奚而不丧？”孔子曰：“仲叔圉治宾客，祝鮀治宗庙，王孙贾治军旅，夫如是，奚其丧？”","b":3,"y":-450,"th":["哲理","治国","用人"],"ap":1},{"id":"8a45392244d8","t":"孟子·梁惠王下 其45","a":"孟子","d":1,"f":"文","g":"文","x":"孟子见齐宣王曰：「为巨室，则必使工师求大木。工师得大木。则王喜，以为能胜其任也。匠人斵而小之，则王怒，以为不胜其任矣。夫人幼而学之，壮而欲行之。王曰『姑舍女所学而从我』，则何如？今有璞玉于此，虽万镒，必使玉人雕琢之。至于治国家，则曰『姑舍女所学而从我』，则何以异于教玉人雕琢玉哉？」","b":5,"y":-320,"th":["哲理","治国","用人"],"ap":1},{"id":"acabc55d5359","t":"孟子·梁惠王下 其38","a":"孟子","d":1,"f":"文","g":"文","x":"孟子见齐宣王曰：「所谓故国者，非谓有乔木之谓也，有世臣之谓也。王无亲臣矣，昔者所进，今日不知其亡也。」","b":5,"y":-320,"th":["哲理","政治","用人"],"ap":1},{"id":"c98e23907e6b","t":"孟子·梁惠王下 其39","a":"孟子","d":1,"f":"文","g":"文","x":"王曰：「吾何以识其不才而舍之？」","b":5,"y":-320,"th":["哲理","政治","用人"],"ap":1}],"t113":[{"id":"0161ba872c03","t":"夏云峰","a":"柳永","d":8,"f":"词","g":"词","x":"宴堂深。","b":2,"y":1030,"th":["宴饮","避暑","旷达"],"ap":1},{"id":"aaa12d84ce60","t":"巫山一段云","a":"柳永","d":8,"f":"词","g":"词","x":"清旦朝金母，斜阳醉玉龟。","b":2,"y":1030,"th":["游仙","旷达","漂泊"],"ap":1},{"id":"9cf766e0ef09","t":"木兰花・玉楼春","a":"柳永","d":8,"f":"词","g":"词","x":"翦裁用尽春工意。","b":2,"y":1035,"th":["咏物","旷达","伤春"],"ap":1},{"id":"d537d586a379","t":"更漏子","a":"晏殊","d":8,"f":"词","g":"词","x":"菊花残，梨叶堕。","b":3,"y":1040,"th":["惜时","宴饮","旷达"],"ap":1},{"id":"228ca2e328c1","t":"定风波","a":"范仲淹","d":8,"f":"词","g":"词","x":"罗绮满城春欲暮。","b":3,"y":1045,"th":["旷达","咏春","哲理"],"ap":1},{"id":"3100233587b8","t":"玉蝴蝶","a":"柳永","d":8,"f":"词","g":"词","x":"淡荡素商行暮，远空雨歇，平野烟收。","b":4,"y":1100,"th":["秋景","羁旅","重阳","旷达"],"ap":1},{"id":"de1dd8959f6f","t":"挂打沽・浅浅江梅驿使传，乱剪碎鹅毛片。旋剖温橙列着玳筵，玉液着金","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"瓶旋。","b":0,"y":1280,"th":["咏物","宴饮","旷达"],"ap":1},{"id":"185782e13675","t":"锦上花・展放愁眉，休争闲气。今日容颜，老如昨日。古往今来，恁须尽","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"知，贤的愚的，贫的和富的。","b":0,"y":1290,"th":["哲理","叹老","旷达"],"ap":1},{"id":"34a81b790411","t":"双调・乔牌儿","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"世情推物理，人生贵适意。","b":0,"y":1290,"th":["哲理","旷达"],"ap":1},{"id":"8d35b9e8707c","t":"于中好·小构园林寂不哗","a":"纳兰性德","d":11,"f":"词","g":"词","x":"小构园林寂不哗，疏篱曲径仿山家","b":0,"y":1680,"th":["田园","隐逸","壮志","旷达"],"ap":1}],"t139":[{"id":"824cee8e2ba3","t":"谷风","a":"佚名","d":1,"f":"诗经","g":"诗","x":"习习谷风，以阴以雨。黾勉同心，不宜有怒。采葑采菲，无以下体？德音莫违，及尔同死。","b":0,"y":-1050,"th":["弃妇","婚姻","怨情","对比"],"ap":1},{"id":"e6e83b8cc14a","t":"我行其野","a":"佚名","d":1,"f":"诗经","g":"诗","x":"我行其野，蔽芾其樗。婚姻之故，言就尔居。尔不我畜，复我邦家。","b":0,"y":-700,"th":["弃妇","怨情","婚姻"],"ap":1},{"id":"f8a050cc7294","t":"日月","a":"佚名","d":1,"f":"诗经","g":"诗","x":"日居月诸，照临下土。乃如之人兮，逝不古处？胡能有定？宁不我顾。","b":0,"y":-700,"th":["弃妇","怨情","婚姻"],"ap":1},{"id":"1fddd3a8bef6","t":"氓","a":"佚名","d":1,"f":"诗经","g":"诗","x":"氓之蚩蚩，抱布贸丝。匪来贸丝，来即我谋。送子涉淇，至于顿丘。匪我愆期，子无良媒。将子无怒，秋以为期。","b":1,"y":-650,"th":["弃妇","婚姻","爱情","怨情"],"ap":1},{"id":"55f14d7491b5","t":"东门之杨","a":"佚名","d":1,"f":"诗经","g":"诗","x":"东门之杨，其叶牂牂。昏以为期，明星煌煌。","b":1,"y":-650,"th":["爱情","怨情"],"ap":1},{"id":"d985c781d2da","t":"琴曲歌辞 湘妃怨","a":"陈羽","d":6,"f":"七绝","g":"诗","x":"二妃怨处云沈沈，二妃哭处湘水深。","b":8,"y":800,"th":["怀古","爱情","怨情"],"ap":1},{"id":"f4798fd93787","t":"相和歌辞 懊恼曲","a":"温庭筠","d":6,"f":"七古","g":"诗","x":"藕丝作线难胜针，蘂粉染黄那得深。","b":10,"y":850,"th":["爱情","咏物","怀古","怨情"],"ap":1}],"t140":[{"id":"ae5fa8015092","t":"论语·雍也篇 其9","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"季氏使闵子骞为费宰，闵子骞曰：“善为我辞焉。如有复我者，则吾必在汶上矣。”","b":1,"y":-500,"th":["气节","辞官","守道"],"ap":1},{"id":"551fbf9cdf81","t":"论语·卫灵公篇 其2","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"在陈绝粮，从者病莫能兴。子路愠见曰：“君子亦有穷乎？”子曰：“君子固穷，小人穷斯滥矣。”","b":2,"y":-489,"th":["哲理","气节","修身"],"ap":1},{"id":"ef6ee2c8e508","t":"孟子·公孙丑下 其56","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「非也。于崇，吾得见王。退而有去志，不欲变，故不受也。继而有师命，不可以请。久于齐，非我志也。」","b":4,"y":-320,"th":["哲理","气节","家国"],"ap":1},{"id":"f51965782d5e","t":"孟子·公孙丑下 其3","a":"孟子","d":1,"f":"文","g":"文","x":"明日，出吊于东郭氏，公孙丑曰：「昔者辞以病，今日吊，或者不可乎！」曰：「昔者疾，今日愈，如之何不吊？」","b":4,"y":-320,"th":["哲理","处世","气节"],"ap":1},{"id":"29d18072c69b","t":"孟子·滕文公下 其2","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「昔齐景公田，招虞人以旌，不至，将杀之。志士不忘在沟壑，勇士不忘丧其元。孔子奚取焉？取非其招不往也，如不待其招而往，何哉？且夫枉尺而直寻者，以利言也。如以利，则枉寻直尺而利，亦可为与？昔者赵简子使王良与嬖奚乘，终日而不获一禽。嬖奚反命曰：『天下之贱工也。』或以告王良。良曰：『请复之。』彊而后可，一朝而获十禽。嬖奚反命曰：『天下之良工也。』简子曰：『我使掌与女乘。』谓王良。良不可，曰：『吾为之范我驰驱，终日不获一；为之诡遇，一朝而获十。《诗》云：「不失其驰，舍矢如破。」我不贯与小人乘，请辞。』御者且羞与射者比。比而得禽兽，虽若丘陵，弗为也。如枉道而从彼，何也？且子过矣，枉己者，未有能直人者也。」","b":5,"y":-300,"th":["哲理","气节","守正"],"ap":1},{"id":"4aa58a78dc7b","t":"孟子·滕文公下 其29","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「古者不为臣不见。段干木逾垣而辟之，泄柳闭门而不内，是皆已甚。迫，斯可以见矣。阳货欲见孔子而恶无礼，大夫有赐于士，不得受于其家，则往拜其门。阳货矙孔子之亡也，而馈孔子蒸豚；孔子亦矙其亡也，而往拜之。当是时，阳货先，岂得不见？曾子曰：『胁肩谄笑，病于夏畦。』子路曰：『未同而言，观其色赧赧然，非由之所知也。』由是观之，则君子之所养可知已矣。」","b":5,"y":-300,"th":["哲理","气节","礼制"],"ap":1},{"id":"ca84ba05cee0","t":"孟子·公孙丑下 其12","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「不待三。」","b":5,"y":-300,"th":["哲理","治国","气节"],"ap":1}],"t166":[{"id":"bdb7a6dd5711","t":"杂曲歌辞 结客少年场行","a":"卢照邻","d":6,"f":"五古","g":"诗","x":"长安重游侠，洛阳富才雄。","b":1,"y":670,"th":["边塞","咏侠","建功立业"],"ap":1},{"id":"389e19934bb4","t":"杂曲歌辞 少年行四首 二","a":"王维","d":6,"f":"七绝","g":"诗","x":"汉家君臣欢宴终，高议云台论战功。","b":2,"y":736,"th":["边塞","建功立业","咏人"],"ap":1},{"id":"68ffba41488f","t":"杂曲歌辞 出自蓟北门行","a":"李白","d":6,"f":"五古","g":"诗","x":"虏阵横北荒，胡星曜精芒。","b":4,"y":750,"th":["边塞","战争","建功立业","报国"],"ap":1},{"id":"ce343088426c","t":"相和歌辞 度关山","a":"李端","d":6,"f":"五律","g":"诗","x":"雁塞日初晴，胡关雪复平。","b":7,"y":780,"th":["边塞","建功立业","豪情"],"ap":1},{"id":"7dc4bab2440f","t":"相和歌辞 从军行三首 二","a":"王涯","d":6,"f":"五绝","g":"诗","x":"燕颔多奇相，狼头敢犯边。","b":8,"y":800,"th":["边塞","建功立业","咏志"],"ap":1},{"id":"d63e13c776a3","t":"相和歌辞 从军行","a":"张祜","d":6,"f":"七律","g":"诗","x":"少年金紫就光辉，直指边城虎翼飞。","b":9,"y":827,"th":["边塞","建功立业","咏怀"],"ap":1}],"t175":[{"id":"5d8e9ba10ada","t":"鹊踏枝・蝶恋花","a":"晏殊","d":8,"f":"词","g":"词","x":"槛菊愁烟兰泣露。","b":2,"y":1030,"th":["离愁","相思","秋景"],"ap":1},{"id":"feb8c1f43605","t":"八声甘州","a":"柳永","d":8,"f":"词","g":"词","x":"对潇潇、暮雨洒江天，一番洗清秋。","b":3,"y":1040,"th":["羁旅","思乡","秋景","怀人"],"ap":1},{"id":"a26e0f489b10","t":"苏幕遮","a":"范仲淹","d":8,"f":"词","g":"词","x":"碧云天，黄叶地。","b":3,"y":1042,"th":["思乡","秋景","羁旅"],"ap":1},{"id":"ffceb2b49f9d","t":"诉衷情","a":"晏殊","d":8,"f":"词","g":"词","x":"数枝金菊对芙蓉。","b":3,"y":1050,"th":["秋景","闺怨","闲愁"],"ap":1},{"id":"3100233587b8","t":"玉蝴蝶","a":"柳永","d":8,"f":"词","g":"词","x":"淡荡素商行暮，远空雨歇，平野烟收。","b":4,"y":1100,"th":["秋景","羁旅","重阳","旷达"],"ap":1},{"id":"9b067827e673","t":"风流子·秋郊射猎","a":"纳兰性德","d":11,"f":"词","g":"词","x":"平原草枯矣，重阳后，黄叶树骚骚","b":0,"y":1680,"th":["咏怀","射猎","秋景","叹老"],"ap":1}],"t210":[{"id":"043f3d9ea2ee","t":"论语·八佾篇 其22","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“管仲之器小哉！”或曰：“管仲俭乎？”曰：“管氏有三归，官事不摄，焉得俭？”“然则管仲知礼乎？”曰：“邦君树塞门，管氏亦树塞门；邦君为两君之好，有反坫。管氏亦有反坫，管氏而知礼，孰不知礼？”","b":2,"y":-450,"th":["哲理","礼制","人物品评"],"ap":1},{"id":"0528fca45eb5","t":"论语·先进篇 其3","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"德行：颜渊，闵子骞，冉伯牛，仲弓。言语：宰我，子贡。政事：冉有，季路。文学：子游，子夏。","b":2,"y":-450,"th":["哲理","教育","人物品评"],"ap":1},{"id":"15a2c4b234f8","t":"论语·颜渊篇 其12","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“片言可以折狱者，其由也与？”子路无宿诺。","b":3,"y":-450,"th":["哲理","人物品评"],"ap":1},{"id":"c5632aa12579","t":"论语·公冶长篇 其4","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子贡问曰：“赐也何如？”子曰：“女器也。”曰：“何器也？”曰：“瑚琏也。”","b":2,"y":-450,"th":["哲理","教育","人物品评"],"ap":1}],"t225":[{"id":"2a5597e36409","t":"孟子·梁惠王上 其42","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「王之所大欲可得闻与？」王笑而不言。","b":4,"y":-320,"th":["哲理","政治","心理"],"ap":1},{"id":"9e78ca8e0b10","t":"诈妮子调风月・幺篇","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"教人道\"眼里无珍一世贫\"；成就了又怕辜恩。","b":0,"y":1250,"th":["爱情","心理","杂剧曲词"],"ap":1},{"id":"9df7111589b4","t":"草桥店梦莺莺(第四本)・油葫芦","a":"王实甫","d":9,"f":"曲","g":"曲","x":"情思昏昏眼倦开，单枕侧，梦魂飞入梦阳台。","b":0,"y":1295,"th":["爱情","心理","哲理"],"ap":1},{"id":"ed792dd7f782","t":"草桥店梦莺莺(第四本)・那吒令","a":"王实甫","d":9,"f":"曲","g":"曲","x":"他若是肯来，早身离贵宅；他若是到来，便春生敝斋；他若是不来，似石沉大海。","b":0,"y":1301,"th":["爱情","期盼","心理"],"ap":1}],"t236":[{"id":"800230804ed7","t":"板","a":"佚名","d":1,"f":"诗经","g":"诗","x":"上帝板板，下民卒瘅。出话不然，为犹不远。","b":0,"y":-800,"th":["政治讽刺","忧国忧民","咏史怀古"],"ap":1},{"id":"6edf7e62e45d","t":"十月之交","a":"佚名","d":1,"f":"诗经","g":"诗","x":"十月之交，朔月辛卯。日有食之，亦孔之丑。彼月而微，此日而微；今此下民，亦孔之哀。","b":0,"y":-776,"th":["政治讽刺","天灾人祸","忧国忧民","批判权臣"],"ap":1},{"id":"a71652270044","t":"节南山","a":"佚名","d":1,"f":"诗经","g":"诗","x":"节彼南山，维石岩岩。赫赫师尹，民具尔瞻。忧心如惔，不敢戏谈。国既卒斩，何用不监！","b":0,"y":-750,"th":["政治讽刺","忧国忧民","咏史"],"ap":1},{"id":"b7c784d8c527","t":"候人","a":"佚名","d":1,"f":"诗经","g":"诗","x":"彼候人兮，何戈与祋。彼其之子，三百赤芾。","b":1,"y":-650,"th":["政治讽刺","民生疾苦","咏物"],"ap":1}],"t243":[{"id":"4c4c17839128","t":"相和歌辞 公无渡河","a":"李白","d":6,"f":"古体","g":"诗","x":"黄河西来决崐崘，咆吼万里触龙门。","b":3,"y":736,"th":["咏史","悲剧","哲理"],"ap":1},{"id":"