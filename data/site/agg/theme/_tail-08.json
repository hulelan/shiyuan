,"b":0,"y":1680,"th":["禅意","咏物","即景"],"ap":1}],"t331":[{"id":"d715bdd19170","t":"论语·颜渊篇 其8","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"棘子成曰：“君子质而已矣，何以文为？”子贡曰：“惜乎，夫子之说君子也！驷不及舌。文犹质也，质犹文也。虎豹之鞟犹犬羊之鞟。”","b":1,"y":-500,"th":["哲理","文质关系","儒家思想"],"ap":1},{"id":"0efcda4e7786","t":"孟子·公孙丑上 其30","a":"孟子","d":1,"f":"文","g":"文","x":"「伯夷、伊尹于孔子，若是班乎？」","b":4,"y":-320,"th":["哲理","圣贤之道","儒家思想"],"ap":1}],"t344":[{"id":"2ad5cefed45b","t":"丰","a":"佚名","d":1,"f":"诗经","g":"诗","x":"子之丰兮，俟我乎巷兮，悔予不送兮。","b":0,"y":-700,"th":["爱情","悔恨","婚姻"],"ap":1},{"id":"d96f40bf2e68","t":"八六子","a":"柳永","d":8,"f":"词","g":"词","x":"如花貌。","b":2,"y":1030,"th":["爱情","悔恨","闺怨"],"ap":1}],"t357":[{"id":"4581a9c0a9a4","t":"论语·为政篇 其22","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“人而无信，不知其可也。大车无輗，小车无軏，其何以行之哉？”","b":1,"y":-500,"th":["哲理","修身","诚信"],"ap":1},{"id":"b37dcfc2b3fd","t":"论语·子罕篇 其12","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子疾病，子路使门人为臣。病间，曰：“久矣哉，由之行诈也！无臣而为有臣，吾谁欺？欺天乎？且予与其死于臣之手也，无宁死于二三子之手乎！且予纵不得大葬，予死于道路乎？”","b":1,"y":-500,"th":["礼制","诚信","哲理"],"ap":1}],"t380":[{"id":"f8733dcbb44f","t":"论语·先进篇 其8","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"颜渊死，颜路请子之车以为之椁。子曰：“才不才，亦各言其子也。鲤也死，有棺而无椁，吾不徒行以为之椁。以吾从大夫之后，不可徒行也。”","b":2,"y":-480,"th":["礼制","丧葬","哲理"],"ap":1},{"id":"7bb039c82a53","t":"孟子·滕文公上 其32","a":"孟子","d":1,"f":"文","g":"文","x":"徐子以告孟子。孟子曰：「夫夷子，信以为人之亲其兄之子为若亲其邻之赤子乎？彼有取尔也。赤子匍匐将入井，非赤子之罪也。且天之生物也，使之一本，而夷子二本故也。盖上世尝有不葬其亲者。其亲死，则举而委之于壑。他日过之，狐狸食之，蝇蚋姑嘬之。其颡有泚，睨而不视。夫泚也，非为人泚，中心达于面目。盖归反蔂梩而掩之。掩之诚是也，则孝子仁人之掩其亲，亦必有道矣。」","b":5,"y":-300,"th":["哲理","伦理","丧葬"],"ap":1}],"t393":[{"id":"b260e4a6c4c1","t":"猗嗟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"猗嗟昌兮，颀而长兮。抑若扬兮，美目扬兮。巧趋跄兮，射则臧兮。","b":1,"y":-694,"th":["赞美","讽喻","射猎"],"ap":1},{"id":"9b067827e673","t":"风流子·秋郊射猎","a":"纳兰性德","d":11,"f":"词","g":"词","x":"平原草枯矣，重阳后，黄叶树骚骚","b":0,"y":1680,"th":["咏怀","射猎","秋景","叹老"],"ap":1}],"t407":[{"id":"308edfbae82a","t":"杂曲歌辞 少年子","a":"李百药","d":6,"f":"五古","g":"诗","x":"少年飞翠盖，上路动金镳。","b":0,"y":635,"th":["爱情","游冶","及时行乐"],"ap":1},{"id":"22606d3bdd9a","t":"杂曲歌辞 长安少年行十首 二","a":"李廓","d":6,