，夫如是，奚其丧？”","b":3,"y":-450,"th":["哲理","治国","用人"],"ap":1},{"id":"8a45392244d8","t":"孟子·梁惠王下 其45","a":"孟子","d":1,"f":"文","g":"文","x":"孟子见齐宣王曰：「为巨室，则必使工师求大木。工师得大木。则王喜，以为能胜其任也。匠人斵而小之，则王怒，以为不胜其任矣。夫人幼而学之，壮而欲行之。王曰『姑舍女所学而从我』，则何如？今有璞玉于此，虽万镒，必使玉人雕琢之。至于治国家，则曰『姑舍女所学而从我』，则何以异于教玉人雕琢玉哉？」","b":5,"y":-320,"th":["哲理","治国","用人"],"ap":1},{"id":"acabc55d5359","t":"孟子·梁惠王下 其38","a":"孟子","d":1,"f":"文","g":"文","x":"孟子见齐宣王曰：「所谓故国者，非谓有乔木之谓也，有世臣之谓也。王无亲臣矣，昔者所进，今日不知其亡也。」","b":5,"y":-320,"th":["哲理","政治","用人"],"ap":1},{"id":"c98e23907e6b","t":"孟子·梁惠王下 其39","a":"孟子","d":1,"f":"文","g":"文","x":"王曰：「吾何以识其不才而舍之？」","b":5,"y":-320,"th":["哲理","政治","用人"],"ap":1}],"t168":[{"id":"b6d93504585d","t":"赠胡天师","a":"则天皇后","d":6,"f":"五律","g":"诗","x":"高人叶高志，山服往山家。","b":1,"y":690,"th":["仙道","隐逸","送别","咏物"],"ap":1},{"id":"94bed72d99b2","t":"送玄同真人李抱朴谒灊山仙祠","a":"明皇帝","d":6,"f":"五律","g":"诗","x":"城阙天中近，蓬瀛海上遥。","b":2,"y":720,"th":["送别","仙道","隐逸"],"ap":1},{"id":"32cd61992d08","t":"清明日宴梅道士房","a":"孟浩然","d":6,"f":"五律","g":"诗","x":"林卧愁春尽，开轩览物华。","b":2,"y":728,"th":["隐逸","仙道","惜春"],"ap":1},{"id":"28817cbff252","t":"郊庙歌辞 享惠昭太子庙乐章 亚献终献","a":"裴度","d":6,"f":"五律","g":"诗","x":"重轮始发祥，齿胄方兴学。","b":5,"y":750,"th":["祭祀","追思","仙道"],"ap":1},{"id":"75c27a037980","t":"相和歌辞 凤台曲","a":"王无竞","d":6,"f":"五律","g":"诗","x":"凤台何逶迤，嬴女管参差。","b":4,"y":750,"th":["怀古","爱情","仙道"],"ap":1},{"id":"97631fab2879","t":"郊庙歌辞 享章怀太子庙乐章 迎神","a":"不详","d":6,"f":"四言","g":"诗","x":"副君昭象，道应黄离。","b":5,"y":750,"th":["祭祀","颂德","仙道"],"ap":1},{"id":"260012e39a7e","t":"相和歌辞 乌夜啼二首 一","a":"顾况","d":6,"f":"古体","g":"诗","x":"玉房掣锁声翻叶，银箭添泉遶霜堞。","b":7,"y":790,"th":["咏物","仙道","夜景"],"ap":1},{"id":"7f506f109048","t":"舞曲歌辞 霓裳辞十首 二","a":"王建","d":6,"f":"七绝","g":"诗","x":"中管五弦初半曲，遥教合上隔帘听。","b":8,"y":800,"th":["音乐","咏物","仙道"],"ap":1},{"id":"87a0a79420f4","t":"玄都观","a":"蜀太妃徐氏","d":6,"f":"七绝","g":"诗","x":"登寻丹壑到玄都，接日红霞照座隅。","b":10,"y":900,"th":["仙道","山水","咏物"],"ap":1}],"t182":[{"id":"bb9e65732d3e","t":"郊庙歌辞 武后享清庙乐章十首 第三登歌","a":"不详","d":6,"f":"四言","g":"诗","x":"肃敷大礼，上谒尊灵。","b":1,"y":690,"th":["祭祀","礼乐",