:0,"y":1250,"th":["风尘女子","弃贱从良","戏剧曲词"],"ap":1}],"t599":[{"id":"0761a7d98e30","t":"论语·八佾篇 其24","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"仪封人请见，曰：“君子之至于斯也，吾未尝不得见也。”从者见之。出曰：“二三子何患于丧乎？天下之无道也久矣，天将以夫子为木铎。”","b":1,"y":-492,"th":["哲理","使命","教化"],"ap":1}],"t605":[{"id":"118c4e01b127","t":"悼乱","a":"王逸","d":1,"f":"楚辞","g":"诗","x":"嗟嗟兮悲夫，殽乱兮纷挐。","b":5,"y":-300,"th":["乱世之悲","孤臣之愤","隐逸","怀古"],"ap":1}],"t612":[{"id":"139bb8ad2623","t":"中庸·中庸 其34","a":"子思（传）","d":1,"f":"文","g":"文","x":"《诗》曰：「衣锦尚䌹」，恶其文之著也。故君子之道，暗然而日章；小人之道，的然而日亡。君子之道：淡而不厌，简而文，温而理，知远之近，知风之自，知微之显，可与入德矣。","b":4,"y":-430,"th":["哲理","修身","内敛"],"ap":1}],"t649":[{"id":"321fb06b2579","t":"论语·卫灵公篇 其23","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“君子不以言举人，不以人废言。”","b":2,"y":-450,"th":["哲理","知人论世","修身处世"],"ap":1}],"t656":[{"id":"3d4de28001e1","t":"论语·子路篇 其8","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子谓卫公子荆，“善居室。始有，曰：‘苟合矣。’少有，曰：‘苟完矣。’富有，曰：‘苟美矣。’”","b":3,"y":-450,"th":["哲理","修身","节俭"],"ap":1}],"t663":[{"id":"44745e094f0b","t":"中庸·中庸 其32","a":"子思（传）","d":1,"f":"文","g":"文","x":"唯天下至圣，为能聪明睿知，足以有临也；宽裕温柔，足以有容也；发强刚毅，足以有执也；齐庄中正，足以有敬也；文理密察，足以有别也。溥博渊泉，而时出之。溥博如天，渊泉如渊。见而民莫不敬，言而民莫不信，行而民莫不说。是以声名洋溢乎中国，施及蛮貊；舟车所至，人力所通，天之所覆，地之所载，日月所照，霜露所队；凡有血气者，莫不尊亲，故曰配天。","b":5,"y":-250,"th":["哲理","修身","圣人","德治"],"ap":1}],"t670":[{"id":"46ede394f88d","t":"论语·微子篇 其9","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"太师挚适齐，亚饭干适楚，三饭缭适蔡，四饭缺适秦，鼓方叔入于河，播鼗武入于汉，少师阳、击磬襄入于海。","b":3,"y":-450,"th":["礼崩乐坏","怀古","文化凋零"],"ap":1}],"t722":[{"id":"8f36377effb9","t":"孟子·公孙丑上 其2","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「子诚齐人也，知管仲、晏子而已矣。或问乎曾西曰；『吾子与子路孰贤？』曾西蹴然曰：『吾先子之所畏也。』曰：『然则吾子与管仲孰贤？』曾西艴然不悦，曰：『尔何曾比予于管仲？管仲得君，如彼其专也；行乎国政，如彼其久也；功烈，如彼其卑也。尔何曾比予于是？』」曰：「管仲，曾西之所不为也，而子为我愿之乎？」","b":4,"y":-320,"th":["哲理","王霸之辩","儒家理想"],"ap":1}],"t735":[{"id":"a177567d7c14","t":"论语·述而篇 其27","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子钓而不纲，弋不射宿。","b":3,"y":-450,"th":["哲理","生态伦理","仁爱"],"ap":1}],"t740":[{"id":"a31f197241a1","t":"孟子·公孙丑下 其10","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「皆是也。当在宋也，予将有远行。行者必以赆，辞曰：『餽赆。』予何为不受？当在薛也，予有戒心。辞曰：『闻戒。』故为兵餽