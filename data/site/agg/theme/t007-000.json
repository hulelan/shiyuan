[{"id":"fb0c7b5a8a5f","t":"天作","a":"佚名","d":1,"f":"诗经","g":"诗","x":"天作高山，大王荒之。彼作矣，文王康之。彼徂矣，岐有夷之行。子孙保之。","b":0,"y":-1050,"th":["咏史","颂祖","祭祀"],"ap":1},{"id":"f9899ae6856d","t":"执竞","a":"佚名","d":1,"f":"诗经","g":"诗","x":"执竞武王，无竞维烈。不显成康，上帝是皇。自彼成康，奄有四方，斤斤其明。","b":0,"y":-1050,"th":["祭祀","咏史","颂德"],"ap":1},{"id":"286a573d2d41","t":"文王","a":"佚名","d":1,"f":"诗经","g":"诗","x":"文王在上，于昭于天。周虽旧邦，其命维新。有周不显，帝命不时。文王陟降，在帝左右。","b":0,"y":-1050,"th":["颂歌","咏史","哲理"],"ap":1},{"id":"a7351cc8141b","t":"文王有声","a":"佚名","d":1,"f":"诗经","g":"诗","x":"文王有声，遹骏有声。遹求厥宁，遹观厥成。文王烝哉！","b":0,"y":-1050,"th":["咏史","颂赞","家国"],"ap":1},{"id":"d69af022774f","t":"下武","a":"佚名","d":1,"f":"诗经","g":"诗","x":"下武维周，世有哲王。三后在天，王配于京。","b":0,"y":-1046,"th":["颂美","咏史","哲理"],"ap":1},{"id":"0c233e5837a3","t":"大明","a":"佚名","d":1,"f":"诗经","g":"诗","x":"明明在下，赫赫在上。天难忱斯，不易维王。天位殷适，使不挟四方。","b":0,"y":-1046,"th":["咏史","天命","战争","颂德"],"ap":1},{"id":"bb978f1e6e19","t":"时迈","a":"佚名","d":1,"f":"诗经","g":"诗","x":"时迈其邦，昊天其子之，实右序有周。薄言震之，莫不震叠。怀柔百神，及河乔岳，允王维后。","b":0,"y":-1046,"th":["祭祀","咏史","治国"],"ap":1},{"id":"3469cf1b3e66","t":"武","a":"佚名","d":1,"f":"诗经","g":"诗","x":"于皇武王！无竞维烈。允文文王，克开厥后。嗣武受之，胜殷遏刘，耆定尔功。","b":0,"y":-1046,"th":["咏史","颂功","祭祀"],"ap":1},{"id":"052e69baaeb5","t":"破斧","a":"佚名","d":1,"f":"诗经","g":"诗","x":"既破我斧，又缺我斨。周公东征，四国是皇。哀我人斯，亦孔之将。","b":0,"y":-1042,"th":["战争","咏史","悲叹"],"ap":1},{"id":"9e65cab984a0","t":"访落","a":"佚名","d":1,"f":"诗经","g":"诗","x":"访予落止，率时昭考。于乎悠哉，朕未有艾。将予就之，继犹判涣。","b":0,"y":-1042,"th":["咏史","政治","祭祀"],"ap":1},{"id":"741c54e81584","t":"闵予小子","a":"佚名","d":1,"f":"诗经","g":"诗","x":"闵予小子，遭家不造，嬛嬛在疚。于乎皇考，永世克孝。","b":0,"y":-1040,"th":["悼亡","咏史","颂德"],"ap":1},{"id":"262be2052fe7","t":"昊天有成命","a":"佚名","d":1,"f":"诗经","g":"诗","x":"昊天有成命，二后受之。成王不敢康，夙夜基命宥密。于缉熙！单厥心，四其靖之。","b":0,"y":-1022,"th":["颂歌","咏史","祭祀"],"ap":1},{"id":"9cdbe00ccda7","t":"般","a":"佚名","d":1,"f":"诗经","g":"诗","x":"于皇时周！陟其高山，嶞山乔岳，允犹翕河。敷天之下，裒时之对。时周之命。","b":0,"y":-908,"th":["咏史","祭祀","家国"],"ap":1},{"id":"66818a17e489","t":"荡","a":"佚名","d":1,"f":"诗经","g":"诗","x":"荡荡上帝，下民之辟。疾威上帝，其命多辟。","b":0,"y":-908,"th":["咏史","怀古","哲理"],"ap":1},{"id":"0d5e4d6d7a15","t":"江汉","a":"佚名","d":1,"f":"诗经","g":"诗","x":"江汉浮浮，武夫滔滔。匪安匪游，淮夷来求。既出我车，既设我旟。匪安匪舒，淮夷来铺。","b":0,"y":-820,"th":["战争","颂功","咏史"],"ap":1},{"id":"a71652270044","t":"节南山","a":"佚名","d":1,"f":"诗经","g":"诗","x":"节彼南山，维石岩岩。赫赫师尹，民具尔瞻。忧心如惔，不敢戏谈。国既卒斩，何用不监！","b":0,"y":-750,"th":["政治讽刺","忧国忧民","咏史"],"ap":1},{"id":"fb883494b4f4","t":"黍离","a":"佚名","d":1,"f":"诗经","g":"诗","x":"彼黍离离，彼稷之苗。行迈靡靡，中心摇摇。知我者，谓我心忧；不知我者，谓我何求。悠悠苍天，此何人哉？","b":0,"y":-750,"th":["怀古","咏史","家国"],"ap":1},{"id":"8e62eca867c4","t":"棫朴","a":"佚名","d":1,"f":"诗经","g":"诗","x":"芃芃棫朴，薪之槱之。济济辟王，左右趣之。","b":0,"y":-700,"th":["颂美","咏史","人才"],"ap":1},{"id":"d864ea04d259","t":"殷武","a":"佚名","d":1,"f":"诗经","g":"诗","x":"挞彼殷武，奋伐荆楚。深入其阻，裒荆之旅。有截其所，汤孙之绪。","b":0,"y":-700,"th":["颂赞","咏史","祭祀"],"ap":1},{"id":"c668b992327c","t":"绵","a":"佚名","d":1,"f":"诗经","g":"诗","x":"绵绵瓜瓞。民之初生，自土沮漆。古公亶父，陶复陶冗，未有家室。","b":0,"y":-700,"th":["史诗","咏史","颂歌"],"ap":1},{"id":"0ea59649a955","t":"长发","a":"佚名","d":1,"f":"诗经","g":"诗","x":"浚哲维商，长发其祥。洪水芒芒，禹敷下土方。外大国是疆，幅陨既长。有娀方将，帝立子生商。","b":1,"y":-700,"th":["史诗","祭祀","咏史","颂德"],"ap":1},{"id":"bf5283d8796c","t":"定之方中","a":"佚名","d":1,"f":"诗经","g":"诗","x":"定之方中，作于楚宫。揆之以日，作于楚室。树之榛栗，椅桐梓漆，爰伐琴桑。","b":1,"y":-658,"th":["颂美","农事","咏史"],"ap":1},{"id":"de65697df98a","t":"玄鸟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"天命玄鸟，降而生商，宅殷土芒芒。古帝命武汤，正域彼四方。","b":1,"y":-650,"th":["祭祀","咏史","颂歌"],"ap":1},{"id":"51672a83c681","t":"株林","a":"佚名","d":1,"f":"诗经","g":"诗","x":"胡为乎株林？从夏南！匪适株林，从夏南！","b":1,"y":-600,"th":["讽刺","政治","咏史"],"ap":1},{"id":"362e8d2a8df7","t":"论语·季氏篇 其12","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"齐景公有马千驷，死之日，民无德而称焉；伯夷、叔齐饿于首阳之下，民到于今称之。其斯之谓与？”","b":1,"y":-500,"th":["哲理","咏史","修德"],"ap":1},{"id":"aedae0a62849","t":"论语·微子篇 其11","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"周有八士：伯达、伯适、仲突、仲忽、叔夜、叔夏、季随、季騧。","b":2,"y":-480,"th":["咏史","怀古","哲理"],"ap":1},{"id":"fc97c19cc0ff","t":"论语·泰伯篇 其1","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“泰伯，其可谓至德也已矣。三以天下让，民无得而称焉。”","b":3,"y":-450,"th":["哲理","咏