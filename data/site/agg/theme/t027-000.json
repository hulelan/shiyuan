[{"id":"0c233e5837a3","t":"大明","a":"佚名","d":1,"f":"诗经","g":"诗","x":"明明在下，赫赫在上。天难忱斯，不易维王。天位殷适，使不挟四方。","b":0,"y":-1046,"th":["咏史","天命","战争","颂德"],"ap":1},{"id":"052e69baaeb5","t":"破斧","a":"佚名","d":1,"f":"诗经","g":"诗","x":"既破我斧，又缺我斨。周公东征，四国是皇。哀我人斯，亦孔之将。","b":0,"y":-1042,"th":["战争","咏史","悲叹"],"ap":1},{"id":"fda945734a98","t":"东山","a":"佚名","d":1,"f":"诗经","g":"诗","x":"我徂东山，慆慆不归。我来自东，零雨其濛。我东曰归，我心西悲。","b":0,"y":-908,"th":["思乡","战争","归家"],"ap":1},{"id":"03280f3e5120","t":"六月","a":"佚名","d":1,"f":"诗经","g":"诗","x":"六月栖栖，戎车既饬。四牡骙骙，载是常服。玁狁孔炽，我是用急。王于出征，以匡王国。","b":0,"y":-823,"th":["边塞","战争","颂功","宴饮"],"ap":1},{"id":"0d5e4d6d7a15","t":"江汉","a":"佚名","d":1,"f":"诗经","g":"诗","x":"江汉浮浮，武夫滔滔。匪安匪游，淮夷来求。既出我车，既设我旟。匪安匪舒，淮夷来铺。","b":0,"y":-820,"th":["战争","颂功","咏史"],"ap":1},{"id":"96a554a213a0","t":"出车","a":"佚名","d":1,"f":"诗经","g":"诗","x":"我出我车，于彼牧矣。自天子所，谓我来矣。召彼仆夫，谓之载矣。王事多难，维其棘矣。","b":0,"y":-800,"th":["战争","思乡","边塞","爱国"],"ap":1},{"id":"71a776b5f918","t":"常武","a":"佚名","d":1,"f":"诗经","g":"诗","x":"赫赫明明。王命卿士，南仲大祖，大师皇父。整我六师，以修我戎。既敬既戒，惠此南国。","b":0,"y":-800,"th":["战争","颂歌","军旅","怀古"],"ap":1},{"id":"274e2c5e8884","t":"采芑","a":"佚名","d":1,"f":"诗经","g":"诗","x":"薄言采芑，于彼新田，呈此菑亩。方叔涖止，其车三千。师干之试，方叔率止。","b":0,"y":-800,"th":["战争","颂赞","边塞"],"ap":1},{"id":"e2a86f29696a","t":"君子于役","a":"佚名","d":1,"f":"诗经","g":"诗","x":"君子于役，不知其期。曷至哉？鸡栖于埘。日之夕矣，羊牛下来。君子于役，如之何勿思！","b":0,"y":-700,"th":["思妇","战争","田园"],"ap":1},{"id":"1a477d2b9b31","t":"渐渐之石","a":"佚名","d":1,"f":"诗经","g":"诗","x":"渐渐之石，维其高矣。山川悠远，维其劳矣。武人东征，不遑朝矣。","b":0,"y":-700,"th":["战争","行役","劳苦"],"ap":1},{"id":"ed0bc22b4565","t":"祈父","a":"佚名","d":1,"f":"诗经","g":"诗","x":"祈父，予王之爪牙。胡转予于恤，靡所止居？","b":0,"y":-700,"th":["战争","怨刺","孝道"],"ap":1},{"id":"6fb100f8a178","t":"酌","a":"佚名","d":1,"f":"诗经","g":"诗","x":"于铄王师，遵养时晦。时纯熙矣，是用大介。我龙受之，蹻蹻王之造。载用有嗣，实维尔公允师。","b":1,"y":-700,"th":["战争","颂歌","怀古"],"ap":1},{"id":"0bac9f63b137","t":"伯兮","a":"佚名","d":1,"f":"诗经","g":"诗","x":"伯兮朅兮，邦之桀兮。伯也执殳，为王前驱。","b":1,"y":-650,"th":["闺怨","战争","相思"],"ap":1},{"id":"1e37209942b8","t":"小戎","a":"佚名","d":1,"f":"诗经","g":"诗","x":"小戎俴收，五楘梁辀。游环胁驱，阴靷鋈续。文茵畅毂，驾我骐馵。","b":1,"y":-650,"th":["思妇","战争","咏物"],"ap":1},{"id":"94d88dfdff79","t":"泮水","a":"佚名","d":1,"f":"诗经","g":"诗","x":"思乐泮水，薄采其芹。鲁侯戾止，言观其旂。其旂茷茷，鸾声哕哕。无小无大，从公于迈。","b":1,"y":-650,"th":["颂功","战争","德化"],"ap":1},{"id":"92d4fea5b7b4","t":"击鼓","a":"佚名","d":1,"f":"诗经","g":"诗","x":"击鼓其镗，踊跃用兵。土国城漕，我独南行。","b":1,"y":-550,"th":["战争","爱情","思乡"],"ap":1},{"id":"6caa7a624c10","t":"国殇","a":"屈原","d":1,"f":"楚辞","g":"诗","x":"操吴戈兮被犀甲，车错毂兮短兵接","b":5,"y":-290,"th":["战争","哀悼","咏怀"],"ap":1},{"id":"d0066c99dfa2","t":"相和歌辞 从军行二首 二","a":"虞世南","d":6,"f":"五古","g":"诗","x":"爟火发金微，连营出武威。","b":0,"y":620,"th":["边塞","战争","咏怀","壮行"],"ap":1},{"id":"095580a994e0","t":"相和歌辞 饮马长城窟行","a":"太宗皇帝","d":6,"f":"五古","g":"诗","x":"塞外悲风切，交河冰已结。","b":0,"y":630,"th":["边塞","战争","咏志"],"ap":1},{"id":"404f2530ebab","t":"横吹曲辞 紫骝马","a":"卢照邻","d":6,"f":"五律","g":"诗","x":"骝马照金鞍，转战入皐兰。","b":0,"y":670,"th":["边塞","咏物","战争"],"ap":1},{"id":"1a9e7ec3f519","t":"相和歌辞 燕歌行","a":"高适","d":6,"f":"古体","g":"诗","x":"汉家烟尘在东北，汉将辞家破残贼。","b":0,"y":738,"th":["边塞","战争","怀古","思乡"],"ap":1},{"id":"68ffba41488f","t":"杂曲歌辞 出自蓟北门行","a":"李白","d":6,"f":"五古","g":"诗","x":"虏阵横北荒，胡星曜精芒。","b":0,"y":750,"th":["边塞","战争","建功立业","报国"],"ap":1},{"id":"4cd54732958b","t":"杂曲歌辞 结客少年场行","a":"虞羽客","d":6,"f":"五古","g":"诗","x":"幽幷侠少年，金络控连钱。","b":0,"y":750,"th":["边塞","游侠","咏史","战争"],"ap":1},{"id":"939c2592f36e","t":"杂曲歌辞 蓟门行","a":"李希仲","d":6,"f":"五古","g":"诗","x":"旄头有精芒，胡骑猎秋草。","b":0,"y":750,"th":["边塞","战争","忠义"],"ap":1},{"id":"4e5ff19816ef","t":"杂曲歌辞 行路难五首 三","a":"贺兰进明","d":6,"f":"古体","g":"诗","x":"君不见荒树枝，春花落尽蜂不窥。","b":0,"y":750,"th":["闺怨","边塞","战争"],"ap":1},{"id":"6938ff6ad90c","t":"相和歌辞 从军行","a":"杜𬱟","d":6,"f":"五古","g":"诗","x":"秋草马蹄轻，角弓持弦急。","b":1,"y":750,"th":["边塞","思乡","战争"],"ap":1},{"id":"737ad0c555c3","t":"相和歌辞 从军行","a":"王维","d":6,"f":"五律","g":"诗","x":"吹角动行人，喧喧行人起。","b":1,"y":750,"th":["边塞","报国","战争"],"ap":1},{"id":"68d0e2a1921d","t":"相和歌辞 从军行三首 三","a":"王涯","d":6,"f":"七绝","g":"诗","x":"旄头夜落捷书飞，来奏金门著赐衣。","b":1,"y":750,"th":["边塞","思乡","战争"],"ap":1},{"id":"b9a086704b77","t":"相和歌辞 从军行二首 二","a":"李白","d":6,"f":"七绝","g":"诗","x":"百战沙场碎铁衣，城南已合数重围。","b":1,"y":750,"th":["边塞","战争","英雄"],"ap":1},{"id":"04380cdc4b28","t":"相和歌辞 从军行五首 三","a":"令狐楚","d":6,"f":"五绝","g":"诗","x":"却望冰河阔，前登雪岭高。","b":1,"y":750,"th":["边塞","战争","悲壮"],"ap":1},{"id":"e71c1be172b0","t":"相和歌辞 关山曲 一","a":"马戴","d":6,"f":"五律","g":"诗","x":"金锁耀兜鍪，黄云拂紫骝。","b":1,"y":750,"th":["边塞","战争","劳顿"],"ap":1},{"id":"5d437bd29126","t":"相和歌辞 胡无人行","a":"李白","d":6,"f":"古体","g":"诗","x":"严风吹霜海草雕，筋干精坚胡马骄。","b":1,"y":750,"th":["边塞","战争","咏史","壮志"],"ap":1},{"id":"6bef9b6373f1","t":"相和歌辞 陇西行","a":"王维","d":6,"f":"五古","g":"诗","x":"十里一走马，五里一扬鞭。","b":2,"y":750,"th":["边塞","战争","军旅"],"ap":1},{"id":"9756b56ed04c","t":"相和歌辞 雁门太守行","a":"庄南杰","d":6,"f":"古体","g":"诗","x":"旌旗闪闪摇天末，长笛横吹虏尘阔。","b":2,"y":750,"th":["边塞","战争","悲秋"],"ap":1},{"id":"40afa6325835","t":"杂曲歌辞 蓟门行五首 四","a":"高适","d":6,"f":"五古","g":"诗","x":"茫茫长城外，日没更烟尘。","b":2,"y":752,"th":["边塞","战争","悲壮"],"ap":1},{"id":"1c158b8ef170","t":"横吹曲辞 幽州胡马客歌","a":"李白","d":6,"f":"五古","g":"诗","x":"幽州胡马客，绿眼虎皮冠。","b":2,"y":752,"th":["边塞","战争","悲悯","咏怀"],"ap":1},{"id":"b164bddcfb1d","t":"相和歌辞  豫章行","a":"李白","d":6,"f":"五古","g":"诗","x":"胡风吹代马，北拥鲁阳关。","b":2,"y":756,"th":["边塞","战争","离别"],"ap":1},{"id":"09a8578d56b1","t":"相和歌辞 从军行六首 一","a":"刘长卿","d":6,"f":"五古","g":"诗","x":"回看虏骑合，城下汉兵稀。","b":2,"y":760,"th":["边塞","战争","悲壮"],"ap":1},{"id":"26e8d4e18765","t":"相和歌辞 苦哉行五首 四","a":"戎昱","d":6,"f":"五古","g":"诗","x":"妾家青河边，七叶承貂蝉。","b":2,"y":765,"th":["战争","叙事","闺怨","讽喻"],"ap":1},{"id":"afea0e17cff0","t":"相和歌辞 乌栖曲","a":"李端","d":6,"f":"古体","g":"诗","x":"白马逐牛车，黄昏入狭斜。","b":2,"y":780,"th":["闺怨","战争","思妇"],"ap":1},{"id":"746fa9540753","t":"相和歌辞 从军行","a":"卢纶","d":6,"f":"五古","g":"诗","x":"二十在边城，军中得勇名。","b":2,"y":780,"th":["边塞","战争","怀古","讽喻"],"ap":1},{"id":"bb0a31315594","t":"相和歌辞 从军行","a":"戎昱","d":6,"f":"五古","g":"诗","x":"昔从李都尉，双鞬照马蹄。","b":2,"y":780,"th":["边塞","游侠","战争"],"ap":1},{"id":"64324f781e2d","t":"相和歌辞 从军行 一","a":"僧皎然","d":6,"f":"五律","g":"诗","x":"候骑出纷纷，元戎霍冠军。","