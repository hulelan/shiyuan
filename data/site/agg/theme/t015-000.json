[{"id":"f9899ae6856d","t":"执竞","a":"佚名","d":1,"f":"诗经","g":"诗","x":"执竞武王，无竞维烈。不显成康，上帝是皇。自彼成康，奄有四方，斤斤其明。","b":0,"y":-1050,"th":["祭祀","咏史","颂德"],"ap":1},{"id":"445be98712f9","t":"清庙","a":"佚名","d":1,"f":"诗经","g":"诗","x":"于穆清庙，肃雍显相。济济多士，秉文之德。对越在天，骏奔走在庙。不显不承，无射于人斯。","b":0,"y":-1050,"th":["祭祀","颂德","宗庙"],"ap":1},{"id":"59c9880e8892","t":"灵台","a":"佚名","d":1,"f":"诗经","g":"诗","x":"经始灵台，经之营之。庶民攻之，不日成之。经始勿亟，庶民子来。","b":0,"y":-1050,"th":["颂德","田园","咏物"],"ap":1},{"id":"78c759ab3d67","t":"维天之命","a":"佚名","d":1,"f":"诗经","g":"诗","x":"维天之命，于穆不已。于乎不显，文王之德之纯。假以溢我，我其收之。骏惠我文王，曾孙笃之。","b":0,"y":-1050,"th":["祭祀","颂德","天命"],"ap":1},{"id":"350284adda79","t":"维清","a":"佚名","d":1,"f":"诗经","g":"诗","x":"维清缉熙，文王之典。肇禋，迄用有成，维周之祯。","b":0,"y":-1050,"th":["祭祀","颂德","怀古"],"ap":1},{"id":"0c233e5837a3","t":"大明","a":"佚名","d":1,"f":"诗经","g":"诗","x":"明明在下，赫赫在上。天难忱斯，不易维王。天位殷适，使不挟四方。","b":0,"y":-1046,"th":["咏史","天命","战争","颂德"],"ap":1},{"id":"741c54e81584","t":"闵予小子","a":"佚名","d":1,"f":"诗经","g":"诗","x":"闵予小子，遭家不造，嬛嬛在疚。于乎皇考，永世克孝。","b":0,"y":-1040,"th":["悼亡","咏史","颂德"],"ap":1},{"id":"b24a61578d79","t":"卷阿","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有卷者阿，飘风自南。岂弟君子，来游来歌，以矢其音。","b":0,"y":-1032,"th":["颂德","咏物","宴饮"],"ap":1},{"id":"b9b5bb5b76b7","t":"旱麓","a":"佚名","d":1,"f":"诗经","g":"诗","x":"瞻彼旱麓，榛楛济济。岂弟君子，干禄岂弟。","b":0,"y":-771,"th":["祭祀","颂德","咏物","哲理"],"ap":1},{"id":"a3964f6dc9d4","t":"南山有台","a":"佚名","d":1,"f":"诗经","g":"诗","x":"南山有台，北山有莱。乐只君子，邦家之基。乐只君子，万寿无期。","b":0,"y":-700,"th":["颂德","祝寿","宴饮"],"ap":1},{"id":"7a1916fe30d7","t":"南有嘉鱼","a":"佚名","d":1,"f":"诗经","g":"诗","x":"南有嘉鱼，烝然罩罩。君子有酒，嘉宾式燕以乐。","b":0,"y":-700,"th":["宴饮","贵族","颂德"],"ap":1},{"id":"e9a41e7c53da","t":"有客","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有客有客，亦白其马。有萋有且，敦琢其旅。有客宿宿，有客信信。","b":0,"y":-700,"th":["宴饮","送别","颂德"],"ap":1},{"id":"75a6a2f68eb4","t":"湛露","a":"佚名","d":1,"f":"诗经","g":"诗","x":"湛湛露斯，匪阳不晞。厌厌夜饮，不醉无归。","b":0,"y":-700,"th":["宴饮","颂德","宗庙"],"ap":1},{"id":"d77c15e5c598","t":"烈文","a":"佚名","d":1,"f":"诗经","g":"诗","x":"烈文辟公，锡兹祉福。惠我无疆，子孙保之。无封靡于尔邦，维王其崇之。","b":0,"y":-700,"th":["祭祀","颂德","诫勉"],"ap":1},{"id":"85747689802c","t":"蓼萧","a":"佚名","d":1,"f":"诗经","g":"诗","x":"蓼彼萧斯，零露湑兮。既见君子，我心写兮。燕笑语兮，是以有誉处兮。","b":0,"y":-700,"th":["宴饮","颂德","祈福"],"ap":1},{"id":"0ea59649a955","t":"长发","a":"佚名","d":1,"f":"诗经","g":"诗","x":"浚哲维商，长发其祥。洪水芒芒，禹敷下土方。外大国是疆，幅陨既长。有娀方将，帝立子生商。","b":1,"y":-700,"th":["史诗","祭祀","咏史","颂德"],"ap":1},{"id":"a2a234e23dea","t":"駉","a":"佚名","d":1,"f":"诗经","g":"诗","x":"駉駉牡马，在坰之野。薄言駉者，有驈有皇，有骊有黄，以车彭彭。思无疆思，马斯臧。","b":1,"y":-650,"th":["咏物","颂德","田园"],"ap":1},{"id":"ea1e4970fe9a","t":"郊庙歌辞 明堂乐章 肃和","a":"褚亮","d":6,"f":"四言","g":"诗","x":"象天御宇，乘时布政。","b":0,"y":595,"th":["祭祀","颂德","礼制"],"ap":1},{"id":"b78141620820","t":"郊庙歌辞 祭方丘乐章 肃和","a":"褚亮","d":6,"f":"四言","g":"诗","x":"至矣坤德，皇哉地祇。","b":0,"y":595,"th":["祭祀","颂德","祈福"],"ap":1},{"id":"eab8f013d4d9","t":"郊庙歌辞 雩祀乐章 舒和","a":"褚亮","d":6,"f":"七绝","g":"诗","x":"凤曲登歌调令序，龙雩集舞泛祥风。","b":0,"y":595,"th":["祭祀","礼乐","颂德"],"ap":1},{"id":"059b216eca99","t":"郊庙歌辞 晋昭德成功舞歌 武功舞歌二首 一","a":"不详","d":6,"f":"五律","g":"诗","x":"拨乱资英主，开基自晋阳。","b":0,"y":618,"th":["咏史","颂德","武功"],"ap":1},{"id":"15080faf3f36","t":"郊庙歌辞 祀圜丘乐章 凯安","a":"褚亮","d":6,"f":"五律","g":"诗","x":"昔在炎运终，中华乱无象。","b":0,"y":620,"th":["咏史","颂德","天命"],"ap":1},{"id":"60ac15ce9b2a","t":"郊庙歌辞 祀圜丘乐章 寿和","a":"褚亮","d":6,"f":"四言","g":"诗","x":"八音斯奏，三献毕陈。","b":0,"y":630,"th":["礼乐","颂德","祈福"],"ap":1},{"id":"4f9c2c2acfb4","t":"郊庙歌辞 祀圜丘乐章 豫和","a":"褚亮","d":6,"f":"七绝","g":"诗","x":"上灵睠命膺会昌，盛德殷荐叶辰良。","b":0,"y":630,"th":["颂德","祭祀","天命"],"ap":1},{"id":"1053f7066d45","t":"郊庙歌辞 祀圜丘乐章 雍和","a":"褚亮","d":6,"f":"四言","g":"诗","x":"钦惟大帝，[载]仰皇穹。","b":0,"y":630,"th":["祭祀","颂德","天人感应"],"ap":1},{"id":"ebeb1bccb6e6","t":"郊庙歌辞 享太庙乐章 肃和","a":"魏征、褚亮","d":6,"f":"四言","g":"诗","x":"大哉至德，允兹明圣。","b":0,"y":635,"th":["礼乐","颂德","祭祀"],"ap":1},{"id":"a67e1263bab6","t":"重幸武功","a":"太宗皇帝","d":6,"f":"五古","g":"诗","x":"代马依朔吹，惊禽愁昔丛。","b":0,"y":635,"th":["怀旧","颂德","田园","治世"],"ap":1},{"id":"a153ea339bb7","t":"幸武功庆善宫","a":"太宗皇帝","d":6,"f":"古体","g":"诗","x":"寿丘惟旧迹，酆邑乃前基。","b":0,"y":640,"th":["咏史","颂德","盛世"],"ap":1},{"id":"9