0,"th":["哲理","入世与避世","知其不可而为之"],"ap":1}],"t541":[{"id":"4c4bc11dcc4e","t":"君子阳阳","a":"佚名","d":1,"f":"诗经","g":"诗","x":"君子阳阳，左执簧，右招我由房，其乐只且！","b":0,"y":-700,"th":["燕乐","欢舞","友谊"],"ap":1}],"t556":[{"id":"5f902be54015","t":"孟子·滕文公下 其36","a":"孟子","d":1,"f":"文","g":"文","x":"「圣王不作，诸侯放恣，处士横议，杨朱、墨翟之言盈天下。天下之言，不归杨，则归墨。杨氏为我，是无君也；墨氏兼爱，是无父也。无父无君，是禽兽也。公明仪曰：『庖有肥肉，厩有肥马，民有饥色，野有饿莩，此率兽而食人也。』杨墨之道不息，孔子之道不著，是邪说诬民，充塞仁义也。仁义充塞，则率兽食人，人将相食。吾为此惧，闲先圣之道，距杨墨，放淫辞，邪说者不得作。作于其心，害于其事；作于其事，害于其政。圣人复起，不易吾言矣。","b":5,"y":-320,"th":["卫道","仁义","辟异端","哲理"],"ap":1}],"t592":[{"id":"8f3dc7374f41","t":"论语·乡党篇 其10","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"食不语，寝不言。","b":2,"y":-450,"th":["礼仪","修身","养生"],"ap":1}],"t619":[{"id":"acad1f0f2ca0","t":"论语·八佾篇 其25","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子谓《韶》：“尽美矣，又尽善也。”谓《武》：“尽美矣，未尽善也。”","b":2,"y":-450,"th":["哲理","文艺","仁政"],"ap":1}],"t624":[{"id":"b2a49ab494c4","t":"巧言","a":"佚名","d":1,"f":"诗经","g":"诗","x":"悠悠昊天，曰父母且。无罪无辜，乱如此幠。昊天已威，予慎无罪。昊天大幠，予慎无辜。","b":0,"y":-700,"th":["政治讽喻","忧国忧民","刺谗"],"ap":1}],"t637":[{"id":"bd3759373ecd","t":"孟子·公孙丑下 其11","a":"孟子","d":1,"f":"文","g":"文","x":"孟子之平陆。谓其大夫曰：「子之持戟之士，一日而三失伍，则去之否乎？」","b":4,"y":-320,"th":["哲理","治国","责任"],"ap":1}],"t642":[{"id":"c23495781d7b","t":"孟子·公孙丑上 其42","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「伯夷，非其君不事，非其友不友。不立于恶人之朝，不与恶人言。立于恶人之朝，与恶人言，如以朝衣朝冠坐于涂炭。推恶恶之心，思与乡人立，其冠不正，望望然去之，若将浼焉。是故诸侯虽有善其辞命而至者，不受也。不受也者，是亦不屑就已。柳下惠，不羞污君，不卑小官。进不隐贤，必以其道。遗佚而不怨，阨穷而不悯。故曰：『尔为尔，我为我，虽袒裼裸裎于我侧，尔焉能浼我哉？』故由由然与之偕而不自失焉，援而止之而止。援而止之而止者，是亦不屑去已。」","b":5,"y":-300,"th":["哲理","处世之道","人格修养"],"ap":1}],"t668":[{"id":"dba33dcb8da7","t":"论语·阳货篇 其19","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“予欲无言。”子贡曰：“子如不言，则小子何述焉？”子曰：“天何言哉？四时行焉，百物生焉，天何言哉？”","b":1,"y":-500,"th":["哲理","教育","天道","自然"],"ap":1}],"t686":[{"id":"e839a35851f9","t":"樛木","a":"佚名","d":1,"f":"诗经","g":"诗","x":"南有樛木，葛藟累之。乐只君子，福履绥之。","b":0,"y":-700,"th":["祝贺","比兴","福禄"],"ap":1}],"t691":[{"id":"eaf23f4a5874","t":"论语·述而篇 其21","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子不语怪、力、乱、神。","b":3,"y":-450,"th":["哲理","修身","理性"],"ap":1}],"t707