","儒家道统","人物品鉴"],"ap":1}],"t743":[{"id":"a7b6164a3e00","t":"孟子·公孙丑下 其48","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「坐！我明语子。昔者鲁缪公无人乎子思之侧，则不能安子思；泄柳、申详，无人乎缪公之侧，则不能安其身。子为长者虑，而不及子思，子绝长者乎？长者绝子乎？」","b":5,"y":-300,"th":["哲理","尊贤","辞受"],"ap":1}],"t750":[{"id":"b27d51d42531","t":"孟子·公孙丑下 其15","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「今有受人之牛羊而为之牧之者，则必为之求牧与刍矣。求牧与刍而不得，则反诸其人乎？抑亦立而视其死与？」","b":4,"y":-320,"th":["哲理","政治","比喻"],"ap":1}],"t765":[{"id":"c0cf584b273f","t":"孟子·公孙丑下 其47","a":"孟子","d":1,"f":"文","g":"文","x":"有欲为王留行者，坐而言。不应，隐几而卧。客不悦曰：「弟子齐宿而后敢言，夫子卧而不听，请勿复敢见矣。」","b":4,"y":-320,"th":["哲理","傲骨","辞行"],"ap":1}],"t787":[{"id":"d77c15e5c598","t":"烈文","a":"佚名","d":1,"f":"诗经","g":"诗","x":"烈文辟公，锡兹祉福。惠我无疆，子孙保之。无封靡于尔邦，维王其崇之。","b":0,"y":-700,"th":["祭祀","颂德","诫勉"],"ap":1}],"t794":[{"id":"dcef9ba2f40f","t":"黄鸟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"黄鸟黄鸟，无集于穀，无啄我粟。此邦之人，不我肯穀。言旋言归，复我邦族。","b":1,"y":-700,"th":["思乡","流离","怀亲"],"ap":1}],"t808":[{"id":"e839a35851f9","t":"樛木","a":"佚名","d":1,"f":"诗经","g":"诗","x":"南有樛木，葛藟累之。乐只君子，福履绥之。","b":0,"y":-700,"th":["祝贺","比兴","福禄"],"ap":1}],"t822":[{"id":"f3c18d99ecae","t":"何人斯","a":"佚名","d":1,"f":"诗经","g":"诗","x":"彼何人斯？其心孔艰。胡逝我梁，不入我门？伊谁云从？维暴之云。","b":0,"y":-700,"th":["怨刺","绝交","友情"],"ap":1}],"t844":[{"id":"00779ab71435","t":"九日绝句","a":"德宗皇帝","d":6,"f":"七绝","g":"诗","x":"禁苑秋来爽气多，昆明风动起沧波。","b":7,"y":785,"th":["宫廷/咏物/怀古"],"ap":1}],"t857":[{"id":"05d25d1787b3","t":"郊庙歌辞 周宗庙乐舞辞 治顺","a":"不详","d":6,"f":"四言","g":"诗","x":"清庙将入，衮服是依。","b":5,"y":750,"th":["祭祖","孝道","礼乐"],"ap":1}],"t879":[{"id":"1456efdcc48f","t":"采芙蓉","a":"太宗皇帝","d":6,"f":"五古","g":"诗","x":"结伴戏方塘，携手上雕航。","b":0,"y":645,"th":["宫廷游乐","自然抒情","闲适生活"],"ap":1}],"t880":[{"id":"1456efdcc48f","t":"采芙蓉","a":"太宗皇帝","d":6,"f":"五古","g":"诗","x":"结伴戏方塘，携手上雕航。","b":0,"y":645,"th":["宫廷游乐","自然抒情","闲适生活"],"ap":1}],"t893":[{"id":"1cf9f1885b7f","t":"琴曲歌辞 龙宫操","a":"顾况","d":6,"f":"七古","g":"诗","x":"龙宫月明光参差，精卫衔石东飞时。","b":7,"y":780,"th":["神话","奇幻","咏物"],"ap":1}],"t901":[{"id":"2044e6b2a55d","t":"石淙","a":"睿宗皇帝","d":6,"f":"古体","g":"诗","x":"奇峰嶾