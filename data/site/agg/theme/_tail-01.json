宿而出昼，于予心犹以为速。王庶几改之。王如改诸，则必反予。夫出昼而王不予追也，予然后浩然有归志。予虽然，岂舍王哉？王由足用为善。王如用予，则岂徒齐民安，天下之民举安。王庶几改之，予日望之。予岂若是小丈夫然哉？谏于其君而不受，则怒，悻悻然见于其面。去则穷日之力而后宿哉？」","b":4,"y":-320,"th":["政治抱负","进退之道","儒家人格","家国情怀"],"ap":1},{"id":"da343dac847f","t":"示儿","a":"陆游","d":8,"f":"七绝","g":"诗","x":"死去元知万事空，但悲不见九州同。","b":3,"y":1210,"th":["爱国","临终","家国情怀"],"ap":1},{"id":"2a6a62c0f852","t":"玉楼春·年年跃马长安市","a":"刘克庄","d":8,"f":"词","g":"词","x":"年年跃马长安市。","b":3,"y":1230,"th":["家国情怀","人生感慨","豪放抒情"],"ap":1}],"t383":[{"id":"67a068c0b061","t":"相和歌辞 野田黄雀行","a":"储光羲","d":6,"f":"五古","g":"诗","x":"啧啧野田雀，不知躯体微。","b":4,"y":750,"th":["咏物","田园","悯农"],"ap":1},{"id":"43f6af42648f","t":"相和歌辞  董逃行","a":"张籍","d":6,"f":"古体","g":"诗","x":"洛阳城头火曈曈，乱兵烧我天子宫。","b":7,"y":790,"th":["战乱","悯农","怀古"],"ap":1},{"id":"143c963e0e53","t":"杂曲歌辞 苦热行","a":"僧齐己","d":6,"f":"七律","g":"诗","x":"离宫划开赤帝怒，喝起六龙奔日驭。","b":10,"y":898,"th":["悯农","咏物","祈雨"],"ap":1}],"t390":[{"id":"d67090fa18d4","t":"送忠州太守康昭远等","a":"明皇帝","d":6,"f":"五古","g":"诗","x":"端拱临中枢，缅怀共予理。","b":2,"y":713,"th":["送别","政治理想","勉励"],"ap":1},{"id":"310cd9ef288a","t":"送李邕之任滑台","a":"明皇帝","d":6,"f":"五律","g":"诗","x":"汉家重东郡，宛彼白马津。","b":3,"y":736,"th":["送别","仕宦","勉励"],"ap":1},{"id":"eb6a1ad2641d","t":"送徐州张建封还镇","a":"德宗皇帝","d":6,"f":"五古","g":"诗","x":"牧守寄所重，才贤生为时。","b":7,"y":788,"th":["送别","忠君","勉励"],"ap":1}],"t404":[{"id":"ac2b83c9d790","t":"同从弟销南斋玩月忆山阴崔少府","a":"王昌龄","d":6,"f":"五古","g":"诗","x":"高卧南斋时，开帷月初吐。","b":3,"y":734,"th":["怀人","咏月","哲理"],"ap":1},{"id":"d46cca3e5b99","t":"绿头鸭・多丽·晚云收","a":"晁端礼","d":8,"f":"词","g":"词","x":"晚云收，淡天一片琉璃。","b":0,"th":["爱情","怀人","咏月"],"ap":1},{"id":"9a9322ef8368","t":"燕归梁","a":"张先","d":8,"f":"词","g":"词","x":"夜月啼乌促乱弦。","b":2,"y":1050,"th":["离愁","爱情","咏月"],"ap":1}],"t417":[{"id":"0a349328ddff","t":"女冠子","a":"柳永","d":8,"f":"词","g":"词","x":"淡烟飘薄。","b":1,"y":1030,"th":["夏日","闲适","咏怀"],"ap":1},{"id":"8cd03197fc11","t":"女冠子","a":"柳永","d":8,"f":"词","g":"词","x":"火云初布。","b":3,"y":1100,"th":["闺怨","爱情","夏日"],"ap":1},{"id":"f610f88f047b","t":"玉山枕","a":"柳永","d":8,"f":"词","g":"词","x":"骤雨新霁。