g":"诗","x":"手盘风，头背分，电光战扇，欲刺敲心留半线。","b":10,"y":875,"th":["武舞","尚武","咏技"],"ap":1}],"t152":[{"id":"b26248ece44b","t":"论语·雍也篇 其15","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“孟之反不伐，奔而殿，将入门，策其马曰：‘非敢后也，马不进也。’”","b":1,"y":-500,"th":["哲理","谦逊","品德"],"ap":1},{"id":"2663f4a36c46","t":"论语·公冶长篇 其19","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子张问曰：“令尹子文三仕为令尹，无喜色，三已之无愠色，旧令尹之政必以告新令尹，何如？”子曰：“忠矣。”曰：“仁矣乎？”曰：“未知，焉得仁？”“崔子弑齐君，陈文子有马十乘，弃而违之。至于他邦，则曰：‘犹吾大夫崔子也。’违之。之一邦，则又曰：‘犹吾大夫崔子也。’违之，何如？”子曰：“清矣。”曰：“仁矣乎？”曰：“未知，焉得仁？”","b":2,"y":-450,"th":["哲理","品德","用人"],"ap":1},{"id":"46479417f5c6","t":"论语·子路篇 其27","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“刚、毅、木、讷近仁。”","b":3,"y":-450,"th":["哲理","修身","品德"],"ap":1},{"id":"4a1d36288db9","t":"论语·宪问篇 其18","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"公叔文子之臣大夫僎与文子同升诸公，子闻之,曰：“可以为‘文’矣。”","b":3,"y":-450,"th":["哲理","举贤","品德"],"ap":1},{"id":"4b6fa423e2ed","t":"论语·子张篇 其21","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子贡曰：“君子之过也，如日月之食焉。过也人皆见之，更也人皆仰之。”","b":2,"y":-450,"th":["哲理","修身","品德"],"ap":1},{"id":"4f64b92c5f78","t":"论语·学而篇 其10","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子禽问于子贡曰：“夫子至于是邦也，必闻其政，求之与，抑与之与？”子贡曰：“夫子温、良、恭、俭、让以得之。夫子之求之也，其诸异乎人之求之与？”","b":3,"y":-450,"th":["修身","品德","哲理"],"ap":1}],"t178":[{"id":"04eb572548f7","t":"鸡鸣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鸡既鸣矣，朝既盈矣。匪鸡则鸣，苍蝇之声。","b":1,"y":-700,"th":["爱情","生活","闺情"],"ap":1},{"id":"23b752bddf67","t":"论语·乡党篇 其9","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"祭于公，不宿肉。祭肉不出三日，出三日不食之矣。","b":2,"y":-450,"th":["礼制","哲理","生活"],"ap":1},{"id":"12dcdc243913","t":"诈妮子调风月・那吒令","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"等不得水温，一声要面盆；恰递与面盆，一声要手巾；却执与手巾，一声解纽门。","b":0,"y":1250,"th":["爱情","生活","杂剧"],"ap":1},{"id":"62475cc7ab9a","t":"中吕・朝天子书所见","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"鬓鸦，脸霞，屈杀将陪嫁。","b":0,"y":1290,"th":["咏人","爱情","生活"],"ap":1},{"id":"96c2811a5b8f","t":"诈妮子调风月・幺篇","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"这书房存得阿马，会得客宾。","b":0,"y":1290,"th":["讽刺","闲适","生活"],"ap":1}],"t181":[{"id":"12583be7dee8","t":"论语·子张篇 其23","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"叔孙武叔语大夫于朝曰：“子贡贤于仲尼。”子服景伯以告子贡，子贡曰：“譬之宫墙，赐之墙也及肩，窥见室家之好；夫子之墙数仞，不得其门而入，不见宗庙之美、百官之富。得其门者或寡矣，夫子之云不亦宜乎！”","b":2,"y":-450,"th":["哲理","尊师","辩才"],"ap":1},{"id":"1e1be69f804d","t":"论语·子罕篇 其11","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"颜渊喟然叹曰：“仰之弥高，钻之弥坚。瞻之在前，忽焉在后。夫子循循然善诱人，博我以文，约我以礼，欲罢不能。既竭吾才，如有所立卓尔，虽欲从之，末由也已。”","b":2,"y":-450,"th":["哲理","教育","尊师"],"ap":1},{"id":"33f5c0bf1a7a","t":"论语·子张篇 其25","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"陈子禽谓子贡曰：“子为恭也，仲尼岂贤于子乎？”子贡曰：“君子一言以为知，一言以为不知，言不可不慎也。夫子之不可及也，犹天之不可阶而升也。夫子之得邦家者，所谓立之斯立，道之斯行，绥之斯来，动之斯和。其生也荣，其死也哀，如之何其可及也？”","b":2,"y":-450,"th":["哲理","尊师","崇儒"],"ap":1},{"id":"6d3b5c98850d","t":"论语·子张篇 其24","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"叔孙武叔毁仲尼，子贡曰：“无以为也，仲尼不可毁也。他人之贤者，丘陵也，犹可逾也；仲尼，日月也，无得而逾焉。人虽欲自绝，其何伤于日月乎？多见其不知量也。”","b":2,"y":-450,"th":["哲理","尊师","论辩"],"ap":1},{"id":"186fb700e1ba","t":"孟子·公孙丑上 其31","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「否。自有生民以来，未有孔子也。」","b":4,"y":-320,"th":["哲理","尊师","崇圣"],"ap":1}],"t196":[{"id":"f144196d0fec","t":"论语·为政篇 其4","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“吾十有五而志于学，三十而立，四十而不惑，五十而知天命，六十而耳顺，七十而从心所欲，不逾矩。”","b":2,"y":-480,"th":["哲理","修身","人生"],"ap":1},{"id":"7040315b1681","t":"论语·季氏篇 其7","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"孔子曰：“君子有三戒：少之时，血气未定，戒之在色；及其壮也，血气方刚，戒之在斗；及其老也，血气既衰，戒之在得。”","b":3,"y":-450,"th":["哲理","修身","人生"],"ap":1},{"id":"8eb33e9c39c4","t":"相和歌辞 短歌行","a":"王建","d":6,"f":"古体","g":"诗","x":"人初生，日初出。","b":8,"y":800,"th":["哲理","叹时","人生"],"ap":1},{"id":"3dc8f21f88fa","t":"鹤冲天","a":"柳永","d":8,"f":"词","g":"词","x":"黄金榜上。","b":2,"y":1030,"th":["落第","抒愤","爱情","人生"],"ap":1},{"id":"a27c0a7519db","t":"大石调・青杏子骋怀","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"花月酒家楼，可追欢亦可悲秋。","b":0,"y":1290,"th":["哲理","咏怀","人生"],"ap":1}],"t202":[{"id":"643b52f02e95","t":"相和歌辞 公无渡河","a":"王叡","d":6,"f":"古体","g":"诗","x":"浊波洋洋兮凝晓雾，公无渡河兮公苦渡。","b":4,"y":750,"th":["悼亡","爱情","咏物","悲壮"],"ap":1},{"id":"40afa6325835","t":"杂曲歌辞 蓟门行五首 四","a":"高适","d":6,"f":"五古","g":"诗","x":"茫茫长城外，日没更烟尘。","b":7,"y":752,"th":["边塞","战争","悲壮"],"ap":1},{"id":"09a8578d56b1","t":"相和歌辞 从军行六首 一","a":"刘长卿","d":6,"