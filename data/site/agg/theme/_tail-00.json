{"t047":[{"id":"1b55816d777a","t":"凯风","a":"佚名","d":1,"f":"诗经","g":"诗","x":"凯风自南，吹彼棘心。棘心夭夭，母氏劬劳。","b":0,"y":-700,"th":["孝道","感恩","自责"],"ap":1},{"id":"4e242cd41187","t":"蓼莪","a":"佚名","d":1,"f":"诗经","g":"诗","x":"蓼蓼者莪，匪莪伊蒿。哀哀父母，生我劬劳。","b":0,"y":-700,"th":["悼亡","孝道","哀思"],"ap":1},{"id":"ed0bc22b4565","t":"祈父","a":"佚名","d":1,"f":"诗经","g":"诗","x":"祈父，予王之爪牙。胡转予于恤，靡所止居？","b":0,"y":-700,"th":["战争","怨刺","孝道"],"ap":1},{"id":"362bbc16085f","t":"鸨羽","a":"佚名","d":1,"f":"诗经","g":"诗","x":"肃肃鸨羽，集于苞栩。王事靡盬，不能蓺稷黍。父母何怙？悠悠苍天，曷其有所？","b":1,"y":-650,"th":["徭役","怨刺","孝道"],"ap":1},{"id":"01bb60b7536b","t":"论语·为政篇 其7","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子游问孝。子曰：“今之孝者，是谓能养。至于犬马皆能有养；不敬，何以别乎？”","b":2,"y":-450,"th":["哲理","孝道","伦理"],"ap":1},{"id":"0ca3887ee6a2","t":"论语·里仁篇 其20","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“三年无改于父之道，可谓孝矣。”","b":3,"y":-450,"th":["哲理","伦理","孝道"],"ap":1},{"id":"1215a2466774","t":"论语·阳货篇 其21","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"宰我问：“三年之丧，期已久矣！君子三年不为礼，礼必坏；三年不为乐，乐必崩。旧谷既没，新谷既升，钻燧改火，期可已矣。”子曰：“食夫稻，衣夫锦，于女安乎？”曰：“安！”“女安则为之！夫君子之居丧，食旨不甘，闻乐不乐，居处不安，故不为也。今女安，则为之！”宰我出，子曰：“予之不仁也！子生三年，然后免于父母之怀。夫三年之丧，天下之通丧也，予也有三年之爱于其父母乎！”","b":3,"y":-450,"th":["哲理","礼制","孝道"],"ap":1},{"id":"3e217fbc5c59","t":"论语·里仁篇 其19","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“父母在，不远游，游必有方。”","b":3,"y":-450,"th":["哲理","孝道","伦理"],"ap":1},{"id":"410c528e3e11","t":"论语·宪问篇 其40","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子张曰：“《书》云，‘高宗谅阴，三年不言。’何谓也？”子曰：“何必高宗，古之人皆然。君薨，百官总己以听于冢宰三年。”","b":3,"y":-450,"th":["哲理","礼制","孝道"],"ap":1},{"id":"4498f9b0e6c2","t":"论语·里仁篇 其21","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“父母之年，不可不知也，一则以喜，一则以惧。”","b":3,"y":-450,"th":["哲理","亲情","孝道"],"ap":1},{"id":"63b222f22950","t":"论语·先进篇 其5","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“孝哉闵子骞！人不间于其父母昆弟之言。”","b":2,"y":-450,"th":["孝道","哲理","品评"],"ap":1},{"id":"6d0b7393998b","t":"论语·为政篇 其8","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子夏问孝。子曰：“色难。有事，弟子服其劳；有酒食，先生馔，曾是以为孝乎？”","b":2,"y":-450,"th":["哲理","孝道","伦理"],"ap":1},{"id":"74f7285f01be","t":"论语·学而篇 其11","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“父在，观其志；父没，观其行；三年无改于父之道，可谓孝矣。”","b":3,"y":-450,"th":["哲理","伦理","孝道"],"ap":1},{"id":"8e1d82c3dc44","t":"论语·子张篇 其17","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"曾子曰：“吾闻诸夫子，人未有自致者也，必也亲丧乎！”","b":2,"y":-450,"th":["哲理","孝道","人性"],"ap":1},{"id":"c5ed23b49edd","t":"论语·学而篇 其9","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"曾子曰：“慎终追远，民德归厚矣。”","b":3,"y":-450,"th":["哲理","孝道","礼制"],"ap":1},{"id":"d6d68b7c231c","t":"论语·里仁篇 其18","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“事父母，几谏，谏志不从，又敬不违，劳而不怨。”","b":3,"y":-450,"th":["哲理","伦理","孝道"],"ap":1},{"id":"dd7530e714cc","t":"论语·子张篇 其18","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"曾子曰：“吾闻诸夫子，孟庄子之孝也，其他可能也；其不改父之臣与父之政，是难能也。”","b":2,"y":-450,"th":["孝道","哲理","政治伦理"],"ap":1},{"id":"f4b526e21457","t":"论语·为政篇 其6","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"孟武伯问孝。子曰：“父母唯其疾之忧。”","b":2,"y":-450,"th":["哲理","人伦","孝道"],"ap":1},{"id":"d13051b0b475","t":"论语·泰伯篇 其3","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"曾子有疾，召门弟子曰：“启予足，启予手。《诗》云：‘战战兢兢，如临深渊，如履薄冰。’而今而后，吾知免夫，小子！”","b":4,"y":-435,"th":["哲理","修身","孝道"],"ap":1},{"id":"186e9410a406","t":"中庸·中庸 其17","a":"子思（传）","d":1,"f":"文","g":"文","x":"子曰：「舜其大孝也与！德为圣人，尊为天子，富有四海之内。宗庙飨之，子孙保之。故大德必得其位，必得其禄，必得其名，必得其寿。故天之生物，必因其材而笃焉。故栽者培之，倾者覆之。《诗》曰：『嘉乐君子，宪宪令德！宜民宜人，受禄于天。保佑命之，自天申之！』故大德者必受命。」","b":4,"y":-430,"th":["哲理","孝道","德政"],"ap":1},{"id":"984f2121984d","t":"中庸·中庸 其18","a":"子思（传）","d":1,"f":"文","g":"文","x":"子曰：「无忧者其惟文王乎！以王季为父，以武王为子，父作之，子述之。武王缵大王、王季、文王之绪，壹戎衣而有天下，身不失天下之显名；尊为天子，富有四海之内。宗庙飨之，子孙保之。武王末受命，周公成文、武之德，追王大王、王季，上祀先公以天子之礼。斯礼也，达乎诸侯、大夫及士、庶人。父为大夫，子为士，葬以大夫，祭以士。父为士，子为大夫，葬以士，祭以大夫。期之丧，达乎大夫；三年之丧，达乎天子；父母之丧，无贵贱，一也。」","b":4,"y":-430,"th":["礼制","孝道","宗法","德政"],"ap":1},{"id":"cfd75323439a","t":"中庸·中庸 其19","a":"子思（传）","d":1,"f":"文","g":"文","x":"子曰：「武王、周公，其达孝矣乎！夫孝者：善继人之志，善述人之事者也。春、秋修其祖庙，陈其宗器，设其裳衣，荐其时食。宗庙之礼，所以序昭穆也；序爵，所以辨贵贱也；序事，所以辨贤也；旅酬下为上，所以逮贱也；燕毛，所以序齿也。践其位，行其礼，奏其乐，敬其所尊，爱其所亲，事死如事生，事亡如事存，孝之至也。郊社之礼，所以事上帝也；宗庙之礼，所以祀乎其先也。明乎郊社之礼、禘尝之义，治国其如示诸掌乎！」","b":4,"y":-430,"th":["哲理","礼制","孝道","治国"],"ap":1},{"id":"24f2890c9b22","t":"孟子·公孙丑下 其25","a":"孟子","d":1,"f":"文","g":"文","x":"充虞请曰：「前日不知虞之不肖，使虞敦匠事。严，虞不敢请。今愿窃有请也，木若以美然。」","b":4,"y":-320,"th":["哲理","孝道","人伦"],"ap":1},{"id":"61d0d3c5d93d","t":"孟子·滕文公上 其30","a":"孟子","d":1,"f":"文","g":"文","x":"他日又求见孟子。孟子曰：「吾今则可以见矣。不直，则道不见；我且直之。吾闻夷子墨者。墨之治丧也，以薄为其道也。夷子思以易天下，岂以为非是而不贵也？然而夷子葬其亲厚，则是以所贱事亲也。」","b":5,"y":-320,"th":["哲理","论辩","孝道"],"ap":1},{"id":"759476f5e1d9","t":"孟子·滕文公上 其3","a":"孟子","d":1,"f":"文","g":"文","x":"滕定公薨。世子谓然友曰：「昔者孟子尝与我言于宋，于心终不忘。今也不幸至于大故，吾欲使子问于孟子，然后行事。」","b":5,"y":-320,"th":["哲理","尊师重道","孝道"],"ap":1},{"id":"bd3e221abf55","t":"孟子·公孙丑下 其26","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「古者棺椁无度，中古棺七寸，椁称之。自天子达于庶人。非直为观美也，然后尽于人心。不得，不可以为悦；无财，不可以为悦。得之为有财，古之人皆用之，吾何为独不然？且比化者，无使土亲肤，于人心独无恔乎？吾闻之君子：不以天下俭其亲。」","b":4,"y":-320,"th":["孝道","礼制","哲理"],"ap":1},{"id":"c4a9aabfd619","t":"孟子·滕文公上 其4","a":"孟子","d":1,"f":"文","g":"文","x":"然友之邹问于孟子。孟子曰：「不亦善乎！亲丧固所自尽也。曾子曰：『生事之以礼；死葬之以礼，祭之以礼，可谓孝矣。』诸侯之礼，吾未之学也；虽然，吾尝闻之矣。三年之丧，齐疏之服，𫗞粥之食，自天子达于庶人，三代共之。」","b":5,"y":-320,"th":["哲理","礼制","孝道"],"ap":1}],"t054":[{"id":"824cee8e2ba3","t":"谷风","a":"佚名","d":1,"f":"诗经","g":"诗","x":"习习谷风，以阴以雨。黾勉同心，不宜有怒。采葑采菲，无以下体？德音莫违，及尔同死。","b":0,"y":-1050,"th":["弃妇","婚姻","怨情","对比"],"ap":1},{"id":"29c5c29eb7dd","t":"白华","a":"佚名","d":1,"f":"诗经","g":"诗","x":"白华菅兮，白茅束兮。之子之远，俾我独兮。","b":0,"y":-750,"th":["弃妇","宫怨","爱情","政治讽喻"],"ap":1},{"id":"06ee11bf38cf","t":"终风","a":"佚名","d":1,"f":"诗经","g":"诗","x":"终风且暴，顾我则笑，谑浪笑敖，中心是悼。","b":0,"y":-700,"th":["闺怨","爱情","弃妇"],"ap":1},{"id":"84648cb493fe","t":"谷风","a":"佚名","d":1,"f":"诗经","g":"诗","x":"习习谷风，维风及雨。将恐将惧，维予与女。将安将乐，女转弃予。","b":1,"y":-700,"th":["弃妇","怨刺","爱情"],"ap":1},{"id":"be782b449492","t":"晨风","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鴥彼晨风，郁彼北林。未见君子，忧心钦钦。如何如何，忘我实多！","b":0,"y":-700,"th":["爱情","闺怨","弃妇"],"ap":1},{"id":"d7ead9096b5a","t":"江有汜","a":"佚名","d":1,"f":"诗经","g":"诗","x":"江有汜，之子归，不我以。不我以，其后也悔。","b":0,"y":-700,"th":["弃妇","爱情","怨愤"],"ap":1},{"id":"e6e83b8cc14a","t":"我行其野","a":"佚名","d":1,"f":"诗经","g":"诗","x":"我行其野，蔽芾其樗。婚姻之故，言就尔居。尔不我畜，复我邦家。","b":0,"y":-700,"th":["弃妇","怨情","婚姻"],"ap":1},{"id":"f8a050cc7294","t":"日月","a":"佚名","d":1,"f":"诗经","g":"诗","x":"日居月诸，照临下土。乃如之人兮，逝不古处？胡能有定？宁不我顾。","b":0,"y":-700,"th":["弃妇","怨情","婚姻"],"ap":1},{"id":"1fddd3a8bef6","t":"氓","a":"佚名","d":1,"f":"诗经","g":"诗","x":"氓之蚩蚩，抱布贸丝。匪来贸丝，来即我谋。送子涉淇，至于顿丘。匪我愆期，子无良媒。将子无怒，秋以为期。","b":1,"y":-650,"th":["弃妇","婚姻","爱情","怨情"],"ap":1},{"id":"41afef97f5ed","t":"杂曲歌辞 妾薄命","a":"李百药","d":6,"f":"五律","g":"诗","x":"团扇秋风起，长门夜月明。","b":0,"y":630,"th":["宫怨","弃妇","咏史"],"ap":1},{"id":"9ec9176bff64","t":"相和歌辞 白头吟二首 一","a":"李白","d":6,"f":"古体","g":"诗","x":"锦水东北流，波荡双鸳鸯。","b":3,"y":736,"th":["爱情","弃妇","咏史","闺怨"],"ap":1},{"id":"b5d50263c859","t":"相和歌辞 白头吟二首 二","a":"李白","d":6,"f":"古体","g":"诗","x":"锦水东流碧，波荡双鸳鸯。","b":3,"y":736,"th":["弃妇","咏史","爱情","决绝"],"ap":1},{"id":"2b3434b422cc","t":"杂曲歌辞 妾薄命","a":"卢弼","d":6,"f":"七律","g":"诗","x":"君恩已断尽成空，追想娇欢恨莫穷。","b":4,"y":750,"th":["宫怨","弃妇","咏物","悲秋伤春"],"ap":1},{"id":"404071c35417","t":"杂曲歌辞 妾薄命三首 一","a":"李端","d":6,"f":"古体","g":"诗","x":"忆妾初嫁君，花鬟如绿云。","b":7,"y":780,"th":["宫怨","弃妇","咏叹"],"ap":1},{"id":"8d58fdd3659d","t":"杂曲歌辞 行路难","a":"韦应物","d":6,"f":"古体","g":"诗","x":"荆山之白玉兮。","b":7,"y":780,"th":["咏物","爱情","弃妇","哲理"],"ap":1},{"id":"cb97d176179b","t":"杂曲歌辞 妾薄命三首 三","a":"李端","d":6,"f":"五绝","g":"诗","x":"自从君弃妾，憔悴不羞人。","b":7,"y":780,"th":["弃妇","爱情","闺怨"],"ap":1},{"id":"93c4f2def97f","t":"杂曲歌辞 妾薄命","a":"孟郊","d":6,"f":"五古","g":"诗","x":"不惜十指弦，为君千万弹。","b":8,"y":786,"th":["弃妇","爱情","哲理"],"ap":1},{"id":"5f0598ad4441","t":"相和歌辞 白头吟","a":"张籍","d":6,"f":"古体","g":"诗","x":"请君膝上琴，弹我白头吟。","b":8,"y":800,"th":["弃妇","闺怨","爱情","咏叹"],"ap":1},{"id":"68bc184dc55c","t":"相和歌辞 决绝[词]三首 一","a":"元稹","d":6,"f":"古体","g":"诗","x":"乍可为天上牵牛织女星，不愿为庭前红槿枝。","b":9,"y":814,"th":["爱情","弃妇","决绝"],"ap":1},{"id":"f9082f81b468","t":"相和歌辞 怨诗","a":"鲍溶","d":6,"f":"五古","g":"诗","x":"女萝寄松柏，绿蔓花緜緜。","b":9,"y":815,"th":["闺怨","弃妇","爱情","咏物"],"ap":1},{"id":"56c9ce6603e6","t":"诈妮子调风月・上小楼","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"我敢摔碎这盒子，玳瑁纳子，教石头砸碎。","b":0,"y":1250,"th":["闺怨","弃妇","决绝"],"ap":1},{"id":"9979f4cf12f5","t":"双调・新水令","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"搅闲风吹散楚台云，天对付满怀愁闷。","b":0,"y":1250,"th":["爱情","闺怨","弃妇"],"ap":1},{"id":"22720c177603","t":"诈妮子调风月・三煞","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"明日索一般供与他衣袂穿，一般过与他茶饭吃，到晚送得他被底成双睡。","b":0,"y":1290,"th":["弃妇","闺怨","讽刺"],"ap":1},{"id":"5cc4429c1a77","t":"诈妮子调风月・柳叶儿","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"一个个背槽抛粪，一个个负义忘恩，自来鱼雁无音信。","b":0,"y":1290,"th":["闺怨","弃妇"],"ap":1}],"t083":[{"id":"78c759ab3d67","t":"维天之命","a":"佚名","d":1,"f":"诗经","g":"诗","x":"维天之命，于穆不已。于乎不显，文王之德之纯。假以溢我，我其收之。骏惠我文王，曾孙笃之。","b":0,"y":-1050,"th":["祭祀","颂德","天命"],"ap":1},{"id":"0c233e5837a3","t":"大明","a":"佚名","d":1,"f":"诗经","g":"诗","x":"明明在下，赫赫在上。天难忱斯，不易维王。天位殷适，使不挟四方。","b":0,"y":-1046,"th":["咏史","天命","战争","颂德"],"ap":1},{"id":"bccd51e0850a","t":"假乐","a":"佚名","d":1,"f":"诗经","g":"诗","x":"假乐君子，显显令德，宜民宜人。受禄于天，保右命之，自天申之。","b":0,"y":-908,"th":["颂赞","德政","天命"],"ap":1},{"id":"11c1126c83b8","t":"论语·子罕篇 其5","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子畏于匡，曰：“文王既没，文不在兹乎？天之将丧斯文也，后死者不得与于斯文也；天之未丧斯文也，匡人其如予何？”","b":1,"y":-495,"th":["哲理","天命","文化传承"],"ap":1},{"id":"a15a295bd2d4","t":"论语·述而篇 其23","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“天生德于予，桓魋其如予何？”","b":1,"y":-492,"th":["哲理","天命","临危不惧"],"ap":1},{"id":"12f3033a10e5","t":"论语·尧曰篇 其1","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"尧曰：“咨！尔舜，天之历数在尔躬，允执其中。四海困穷，天禄永终。”舜亦以命禹。曰：“予小子履，敢用玄牡，敢昭告于皇皇后帝：有罪不敢赦，帝臣不蔽，简在帝心。朕躬有罪，无以万方；万方有罪，罪在朕躬。”周有大赉，善人是富。“虽有周亲，不如仁人。百姓有过，在予一人。”谨权量，审法度，修废官，四方之政行焉。兴灭国，继绝世，举逸民，天下之民归心焉。所重：民、食、丧、祭。宽则得众，信则民任焉，敏则有功，公则说。","b":3,"y":-450,"th":["天命","民本","仁政","道统"],"ap":1},{"id":"25329edcb9f0","t":"论语·宪问篇 其36","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"公伯寮愬子路于季孙。子服景伯以告，曰：“夫子固有惑志于公伯寮，吾力犹能肆诸市朝。”子曰：“道之将行也与，命也；道之将废也与，命也。公伯寮其如命何？”","b":3,"y":-450,"th":["哲理","天命","守道"],"ap":1},{"id":"3d3c7befc5e9","t":"论语·子罕篇 其1","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子罕言利与命与仁。","b":2,"y":-450,"th":["哲理","义利之辨","天命","仁德"],"ap":1},{"id":"48d13474693a","t":"论语·雍也篇 其10","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"伯牛有疾，子问之，自牖执其手，曰：“亡之，命矣夫！斯人也而有斯疾也！斯人也而有斯疾也！”","b":3,"y":-450,"th":["师生情谊","天命","悲叹"],"ap":1},{"id":"8e44a8a6dea7","t":"论语·述而篇 其35","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子疾病，子路请祷。子曰：“有诸？”子路对曰：“有之。《诔》曰：‘祷尔于上下神祇。’”子曰：“丘之祷久矣。”","b":3,"y":-450,"th":["哲理","天命","师生情谊"],"ap":1},{"id":"2c1a0243b13b","t":"孟子·梁惠王下 其61","a":"孟子","d":1,"f":"文","g":"文","x":"乐正子见孟子，曰：「克告于君，君为来见也。嬖人有臧仓者沮君，君是以不果来也。」曰：「行或使之，止或尼之。行止，非人所能也。吾之不遇鲁侯，天也。臧氏之子焉能使予不遇哉？」","b":5,"y":-320,"th":["天命","哲理","修身","出处进退"],"ap":1},{"id":"eaa7924a5185","t":"孟子·梁惠王下 其56","a":"孟子","d":1,"f":"文","g":"文","x":"孟子对曰：「昔者大王居邠，狄人侵之，去之岐山之下居焉。非择而取之，不得已也。苟为善，后世子孙必有王者矣。君子创业垂统，为可继也。若夫成功，则天也。君如彼何哉？彊为善而已矣。」","b":5,"y":-320,"th":["哲理","治国","天命"],"ap":1},{"id":"4dcf0eb19cc4","t":"舞曲歌辞 公莫舞歌","a":"李贺","d":6,"f":"七古","g":"诗","x":"方花古础排九楹，刺豹淋血盛银甖。","b":9,"y":810,"th":["咏史","天命","霸业"],"ap":1}],"t090":[{"id":"c5bee6a12ac0","t":"杕杜","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有杕之杜，有睆其实。王事靡盬，继嗣我日。日月阳止，女心伤止，征夫遑止。","b":0,"y":-700,"th":["思妇","怀远","战争徭役"],"ap":1},{"id":"edb47427029d","t":"琴曲歌辞  秋思二首 一","a":"鲍溶","d":6,"f":"五古","g":"诗","x":"胡风吹雁翼，远别无人乡。","b":9,"y":815,"th":["闺怨","边塞","怀远"],"ap":1},{"id":"991e3c53efec","t":"酒泉子","a":"潘阆","d":8,"f":"词","g":"词","x":"长忆高峰，峰上塔高尘世外。","b":1,"y":990,"th":["登高","怀远","写景"],"ap":1},{"id":"cb4b78e154c7","t":"倾杯・倾杯乐","a":"柳永","d":8,"f":"词","g":"词","x":"鹜落霜洲，雁横烟渚，分明画出秋色。","b":2,"y":1030,"th":["羁旅","离愁","怀远"],"ap":1},{"id":"7091530f9619","t":"卜算子","a":"柳永","d":8,"f":"词","g":"词","x":"江风渐老，汀蕙半凋，满目败红衰翠。","b":2,"y":1035,"th":["羁旅","怀远","悲秋"],"ap":1},{"id":"95bd02ace326","t":"诉衷情近","a":"柳永","d":8,"f":"词","g":"词","x":"景阑昼永，渐入清和气序。","b":2,"y":1035,"th":["伤春","羁旅","怀远"],"ap":1},{"id":"f8886a49e315","t":"碧牡丹","a":"张先","d":8,"f":"词","g":"词","x":"步帐摇红绮。","b":3,"y":1040,"th":["闺怨","怀远","爱情"],"ap":1},{"id":"2873b71a021d","t":"劝金船","a":"张先","d":8,"f":"词","g":"词","x":"流泉宛转双开窦。","b":3,"y":1050,"th":["宴饮","怀远","惜时"],"ap":1},{"id":"d8015fbe72a1","t":"浣溪沙","a":"张先","d":8,"f":"词","g":"词","x":"楼倚春江百尺高。","b":3,"y":1050,"th":["闺怨","伤春","怀远"],"ap":1},{"id":"e9a048831165","t":"虞美人","a":"张先","d":8,"f":"词","g":"词","x":"恩如明月家家到。","b":3,"y":1050,"th":["送别","思