],"ap":1},{"id":"730c67303756","t":"孟子·公孙丑上 其1","a":"孟子","d":1,"f":"文","g":"文","x":"公孙丑问曰：「夫子当路于齐，管仲、晏子之功，可复许乎？」","b":4,"y":-320,"th":["哲理","政治","王道"],"ap":1},{"id":"763f80313015","t":"孟子·滕文公下 其24","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「汤居亳，与葛为邻，葛伯放而不祀。汤使人问之曰：『何为不祀？』曰：『无以供牺牲也。』汤使遗之牛羊。葛伯食之，又不以祀。汤又使人问之曰：『何为不祀？』曰：『无以供粢盛也。』汤使亳众往为之耕，老弱馈食。葛伯率其民，要其有酒食黍稻者夺之，不授者杀之。有童子以黍肉饷，杀而夺之。《书》曰：『葛伯仇饷。』此之谓也。为其杀是童子而征之，四海之内皆曰：『非富天下也，为匹夫匹妇复雠也。』『汤始征，自葛载』，十一征而无敌于天下。东面而征，西夷怨；南面而征，北狄怨，曰：『奚为后我？』民之望之，若大旱之望雨也。归市者弗止，芸者不变，诛其君，吊其民，如时雨降。民大悦。《书》曰：『徯我后，后来其无罚。』『有攸不惟臣，东征，绥厥士女，匪厥玄黄，绍我周王见休，惟臣附于大邑周。』其君子实玄黄于匪以迎其君子，其小人箪食壶浆以迎其小人，救民于水火之中，取其残而已矣。《太誓》曰：『我武惟扬，侵于之疆，则取于残，杀伐用张，于汤有光。』不行王政云尔，苟行王政，四海之内皆举首而望之，欲以为君。齐楚虽大，何畏焉？」","b":5,"y":-320,"th":["王道","仁政","民本","哲理"],"ap":1},{"id":"8aecda1ea5fd","t":"孟子·梁惠王下 其49","a":"孟子","d":1,"f":"文","g":"文","x":"孟子对曰：「臣闻七十里为政于天下者，汤是也。未闻以千里畏人者也。《书》曰：『汤一征，自葛始。』天下信之。『东面而征，西夷怨；南面而征，北狄怨。曰，奚为后我？』民望之，若大旱之望云霓也。归市者不止，耕者不变。诛其君而吊其民，若时雨降，民大悦。《书》曰：『徯我后，后来其苏。』","b":5,"y":-320,"th":["哲理","仁政","王道","民本"],"ap":1},{"id":"ec88cf819177","t":"孟子·离娄上 其17","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「伯夷辟纣，居北海之滨，闻文王作，兴曰：『盍归乎来！吾闻西伯善养老者。』太公辟纣，居东海之滨，闻文王作，兴曰：『盍归乎来！吾闻西伯善养老者。』二老者，天下之大老也，而归之，是天下之父归之也。天下之父归之，其子焉往？诸侯有行文王之政者，七年之内，必为政于天下矣。」","b":5,"y":-320,"th":["仁政","王道","哲理"],"ap":1},{"id":"c073810038d6","t":"孟子·梁惠王上 其18","a":"孟子","d":1,"f":"文","g":"文","x":"孟子见梁襄王。出，语人曰：「望之不似人君，就之而不见所畏焉。卒然问曰：『天下恶乎定？』吾对曰：『定于一。』","b":5,"y":-319,"th":["哲理","政治","王道"],"ap":1},{"id":"1c7cb78962e0","t":"孟子·梁惠王上 其44","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「否。吾不为是也。」","b":5,"y":-300,"th":["哲理","王道","论辩"],"ap":1}],"t209":[{"id":"3c07bf830f65","t":"钱大尹智宠谢天香・哨遍","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"一自才郎别后，相公那帘幕里香风透。","b":0,"y":1250,"th":["爱情","戏剧","羁旅"],"ap":1},{"id":"2b0a5215a2d0","t":"诈妮子调风月・紫花儿序","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"你把遥天指定，指定那淡月疏星，再说一个海誓山盟；我便收撮了火性，铺撒了人情，忍气吞声，饶过你那亏人不志诚。","b":0,"y":1280,"th":["爱情","闺怨","戏剧"],"ap":1},{"id":"d2a28f248b45","t":"诈妮子调风月・尧民歌","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"见那厮手慌脚乱紧收拾，被我先藏在香罗袖儿里。","b":0,"y":1280,"th":["爱情","闺怨","戏剧"],"ap":1},{"id":"f62167a95960","t":"诈妮子调风月・梨花儿","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"是教我软地上吃交，我也不共你争。","b":0,"y":1280,"th":["爱情","社会","戏剧"],"ap":1},{"id":"915c16aa2caf","t":"钱大尹智宠谢天香・中吕/粉蝶儿","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"送的那水护衣为头，先使了熬麸浆细香澡豆，暖的那温泔清手面轻揉；打底干南定粉，把蔷擞露和就；破开那苏合香油，我嫌棘针梢燎的来油臭。","b":0,"y":1290,"th":["闺阁","咏物","戏剧"],"ap":1},{"id":"292a24efc499","t":"草桥店梦莺莺(第四本)・紫花儿序","a":"王实甫","d":9,"f":"曲","g":"曲","x":"老夫人猜那穷酸做了新婿，小姐做了娇妻，这小贱人做了牵头。","b":0,"y":1300,"th":["爱情","戏剧"],"ap":1},{"id":"3fe0ed327749","t":"草桥店梦莺莺(第四本)・鬼三台","a":"王实甫","d":9,"f":"曲","g":"曲","x":"夜坐时停了针绣，共姐姐闲穷究，说张生哥哥病久。","b":0,"y":1301,"th":["爱情","戏剧"],"ap":1}],"t216":[{"id":"b26248ece44b","t":"论语·雍也篇 其15","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“孟之反不伐，奔而殿，将入门，策其马曰：‘非敢后也，马不进也。’”","b":1,"y":-500,"th":["哲理","谦逊","品德"],"ap":1},{"id":"2663f4a36c46","t":"论语·公冶长篇 其19","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子张问曰：“令尹子文三仕为令尹，无喜色，三已之无愠色，旧令尹之政必以告新令尹，何如？”子曰：“忠矣。”曰：“仁矣乎？”曰：“未知，焉得仁？”“崔子弑齐君，陈文子有马十乘，弃而违之。至于他邦，则曰：‘犹吾大夫崔子也。’违之。之一邦，则又曰：‘犹吾大夫崔子也。’违之，何如？”子曰：“清矣。”曰：“仁矣乎？”曰：“未知，焉得仁？”","b":2,"y":-450,"th":["哲理","品德","用人"],"ap":1},{"id":"46479417f5c6","t":"论语·子路篇 其27","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“刚、毅、木、讷近仁。”","b":3,"y":-450,"th":["哲理","修身","品德"],"ap":1},{"id":"4a1d36288db9","t":"论语·宪问篇 其18","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"公叔文子之臣大夫僎与文子同升诸公，子闻之,曰：“可以为‘文’矣。”","b":3,"y":-450,"th":["哲理","举贤","品德"],"ap":1},{"id":"4b6fa423e2ed","t":"论语·子张篇 其21","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子贡曰：“君子之过也，如日月之食焉。过也人皆见之，更也人皆仰之。”","b":2,"y":-450,"th":["哲理","修身","品德"],"ap":1},{"id":"4f64b92c5f78","t":"论语·学而篇 其10","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子禽问于子贡曰：“夫子至于是邦也，必闻其政，求之与，抑与之与？”子贡曰：“夫子温、良、恭、俭、让以得之。夫子之求之也，其诸异乎人之求之与？”","b":3,"y":-450,"th":["修身","品德","哲理"],"ap":1}],"t223":[{"id":"ec64a7a9d8ae","t":"考槃","a":"佚名","d":1,"f":"诗经","g":"诗","x":"考槃在涧，硕人之宽。独寐寤言，永矢弗谖。","b":0,"y":-700,"th":["隐逸","咏人","高洁"],"ap":1},{"id":"d8be0e992c81","t":"危俊","a":"王褒","d":1,"f":"楚辞","g":"诗","x":"林不容兮鸣蜩，余何留兮中州？","b":5,"y":-300,"th":["远游","孤愤","高洁"],"ap":1},{"id":"969aceff12f9","t":"渔父","a":"屈原","d":1,"f":"楚辞","g":"诗","x":"屈原既放，游于江潭，行吟泽畔，颜色憔悴，形容枯槁。渔父见而问之曰：“子非三闾大夫与？何故至于斯？”屈原曰：“举世皆浊我独清，众人皆醉我独醒，是以见放。”","b":5,"y":-278,"th":["哲理","咏怀","高洁"],"ap":1},{"id":"92ccdd41713e","t":"瑞鹧鸪","a":"林逋","d":8,"f":"词","g":"词","x":"众芳摇落独鲜妍。","b":0,"y":1005,"th":["咏物","隐逸","高洁"],"ap":1},{"id":"77a7f6491dc4","t":"卜算子·缺月挂疏桐","a":"苏轼","d":8,"f":"词","g":"词","x":"缺月挂疏桐，漏断人初静。","b":3,"y":1082,"th":["咏物","抒怀","孤寂","高洁"],"ap":1},{"id":"2431cd2e4b80","t":"点绛唇·咏风兰","a":"纳兰性德","d":11,"f":"词","g":"词","x":"别样幽芬，更无浓艳催开处","b":0,"y":1680,"th":["咏物","高洁","伤秋"],"ap":1}],"t230":[{"id":"549fe9e724d4","t":"郊庙歌辞 武后明堂乐章 皇帝行","a":"武则天","d":6,"f":"四言","g":"诗","x":"仰膺历数，俯顺讴歌。","b":1,"y":696,"th":["颂圣","治国","和平"],"ap":1},{"id":"0d954e6fbc28","t":"郊庙歌辞 释奠武成王乐章 亚献终献","a":"于邵","d":6,"f":"四言","g":"诗","x":"贰觞以献，三变其终。","b":6,"y":750,"th":["祭祀","祈福","和平"],"ap":1},{"id":"c0184ec51ddf","t":"书边事","a":"张乔","d":6,"f":"五律","g":"诗","x":"调角断清秋，征人倚戍楼。","b":4,"y":750,"th":["边塞","和平","民族融合"],"ap":1},{"id":"c811b95f2e5a","t":"舞曲歌辞 凯乐歌辞 贺圣欢","a":"不详","d":6,"f":"五绝","g":"诗","x":"四海皇风被，千年德水清。","b":5,"y":750,"th":["颂德","庆典","和平"],"ap":1},{"id":"1b22bb56dac3","t":"相和歌辞 王昭君","a":"张仲素","d":6,"f":"五绝","g":"诗","x":"仙娥今下嫁，骄子自同和。","b":8,"y":800,"th":["咏史","边塞","和平"],"ap":1},{"id":"99c05abc2fe4","t":"郊庙歌辞 梁郊祀乐章 庆融","a":"赵光逢、张衮","d":6,"f":"七绝","g":"诗","x":"道和气兮袭氤氲，宣皇规兮彰圣神。","b":10,"y":907,"th":["颂德","和平","教化"],"ap":1}],"t245":[{"id":"02af8d1c39a1","t":"论语·宪问篇 其39","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子击磬于卫，有荷蒉而过孔氏之门者，曰：“有心哉，击磬乎！”既而曰：“鄙哉，硁硁乎！莫己知也，斯己而已矣。深则厉，浅则揭。”子曰：“果哉！末之难矣。”","b":1,"y":-492,"th":["哲理","入世","隐逸","知音"],"ap":1},{"id":"b81bf5057bfb","t":"论语·子罕篇 其13","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子贡曰：“有美玉于斯，韫椟而藏诸？求善贾而沽诸？”子曰：“沽之哉，沽之哉！我待贾者也。”","b":1,"y":-490,"th":["哲理","入世","言志"],"ap":1},{"id":"1029674209a3","t":"论语·宪问篇 其38","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子路宿于石门，晨门曰：“奚自？”子路曰：“自孔氏。”曰：“是知其不可而为之者与？”","b":3,"y":-450,"th":["哲理","入世","人物评赞"],"ap":1},{"id":"6cef2b5753c3","t":"论语·先进篇 其12","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"季路问事鬼神，子曰：“未能事人，焉能事鬼？”,曰：“敢问死。”曰：“未知生，焉知死？”","b":2,"y":-450,"th":["哲理","入世","生死"],"ap":1},{"id":"ab248f821dda","t":"孟子·滕文公下 其7","a":"孟子","d":1,"f":"文","g":"文","x":"「三月无君则吊，不以急乎？」","b":5,"y":-320,"th":["哲理","入世","政治"],"ap":1}],"t252":[{"id":"29c7c7a484ab","t":"论语·述而篇 其34","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“若圣与仁，则吾岂敢？抑为之不厌，诲人不倦，则可谓云尔已矣。”公西华曰：“正唯弟子不能学也。”","b":1,"y":-500,"th":["谦逊","教育","哲理"],"ap":1},{"id":"b26248ece44b","t":"论语·雍也篇 其15","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“孟之反不伐，奔而殿，将入门，策其马曰：‘非敢后也，马不进也。’”","b":1,"y":-500,"th":["哲理","谦逊","品德"],"ap":1},{"id":"e848e1789759","t":"论语·子罕篇 其6","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"太宰问于子贡曰：“夫子圣者与，何其多能也？”子贡曰：“固天纵之将圣，又多能也。”子闻之，曰：“太宰知我乎？吾少也贱，故多能鄙事。君子多乎哉？不多也。”","b":1,"y":-490,"th":["哲理","修身","谦逊"],"ap":1},{"id":"196a47f1432c","t":"论语·述而篇 其33","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“文，莫吾犹人也。躬行君子，则吾未之有得。”","b":3,"y":-450,"th":["哲理","修身","谦逊"],"ap":1},{"id":"c8a71ec32488","t":"孟子·公孙丑上 其25","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「恶！是何言也？昔者子贡、问于孔子曰：『夫子圣矣乎？』孔子曰：『圣则吾不能，我学不厌而教不倦也。』子贡曰：『学不厌，智也；教不倦，仁也。仁且智，夫子既圣矣！』夫圣，孔子不居，是何言也？」","b":5,"y":-300,"th":["哲理","谦逊","教育"],"ap":1}],"t281":[{"id":"f610f88f047b","t":"玉山枕","a":"柳永","d":8,"f":"词","g":"词","x":"骤雨新霁。","b":3,"y":1100,"th":["夏日","闲适","宴饮","咏景"],"ap":1},{"id":"fba14d6d59c8","t":"南吕・一枝花杭州景","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"普天下锦绣乡，寰海内风流地。","b":0,"y":1290,"th":["咏景","怀古","市井"],"ap":1},{"id":"cd2ace190ebc","t":"天仙子·渌水亭秋夜","a":"纳兰性德","d":11,"f":"词","g":"词","x":"水浴凉蟾风入袂，鱼鳞蹙损金波碎","b":0,"y":1670,"th":["秋夜","愁绪","咏景"],"ap":1},{"id":"b2ecb3af7f74","t":"扈跸霸州","a":"纳兰性德","d":11,"f":"词","g":"词","x":"霸山重镇奠神京，鸾辂春游淑景明","b":0,"y":1680,"th":["随驾纪行","咏景","边塞"],"ap":1},{"id":"3ed6d6f7851a","t":"忆秦娥·山重叠","a":"纳兰性德","d":11,"f":"词","g":"词","x":"山重叠","b":1,"y":1682,"th":["怀古","咏景","哲理"],"ap":1}],"t300":[{"id":"4c4bc11dcc4e","t":"君子阳阳","a":"佚名","d":1,"f":"诗经","g":"诗","x":"君子阳阳，左执簧，右招我由房，其乐只且！","b":0,"y":-700,"th":["燕乐","欢舞","友谊"],"ap":1},