身"],"ap":1}],"t223":[{"id":"d983cf5ba5cc","t":"论语·阳货篇 其1","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"阳货欲见孔子，孔子不见，归孔子豚。孔子时其亡也而往拜之，遇诸涂。谓孔子曰：“来，予与尔言。”曰：“怀其宝而迷其邦，可谓仁乎？”曰：“不可。”“好从事而亟失时，可谓知乎？”曰：“不可！”“日月逝矣，岁不我与！”孔子曰：“诺，吾将仕矣。”","b":1,"y":-500,"th":["哲理","出仕","处世之道"],"ap":1},{"id":"3f9c7543ca0d","t":"论语·宪问篇 其1","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"宪问耻，子曰：“邦有道，谷；邦无道，谷，耻也。”“克、伐、怨、欲不行焉，可以为仁矣？”子曰：“可以为难矣，仁则吾不知也。”","b":3,"y":-450,"th":["哲理","修身","出仕"],"ap":1},{"id":"26d98203ff40","t":"孟子·滕文公下 其6","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「仕。传曰：『孔子三月无君，则皇皇如也，出疆必载质。』公明仪曰：『古之人三月无君则吊。』」","b":5,"y":-320,"th":["哲理","出仕","入世情怀"],"ap":1},{"id":"ce88ad0ab76f","t":"孟子·滕文公下 其11","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「晋国亦仕国也，未尝闻仕如此其急。仕如此其急也，君子之难仕，何也？」","b":5,"y":-320,"th":["哲理","出仕","道德"],"ap":1}],"t230":[{"id":"4c4bc11dcc4e","t":"君子阳阳","a":"佚名","d":1,"f":"诗经","g":"诗","x":"君子阳阳，左执簧，右招我由房，其乐只且！","b":0,"y":-700,"th":["燕乐","欢舞","友谊"],"ap":1},{"id":"ebaf6cf527cb","t":"北风","a":"佚名","d":1,"f":"诗经","g":"诗","x":"北风其凉，雨雪其雱。惠而好我，携手同行。其虚其邪？既亟只且！","b":0,"y":-700,"th":["政治怨刺","逃亡避祸","友谊"],"ap":1},{"id":"8efd99315f8a","t":"杂曲歌辞 伤歌行","a":"孟郊","d":6,"f":"五古","g":"诗","x":"众毒蔓贞松，一枝难久荣。","b":8,"y":786,"th":["悼亡","咏物","友谊"],"ap":1},{"id":"f2a3df01ae4d","t":"菩萨蛮·过张见阳山居，赋赠","a":"纳兰性德","d":11,"f":"词","g":"词","x":"车尘马迹纷如织，羡君筑处真幽僻","b":0,"y":1680,"th":["隐逸","友谊","咏怀","田园"],"ap":1}],"t245":[{"id":"c35b00c60cfe","t":"相和歌辞 怨诗三首 一","a":"李暇","d":6,"f":"五绝","g":"诗","x":"罗敷初总髻，蕙芳正娇小。","b":4,"y":750,"th":["闺怨","少女","咏美"],"ap":1},{"id":"48af8e837dea","t":"河传","a":"柳永","d":8,"f":"词","g":"词","x":"翠深红浅。","b":2,"y":1030,"th":["咏美","迟暮","邂逅"],"ap":1},{"id":"df3b18b4f3d7","t":"多丽","a":"聂冠卿","d":8,"f":"词","g":"词","x":"想人生，美景良辰堪惜。","b":2,"y":1030,"th":["宴饮","咏美","惜时"],"ap":1},{"id":"3a75f738bdc2","t":"西江月","a":"张先","d":8,"f":"词","g":"词","x":"泛泛春船载乐，溶溶湖水平桥。","b":3,"y":1050,"th":["春日","咏美","伤时","怀人"],"ap":1}],"t252":[{"id":"2d241bf2255e","t":"诈妮子调风月・甜水令","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"姐姐骨甜肉净，堪描堪塑。","b":0,"y":1250,"th":["闺阁","咏人","杂剧"