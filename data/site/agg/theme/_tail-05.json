8","t":"钱大尹智宠谢天香・耍孩儿","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"相公讳字都全有，我将别韵儿轻轻换偷；即时间乐案里便除名，扬言说要结绸缪。","b":0,"y":1250,"th":["风尘女子","身世之感","杂剧曲词"],"ap":1}],"t358":[{"id":"6f7a519c7491","t":"烝民","a":"佚名","d":1,"f":"诗经","g":"诗","x":"天生烝民，有物有则。民之秉彝，好是懿德。天监有周，昭假于下。保兹天子，生仲山甫。","b":0,"y":-700,"th":["颂赞","德行","哲理","送别"],"ap":1},{"id":"4754a83c301e","t":"论语·颜渊篇 其19","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"季康子问政于孔子曰：“如杀无道以就有道，何如？”孔子对曰：“子为政，焉用杀？子欲善而民善矣。君子之德风，小人之德草，草上之风必偃。”","b":2,"y":-490,"th":["哲理","政治","德行"],"ap":1}],"t365":[{"id":"554c000832fe","t":"哀命","a":"东方朔","d":1,"f":"楚辞","g":"诗","x":"哀时命之不合兮，伤楚国之多忧。","b":5,"y":-300,"th":["怀古","忠贞","悲愤"],"ap":1},{"id":"e4f26c165293","t":"守志","a":"王逸","d":1,"f":"楚辞","g":"诗","x":"陟玉峦兮逍遥，览高冈兮峣峣。","b":5,"y":-300,"th":["忠贞","神游","咏怀","政治抱负"],"ap":1}],"t372":[{"id":"f448546f6df6","t":"扬之水","a":"佚名","d":1,"f":"诗经","g":"诗","x":"扬之水，不流束楚。终鲜兄弟，维予与女。无信人之言，人实诳女。","b":0,"y":-750,"th":["亲情","劝诫","乱世"],"ap":1},{"id":"5e4d4fe17a0f","t":"兔爰","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有兔爰爰，雉离于罗。我生之初，尚无为；我生之后，逢此百罹。尚寐无吪。","b":1,"y":-650,"th":["伤时","乱世","哀怨"],"ap":1}],"t408":[{"id":"31ccd1889dcf","t":"相和歌辞 采桑","a":"刘希夷","d":6,"f":"五古","g":"诗","x":"杨柳送行人，青青西入秦。","b":1,"y":675,"th":["春怨","爱情","闺怨"],"ap":1},{"id":"34ce2d34e575","t":"相和歌辞 子夜春歌","a":"王翰","d":6,"f":"五律","g":"诗","x":"春气满林香，春游不可忘。","b":4,"y":750,"th":["春怨","闺思","边塞"],"ap":1}],"t422":[{"id":"ea2f01849841","t":"相和歌辞 从军行","a":"王昌龄","d":6,"f":"五古","g":"诗","x":"向夕临大荒，朔风轸归虑。","b":2,"y":730,"th":["边塞","思乡","壮志未酬"],"ap":1},{"id":"8ede71fd8f6a","t":"杂曲歌辞 游侠行","a":"孟郊","d":6,"f":"五律","g":"诗","x":"壮士性刚决，火中见石裂。","b":8,"y":800,"th":["游侠","壮志未酬","悲愤"],"ap":1}],"t435":[{"id":"6d6255bd63ac","t":"菩萨蛮","a":"张先","d":8,"f":"词","g":"词","x":"夜深不至春蟾见。","b":3,"y":1040,"th":["爱情","闺怨","等待"],"ap":1},{"id":"9ffe7573e733","t":"幺・铜壶玉漏催凄切，正更阑人静也。金闺潇洒转伤嗟，莲步轻移呼侍妾：","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"“把香桌儿安排打快些。","b":0,"y":1290,"th":["闺怨","夜思","等待"],"ap":1}],"t444":[{"id":"1b3395f3e0ff","t":"诈妮子调风月・收尾","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"大刚来\"主人有福牙推胜\"，不似这调风月媒人背厅。","b":0,"y":1250,"th":["爱情","自嘲","世态人情"],"ap":1},{"id":"897975fb8119","t":"钱大尹智宠谢天香・南吕/一枝花","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"往常时唤官身可早眉黛舒，今日个叫祗候喉咙响。","b":0,"y":1290,"th":["杂剧曲词","自嘲","市井风情"],"ap":1}],"t457":[{"id":"05f84a31ab30","t":"论语·宪问篇 其11","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“孟公绰为赵、魏老则优，不可以为滕、薛大夫。”","b":3,"y":-450,"th":["哲理","知人善任","才性"],"ap":1}],"t471":[{"id":"122e7b9991a1","t":"哀岁","a":"王逸","d":1,"f":"楚辞","g":"诗","x":"旻天兮清凉，玄气兮高朗。","b":5,"y":-300,"th":["岁暮感怀","咏物抒愤","怀古伤己","隐逸"],"ap":1}],"t480":[{"id":"183f4b4d69fc","t":"论语·宪问篇 其3","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“邦有道，危言危行；邦无道，危行言孙。”","b":3,"y":-450,"th":["哲理","处世之道","政治智慧"],"ap":1}],"t493":[{"id":"263091314ea2","t":"大司命","a":"屈原","d":1,"f":"楚辞","g":"诗","x":"广开兮天门，纷吾乘兮玄云","b":5,"y":-300,"th":["神话祭祀","生死哲理","离愁别绪"],"ap":1}],"t501":[{"id":"2b387a5a0a0e","t":"论语·卫灵公篇 其29","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“人能弘道，非道弘人。”","b":2,"y":-450,"th":["哲理","修身","主体性"],"ap":1}],"t527":[{"id":"44745e094f0b","t":"中庸·中庸 其32","a":"子思（传）","d":1,"f":"文","g":"文","x":"唯天下至圣，为能聪明睿知，足以有临也；宽裕温柔，足以有容也；发强刚毅，足以有执也；齐庄中正，足以有敬也；文理密察，足以有别也。溥博渊泉，而时出之。溥博如天，渊泉如渊。见而民莫不敬，言而民莫不信，行而民莫不说。是以声名洋溢乎中国，施及蛮貊；舟车所至，人力所通，天之所覆，地之所载，日月所照，霜露所队；凡有血气者，莫不尊亲，故曰配天。","b":5,"y":-250,"th":["哲理","修身","圣人","德治"],"ap":1}],"t534":[{"id":"46ede394f88d","t":"论语·微子篇 其9","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"太师挚适齐，亚饭干适楚，三饭缭适蔡，四饭缺适秦，鼓方叔入于河，播鼗武入于汉，少师阳、击磬襄入于海。","b":3,"y":-450,"th":["礼崩乐坏","怀古","文化凋零"],"ap":1}],"t545":[{"id":"4fc516c18189","t":"孟子·滕文公上 其11","a":"孟子","d":1,"f":"文","g":"文","x":"使毕战问井地。孟子曰：「子之君将行仁政，选择而使子，子必勉之！夫仁政，必自经界始。经界不正，井地不钧，谷禄不平。是故暴君污吏必慢其经界。经界既正，分田制禄可坐而定也。夫滕壤地褊小，将为君子焉，将为野人焉。无君子莫治野人，无野人莫养君子。请野九一而助，国中什一使自赋。卿以下必有圭田，圭田五十亩。余夫二十五亩。死徙无出乡，乡田同井。出入相友，守望相助，疾病相扶持，则百姓亲睦。方里而井，井九百亩，其中为公田。八家皆私百亩，同养公田。公事毕，然后敢治私事，所以别野人也。此其大略也。若夫润泽之，则在君与子矣。」","b":5,"y":-320,"th":["仁政","井田制","经界","社会理想"],"ap":1}],"t552":[{"id":"57a898e49afa","t":"鱼丽","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鱼丽于罶，鲿鲨。君子有酒，旨且多。","b":1,"y":-700,"th":["宴饮","颂赞","乐歌"],"ap":1}],"t578":[{"id":"78624365f08e","t":"招隐士","a":"淮南小山","d":1,"f":"楚辞","g":"诗","x":"桂树丛生兮山之幽，偃蹇连蜷兮枝相缭。","b":5,"y":-300,"th":["招隐","山水","忧惧"],"ap":1}],"t589":[{"id":"8bec7ed3ad4d","t":"干旄","a":"佚名","d":1,"f":"诗经","g":"诗","x":"孑孑干旄，在浚之郊。素丝纰之，良马四之。彼姝者子，何以畀之？","b":1,"y":-650,"th":["招贤","爱情","礼赞"],"ap":1}],"t596":[{"id":"93d2d3f66283","t":"孟子·公孙丑下 其20","a":"孟子","d":1,"f":"文","g":"文","x":"公都子以告。曰：「吾闻之也：有官守者，不得其职则去；有言责者，不得其言则去。我无官守，我无言责也，则吾进退，岂不绰绰然有余裕哉？」","b":4,"y":-320,"th":["哲理","进退之道","独立人格"],"ap":1}],"t620":[{"id":"ae4eb16cc38b","t":"孟子·离娄上 其10","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「天下有道，小德役大德，小贤役大贤；天下无道，小役大，弱役强。斯二者天也。顺天者存，逆天者亡。齐景公曰：『既不能令，又不受命，是绝物也。』涕出而女于吴。","b":5,"y":-320,"th":["哲理","政治","历史兴亡"],"ap":1}],"t633":[{"id":"b80e9482e5ae","t":"皇皇者华","a":"佚名","d":1,"f":"诗经","g":"诗","x":"皇皇者华，于彼原隰。駪駪征夫，每怀靡及。","b":0,"y":-700,"th":["使臣","出使","咏物","勤勉"],"ap":1}],"t646":[{"id":"c4df6cef3819","t":"论语·述而篇 其4","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子之燕居，申申如也，夭夭如也。","b":1,"y":-500,"th":["修身","哲理","圣贤气象"],"ap":1}],"t659":[{"id":"d0ab6773a88c","t":"孟子·公孙丑上 其9","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「否。我四十不动心。」","b":4,"y":-320,"th":["哲理","修身","境界"],"ap":1}],"t682":[{"id":"e680c96f6775","t":"论语·乡党篇 其3","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"君召使摈，色勃如也，足躩如也。揖所与立，左右手，衣前后襜如也。趋进，翼如也。宾退，必复命曰：“宾不顾矣。”","b":2,"y":-450,"th":["礼仪","履职","修身"],"ap":1}],"t695":[{"id":"ec6056cfc562","t":"孟子·滕文公上 其13","a":"孟子","d":1,"f":"文","g":"文","x":"陈良之徒陈相与其弟辛，负耒耜而自宋之滕，曰：「闻君行圣人之政，是亦圣人也，愿为圣人氓。」陈相见许行而大悦，尽弃其学而学焉。","b":5,"y":-320,"th":["哲理","百家争鸣","仁政"],"ap":1}],"t703":[{"id":"f611c97e3e19","t":"论语·阳货篇 其16","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“古者民有三疾，今也或是之亡也。古之狂也肆，今之狂也荡；古之矜也廉，今之矜也忿戾；古之愚也直，今之愚也诈而已矣。”","b":3,"y":-450,"th":["哲理","怀古","世道人心"],"ap":1}],"t710":[{"id":"fb5365dd5df8","t":"论语·述而篇 其14","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子在齐闻《韶》，三月不知肉味，曰：“不图为乐之至于斯也。”","b":1,"y":-517,"th":["艺术","审美","哲理"],"ap":1}],"t769":[{"id":"6e6e0f2e0bb8","t":"相和歌辞 当来日大难","a":"元稹","d":6,"f":"古体","g":"诗","x":"当来日大难行，前有坂，后有坑，大梁侧，小梁倾