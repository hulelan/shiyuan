-450,"th":["人物刻画","哲理"],"ap":1}],"t697":[{"id":"663437f851ab","t":"孟子·滕文公上 其26","a":"孟子","d":1,"f":"文","g":"文","x":"「尧以不得舜为己忧，舜以不得禹、皋陶为己忧。夫以百亩之不易为己忧者，农夫也。分人以财谓之惠，教人以善谓之忠，为天下得人者谓之仁。是故以天下与人易，为天下得人难。孔子曰：『大哉尧之为君！惟天为大，惟尧则之，荡荡乎民无能名焉！君哉舜也！巍巍乎有天下而不与焉！』尧舜之治天下，岂无所用其心哉？亦不用于耕耳。","b":5,"y":-300,"th":["哲理","治国","尚贤"],"ap":1}],"t701":[{"id":"6c6904c62d70","t":"论语·公冶长篇 其9","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子谓子贡曰：“女与回也孰愈？”对曰：“赐也何敢望回？回也闻一以知十，赐也闻一以知二。”子曰：“弗如也，吾与女弗如也！”","b":2,"y":-450,"th":["哲理","教育","师生情"],"ap":1}],"t712":[{"id":"78624365f08e","t":"招隐士","a":"淮南小山","d":1,"f":"楚辞","g":"诗","x":"桂树丛生兮山之幽，偃蹇连蜷兮枝相缭。","b":5,"y":-300,"th":["招隐","山水","忧惧"],"ap":1}],"t738":[{"id":"a29a64180be2","t":"通路","a":"王褒","d":1,"f":"楚辞","g":"诗","x":"天门兮墬户，孰由兮贤者？","b":5,"y":-300,"th":["怀才不遇","楚辞神游","咏叹命运"],"ap":1}],"t774":[{"id":"c719391dc722","t":"北山","a":"佚名","d":1,"f":"诗经","g":"诗","x":"陟彼北山，言采其杞。偕偕士子，朝夕从事。王事靡盬，忧我父母。","b":0,"y":-700,"th":["怨刺","劳役","不公"],"ap":1}],"t789":[{"id":"d8be0e992c81","t":"危俊","a":"王褒","d":1,"f":"楚辞","g":"诗","x":"林不容兮鸣蜩，余何留兮中州？","b":5,"y":-300,"th":["远游","孤愤","高洁"],"ap":1}],"t806":[{"id":"e7c5d2fccf1e","t":"论语·卫灵公篇 其11","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"颜渊问为邦，子曰：“行夏之时，乘殷之辂，服周之冕，乐则《韶》、《舞》；放郑声，远佞人。郑声淫，佞人殆。”","b":2,"y":-450,"th":["治国理政","礼乐文明","儒家哲理"],"ap":1}],"t815":[{"id":"ebaf6cf527cb","t":"北风","a":"佚名","d":1,"f":"诗经","g":"诗","x":"北风其凉，雨雪其雱。惠而好我，携手同行。其虚其邪？既亟只且！","b":0,"y":-700,"th":["政治怨刺","逃亡避祸","友谊"],"ap":1}],"t833":[{"id":"fc28edc4f1ba","t":"论语·乡党篇 其18","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"君赐食，必正席先尝之；君赐腥，必熟而荐之；君赐生，必畜之。侍食于君，君祭，先饭。","b":1,"y":-500,"th":["礼制","忠君","哲思"],"ap":1}],"t859":[{"id":"07680a5520e8","t":"郊庙歌辞 享太庙乐章 永和三章 一","a":"张说","d":6,"f":"古体","g":"诗","x":"肃九室，谐八音。","b":2,"y":720,"th":["礼乐/祭祀/宗庙/帝王"],"ap":1}],"t860":[{"id":"076eea7732df","t":"中春麟德殿会百僚观新乐诗一章章十六句","a":"德宗皇帝","d":6,"f":"五古","g":"诗","x":"芳岁肇佳节，物华当仲春。","b":7,"y":785,"th":["礼乐/治国/盛世"],"ap":1}],"t877":[{"id":"14083a7d15ea","t":"月下独酌四首 一","a":"李白","d":6,"f":"五古","g":"诗","x":"花间一壶酒，独酌无相亲。","b":3,"y"