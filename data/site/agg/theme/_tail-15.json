，诛纣伐奄，三年讨其君，驱飞廉于海隅而戮之。灭国者五十，驱虎、豹、犀、象而远之。天下大悦。《书》曰：『丕显哉，文王谟！丕承哉，武王烈！佑启我后人，咸以正无缺。』","b":5,"y":-320,"th":["哲理","怀古","仁政","历史"],"ap":1},{"id":"cedb54aaedf9","t":"孟子·公孙丑上 其6","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「文王何可当也？由汤至于武丁，贤圣之君六七作。天下归殷久矣，久则难变也。武丁朝诸侯有天下，犹运之掌也。纣之去武丁未久也，其故家遗俗，流风善政，犹有存者；又有微子、微仲、王子比干、箕子、胶鬲皆贤人也，相与辅相之，故久而后失之也。尺地莫非其有也，一民莫非其臣也，然而文王犹方百里起，是以难也。齐人有言曰：『虽有智慧，不如乘势；虽有镃基，不如待时。』","b":4,"y":-320,"th":["哲理","历史","政治"],"ap":1},{"id":"e2e77f97e3ce","t":"孟子·公孙丑下 其37","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「使管叔监殷，管叔以殷畔也，有诸？」","b":4,"y":-320,"th":["哲理","怀古","历史"],"ap":1}],"t240":[{"id":"79ba9343b279","t":"相和歌辞 贾客词","a":"刘驾","d":6,"f":"五古","g":"诗","x":"贾客灯下起，犹言发已迟。","b":10,"y":850,"th":["讽喻","社会","悲剧"],"ap":1},{"id":"086c834986b6","t":"杂曲歌辞 轻薄行","a":"僧齐己","d":6,"f":"七律","g":"诗","x":"玉鞭金镫骅骝蹏，横眉吐气如虹霓。","b":10,"y":900,"th":["讽刺","社会","咏史"],"ap":1},{"id":"f62167a95960","t":"诈妮子调风月・梨花儿","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"是教我软地上吃交，我也不共你争。","b":0,"y":1280,"th":["爱情","社会","戏剧"],"ap":1},{"id":"454e6ee89766","t":"诈妮子调风月・双调/新水令","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"双撒敦是部尚书，女婿是世袭千户。","b":0,"y":1290,"th":["爱情","悲怨","社会"],"ap":1}],"t257":[{"id":"9073dbc03030","t":"鸱鸮","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鸱鸮鸱鸮，既取我子，无毁我室。恩斯勤斯，鬻子之闵斯。","b":0,"y":-1050,"th":["咏物","忧患","比兴"],"ap":1},{"id":"be5438d7322d","t":"小宛","a":"佚名","d":1,"f":"诗经","g":"诗","x":"宛彼鸣鸠，翰飞戾天。我心忧伤，念昔先人。明发不寐，有怀二人。","b":0,"y":-800,"th":["怀古","教子","忧患","哲理"],"ap":1},{"id":"0e4b4faf7f0a","t":"孟子·梁惠王下 其55","a":"孟子","d":1,"f":"文","g":"文","x":"滕文公问曰：「齐人将筑薛，吾甚恐。如之何则可？」","b":5,"y":-320,"th":["治国","哲理","忧患"],"ap":1}],"t279":[{"id":"6caa7a624c10","t":"国殇","a":"屈原","d":1,"f":"楚辞","g":"诗","x":"操吴戈兮被犀甲，车错毂兮短兵接","b":5,"y":-290,"th":["战争","哀悼","咏怀"],"ap":1},{"id":"e06d3ed29374","t":"琴曲歌辞 湘夫人","a":"郎士元","d":6,"f":"五古","g":"诗","x":"娥眉对湘水，遥哭苍梧间。","b":7,"y":780,"th":["怀古","神话","哀悼"],"ap":1},{"id":"eb1f3bc196ef","t":"相和歌辞 公无渡河","a":"王建","d":6,"f":"七古","g":"诗","x":"渡头恶天两岸远，波涛塞川如叠坂。","b":8,"y":800,"th":["哀悼","警世","乐府"],"ap":1}],"t284":[{"id":"d0b85d8