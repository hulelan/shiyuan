":"楚辞","g":"诗","x":"林不容兮鸣蜩，余何留兮中州？","b":5,"y":-300,"th":["远游","孤愤","高洁"],"ap":1},{"id":"969aceff12f9","t":"渔父","a":"屈原","d":1,"f":"楚辞","g":"诗","x":"屈原既放，游于江潭，行吟泽畔，颜色憔悴，形容枯槁。渔父见而问之曰：“子非三闾大夫与？何故至于斯？”屈原曰：“举世皆浊我独清，众人皆醉我独醒，是以见放。”","b":5,"y":-278,"th":["哲理","咏怀","高洁"],"ap":1},{"id":"92ccdd41713e","t":"瑞鹧鸪","a":"林逋","d":8,"f":"词","g":"词","x":"众芳摇落独鲜妍。","b":1,"y":1005,"th":["咏物","隐逸","高洁"],"ap":1},{"id":"2431cd2e4b80","t":"点绛唇·咏风兰","a":"纳兰性德","d":11,"f":"词","g":"词","x":"别样幽芬，更无浓艳催开处","b":0,"y":1680,"th":["咏物","高洁","伤秋"],"ap":1}],"t213":[{"id":"0c4612ddf296","t":"黄鸟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"交交黄鸟，止于棘。谁从穆公？子车奄息。维此奄息，百夫之特。","b":1,"y":-621,"th":["挽歌","悼亡","控诉"],"ap":1},{"id":"761dec7aa00c","t":"相和歌辞 挽歌","a":"孟云卿","d":6,"f":"五古","g":"诗","x":"草草门巷喧，涂车俨成位。","b":4,"y":750,"th":["悼亡","挽歌","哲理"],"ap":1},{"id":"375ad9d7efb5","t":"相和歌辞 挽歌二首 二","a":"于鹄","d":6,"f":"五古","g":"诗","x":"双辙出郭门，緜緜东西道。","b":7,"y":780,"th":["哲理","生死","挽歌"],"ap":1},{"id":"db6f2c73884d","t":"相和歌辞 挽歌","a":"白居易","d":6,"f":"古体","g":"诗","x":"丹旐何飞扬，素骖亦悲鸣。","b":8,"y":807,"th":["挽歌","生死","哲理"],"ap":1}],"t226":[{"id":"348b7975abb5","t":"大东","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有饛簋飧，有捄棘匕。周道如砥，其直如矢。君子所履，小人所视。眷言顾之，潸焉出涕。","b":0,"y":-850,"th":["怨刺","民生","讽喻"],"ap":1},{"id":"add32ae15d7f","t":"孟子·滕文公下 其8","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「士之失位也，犹诸侯之失国家也。礼曰：『诸侯耕助，以供粢盛；夫人蚕缫，以为衣服。牺牲不成，粢盛不洁，衣服不备，不敢以祭。惟士无田，则亦不祭。』牲杀器皿衣服不备，不敢以祭，则不敢以宴，亦不足吊乎？」","b":5,"y":-320,"th":["哲理","礼制","民生"],"ap":1},{"id":"ab30d6e65fa8","t":"相和歌辞 前苦寒行二首 二","a":"杜甫","d":6,"f":"七律","g":"诗","x":"去年白帝雪在山，今年白帝雪在地。","b":7,"y":766,"th":["写景","民生","咏物"],"ap":1},{"id":"b29262ccd6b8","t":"相和歌辞 后苦寒行二首 一","a":"杜甫","d":6,"f":"七绝","g":"诗","x":"南纪巫庐瘴不绝，太古以来无尺雪。","b":7,"y":766,"th":["忧时","民生","咏寒"],"ap":1}],"t235":[{"id":"5f463b45a5d4","t":"论语·为政篇 其23","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子张问：“十世可知也？”子曰：“殷因于夏礼，所损益，可知也；周因于殷礼，所损益，可知也。其或继周者，虽百世，可知也。”","b":2,"y":-450,"th":["哲理","历史","治国"],"ap":1},{"id":"c72cf91ebc54","t":"孟子·滕文公下 其34","a":"孟子","d":1,"f":"文","g":"文","x":"「尧、舜既没，圣人之道衰。暴君代作，坏宫室以为污池，民无所安息；弃田以为园囿，使民不得衣食。邪说暴行又作，园囿、污池、沛泽多而禽兽至。及纣之身，天下又大乱。周公相武王，诛纣伐奄，三年讨其君，驱飞廉于海隅而戮之。灭国者五十，驱虎、豹、犀、象而远之。天下大悦。《书》曰：『丕显哉，文王谟！丕承哉，武王烈！佑启我后人，咸以正无缺。』","b":5,"y":-320,"th":["哲理","怀古","仁政","历史"],"ap":1},{"id":"cedb54aaedf9","t":"孟子·公孙丑上 其6","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「文王何可当也？由汤至于武丁，贤圣之君六七作。天下归殷久矣，久则难变也。武丁朝诸侯有天下，犹运之掌也。纣之去武丁未久也，其故家遗俗，流风善政，犹有存者；又有微子、微仲、王子比干、箕子、胶鬲皆贤人也，相与辅相之，故久而后失之也。尺地莫非其有也，一民莫非其臣也，然而文王犹方百里起，是以难也。齐人有言曰：『虽有智慧，不如乘势；虽有镃基，不如待时。』","b":4,"y":-320,"th":["哲理","历史","政治"],"ap":1},{"id":"e2e77f97e3ce","t":"孟子·公孙丑下 其37","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「使管叔监殷，管叔以殷畔也，有诸？」","b":4,"y":-320,"th":["哲理","怀古","历史"],"ap":1}],"t240":[{"id":"79ba9343b279","t":"相和歌辞 贾客词","a":"刘驾","d":6,"f":"五古","g":"诗","x":"贾客灯下起，犹言发已迟。","b":10,"y":850,"th":["讽喻","社会","悲剧"],"ap":1},{"id":"086c834986b6","t":"杂曲歌辞 轻薄行","a":"僧齐己","d":6,"f":"七律","g":"诗","x":"玉鞭金镫骅骝蹏，横眉吐气如虹霓。","b":10,"y":900,"th":["讽刺","社会","咏史"],"ap":1},{"id":"f62167a95960","t":"诈妮子调风月・梨花儿","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"是教我软地上吃交，我也不共你争。","b":0,"y":1280,"th":["爱情","社会","戏剧"],"ap":1},{"id":"454e6ee89766","t":"诈妮子调风月・双调/新水令","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"双撒敦是部尚书，女婿是世袭千户。","b":0,"y":1290,"th":["爱情","悲怨","社会"],"ap":1}],"t257":[{"id":"9073dbc03030","t":"鸱鸮","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鸱鸮鸱鸮，既取我子，无毁我室。恩斯勤斯，鬻子之闵斯。","b":0,"y":-1050,"th":["咏物","忧患","比兴"],"ap":1},{"id":"be5438d7322d","t":"小宛","a":"佚名","d":1,"f":"诗经","g":"诗","x":"宛彼鸣鸠，翰飞戾天。我心忧伤，念昔先人。明发不寐，有怀二人。","b":0,"y":-800,"th":["怀古","教子","忧患","哲理"],"ap":1},{"id":"0e4b4faf7f0a","t":"孟子·梁惠王下 其55","a":"孟子","d":1,"f":"文","g":"文","x":"滕文公问曰：「齐人将筑薛，吾甚恐。如之何则可？」","b":5,"y":-320,"th":["治国","哲理","忧患"],"ap":1}],"t279":[{"id":"6caa7a624c10","t":"国殇","a":"屈原","d":1,"f":"楚辞","g":"诗","x":"操吴戈兮被犀甲，车错毂兮短兵接","b":5,"y":-290,"th":["战争","哀悼","咏怀"],"ap":1},{"id":"e06d3ed29374","t":"琴曲歌辞 湘夫人","a":"郎士元","d":6,"f":"五古","g":"诗","x":"娥眉对湘水，遥哭苍梧间。","b":7,"y":780,"th":["怀古","神话","哀悼"],"ap":1},{"id":"eb1f3bc196ef","t":"相和歌辞 公无渡河","a":"王建","d":6,"f":"七古","g":"诗","x