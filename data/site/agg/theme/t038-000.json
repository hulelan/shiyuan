[{"id":"6d3b5c98850d","t":"论语·子张篇 其24","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"叔孙武叔毁仲尼，子贡曰：“无以为也，仲尼不可毁也。他人之贤者，丘陵也，犹可逾也；仲尼，日月也，无得而逾焉。人虽欲自绝，其何伤于日月乎？多见其不知量也。”","b":2,"y":-450,"th":["哲理","尊师","论辩"],"ap":1},{"id":"6af634761f0e","t":"孟子·滕文公上 其28","a":"孟子","d":1,"f":"文","g":"文","x":"「从许子之道，则市贾不贰，国中无伪。虽使五尺之童适市，莫之或欺。布帛长短同，则贾相若；麻缕丝絮轻重同，则贾相若；五谷多寡同，则贾相若；屦大小同，则贾相若。」曰：「夫物之不齐，物之情也；或相倍蓰，或相什伯，或相千万。子比而同之，是乱天下也。巨屦小屦同贾，人岂为之哉？从许子之道，相率而为伪者也，恶能治国家？」","b":4,"y":-330,"th":["哲理","治国","论辩"],"ap":1},{"id":"7d97675f6001","t":"孟子·公孙丑上 其11","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「是不难，告子先我不动心。」","b":4,"y":-320,"th":["哲理","修身","论辩"],"ap":1},{"id":"dba87f7fe0d5","t":"孟子·公孙丑下 其28","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「可。子哙不得与人燕，子之不得受燕于子哙。有仕于此，而子悦之，不告于王而私与之吾子之禄爵；夫士也，亦无王命而私受之于子，则可乎？何以异于是？」","b":4,"y":-320,"th":["哲理","政治","论辩"],"ap":1},{"id":"d237c3cfb2c0","t":"孟子·公孙丑下 其34","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「周公使管叔监殷，管叔以殷畔。知而使之，是不仁也；不知而使之，是不智也。仁智，周公未之尽也，而况于王乎？贾请见而解之。」","b":4,"y":-320,"th":["哲理","论辩","怀古"],"ap":1},{"id":"8d2c540ee757","t":"孟子·公孙丑下 其39","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「周公知其将畔而使之与？」","b":4,"y":-320,"th":["哲理","怀古","论辩"],"ap":1},{"id":"4a993a956876","t":"孟子·公孙丑下 其9","a":"孟子","d":1,"f":"文","g":"文","x":"陈臻问曰：「前日于齐，王餽兼金一百而不受；于宋，餽七十镒而受；于薛，餽五十镒而受。前日之不受是，则今日之受非也；今日之受是，则前日之不受非也。夫子必居一于此矣。」","b":4,"y":-320,"th":["哲理","论辩"],"ap":1},{"id":"025280f81360","t":"孟子·梁惠王上 其12","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「无以异也。」","b":4,"y":-320,"th":["哲理","政治","论辩"],"ap":1},{"id":"d72ca22a7591","t":"孟子·梁惠王上 其48","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「可得闻与？」","b":4,"y":-320,"th":["哲理","政治","论辩"],"ap":1},{"id":"2fd6370051e1","t":"孟子·梁惠王下 其10","a":"孟子","d":1,"f":"文","g":"文","x":"孟子对曰：「于传有之。」","b":4,"y":-320,"th":["哲理","论辩","政治"],"ap":1},{"id":"9ec4d839f620","t":"孟子·梁惠王下 其17","a":"孟子","d":1,"f":"文","g":"文","x":"王曰：「大哉言矣！寡人有疾，寡人好勇。」","b":4,"y":-320,"th":["哲理","治国","论辩"],"ap":1},{"id":"8c9ebe7bd4d3","t":"孟子·梁惠王下 其27","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「王如善之，则何为不行？」","b":4,"y":-320,"th":["哲理","论辩","治国"],"ap":1},{"id":"e585882b7203","t":"孟子·梁惠王下 其32","a":"孟子","d":1,"f":"文","g":"文","x":"孟子谓齐宣王曰：「王之臣有托其妻子于其友，而之楚游者。比其反也，则冻馁其妻子，则如之何？」","b":5,"y":-320,"th":["哲理","政治","论辩"],"ap":1},{"id":"d956e4d352e7","t":"孟子·梁惠王下 其33","a":"孟子","d":1,"f":"文","g":"文","x":"王曰：「弃之。」","b":5,"y":-320,"th":["哲理","论辩"],"ap":1},{"id":"d0ea23f4dce9","t":"孟子·梁惠王下 其35","a":"孟子","d":1,"f":"文","g":"文","x":"王曰：「已之。」","b":5,"y":-320,"th":["论辩","仁政","治国","哲理"],"ap":1},{"id":"6728507fbc59","t":"孟子·梁惠王下 其42","a":"孟子","d":1,"f":"文","g":"文","x":"孟子对曰：「于传有之。」","b":5,"y":-320,"th":["哲理","治国","论辩"],"ap":1},{"id":"3866950d694b","t":"孟子·滕文公上 其15","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「许子必种粟而后食乎？」曰：「然。」","b":5,"y":-320,"th":["哲理","论辩"],"ap":1},{"id":"e5e3d2e6eaf2","t":"孟子·滕文公上 其16","a":"孟子","d":1,"f":"文","g":"文","x":"「许子必织布而后衣乎？」曰：「否。许子衣褐。」","b":5,"y":-320,"th":["哲理","社会分工","论辩"],"ap":1},{"id":"a0ccac5cec41","t":"孟子·滕文公上 其17","a":"孟子","d":1,"f":"文","g":"文","x":"「许子冠乎？」曰：「冠。」","b":5,"y":-320,"th":["哲理","论辩","社会分工"],"ap":1},{"id":"84ee3e1978c2","t":"孟子·滕文公上 其18","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「奚冠？」曰：「冠素。」","b":5,"y":-320,"th":["哲理","论辩"],"ap":1},{"id":"98100254e710","t":"孟子·滕文公上 其20","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「许子奚为不自织？」曰：「害于耕。」","b":5,"y":-320,"th":["哲理","论辩","社会分工"],"ap":1},{"id":"92bf89c156a2","t":"孟子·滕文公上 其21","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「许子以釜甑爨，以铁耕乎？」曰：「然。」","b":5,"y":-320,"th":["哲理","社会分工","论辩"],"ap":1},{"id":"c1eb4877d1d1","t":"孟子·滕文公上 其22","a":"孟子","d":1,"f":"文","g":"文","x":"「自为之与？」曰：「否。以粟易之。」","b":5,"y":-320,"th":["哲理","社会分工","论辩"],"ap":1},{"id":"dcb5b6dfe93c","t":"孟子·滕文公上 其29","a":"孟子","d":1,"f":"文","g":"文","x":"墨者夷之，因徐辟而求见孟子。孟子曰：「吾固愿见，今吾尚病，病愈，我且往见，夷子不来！」","b":5,"y":-320,"th":["哲理","论辩","诸子百家"],"ap":1},{"id":"61d0d3c5d93d","t":"孟子·滕文公上 其30","a":"孟子","d":1,"f":"文","g":"文","x":"他日又求见孟子。孟子曰：「吾今则可以见矣。不直，则道不见；我且直之。吾闻夷子墨者。墨之治丧也，以薄为其道也。夷子思以易天下，岂以为非是而不贵也？然而夷子葬其亲厚，则是以所贱事亲也。」","b":5,"y":-320,"th":["哲理","论辩","孝道"],"ap":1},{"id":"b06f102870dd","t":"孟子·滕文公下 其20","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「有人于此，毁瓦画墁，其志将以求食也，则子食之乎？」","b":5,"y":-320,"th":["哲理","论辩","义利之辨"],"ap":1},{"id":"486b369e8fbd","t":"孟子·滕文公下 其32","a":"孟子","d":1,"f":"文","g":"文","x":"公都子曰：「外人皆称夫子好辩，敢问何也？」","b":5,"y":-320,"th":["哲理","论辩"],"ap":1},{"id":"df0ec877540a","t":"孟子·滕文公下 其38","a":"孟子","d":1,"f":"文","g":"文","x":"匡章曰：「陈仲子岂不诚廉士哉？居于陵，三日不食，耳无闻，目无见也。井上有李，螬食实者过半矣，匍匐往将食之，三咽，然后耳有闻，目有见。」","b":5,"y":-320,"th":["哲理","论辩","修身"],"ap":1},{"id":"3d1e5cce4382","t":"孟子·滕文公下 其39","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「于齐国之士，吾必以仲子为巨擘焉。虽然，仲子恶能廉？充仲子之操，则蚓而后可者也。夫蚓，上食槁壤，下饮黄泉。仲子所居之室，伯夷之所筑与？抑亦盗跖之所筑与？所食之粟，伯夷之所树与？抑亦盗跖之所树与？是未可知也。」","b":5,"y":-320,"th":["哲理","论辩","道德"],"ap":1},{"id":"f36a3a3a0021","t":"孟子·公孙丑上 其34","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「敢问其所以异？」","b":5,"y":-300,"th":["哲理","师道","论辩"],"ap":1},{"id":"15861779e740","t":"孟子·公孙丑下 其41","a":"孟子","d":1,"f":"文","g":"文","x":"「然则圣人且有过与？」","b":5,"y":-300,"th":["哲理","论辩"],"ap":1},{"id":"1c7cb78962e0","t":"孟子·梁惠王上 其44","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「否。吾不为是也。」","b":5,"y":-300,"th":["哲理","王道","论辩"],"ap":1},{"id":"4aa53e4767fe","t":"孟子·滕文公上 其23","a":"孟子","d":1,"f":"文","g":"文","x":"「以粟易械器者，不为厉陶冶；陶冶亦以其械器易粟者，岂为厉农夫哉？且许子何不为陶冶。舍皆取诸其宫中而用之？何为纷纷然与百工交易？何许子之不惮烦？」曰：「百工之事，固不可耕且为也。」","b":5,"y":-300,"th":["哲理","论辩"],"ap":1},{"id":"e888c3b15df8","t":"孟子·滕文公上 其33","a":"孟子","d":1,"f":"文","g":"文","x":"徐子以告夷子。夷子怃然为闲曰：「命之矣。」","b":5,"y":-300,"th":["哲理","论辩","受教"],"ap":1},{"id":"81958818b091","t":"孟子·滕文公下 其18","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「子何以其志为哉？其有功于子，可食而食之矣。且子食志乎？食功乎？」","b":5,"y":-300,"th":["哲理","论辩"],"ap":1}]