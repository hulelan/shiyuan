","政治哲理","宫廷生活"],"ap":1},{"id":"c8aae5a01430","t":"寄左省杜拾遗","a":"岑参","d":6,"f":"五律","g":"诗","x":"联步趋丹陛，分曹限紫微。","b":6,"y":754,"th":["仕途感慨","怀才不遇","宫廷生活"],"ap":1},{"id":"a5578fbd83ba","t":"宫词五首 二","a":"顾况","d":6,"f":"七绝","g":"诗","x":"玉楼天半起笙歌，风送宫嫔笑语和。","b":6,"y":760,"th":["宫廷生活","奢华意象","时空幻境"],"ap":1},{"id":"847882ee8e21","t":"舞曲歌辞 霓裳辞十首 四","a":"王建","d":6,"f":"七绝","g":"诗","x":"旋翻新谱声初足，除却梨园未教人。","b":8,"y":800,"th":["宫廷生活","音乐","皇恩"],"ap":1},{"id":"f264308b280e","t":"舞曲歌辞 霓裳辞十首 三","a":"王建","d":6,"f":"七绝","g":"诗","x":"自直梨园得出稀，更番上曲不教归。","b":8,"y":800,"th":["宫廷生活","咏史","音乐"],"ap":1},{"id":"c942cf9cfe9d","t":"杂曲歌辞 长安少年行十首 八","a":"李廓","d":6,"f":"五律","g":"诗","x":"新年高殿上，始见有光辉。","b":9,"y":820,"th":["宫廷生活","游宴","咏物"],"ap":1},{"id":"8a9349b0fa03","t":"句","a":"后主煜","d":6,"f":"古体","g":"诗","x":"迢迢牵牛星，杳在河之阳。","b":10,"y":975,"th":["人生感慨","宫廷生活","哲理思考","病痛自怜"],"ap":1},{"id":"8101da89e7aa","t":"宫中作","a":"后王钱俶","d":6,"f":"七律","g":"诗","x":"廊庑周遭翠幕遮，禁林深处绝喧哗。","b":10,"y":978,"th":["宫廷生活","隐逸情怀","讽刺"],"ap":1}],"t191":[{"id":"35cd7753ab81","t":"论语·子张篇 其22","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"卫公孙朝问于子贡曰：“仲尼焉学？”子贡曰：“文武之道未坠于地，在人。贤者识其大者，不贤者识其小者，莫不有文武之道焉，夫子焉不学？而亦何常师之有？”","b":2,"y":-450,"th":["哲理","求学","师道"],"ap":1},{"id":"b4995ccd1df8","t":"论语·述而篇 其24","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“二三子以我为隐乎？吾无隐乎尔！吾无行而不与二三子者，是丘也。”","b":3,"y":-450,"th":["哲理","师道","修身"],"ap":1},{"id":"d32362c0efb1","t":"论语·公冶长篇 其13","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子贡曰：“夫子之文章，可得而闻也；夫子之言性与天道，不可得而闻也。”","b":2,"y":-450,"th":["哲理","教育","师道"],"ap":1},{"id":"e89f9fb219bd","t":"孟子·滕文公上 其27","a":"孟子","d":1,"f":"文","g":"文","x":"「吾闻用夏变夷者，未闻变于夷者也。陈良，楚产也。悦周公、仲尼之道，北学于中国。北方之学者，未能或之先也。彼所谓豪杰之士也。子之兄弟事之数十年，师死而遂倍之。昔者孔子没，三年之外，门人治任将归，入揖于子贡，相向而哭，皆失声，然后归。子贡反，筑室于场，独居三年，然后归。他日，子夏、子张、子游以有若似圣人，欲以所事孔子事之，彊曾子。曾子曰：『不可。江汉以濯之，秋阳以暴之，皜皜乎不可尚已。』今也南蛮𫛞舌之人，非先王之道，子倍子之师而学之，亦异于曾子矣。吾闻出于幽谷迁于乔木者，末闻下乔木而入于幽谷者。《鲁颂》曰：『戎狄是膺，荆舒是惩。』周公方且膺之，子是之学，亦为不善变矣。」","b":4,"y":-330,"th":["哲理","师道","道统"],"ap":1},{"id":"196f32aa83c6","t":"孟子·公孙丑上 其14","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「敢问夫子之不动心，与告子之不动心，可得闻与？」","b":4,"y":-320,"th":["哲理","心性","师道"],"ap":1},{"id":"7f06436a8294","t":"孟子·公孙丑上 其24","a":"孟子","d":1,"f":"文","g":"文","x":"「宰我、子贡善为说辞，冉牛、闵子、颜渊善言德行。孔子兼之，曰：『我于辞命则不能也。』然则夫子既圣矣乎？」","b":4,"y":-320,"th":["哲理","师道","修身"],"ap":1},{"id":"f36a3a3a0021","t":"孟子·公孙丑上 其34","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「敢问其所以异？」","b":5,"y":-300,"th":["哲理","师道","论辩"],"ap":1}],"t205":[{"id":"fd461d9a8553","t":"过旧宅二首 一","a":"太宗皇帝","d":6,"f":"五律","g":"诗","x":"新丰停翠辇，谯邑驻鸣笳。","b":0,"y":627,"th":["怀古","帝王气魄","物是人非"],"ap":1},{"id":"4331a68a273c","t":"还乡偶书  其二","a":"黄拱","d":6,"f":"七绝","g":"诗","x":"少小离家老大回，乡音难改鬓毛衰。","b":3,"y":744,"th":["思乡","人生感怀","物是人非"],"ap":1},{"id":"fa86786c383d","t":"鼓吹曲辞 有所思","a":"韦应物","d":6,"f":"五律","g":"诗","x":"借问江上柳，青青为谁春。","b":7,"y":772,"th":["怀人","孤寂","物是人非"],"ap":1},{"id":"53245b0c63fc","t":"赐宫人庆奴","a":"后主煜","d":6,"f":"七绝","g":"诗","x":"风情渐老见春羞，到处消魂感旧游。","b":10,"y":975,"th":["宫怨","伤春","物是人非"],"ap":1},{"id":"8bc645062614","t":"半死桐・鹧鸪天·重过阊门万事非","a":"贺铸","d":8,"f":"词","g":"词","x":"重过阊门万事非。","b":3,"y":1105,"th":["悼亡","怀人","物是人非"],"ap":1},{"id":"6dda0f575442","t":"沈园二首  其一","a":"陆游","d":8,"f":"七绝","g":"诗","x":"城上斜阳画角哀，沈园非复旧池台。","b":3,"y":1205,"th":["爱情","怀旧","物是人非"],"ap":1},{"id":"f18e2c842d92","t":"夜合花·柳暝河桥","a":"吴文英","d":8,"f":"词","g":"词","x":"柳暝河桥，莺晴台苑，短策频惹春香。","b":4,"y":1250,"th":["怀旧","感伤","物是人非"],"ap":1}],"t249":[{"id":"13bfa907feb8","t":"论语·乡党篇 其22","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"朋友死，无所归，曰：“于我殡。”","b":2,"y":-450,"th":["友情","仁义","哲理"],"ap":1},{"id":"34a52859b415","t":"孟子·公孙丑下 其6","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「恶！是何言也！齐人无以仁义与王言者，岂以仁义为不美也？其心曰『是何足与言仁义也』云尔，则不敬莫大乎是。我非尧舜之道，不敢以陈于王前，故齐人莫如我敬王也。」","b":4,"y":-320,"th":["哲理","政治","仁义"]},{"id":"37e8c09428ee","t":"孟子·梁惠王上 其2","a":"孟子","d":1,"f":"文","g":"文","x":"孟子对曰：「王何必曰利？亦有仁义而已矣。王曰『何以利吾国』？大夫曰『何以利吾家』？士庶人曰『何以利吾身』？上下交征利而国危矣。万乘之国弑其君者，必千乘之家；千乘之国弑其君者，必百乘之家。万取千焉，千取百焉，不为不多矣。苟为后义而先利，不夺不餍。未有仁而遗其亲者也，未有义而后其君者也。王亦曰仁义而已矣，何必曰利？」","b":4,"y":-320,"th":["哲理","政治","仁义"],"ap":1},{"id":"5f902be54015","t":"孟子·滕文公下 其36","a":"孟子","d":1,"f":"文","g":"文","x":"「圣王不作，诸侯放恣，处士横议，杨朱、墨翟之言盈天下。天下之言，不归杨，则归墨。杨氏为我，是无君也；墨氏兼爱，是无父也。无父无君，是禽兽也。公明仪曰：『庖有肥肉，厩有肥马，民有饥色，野有饿莩，此率兽而食人也。』杨墨之道不息，孔子之道不著，是邪说诬民，充塞仁义也。仁义充塞，则率兽食人，人将相食。吾为此惧，闲先圣之道，距杨墨，放淫辞，邪说者不得作。作于其心，害于其事；作于其事，害于其政。圣人复起，不易吾言矣。","b":5,"y":-320,"th":["卫道","仁义","辟异端","哲理"],"ap":1},{"id":"6cbc1f4be244","t":"孟子·滕文公下 其16","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「子不通功易事，以羡补不足，则农有余粟，女有余布；子如通之，则梓匠轮舆皆得食于子。于此有人焉，入则孝，出则悌，守先王之道，以待后之学者，而不得食于子。子何尊梓匠轮舆而轻为仁义者哉？」","b":5,"y":-320,"th":["哲理","仁义","社会分工"],"ap":1}],"t263":[{"id":"7ae93c89aac6","t":"风雨","a":"佚名","d":1,"f":"诗经","g":"诗","x":"风雨凄凄，鸡鸣喈喈，既见君子。云胡不夷？","b":1,"y":-550,"th":["爱情","思念","重逢"],"ap":1},{"id":"ec9901be509a","t":"喜见外弟又言别","a":"李益","d":6,"f":"五律","g":"诗","x":"十年离乱后，长大一相逢。","b":7,"y":780,"th":["送别","战乱","重逢"],"ap":1},{"id":"0e5774734e86","t":"鹧鸪天·彩袖殷勤捧玉锺","a":"晏几道","d":8,"f":"词","g":"词","x":"彩袖殷勤捧玉锺。","b":0,"th":["爱情","相思","重逢"],"ap":1},{"id":"dfdeef827f19","t":"秋夜月・相见欢","a":"柳永","d":8,"f":"词","g":"词","x":"当初聚散。","b":1,"y":1030,"th":["爱情","重逢","市井"],"ap":1},{"id":"877a68ae9317","t":"眼儿媚·重见星娥碧海槎","a":"纳兰性德","d":11,"f":"词","g":"词","x":"重见星娥碧海槎，忍笑却盘鸦","b":0,"y":1670,"th":["爱情","重逢"],"ap":1}],"t270":[{"id":"231d719113d7","t":"杂曲歌辞 少年行三首 二","a":"杜甫","d":6,"f":"七绝","g":"诗","x":"巢燕养雏浑去尽，红花结子已无多。","b":4,"y":747,"th":["惜时","暮春","哲理"],"ap":1},{"id":"3977238b5e26","t":"忆王孙·萋萋芳草忆王孙","a":"李重元","d":8,"f":"词","g":"词","x":"萋萋芳草忆王孙。","b":0,"th":["闺怨","离愁","暮春"],"ap":1},{"id":"c0fa969070fa","t":"六么令·绿阴春尽","a":"晏几道","d":8,"f":"词","g":"词","x":"绿阴春尽，飞絮绕香阁。","b":0,"th":["爱情","闺怨","暮春"],"ap":1},{"id":"e8669e53cf62","t":"踏莎行","a":"寇准","d":8,"f":"词","g":"词","x":"春色将阑，莺声渐老。","b":0,"y":1000,"th":["闺怨","暮春","离愁"],"ap":1},{"id":"bd99063862f6","t":"河传","a":"张先","d":8,"f":"词","g":"词","x":"花暮。","b":2,"y":1040,"th":["送别","羁旅","暮春"],"ap":1}],"t292":[{"id":"d983cf5ba5cc","t":"论语·阳货篇 其1","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"阳货欲见孔子，孔子不见，归孔子豚。孔子时其亡也而往拜之，遇诸涂。谓孔子曰：“来，予与尔言。”曰：“怀其宝而迷其邦，可谓仁乎？”曰：“不可。”“好从事而亟失时，可谓知乎？”曰：“不可！”“日月逝矣，岁不我与！”孔子曰：“诺，吾将仕矣。”","b":1,"y":-500,"th":["哲理","出仕","处世之道"],"ap":1},{"id":"3f9c7543ca0d","t":"论语·宪问篇 其1","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"宪问耻，子曰：“邦有道，谷；邦无道，谷，耻也。”“克、伐、怨、欲不行焉，可以为仁矣？”子曰：“可以为难矣，仁则吾不知也。”","b":3,"y":-450,"th":["哲理","修身","出仕"],"ap":1},{"id":"26d98203ff40","t":"孟子·滕文公下 其6","a":"孟子","d":1,"f":"文","g":"文","x":"孟子曰：「仕。传曰：『孔子三月无君，则皇皇如也，出疆必载质。』公明仪曰：『古之人三月无君则吊。』」","b":5,"y":-320,"th":["哲理","出仕","入世情怀"],"ap":1},{"id":"ce88ad0ab76f","t":"孟子·滕文公下 其11","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「晋国亦仕国也，未尝闻仕如此其急。仕如此其急也，君子之难仕，何也？」","b":5,"y":-320,"th":["哲理","出仕","道德"],"ap":1}],"t335":[{"id":"c4b3877c1ef1","t":"木兰花・玉楼春","a":"柳永","d":8,"f":"词","g":"词","x":"东风催露千娇面。","b":1,"y":1030,"th":["咏物","写人","婉约"],"ap":1},{"id":"1fe68ce4a1cd","t":"更漏子","a":"张先","d":8,"f":"词","g":"词","x":"相君家，宾宴集。","b":1,"y":1035,"th":["宴饮","咏乐","写人"],"ap":1},{"id":"bec686ecf849","t":"醉桃源・阮郎归","a":"张先","d":8,"f":"词","g":"词","x":"双花连袂近香猊。","b":2,"y":1040,"th":["送别","音乐","写人"],"ap":1},{"id":"574c95907217","t":"浣溪沙·一半残阳下小楼","a":"纳兰性德","d":11,"f":"词","g":"词","x":"一半残阳下小楼，朱帘斜控软金钩","b":0,"y":1680,"th":["闺情","写人","伤怀"],"ap":1}],"t340":[{"id":"03efd1f8ea43","t":"柏舟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"泛彼柏舟，在彼中河。髧彼两髦，实维我仪。之死矢靡它。母也天只，不谅人只！","b":0,"y":-700,"th":["爱情","婚姻","抗争"],"ap":1},{"id":"ad61f1dd1739","t":"行露","a":"佚名","d":1,"f":"诗经","g":"诗","x":"厌浥行露，岂不夙夜，谓行多露。","b":1,"y":-700,"th":["婚姻","抗争","咏物"],"ap":1},{"id":"b553ef91798f","t":"酥枣儿・一自相逢，将人来萦系。樽前席上，眼约心期。比及道是配合了，","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"受了些闲是闲非。","b":0,"y":1290,"th":["爱情","抗争"],"ap":1}],"t353":[{"id":"2fbfc4d76321","t":"孟子·梁惠王上 其39","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「不为者与不能者之形何以异？」","b":4,"y":-320,"th":["哲理","政治","辩论"],"ap":1},{"id":"65abd3c0933d","t":"孟子·滕文公上 其19","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「自织之与？」曰：「否。以粟易之。」","b":5,"y":-320,"th":["哲理","社会分工","辩论"],"ap":1},{"id":"aa5c9b1ba1b6","t":"孟子·梁惠王上 其36","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「有复于王者曰：『吾力足以举百钧』，而不足以举一羽；『明足以察秋毫之末』，而不见舆薪，则王许之乎？」","b":4,"y":-320,"th":["哲理","政治","辩论"],"ap":1}],"t379"