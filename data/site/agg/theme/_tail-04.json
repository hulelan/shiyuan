1},{"id":"cd80c554af03","t":"诈妮子调风月・雁儿落","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"燕燕那书房中伏侍处，许第二个夫人做。","b":0,"y":1290,"th":["爱情","社会批判","女性命运"],"ap":1}],"t120":[{"id":"a3964f6dc9d4","t":"南山有台","a":"佚名","d":1,"f":"诗经","g":"诗","x":"南山有台，北山有莱。乐只君子，邦家之基。乐只君子，万寿无期。","b":0,"y":-700,"th":["颂德","祝寿","宴饮"],"ap":1},{"id":"fb7ae68f545e","t":"喜迁莺","a":"晏殊","d":8,"f":"词","g":"词","x":"曙河低，斜月淡。","b":2,"y":1030,"th":["祝寿","宴饮","女性"],"ap":1},{"id":"1cb98af70c93","t":"诉衷情","a":"晏殊","d":8,"f":"词","g":"词","x":"秋风吹绽北池莲。","b":2,"y":1035,"th":["祝寿","宴饮","富贵"],"ap":1},{"id":"4850e6a565be","t":"木兰花・玉楼春","a":"晏殊","d":8,"f":"词","g":"词","x":"杏梁归燕双回首。","b":2,"y":1035,"th":["祝寿","宴饮","富贵"],"ap":1},{"id":"a2f3b8ebfa85","t":"诉衷情","a":"晏殊","d":8,"f":"词","g":"词","x":"世间荣贵月中人。","b":2,"y":1035,"th":["祝寿","宴饮","颂赞"],"ap":1},{"id":"8a4218608b36","t":"木兰花・玉楼春","a":"晏殊","d":8,"f":"词","g":"词","x":"紫薇朱槿繁开后。","b":3,"y":1040,"th":["祝寿","宴饮","咏时"],"ap":1},{"id":"27a4ec2f4434","t":"少年游","a":"晏殊","d":8,"f":"词","g":"词","x":"芙蓉花发去年枝。","b":3,"y":1045,"th":["祝寿","惜时","闲适"],"ap":1},{"id":"8ca47e0d04ee","t":"少年游","a":"晏殊","d":8,"f":"词","g":"词","x":"谢家庭槛晓无尘。","b":3,"y":1045,"th":["祝寿","宴饮","太平气象"],"ap":1},{"id":"551e35ec65ff","t":"巫山一段云","a":"柳永","d":8,"f":"词","g":"词","x":"萧氏贤夫妇，茅家好弟兄。","b":3,"y":1100,"th":["游仙","祝寿","奇想"],"ap":1}],"t133":[{"id":"dba33dcb8da7","t":"论语·阳货篇 其19","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“予欲无言。”子贡曰：“子如不言，则小子何述焉？”子曰：“天何言哉？四时行焉，百物生焉，天何言哉？”","b":1,"y":-500,"th":["哲理","教育","天道","自然"],"ap":1},{"id":"014523303f71","t":"中庸·中庸 其31","a":"子思（传）","d":1,"f":"文","g":"文","x":"仲尼祖述尧、舜，宪章文、武；上律天时，下袭水土。辟如天地之无不持载，无不复帱，辟如四时之错行，如日月之代明。万物并育而不相害，道并行而不相悖，小德川流，大德敦化，此天地之所以为大也。","b":4,"y":-430,"th":["哲理","咏人","天道"],"ap":1},{"id":"37fe6c039c07","t":"中庸·中庸 其12","a":"子思（传）","d":1,"f":"文","g":"文","x":"君子之道费而隐。夫妇之愚，可以与知焉，及其至也，虽圣人亦有所不知焉；夫妇之不肖，可以能行焉，及其至也，虽圣人亦有所不能焉。天地之大也，人犹有所憾，故君子语大，天下莫能载焉；语小，天下莫能破焉。《诗》云：『鸢飞戾天，鱼跃于渊。』言其上下察也。君子之道，造端乎夫妇，及其至也，察乎天地。」","b":4,"y":-430,"th":["哲理","修身","天道"],"ap":1},{"id":"cf8bc113ba19","t":"中庸·中庸 其25","a":"子思（传）","d":1,"f":"文","g":"文","x":"至诚之道，可以前知。国家将兴，必有祯祥；国家将亡，必有妖孽。见乎蓍龟，动乎四体。祸福将至：善，必先知之；不善，必先知之。故至诚如神。","b":4,"y":-430,"th":["哲理","修身","天道"],"ap":1},{"id":"8f62ec2271c9","t":"中庸·中庸 其27","a":"子思（传）","d":1,"f":"文","g":"文","x":"天地之道，可壹言而尽也。其为物不贰，则其生物不测。天地之道，博也厚也，高也明也，悠也久也。今夫天，斯昭昭之多，及其无穷也，日月星辰系焉，万物覆焉。今夫地，一撮土之多，及其广厚，载华岳而不重，振河海而不泄，万物载焉。今夫山，一拳石之多，及其广大，草木生之，禽兽居之，宝藏兴焉。今夫水，一勺之多，及其不测，鼋鼍、蛟龙、鱼鳖生焉，货财殖焉。《诗》云：「维天之命，於穆不已！」盖曰天之所以为天也。「於乎不显！文王之德之纯！」盖曰文王之所以为文也，纯亦不已。","b":4,"y":-400,"th":["哲理","天道","至诚无息","天人合一"],"ap":1},{"id":"7411bc9f22fd","t":"中庸·中庸 其33","a":"子思（传）","d":1,"f":"文","g":"文","x":"唯天下至诚，为能经纶天下之大经，立天下之大本，知天地之化育。夫焉有所倚？肫肫其仁！渊渊其渊！浩浩其天！苟不固聪明圣知达天德者，其孰能知之？","b":5,"y":-300,"th":["哲理","修身","天道"],"ap":1},{"id":"ff717278137a","t":"中庸·中庸 其26","a":"子思（传）","d":1,"f":"文","g":"文","x":"诚者自成也，而道自道也。诚者物之终始，不诚无物。是故君子诚之为贵。诚者非自成己而已也，所以成物也。成己，仁也；成物，知也。性之德也，合外内之道也，故时措之宜也。故至诚无息。不息则久，久则征，征则悠远，悠远则博厚，博厚则高明。博厚，所以载物也；高明，所以覆物也；悠久，所以成物也。博厚配地，高明配天，悠久无疆。如此者，不见而章，不动而变，无为而成。","b":5,"y":-300,"th":["哲理","修身","天道"],"ap":1}],"t155":[{"id":"355a9c1ee114","t":"论语·阳货篇 其4","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子之武城，闻弦歌之声。夫子莞尔而笑，曰：“割鸡焉用牛刀？”子游对曰：“昔者偃也闻诸夫子曰：‘君子学道则爱人，小人学道则易使也。’”子曰：“二三子，偃之言是也！前言戏之耳。”","b":1,"y":-500,"th":["哲理","礼乐教化","师生情谊"],"ap":1},{"id":"44a2b31cf11c","t":"论语·先进篇 其23","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子畏于匡，颜渊后。子曰：“吾以女为死矣！”曰：“子在，回何敢死！”","b":1,"y":-496,"th":["师生情谊","哲理","患难"],"ap":1},{"id":"d63a23981ffd","t":"论语·雍也篇 其28","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子见南子，子路不说，夫子矢之曰：“予所否者，天厌之！天厌之！”","b":1,"y":-492,"th":["师生情谊","哲理","权变"],"ap":1},{"id":"aee1a66e1341","t":"论语·先进篇 其11","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"颜渊死，门人欲厚葬之，子曰：“不可。”门人厚葬之，子曰：“回也视予犹父也，予不得视犹子也。非我也，夫二三子也！”","b":2,"y":-481,"th":["师生情谊","礼制","哲理"],"ap":1},{"id":"48d13474693a","t":"论语·雍也篇 其10","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"伯牛有疾，子问之，自牖执其手，曰：“亡之，命矣夫！斯人也而有斯疾也！斯人也而有斯疾也！”","b":3,"y":-450,"th":["师生情谊","天命","悲叹"],"ap":1},{"id":"8e44a8a6dea7","t":"论语·述而篇 其35","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子疾病，子路请祷。子曰：“有诸？”子路对曰：“有之。《诔》曰：‘祷尔于上下神祇。’”子曰：“丘之祷久矣。”","b":3,"y":-450,"th":["哲理","天命","师生情谊"],"ap":1}],"t186":[{"id":"29c7c7a484ab","t":"论语·述而篇 其34","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“若圣与仁，则吾岂敢？抑为之不厌，诲人不倦，则可谓云尔已矣。”公西华曰：“正唯弟子不能学也。”","b":1,"y":-500,"th":["谦逊","教育","哲理"],"ap":1},{"id":"b26248ece44b","t":"论语·雍也篇 其15","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“孟之反不伐，奔而殿，将入门，策其马曰：‘非敢后也，马不进也。’”","b":1,"y":-500,"th":["哲理","谦逊","品德"],"ap":1},{"id":"e848e1789759","t":"论语·子罕篇 其6","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"太宰问于子贡曰：“夫子圣者与，何其多能也？”子贡曰：“固天纵之将圣，又多能也。”子闻之，曰：“太宰知我乎？吾少也贱，故多能鄙事。君子多乎哉？不多也。”","b":1,"y":-490,"th":["哲理","修身","谦逊"],"ap":1},{"id":"196a47f1432c","t":"论语·述而篇 其33","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“文，莫吾犹人也。躬行君子，则吾未之有得。”","b":3,"y":-450,"th":["哲理","修身","谦逊"],"ap":1},{"id":"c8a71ec32488","t":"孟子·公孙丑上 其25","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「恶！是何言也？昔者子贡、问于孔子曰：『夫子圣矣乎？』孔子曰：『圣则吾不能，我学不厌而教不倦也。』子贡曰：『学不厌，智也；教不倦，仁也。仁且智，夫子既圣矣！』夫圣，孔子不居，是何言也？」","b":5,"y":-300,"th":["哲理","谦逊","教育"],"ap":1}],"t191":[{"id":"d75c98915e43","t":"论语·宪问篇 其37","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“贤者辟世，其次辟地，其次辟色，其次辟言。”子曰：“作者七人矣。”","b":3,"y":-450,"th":["哲理","隐逸","出处进退"],"ap":1},{"id":"27125a682168","t":"孟子·公孙丑下 其19","a":"孟子","d":1,"f":"文","g":"文","x":"蚔鼃谏于王而不用，致为臣而去。齐人曰：「所以为蚔鼃，则善矣；所以自为，则吾不知也。」","b":4,"y":-320,"th":["哲理","出处进退","政治"],"ap":1},{"id":"2c0d2a34e84f","t":"孟子·滕文公下 其28","a":"孟子","d":1,"f":"文","g":"文","x":"公孙丑问曰：「不见诸侯何义？」","b":5,"y":-320,"th":["哲理","出处进退","士人操守"],"ap":1},{"id":"2c1a0243b13b","t":"孟子·梁惠王下 其61","a":"孟子","d":1,"f":"文","g":"文","x":"乐正子见孟子，曰：「克告于君，君为来见也。嬖人有臧仓者沮君，君是以不果来也。」曰：「行或使之，止或尼之。行止，非人所能也。吾之不遇鲁侯，天也。臧氏之子焉能使予不遇哉？」","b":5,"y":-320,"th":["天命","哲理","修身","出处进退"],"ap":1},{"id":"f5f084b62cc0","t":"孟子·公孙丑下 其23","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「夫既或治之，予何言哉？」","b":4,"y":-320,"th":["哲理","出处进退","政治抱负"],"ap":1}],"t205":[{"id":"6c1f9747d167","t":"静夜思","a":"李白","d":6,"f":"五绝","g":"诗","x":"床前明月光，疑是地上霜。","b":2,"y":726,"th":["思乡","月夜"],"ap":1},{"id":"2cab4263c452","t":"相和歌辞 怨诗三首 二","a":"李暇","d":6,"f":"五绝","g":"诗","x":"何处期郎游？小苑花台间。","b":4,"y":750,"th":["闺怨","爱情","月夜"],"ap":1},{"id":"4edff2df72ef","t":"相和歌辞 栖乌曲二首 二","a":"刘方平","d":6,"f":"七绝","g":"诗","x":"画舸双艚锦为缆，芙蓉花发莲叶暗。","b":8,"y":790,"th":["爱情","月夜","水乡"],"ap":1},{"id":"08d058d9c9eb","t":"水调歌头·明月几时有","a":"苏轼","d":8,"f":"词","g":"词","x":"明月几时有？把酒问青天。","b":3,"y":1076,"th":["中秋","思亲","哲理","月夜"],"ap":1},{"id":"46cc14e175de","t":"望江南·咏弦月","a":"纳兰性德","d":11,"f":"词","g":"词","x":"初八月，半镜上青霄","b":0,"y":1680,"th":["咏物","闺怨","月夜"],"ap":1}],"t249":[{"id":"74843b70d293","t":"长寿乐","a":"柳永","d":8,"f":"词","g":"词","x":"繁红嫩翠。","b":1,"y":1015,"th":["春景","都市繁华","及时行乐","惜时"],"ap":1},{"id":"d4e2ac5d2fe4","t":"玉楼春","a":"柳永","d":8,"f":"词","g":"词","x":"皇都今夕知何夕。","b":1,"y":1020,"th":["节令","都市繁华","游乐"],"ap":1},{"id":"3c47469f8d2c","t":"看花回","a":"柳永","d":8,"f":"词","g":"词","x":"玉墄金阶舞舜干。","b":2,"y":1030,"th":["都市繁华","太平宴饮","及时行乐"],"ap":1},{"id":"6ca5df45fa47","t":"破阵乐","a":"张先","d":8,"f":"词","g":"词","x":"四堂互映，双门并丽，龙阁开府。","b":3,"y":1072,"th":["赠别","写景","都市繁华"],"ap":1}],"t263":[{"id":"ec65f82eab2e","t":"论语·乡党篇 其19","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"疾，君视之，东首，加朝服，拖绅。","b":2,"y":-450,"th":["礼仪","君臣","哲理"],"ap":1},{"id":"26acd9a06fe4","t":"孟子·公孙丑下 其43","a":"孟子","d":1,"f":"文","g":"文","x":"孟子致为臣而归。王就见孟子，曰：「前日愿见而不可得，得侍，同朝甚喜。今又弃寡人而归，不识可以继此而得见乎？」对曰：「不敢请耳，固所愿也。」","b":4,"y":-320,"th":["君臣","辞官","哲理"],"ap":1},{"id":"d9687b54afca","t":"孟子·公孙丑下 其5","a":"孟子","d":1,"f":"文","g":"文","x":"不得已而之景丑氏宿焉。景子曰：「内则父子，外则君臣，人之大伦也。父子主恩，君臣主敬。丑见王之敬子也，未见所以敬王也。」","b":4,"y":-320,"th":["哲理","君臣","人格独立"],"ap":1}],"t270":[{"id":"31bccfb89af5","t":"论语·雍也篇 其8","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"季康子问：“仲由可使从政也与？”子曰：“由也果，于从政乎何有？”曰：“赐也可使从政也与？”曰：“赐也达，于从政乎何有？”曰：“求也可使从政也与？”曰：“求也艺，于从政乎何有？”","b":2,"y":-490,"th":["知人善任","因材施教","治国理政"],"ap":1},{"id":"e7c5d2fccf1e","t":"论语·卫灵公篇 其11","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"颜渊问为邦，子曰：“行夏之时，乘殷之辂，服周之冕，乐则《韶》、《舞》；放郑声，远佞人。郑声淫，佞人殆。”","b":2,"y":-450,"th":["治国理政","礼乐文明","儒家哲理"],"ap":1},{"id":"681c479b0451","t":"孟子·滕文公下 其22","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「然则子非食志也，食功也。」","b":5,"y":-320,"th":["哲理","义利之辨","治国理政"],"ap":1}],"t292":[{"id":"182f998ed122","t":"相和歌辞 子夜四时歌四首 春歌","a":"陆龟蒙","d":6,"f":"五绝","g":"诗","x":"山连翠羽屏，草接烟华席。","b":10,"y":855,"th":["爱情","闺怨","咏春"],"ap":1},{"id":"a1c489a47a17","t":"尾犯","a":"柳永","d":8,"f":"词","g":"词","x":"晴烟幂幂。","b":2,"y":1035,"th":["咏春","哲理","羁旅"],"ap":1},{"id":"228ca2e328c1","t":"定风波","a":"范仲淹","d":8,"f":"词","g":"词","x":"罗绮满城春欲暮。","b":3,"y":1045,"th":["旷达","咏春","哲理"],"ap":1}],"t335":[{"id":"1c0b4a82f6be","t":"鹊巢","a":"佚名","d":1,"f":"诗经","g":"诗","x":"维鹊有巢，维鸠居之。之子于归，百两御之。","b":1,"y":-700,"th":["婚嫁","祝贺","起兴"],"ap":1},{"id":"e839a35851f9","t":"樛木","a":"佚名","d":1,"f":"诗经","g":"诗","x":"南有樛木，葛藟累之。乐只君子，福履绥之。","b":0,"y":-700,"th":["祝贺","比兴","福禄"],"ap":1}],"t340":[{"id":"ae5fa8015092","t":"论语·雍也篇 其9","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"季氏使闵子骞为费宰，闵子骞曰：“善为我辞焉。如有复我者，则吾必在汶上矣。”","b":1,"y":-500,"th":["气节","辞官","守道"],"ap":1},{"id":"26acd9a06fe4","t":"孟子·公孙丑下 其43","a":"孟子","d":1,"f":"文","g":"文","x":"孟子致为臣而归。王就见孟子，曰：「前日愿见而不可得，得侍，同朝甚喜。今又弃寡人而归，不识可以继此而得见乎？」对曰：「不敢请耳，固所愿也。」","b":4,"y":-320,"th":["君臣","辞官","哲理"],"ap":1}],"t353":[{"id":"3d3c7befc5e9","t":"论语·子罕篇 其1","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子罕言利与命与仁。","b":2,"y":-450,"th":["哲理","义利之辨","天命","仁德"],"ap":1},{"id":"e26d35802a1b","t":"论语·八佾篇 其3","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“人而不仁，如礼何？人而不仁，如乐何？”","b":2,"y":-450,"th":["哲理","礼乐","仁德"],"ap":1}],"t379":[{"id":"7a6236de9176","t":"论语·八佾篇 其12","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"祭如在，祭神如神在。子曰：“吾不与祭，如不祭。”","b":2,"y":-450,"th":["哲理","礼制","诚敬"],"ap":1},{"id":"7af99eb9d497","t":"中庸·中庸 其16","a":"子思（传）","d":1,"f":"文","g":"文","x":"子曰：「鬼神之为德，其盛矣乎！视之而弗见，听之而弗闻，体物而不可遗。使天下之人齐明盛服，以承祭祀，洋洋乎如在其上，如在其左右。《诗》曰：『神之格思，不可度思！矧可射思！』夫微之显，诚之不可掩如此夫。」","b":4,"y":-400,"th":["哲理","祭祀","诚敬"],"ap":1}],"t384":[{"id":"c758f235decc","t":"中庸·中庸 其23","a":"子思（传）","d":1,"f":"文","g":"文","x":"自诚明，谓之性；自明诚，谓之教。诚则明矣，明则诚矣。唯天下至诚，为能尽其性；能尽其性，则能尽人之性；能尽人之性，则能尽物之性；能尽物之性，则可以赞天地之化育；可以赞天地之化育，则可以与天地参矣。","b":4,"y":-430,"th":["哲理","修身","天人合一"],"ap":1},{"id":"8f62ec2271c9","t":"中庸·中庸 其27","a":"子思（传）","d":1,"f":"文","g":"文","x":"天地之道，可壹言而尽也。其为物不贰，则其生物不测。天地之道，博也厚也，高也明也，悠也久也。今夫天，斯昭昭之多，及其无穷也，日月星辰系焉，万物覆焉。今夫地，一撮土之多，及其广厚，载华岳而不重，振河海而不泄，万物载焉。今夫山，一拳石之多，及其广大，草木生之，禽兽居之，宝藏兴焉。今夫水，一勺之多，及其不测，鼋鼍、蛟龙、鱼鳖生焉，货财殖焉。《诗》云：「维天之命，於穆不已！」盖曰天之所以为天也。「於乎不显！文王之德之纯！」盖曰文王之所以为文也，纯亦不已。","b":4,"y":-400,"th":["哲理","天道","至诚无息","天人合一"],"ap":1}],"t397":[{"id":"d710a1e702d0","t":"白驹","a":"佚名","d":1,"f":"诗经","g":"诗","x":"皎皎白驹，食我场苗。絷之维之，以永今朝。所谓伊人，于焉逍遥？","b":0,"y":-771,"th":["思贤","送别","劝勉"],"ap":1},{"id":"665ac45393f1","t":"杂曲歌辞 君子有所思行 一","a":"僧贯休","d":6,"f":"古体","g":"诗","x":"我爱正考甫，思贤作商颂。","b":10,"y":867,"th":["怀古","咏怀","思贤"],"ap":1}],"t403":[{"id":"e08c1b6a4bcd","t":"相和歌辞 上云乐","a":"李贺","d":6,"f":"古体","g":"诗","x":"飞香走红满天春，花龙盘盘上紫云。","b":9,"y":810,"th":["宫廷","宴乐","奇诡"],"ap":1},{"id":"12b895e4640c","t":"杂曲歌辞 长安少年行十首 五","a":"李廓","d":6,"f":"五律","g":"诗","x":"遨游携艳妓，装束似男儿。","b":9,"y":820,"th":["游春","宴乐","都市生活"],"ap":1}],"t410":[{"id":"32445103ed01","t":"登鹳雀楼","a":"王之涣","d":6,"f":"五绝","g":"诗","x":"白日依山尽，黄河入海流。","b":1,"y":704,"th":["登临","哲理","壮阔"],"ap":1},{"id":"d987f84d63d4","t":"喜朝天・踏莎行","a":"张先","d":8,"f":"词","g":"词","x":"晓云开。","b":3,"y":1050,"th":["登临","送别","家国","咏怀"],"ap":1}],"t429":[{"id":"f36ab234fcd1","t":"相和歌辞 长歌续短歌","a":"李贺","d":6,"f":"五古","g":"诗","x":"长歌破衣襟，短歌断白发。","b":9,"y":810,"th":["怀才不遇","时光流逝","政治抱负"],"ap":1},{"id":"1eed6fe11e04","t":"清平乐","a":"晏殊","d":8,"f":"词","g":"词","x":"春来秋去。","b":2,"y":1030,"th":["伤春悲秋","怀人","时光流逝"],"ap":1}],"t465":[{"id":"1029674209a3","t":"论语·宪问篇 其38","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子路宿于石门，晨门曰：“奚自？”子路曰：“自孔氏。”曰：“是知其不可而为之者与？”","b":3,"y":-450,"th":["哲理","入世","人物评赞"],"ap":1}],"t498":[{"id":"284e330c53cd","t":"论语·八佾篇 其6","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"季氏旅于泰山。子谓冉有曰：“女弗能救与？”对曰：“不能。”子曰：“呜呼！曾谓泰山不如林放乎？”","b":2,"y":-450,"th":["礼制","僭越","哲理"],"ap":1}],"t515":[{"id":"33f5c0bf1a7a","t":"论语·子张篇 其25","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"陈子禽谓子贡曰：“子为恭也，仲尼岂贤于子乎？”子贡曰：“君子一言以为知，一言以为不知，言不可不慎也。夫子之不可及也，犹天之不可阶而升也。夫子之得邦家者，所谓立之斯立，道之斯行，绥之斯来，动之斯和。其生也荣，其死也哀，如之何其可及也？”","b":2,"y":-450,"th":["哲理","尊师","崇儒"],"ap":1}],"t559":[{"id":"61f1495fa66d","t":"论语·卫灵公篇 其20","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“君子疾没世而名不称焉。”","b":2,"y":-450,"th":["哲理","修身","生命价值"],"ap":1}],"t560":[{"id":"635e99b441f7","t":"大学·大学 其7","a":"曾子（传）","d":1,"f":"文","g":"文","x":"《诗》云：「邦畿千里，惟民所止。」《诗》云：「缗蛮黄鸟，止于丘隅。」子曰：「于止，知其所止，可以人而不如鸟乎？」《诗》云：「穆穆文王，于缉熙敬止！」为人君，止于仁；为人臣，止于敬；为人子，止于孝；为人父，止于慈；与国人交，止于信。","b":4,"y":-430,"th":["哲理","伦理","修齐治平"],"ap":1}],"t573":[{"id":"6efa967ab68f","t":"论语·子路篇 其24","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子贡问曰：“乡人皆好之，何如？”子曰：“未可也。”“乡人皆恶之，何如？”子曰：“未可也。不如乡人之善者好之，其不善者恶之。”","b":3,"y":-450,"th":["哲理","识人","是非"],"ap":1}],"t582":[{"id":"7d57b08784f7","t":"庭燎","a":"佚名","d":1,"f":"诗经","g":"诗","x":"夜如何其？夜未央，庭燎之光。君子至止，鸾声将将。","b":0,"y":-700,"th":["朝会","勤政","宫廷"],"ap":1}],"t601":[{"id":"984f2121984d","t":"中庸·中庸 其18","a":"子思（传）","d":1,"f":"文","g":"文","x":"子曰：「无忧者其惟文王乎！以王季为父，以武王为子，父作之，子述之。武王缵大王、王季、文王之绪，壹戎衣而有天下，身不失天下之显名；尊为天子，富有四海之内。宗庙飨之，子孙保之。武王末受命，周公成文、武之德，追王大王、王季，上祀先公以天子之礼。斯礼也，达乎诸侯、大夫及士、庶人。父为大夫，子为士，葬以大夫，祭以士。父为士，子为大夫，葬以士，祭以大夫。期之丧，达乎大夫；三年之丧，达乎天子；父母之丧，无贵贱，一也。」","b":4,"y":-430,"th":["礼制","孝道","宗法","德政"],"ap":1}],"t616":[{"id":"a8bb995f5c71","t":"巷伯","a":"佚名","d":1,"f":"诗经","g":"诗","x":"萋兮斐兮，成是贝锦。彼谮人者，亦已大甚！","b":0,"y":-800,"th":["政治讽喻","疾恶如仇","抒愤"],"ap":1}],"t638":[{"id":"bd3759373ecd","t":"孟子·公孙丑下 其11","a":"孟子","d":1,"f":"文","g":"文","x":"孟子之平陆。谓其大夫曰：「子之持戟之士，一日而三失伍，则去之否乎？」","b":4,"y":-320,"th":["哲理","治国","责任"],"ap":1}],"t652":[{"id":"c7bd5c39d38c","t":"我将","a":"佚名","d":1,"f":"诗经","g":"诗","x":"我将我享，维羊维牛，维天其右之。仪式刑文王之典，日靖四方。","b":0,"y":-1050,"th":["祭祀","敬天法祖","治国"],"ap":1}],"t667":[{"id":"d9687b54afca","t":"孟子·公孙丑下 其5","a":"孟子","d":1,"f":"文","g":"文","x":"不得已而之景丑氏宿焉。景子曰：「内则父子，外则君臣，人之大伦也。父子主恩，君臣主敬。丑见王之敬子也，未见所以敬王也。」","b":4,"y":-320,"th":["哲理","君臣","人格独立"],"ap":1}],"t674":[{"id":"ddb49662a96c","t":"孟子·滕文公下 其15","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「否。士无事而食，不可也。」","b":5,"y":-320,"th":["哲理","道德修养","社会责任"],"ap":1}],"t689":[{"id":"ea6a26d644eb","t":"论语·雍也篇 其4","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子华使于齐，冉子为其母请粟，子曰：“与之釜。”请益，曰：“与之庾。”冉子与之粟五秉。子曰：“赤之适齐也，乘肥马，衣轻裘。吾闻之也，君子周急不继富。”","b":3,"y":-450,"th":["哲理","处事之道","财富观"],"ap":1}],"t708":[{"id":"f92b1b2f51d3","t":"昭世","a":"王褒","d":1,"f":"楚辞","g":"诗","x":"世溷兮冥昏，违君兮归真。","b":5,"y":-300,"th":["游仙","怀古","政治感慨"],"ap":1}],"t726":[{"id":"0586789c234b","t":"舞曲歌辞 东海有勇妇","a":"李白","d":6,"f":"五古","g":"诗","x":"梁山感杞妻，恸哭为之倾。","b":3,"y":745,"th":["咏史","烈义","赞颂女性"],"ap":1}],"t731":[{"id":"0f184540f7be","t":"杂曲歌辞 少年行四首 四","a":"令狐楚","d":6,"f":"七绝","g":"诗","x":"霜满中庭月过楼，金尊玉柱对清秋。","b":8,"y":801,"th":["行乐","少年游侠","秋夜"],"ap":1}],"t744":[{"id":"2ba62172d08f","t":"相和歌辞 从军行 四","a":"僧皎然","d":6,"f":"五律","g":"诗","x":"飞将下天来，奇谋阃外裁。","b":7,"y":780,"th":["边塞","咏战","颂功"],"ap":1}],"t757":[{"id":"4dcf0eb19cc4","t":"舞曲歌辞 公莫舞歌","a":"李贺","d":6,"f":"七古","g":"诗","x":"方花古础排九楹，刺豹淋血盛银甖。","b":9,"y":810,"th":["咏史","天命","霸业"],"ap":1}],"t762":[{"id":"5a80501be22d","t":"杂曲歌辞 春日行","a":"李白","d":6,"f":"古体","g":"诗","x":"深宫高楼入紫清，金作蛟龙盘绣楹。","b":2,"y":736,"th":["游仙","政治理想","颂世"],"ap":1}],"t780":[{"id":"8ef7eec2f97c","t":"相和歌辞 宫怨","a":"于𣸣","d":6,"f":"五古","g":"诗","x":"妾家望江口，少年家财厚。","b":10,"y":860,"th":["宫怨","红颜薄命","咏史"],"ap":1}],"t793":[{"id":"afe398ee03df","t":"琴曲歌辞 幽兰","a":"崔涂","d":6,"f":"五古","g":"诗","x":"幽植众能知，贞芳只暗持。","b":4,"y":750,"th":["咏物","怀才不遇","孤芳自赏"],"ap":1}],"t825":[{"id":"fa0ea0804f4a","t":"舞曲歌辞 白纻歌","a":"张籍","d":6,"f":"七律","g":"诗","x":"皎皎白纻白且鲜，将作春衫称少年。","b":9,"y":815,"th":["爱情","少女情思","春日游春"],"ap":1}],"t843":[{"id":"449282d01d37","t":"更漏子","a":"晏殊","d":8,"f":"词","g":"词","x":"雪藏梅，烟著柳。","b":2,"y":1035,"th":["初春","怀人","闲适"],"ap":1}],"t850":[{"id":"60bde4fe9f6c","t":"怨春风・一斛珠","a":"张先","d":8,"f":"词","g":"词","x":"无由且住。","b":3,"y":1040,"th":["爱情","离愁","约会"],"ap":1}],"t869":[{"id":"c424a4c41aa3","t":"感皇恩","a":"张先","d":8,"f":"词","g":"词","x":"万乘靴袍御紫宸。","b":3,"y":1040,"th":["科举","贺人","入仕"],"ap":1}],"t887":[{"id":"089977038410","t":"草桥店梦莺莺(第四本)・麻郎儿","a":"王实甫","d":9,"f":"曲","g":"曲","x":"秀才是文章魁首，姐姐是仕女班头；一个通彻三教九流，一个晓尽描鸾刺绣。","b":0,"y"