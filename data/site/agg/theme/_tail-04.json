":"长忆西山，灵隐寺前三竺后。","b":1,"y":990,"th":["山水","忆旧","思乡"],"ap":1}],"t120":[{"id":"a3964f6dc9d4","t":"南山有台","a":"佚名","d":1,"f":"诗经","g":"诗","x":"南山有台，北山有莱。乐只君子，邦家之基。乐只君子，万寿无期。","b":0,"y":-700,"th":["颂德","祝寿","宴饮"],"ap":1},{"id":"fb7ae68f545e","t":"喜迁莺","a":"晏殊","d":8,"f":"词","g":"词","x":"曙河低，斜月淡。","b":2,"y":1030,"th":["祝寿","宴饮","女性"],"ap":1},{"id":"1cb98af70c93","t":"诉衷情","a":"晏殊","d":8,"f":"词","g":"词","x":"秋风吹绽北池莲。","b":2,"y":1035,"th":["祝寿","宴饮","富贵"],"ap":1},{"id":"4850e6a565be","t":"木兰花・玉楼春","a":"晏殊","d":8,"f":"词","g":"词","x":"杏梁归燕双回首。","b":2,"y":1035,"th":["祝寿","宴饮","富贵"],"ap":1},{"id":"a2f3b8ebfa85","t":"诉衷情","a":"晏殊","d":8,"f":"词","g":"词","x":"世间荣贵月中人。","b":2,"y":1035,"th":["祝寿","宴饮","颂赞"],"ap":1},{"id":"8a4218608b36","t":"木兰花・玉楼春","a":"晏殊","d":8,"f":"词","g":"词","x":"紫薇朱槿繁开后。","b":3,"y":1040,"th":["祝寿","宴饮","咏时"],"ap":1},{"id":"27a4ec2f4434","t":"少年游","a":"晏殊","d":8,"f":"词","g":"词","x":"芙蓉花发去年枝。","b":3,"y":1045,"th":["祝寿","惜时","闲适"],"ap":1},{"id":"8ca47e0d04ee","t":"少年游","a":"晏殊","d":8,"f":"词","g":"词","x":"谢家庭槛晓无尘。","b":3,"y":1045,"th":["祝寿","宴饮","太平气象"],"ap":1},{"id":"551e35ec65ff","t":"巫山一段云","a":"柳永","d":8,"f":"词","g":"词","x":"萧氏贤夫妇，茅家好弟兄。","b":3,"y":1100,"th":["游仙","祝寿","奇想"],"ap":1}],"t133":[{"id":"dba33dcb8da7","t":"论语·阳货篇 其19","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“予欲无言。”子贡曰：“子如不言，则小子何述焉？”子曰：“天何言哉？四时行焉，百物生焉，天何言哉？”","b":1,"y":-500,"th":["哲理","教育","天道","自然"],"ap":1},{"id":"014523303f71","t":"中庸·中庸 其31","a":"子思（传）","d":1,"f":"文","g":"文","x":"仲尼祖述尧、舜，宪章文、武；上律天时，下袭水土。辟如天地之无不持载，无不复帱，辟如四时之错行，如日月之代明。万物并育而不相害，道并行而不相悖，小德川流，大德敦化，此天地之所以为大也。","b":4,"y":-430,"th":["哲理","咏人","天道"],"ap":1},{"id":"37fe6c039c07","t":"中庸·中庸 其12","a":"子思（传）","d":1,"f":"文","g":"文","x":"君子之道费而隐。夫妇之愚，可以与知焉，及其至也，虽圣人亦有所不知焉；夫妇之不肖，可以能行焉，及其至也，虽圣人亦有所不能焉。天地之大也，人犹有所憾，故君子语大，天下莫能载焉；语小，天下莫能破焉。《诗》云：『鸢飞戾天，鱼跃于渊。』言其上下察也。君子之道，造端乎夫妇，及其至也，察乎天地。」","b":4,"y":-430,"th":["哲理","修身","天道"],"ap":1},{"id":"cf8bc113ba19","t":"中庸·中庸 其25","a":"子思（传）","d":1,"f":"文","g":"文","x":"至诚之道，可以前知。国家将兴，必有祯祥；国家将亡，必有妖孽。见乎蓍龟，动乎四体。祸福将至：善，必先知之；不善，必先知之。故至诚如神。","b":4,"y":-430,"th":["哲理","修身","天道"],"ap":1},{"id":"8f62ec2271c9","t":"中庸·中庸 其27","a":"子思（传）","d":1,"f":"文","g":"文","x":"天地之道，可壹言而尽也。其为物不贰，则其生物不测。天地之道，博也厚也，高也明也，悠也久也。今夫天，斯昭昭之多，及其无穷也，日月星辰系焉，万物覆焉。今夫地，一撮土之多，及其广厚，载华岳而不重，振河海而不泄，万物载焉。今夫山，一拳石之多，及其广大，草木生之，禽兽居之，宝藏兴焉。今夫水，一勺之多，及其不测，鼋鼍、蛟龙、鱼鳖生焉，货财殖焉。《诗》云：「维天之命，於穆不已！」盖曰天之所以为天也。「於乎不显！文王之德之纯！」盖曰文王之所以为文也，纯亦不已。","b":4,"y":-400,"th":["哲理","天道","至诚无息","天人合一"],"ap":1},{"id":"7411bc9f22fd","t":"中庸·中庸 其33","a":"子思（传）","d":1,"f":"文","g":"文","x":"唯天下至诚，为能经纶天下之大经，立天下之大本，知天地之化育。夫焉有所倚？肫肫其仁！渊渊其渊！浩浩其天！苟不固聪明圣知达天德者，其孰能知之？","b":5,"y":-300,"th":["哲理","修身","天道"],"ap":1},{"id":"ff717278137a","t":"中庸·中庸 其26","a":"子思（传）","d":1,"f":"文","g":"文","x":"诚者自成也，而道自道也。诚者物之终始，不诚无物。是故君子诚之为贵。诚者非自成己而已也，所以成物也。成己，仁也；成物，知也。性之德也，合外内之道也，故时措之宜也。故至诚无息。不息则久，久则征，征则悠远，悠远则博厚，博厚则高明。博厚，所以载物也；高明，所以覆物也；悠久，所以成物也。博厚配地，高明配天，悠久无疆。如此者，不见而章，不动而变，无为而成。","b":5,"y":-300,"th":["哲理","修身","天道"],"ap":1}],"t155":[{"id":"355a9c1ee114","t":"论语·阳货篇 其4","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子之武城，闻弦歌之声。夫子莞尔而笑，曰：“割鸡焉用牛刀？”子游对曰：“昔者偃也闻诸夫子曰：‘君子学道则爱人，小人学道则易使也。’”子曰：“二三子，偃之言是也！前言戏之耳。”","b":1,"y":-500,"th":["哲理","礼乐教化","师生情谊"],"ap":1},{"id":"44a2b31cf11c","t":"论语·先进篇 其23","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子畏于匡，颜渊后。子曰：“吾以女为死矣！”曰：“子在，回何敢死！”","b":1,"y":-496,"th":["师生情谊","哲理","患难"],"ap":1},{"id":"d63a23981ffd","t":"论语·雍也篇 其28","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子见南子，子路不说，夫子矢之曰：“予所否者，天厌之！天厌之！”","b":1,"y":-492,"th":["师生情谊","哲理","权变"],"ap":1},{"id":"aee1a66e1341","t":"论语·先进篇 其11","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"颜渊死，门人欲厚葬之，子曰：“不可。”门人厚葬之，子曰：“回也视予犹父也，予不得视犹子也。非我也，夫二三子也！”","b":2,"y":-481,"th":["师生情谊","礼制","哲理"],"ap":1},{"id":"48d13474693a","t":"论语·雍也篇 其10","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"伯牛有疾，子问之，自牖执其手，曰：“亡之，命矣夫！斯人也而有斯疾也！斯人也而有斯疾也！”","b":3,"y":-450,"th":["师生情谊","天命","悲叹"],"ap":1},{"id":"8e44a8a6dea7","t":"论语·述而篇 其35","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子疾病，子路请祷。子曰：“有诸？”子路对曰：“有之。《诔》曰：‘祷尔于上下神祇。’”子曰：“丘之祷久矣。”","b":3,"y":-450,"th":["哲理","天命","师生情谊"],"ap":1}],"t186":[{"id":"1c0b4a82f6be","t":"鹊巢","a":"佚名","d":1,"f":"诗经","g":"诗","x":"维鹊有巢，维鸠居之。之子于归，百两御之。","b":1,"y":-700,"th":["婚嫁","祝贺","起兴"],"ap":1},{"id":"cef5dd9e561a","t":"着","a":"佚名","d":1,"f":"诗经","g":"诗","x":"俟我于着乎而，充耳以素乎而，尚之以琼华乎而。","b":0,"y":-700,"th":["爱情","婚嫁","咏物"],"ap":1},{"id":"bebabdcbd9dc","t":"横吹曲辞 捉搦歌","a":"张祜","d":6,"f":"古体","g":"诗","x":"门上关，墙上棘，窗中女子声唧唧，洛阳大道徒自直。","b":9,"y":827,"th":["婚嫁","闺怨","乐府"],"ap":1},{"id":"fb83cb11afc3","t":"诈妮子调风月・乔牌儿","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"勘婚处恰岁数，出嫁后有衣禄。","b":0,"y":1280,"th":["市井","婚嫁","世态"],"ap":1},{"id":"49aec99825a1","t":"诈妮子调风月・小桃红","a":"关汉卿","d":9,"f":"曲","g":"曲","x":"燕燕上复传示煞曾经，谁会甚儿女成婚聘？甚的是许出羞、下红定？问这洛阳城，少甚么能言快语官媒证？燕燕怎敢假名托姓？但教我一权为政，情取\"火上等冬凌\"。","b":0,"y":1290,"th":["爱情","婚嫁","女性意识"],"ap":1}],"t191":[{"id":"4d276f2ca195","t":"既醉","a":"佚名","d":1,"f":"诗经","g":"诗","x":"既醉以酒，既饱以德。君子万年，介尔景福。","b":0,"y":-771,"th":["祭祀","宴饮","祝颂","祈福"],"ap":1},{"id":"93974184a46d","t":"天保","a":"佚名","d":1,"f":"诗经","g":"诗","x":"天保定尔，亦孔之固。俾尔单厚，何福不除？俾尔多益，以莫不庶。","b":0,"y":-771,"th":["祝颂","祭祀","宴饮"],"ap":1},{"id":"34fb33a0320f","t":"螽斯","a":"佚名","d":1,"f":"诗经","g":"诗","x":"螽斯羽，诜诜兮。宜尔子孙，振振兮。","b":0,"y":-700,"th":["祝颂","咏物","繁衍"],"ap":1},{"id":"6a92a8432d58","t":"采菽","a":"佚名","d":1,"f":"诗经","g":"诗","x":"采菽采菽，筐之莒之。君子来朝，何锡予之？虽无予之？路车乘马。又何予之？玄衮及黼。","b":1,"y":-700,"th":["朝会","颂赞","政治","祝颂"],"ap":1},{"id":"9d74835f627e","t":"鸳鸯","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鸳鸯于飞，毕之罗之。君子万年，福禄宜之。","b":1,"y":-700,"th":["祝颂","宴饮","咏物"],"ap":1}],"t205":[{"id":"b2a509e01336","t":"相和歌辞 从军行五首 四","a":"令狐楚","d":6,"f":"五绝","g":"诗","x":"胡风千里惊，汉月五更明。","b":8,"y":801,"th":["边塞","思乡","梦境"],"ap":1},{"id":"908c44cde191","t":"小镇西・小镇西犯","a":"柳永","d":8,"f":"词","g":"词","x":"意中有个人，芳颜二八。","b":2,"y":1035,"th":["爱情","相思","梦境"],"ap":1},{"id":"b5c3d3468160","t":"草桥店梦莺莺(第四本)・寄生草","a":"王实甫","d":9,"f":"曲","g":"曲","x":"多丰韵，忒稔色。","b":0,"y":1295,"th":["爱情","梦境","相思"],"ap":1},{"id":"0d2e276b7157","t":"遐方怨·欹角枕","a":"纳兰性德","d":11,"f":"词","g":"词","x":"欹角枕，掩红窗","b":0,"y":1680,"th":["爱情","思乡","梦境"],"ap":1},{"id":"5