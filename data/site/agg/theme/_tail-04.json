28ca2e328c1","t":"定风波","a":"范仲淹","d":8,"f":"词","g":"词","x":"罗绮满城春欲暮。","b":3,"y":1045,"th":["旷达","咏春","哲理"],"ap":1}],"t335":[{"id":"1c0b4a82f6be","t":"鹊巢","a":"佚名","d":1,"f":"诗经","g":"诗","x":"维鹊有巢，维鸠居之。之子于归，百两御之。","b":1,"y":-700,"th":["婚嫁","祝贺","起兴"],"ap":1},{"id":"e839a35851f9","t":"樛木","a":"佚名","d":1,"f":"诗经","g":"诗","x":"南有樛木，葛藟累之。乐只君子，福履绥之。","b":0,"y":-700,"th":["祝贺","比兴","福禄"],"ap":1}],"t340":[{"id":"ae5fa8015092","t":"论语·雍也篇 其9","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"季氏使闵子骞为费宰，闵子骞曰：“善为我辞焉。如有复我者，则吾必在汶上矣。”","b":1,"y":-500,"th":["气节","辞官","守道"],"ap":1},{"id":"26acd9a06fe4","t":"孟子·公孙丑下 其43","a":"孟子","d":1,"f":"文","g":"文","x":"孟子致为臣而归。王就见孟子，曰：「前日愿见而不可得，得侍，同朝甚喜。今又弃寡人而归，不识可以继此而得见乎？」对曰：「不敢请耳，固所愿也。」","b":4,"y":-320,"th":["君臣","辞官","哲理"],"ap":1}],"t353":[{"id":"3d3c7befc5e9","t":"论语·子罕篇 其1","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子罕言利与命与仁。","b":2,"y":-450,"th":["哲理","义利之辨","天命","仁德"],"ap":1},{"id":"e26d35802a1b","t":"论语·八佾篇 其3","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“人而不仁，如礼何？人而不仁，如乐何？”","b":2,"y":-450,"th":["哲理","礼乐","仁德"],"ap":1}],"t379":[{"id":"7a6236de9176","t":"论语·八佾篇 其12","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"祭如在，祭神如神在。子曰：“吾不与祭，如不祭。”","b":2,"y":-450,"th":["哲理","礼制","诚敬"],"ap":1},{"id":"7af99eb9d497","t":"中庸·中庸 其16","a":"子思（传）","d":1,"f":"文","g":"文","x":"子曰：「鬼神之为德，其盛矣乎！视之而弗见，听之而弗闻，体物而不可遗。使天下之人齐明盛服，以承祭祀，洋洋乎如在其上，如在其左右。《诗》曰：『神之格思，不可度思！矧可射思！』夫微之显，诚之不可掩如此夫。」","b":4,"y":-400,"th":["哲理","祭祀","诚敬"],"ap":1}],"t384":[{"id":"c758f235decc","t":"中庸·中庸 其23","a":"子思（传）","d":1,"f":"文","g":"文","x":"自诚明，谓之性；自明诚，谓之教。诚则明矣，明则诚矣。唯天下至诚，为能尽其性；能尽其性，则能尽人之性；能尽人之性，则能尽物之性；能尽物之性，则可以赞天地之化育；可以赞天地之化育，则可以与天地参矣。","b":4,"y":-430,"th":["哲理","修身","天人合一"],"ap":1},{"id":"8f62ec2271c9","t":"中庸·中庸 其27","a":"子思（传）","d":1,"f":"文","g":"文","x":"天地之道，可壹言而尽也。其为物不贰，则其生物不测。天地之道，博也厚也，高也明也，悠也久也。今夫天，斯昭昭之多，及其无穷也，日月星辰系焉，万物覆焉。今夫地，一撮土之多，及其广厚，载华岳而不重，振河海而不泄，万物载焉。今夫山，一拳石之多，及其广大，草木生之，禽兽居之，宝藏兴焉。今夫水，一勺之多，及其不测，鼋鼍、蛟龙、鱼鳖生焉，货财殖焉。《诗》云：「维天之命，於穆不已！」盖曰天之所以为天也。「於乎不显！文王之德之纯！」盖曰文王之所以为文也，纯亦不已。","b":4,"y":-400,"th":["哲理","天道","至诚无息","天人合一"],"ap":1}],"t397":[{"id":"d710a1e702d0","t":"白驹","a":"佚名","d":1,"f":"诗经","g":"诗","x":"皎皎白驹，食我场苗。絷之维之，以永今朝。所谓伊人，于焉逍遥？","b":0,"y":-771,"th":["思贤","送别","劝勉"],"ap":1},{"id":"665ac45393f1","t":"杂曲歌辞 君子有所思行 一","a":"僧贯休","d":6,"f":"古体","g":"诗","x":"我爱正考甫，思贤作商颂。","b":10,"y":867,"th":["怀古","咏怀","思贤"],"ap":1}],"t403":[{"id":"12bd9dbdea9e","t":"相和歌辞 蛾眉怨","a":"王翰","d":6,"f":"古体","g":"诗","x":"君不见宜春苑中九华殿，飞阁连连直如发。","b":3,"y":740,"th":["宫怨","求仙","咏史","哲理"],"ap":1},{"id":"d16979e63603","t":"杂曲歌辞 行路难三首 一","a":"顾况","d":6,"f":"古体","g":"诗","x":"君不见古来烧水银，变作北邙山上尘。","b":8,"y":790,"th":["咏史","哲理","求仙"],"ap":1}],"t410":[{"id":"f0336b7181a0","t":"送杜少府之任蜀州","a":"王勃","d":6,"f":"五律","g":"诗","x":"城阙辅三秦，风烟望五津。","b":1,"y":676,"th":["送别","友情","壮阔"],"ap":1},{"id":"32445103ed01","t":"登鹳雀楼","a":"王之涣","d":6,"f":"五绝","g":"诗","x":"白日依山尽，黄河入海流。","b":1,"y":704,"th":["登临","哲理","壮阔"],"ap":1}],"t429":[{"id":"fd9dae1effa8","t":"玉阶怨","a":"李白","d":6,"f":"五绝","g":"诗","x":"玉阶生白露，夜久侵罗袜。","b":2,"y":736,"th":["宫怨","望月","孤寂"],"ap":1},{"id":"02a8b3a4a615","t":"高楼望月","a":"纳兰性德","d":11,"f":"词","g":"词","x":"戚戚复戚戚，高楼月如雪","b":1,"y":1680,"th":["闺怨","爱情","望月"],"ap":1}],"t465":[{"id":"1089c516e468","t":"山有扶苏","a":"佚名","d":1,"f":"诗经","g":"诗","x":"山有扶苏，隰有荷华。不见子都，乃见狂且。","b":0,"y":-750,"th":["爱情","娇嗔","民歌"],"ap":1}],"t498":[{"id":"2909f126ffd5","t":"论语·里仁篇 其23","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“以约失之者鲜矣。”","b":3,"y":-450,"th":["哲理","修身","自律"],"ap":1}],"t515":[{"id":"34fb33a0320f","t":"螽斯","a":"佚名","d":1,"f":"诗经","g":"诗","x":"螽斯羽，诜诜兮。宜尔子孙，振振兮。","b":0,"y":-700,"th":["祝颂","咏物","繁衍"],"ap":1}],"t559":[{"id":"635e99b441f7","t":"大学·大学 其7","a":"曾子（传）","d":1,"f":"文","g":"文","x":"《诗》云：「邦畿千里，惟民所止。」《诗》云：「缗蛮黄鸟，止于丘隅。」子曰：「于止，知其所止，可以人而不如鸟乎？」《诗》云：「穆穆文王，于缉熙敬止！」为人君，止于仁；为人臣，止于敬；为人子，止于孝；为人父，止于慈；与国人交，止于信。","b":4,"y":-430,"th":["哲理","伦理","修齐治平"],"ap":1}],"t560":[{"id":"649710a6bdb0","t":"论语·泰伯篇 其10","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“好勇疾贫，乱也。人而不仁，疾之已甚，乱也。”","b":3,"y":-450,"th":["哲理","治世","修身"],"ap":1}],"t573":[{"id":"719d776f6257","t":"论语·子路篇 其3","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子路曰：“卫君待子而为政，子将奚先？”子曰：“必也正名乎！”子路曰：“有是哉，子之迂也！奚其正？”子曰：“野哉由也！君子于其所不知，盖阙如也。名不正，则言不顺；言不顺，则事不成；事不成，则礼乐不兴；礼乐不兴，则刑罚不中；刑罚不中，则民无所错手足。故君子名之必可言也，言之必可行也。君子于其言，无所苟而已矣。”","b":2,"y":-488,"th":["哲理","政治","师生问答"],"ap":1}],"t582":[{"id":"7f71ba082f5a","t":"论语·述而篇 其26","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“圣人，吾不得而见之矣；得见君子者斯可矣。”子曰：“善人，吾不得而见之矣，得见有恒者斯可矣。亡而为有，虚而为盈，约而为泰，难乎有恒乎。”","b":3,"y":-450,"th":["哲理","修身","务实"],"ap":1}],"t601":[{"id":"9a2827847ddd","t":"绿衣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"绿兮衣兮，绿衣黄裹。心之忧矣，曷维其已！","b":0,"y":-700,"th":["悼亡","哀伤","怀人"],"ap":1}],"t616":[{"id":"a932560dee8b","t":"论语·先进篇 其19","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子曰：“回也其庶乎，屡空。赐不受命而货殖焉，亿则屡中。”","b":2,"y":-450,"th":["哲理","人物评骘","义利之辨"],"ap":1}],"t638":[{"id":"be5438d7322d","t":"小宛","a":"佚名","d":1,"f":"诗经","g":"诗","x":"宛彼鸣鸠，翰飞戾天。我心忧伤，念昔先人。明发不寐，有怀二人。","b":0,"y":-800,"th":["怀古","教子","忧患","哲理"],"ap":1}],"t652":[{"id":"c89cdd66e9c4","t":"葛覃","a":"佚名","d":1,"f":"诗经","g":"诗","x":"葛之覃兮，施于中谷，维叶萋萋。黄鸟于飞，集于灌木，其鸣喈喈。","b":0,"y":-700,"th":["劳动","亲情","归宁"],"ap":1}],"t667":[{"id":"dad70fdb2381","t":"汝坟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"遵彼汝坟，伐其条枚。未见君子，惄如调饥。","b":0,"y":-700,"th":["闺怨","思妇","乱世离愁"],"ap":1}],"t674":[{"id":"ddb49662a96c","t":"孟子·滕文公下 其15","a":"孟子","d":1,"f":"文","g":"文","x":"曰：「否。士无事而食，不可也。」","b":5,"y":-320,"th":["哲理","道德修养","社会责任"],"ap":1}],"t689":[{"id":"ea6a26d644eb","t":"论语·雍也篇 其4","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子华使于齐，冉子为其母请粟，子曰：“与之釜。”请益，曰：“与之庾。”冉子与之粟五秉。子曰：“赤之适齐也，乘肥马，衣轻裘。吾闻之也，君子周急不继富。”","b":3,"y":-450,"th":["哲理","处事之道","财富观"],"ap":1}],"t708":[{"id":"f92b1b2f51d3","t":"昭世","a":"王褒","d":1,"f":"楚辞","g":"诗","x":"世溷兮冥昏，违君兮归真。","b":5,"y":-300,"th":["游仙","怀古","政治感慨"],"ap":1}],"t726":[{"id":"0586789c234b","t":"舞曲歌辞 东海有勇妇","a":"李白","d":6,"f":"五古","g":"诗","x":"梁山感杞妻，恸哭为之倾。","b":3,"y":745,"th":["咏史","烈义","赞颂女性"],"ap":1}],"t731":[{"id":"0f184540f7be","t":"杂曲歌辞 少年行四首 四","a":"令狐楚","d":6,"f":"七绝","g":"诗","x":"霜满中庭月过楼，金尊玉柱对清秋。","b":8,"y":801,"th":["行乐","少年游侠",