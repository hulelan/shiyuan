{"t076":[{"id":"a7351cc8141b","t":"文王有声","a":"佚名","d":1,"f":"诗经","g":"诗","x":"文王有声，遹骏有声。遹求厥宁，遹观厥成。文王烝哉！","b":0,"y":-1050,"th":["咏史","颂赞","家国"],"ap":1},{"id":"5b1f97faba9a","t":"桓","a":"佚名","d":1,"f":"诗经","g":"诗","x":"绥万邦，屡丰年。天命匪解，桓桓武王。保有厥士，于以四方，克定厥家。于昭于天，皇以间之。","b":0,"y":-1046,"th":["颂赞","怀古","军旅"],"ap":1},{"id":"23df10bba2e9","t":"瞻彼洛矣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"瞻彼洛矣，维水泱泱。君子至止，福禄如茨。韎韐有奭，以作六师。","b":0,"y":-908,"th":["颂赞","军事","家国"],"ap":1},{"id":"bccd51e0850a","t":"假乐","a":"佚名","d":1,"f":"诗经","g":"诗","x":"假乐君子，显显令德，宜民宜人。受禄于天，保右命之，自天申之。","b":0,"y":-908,"th":["颂赞","德政","天命"],"ap":1},{"id":"fc9e79b534ae","t":"鱼藻","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鱼在在藻，有颁其首。王在在镐，岂乐饮酒。","b":0,"y":-908,"th":["颂赞","宴饮","太平"],"ap":1},{"id":"274e2c5e8884","t":"采芑","a":"佚名","d":1,"f":"诗经","g":"诗","x":"薄言采芑，于彼新田，呈此菑亩。方叔涖止，其车三千。师干之试，方叔率止。","b":0,"y":-800,"th":["战争","颂赞","边塞"],"ap":1},{"id":"e9de788a774e","t":"崧高","a":"佚名","d":1,"f":"诗经","g":"诗","x":"崧高维岳，骏极于天。维岳降神，生甫及申。维申及甫，维周之翰。四国于蕃。四方于宣。","b":0,"y":-800,"th":["送别","颂赞","家国"],"ap":1},{"id":"636114faec6f","t":"泂酌","a":"佚名","d":1,"f":"诗经","g":"诗","x":"泂酌彼行潦，挹彼注兹，可以餴饎。岂弟君子，民之父母。","b":0,"y":-771,"th":["颂赞","民本","哲理"],"ap":1},{"id":"13ed7843cdeb","t":"振鹭","a":"佚名","d":1,"f":"诗经","g":"诗","x":"振鹭于飞，于彼西雍。我客戾止，亦有斯容。在彼无恶，在此无斁。庶几夙夜，以永终誉。","b":0,"y":-700,"th":["宴飨","咏物","颂赞"],"ap":1},{"id":"287290565ef0","t":"吉日","a":"佚名","d":1,"f":"诗经","g":"诗","x":"吉日维戊，既伯既祷。田车既好，四牡孔阜。升彼大阜，从其群丑。","b":0,"y":-700,"th":["田猎","宴饮","颂赞"],"ap":1},{"id":"57a898e49afa","t":"鱼丽","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鱼丽于罶，鲿鲨。君子有酒，旨且多。","b":1,"y":-700,"th":["宴饮","颂赞","乐歌"],"ap":1},{"id":"6a92a8432d58","t":"采菽","a":"佚名","d":1,"f":"诗经","g":"诗","x":"采菽采菽，筐之莒之。君子来朝，何锡予之？虽无予之？路车乘马。又何予之？玄衮及黼。","b":1,"y":-700,"th":["朝会","颂赞","政治","祝颂"],"ap":1},{"id":"6f7a519c7491","t":"烝民","a":"佚名","d":1,"f":"诗经","g":"诗","x":"天生烝民，有物有则。民之秉彝，好是懿德。天监有周，昭假于下。保兹天子，生仲山甫。","b":0,"y":-700,"th":["颂赞","德行","哲理","送别"],"ap":1},{"id":"cf9b1085ec99","t":"桑扈","a":"佚名","d":1,"f":"诗经","g":"诗","x":"交交桑扈，有莺其羽。君