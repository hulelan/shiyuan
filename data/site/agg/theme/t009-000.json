[{"id":"fda945734a98","t":"东山","a":"佚名","d":1,"f":"诗经","g":"诗","x":"我徂东山，慆慆不归。我来自东，零雨其濛。我东曰归，我心西悲。","b":0,"y":-908,"th":["思乡","战争","归家"],"ap":1},{"id":"5b5b33f16ebe","t":"采薇","a":"佚名","d":1,"f":"诗经","g":"诗","x":"采薇采薇，薇亦作止。曰归曰归，岁亦莫止。靡室靡家，玁狁之故。不遑启居，玁狁之故。","b":0,"y":-850,"th":["思乡","边塞","厌战"],"ap":1},{"id":"96a554a213a0","t":"出车","a":"佚名","d":1,"f":"诗经","g":"诗","x":"我出我车，于彼牧矣。自天子所，谓我来矣。召彼仆夫，谓之载矣。王事多难，维其棘矣。","b":0,"y":-800,"th":["战争","思乡","边塞","爱国"],"ap":1},{"id":"1df8877a5438","t":"匪风","a":"佚名","d":1,"f":"诗经","g":"诗","x":"匪风发兮，匪车偈兮。顾瞻周道，中心怛兮。","b":0,"y":-750,"th":["思乡","伤国","怀古"],"ap":1},{"id":"fe1cef2f04c1","t":"四牡","a":"佚名","d":1,"f":"诗经","g":"诗","x":"四牡騑騑，周道倭迟。岂不怀归？王事靡盬，我心伤悲。","b":0,"y":-700,"th":["思乡","行役","忠孝"],"ap":1},{"id":"729ca3f90c81","t":"小明","a":"佚名","d":1,"f":"诗经","g":"诗","x":"明明上天，照临下土。我征徂西，至于艽野。二月初吉，载离寒暑。","b":0,"y":-700,"th":["思乡","行役","劝诫"],"ap":1},{"id":"3b6f8e96b6cc","t":"扬之水","a":"佚名","d":1,"f":"诗经","g":"诗","x":"扬之水，不流束薪。彼其之子，不与我戍申。怀哉怀哉，曷月予还归哉？","b":0,"y":-700,"th":["思乡","戍边","怀人"],"ap":1},{"id":"17c7a25da5e5","t":"河广","a":"佚名","d":1,"f":"诗经","g":"诗","x":"谁谓河广？一苇杭之。谁谓宋远？跂予望之。","b":0,"y":-700,"th":["思乡"],"ap":1},{"id":"cf87fb2d0dc4","t":"葛藟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"绵绵葛藟，在河之浒。终远兄弟，谓他人父。谓他人父，亦莫我顾！","b":0,"y":-700,"th":["流亡","思乡","世态炎凉"],"ap":1},{"id":"b9d06d59695e","t":"陟岵","a":"佚名","d":1,"f":"诗经","g":"诗","x":"陟彼岵兮，瞻望父兮。父曰：嗟！予子行役，夙夜无已。上慎旃哉，犹来！无止！","b":1,"y":-700,"th":["思乡","行役","亲情"],"ap":1},{"id":"dcef9ba2f40f","t":"黄鸟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"黄鸟黄鸟，无集于穀，无啄我粟。此邦之人，不我肯穀。言旋言归，复我邦族。","b":1,"y":-700,"th":["思乡","流离","怀亲"],"ap":1},{"id":"fef7dec8bc4d","t":"泉水","a":"佚名","d":1,"f":"诗经","g":"诗","x":"毖彼泉水，亦流于淇。有怀于卫，靡日不思。娈彼诸姬，聊与之谋。","b":1,"y":-650,"th":["思乡","思归","闺怨"],"ap":1},{"id":"17172b59b2f7","t":"竹竿","a":"佚名","d":1,"f":"诗经","g":"诗","x":"籊籊竹竿，以钓于淇。岂不尔思？远莫致之。","b":1,"y":-650,"th":["思乡","闺怨","怀古"],"ap":1},{"id":"92d4fea5b7b4","t":"击鼓","a":"佚名","d":1,"f":"诗经","g":"诗","x":"击鼓其镗，踊跃用兵。土国城漕，我独南行。","b":1,"y":-550,"th":["战争","爱情","思乡"],"ap":1},{"id":"22a0f9e9ee4d","t":"论语·公冶长篇 其22","a":"孔子及弟子","d":1,"f":"文","g":"文","x":"子在陈，曰：“归与！归与！吾党之小子狂简，斐然成章，不知所以裁之。”","b":1,"y":-492,"th":["思乡","哲理","教育"],"ap":1},{"id":"6eebf18a975f","t":"横吹曲辞 陇头水","a":"杨师道","d":6,"f":"五古","g":"诗","x":"陇头秋月明，陇水带关城。","b":0,"y":640,"th":["边塞","战争","思乡","壮志"],"ap":1},{"id":"41d4888696fe","t":"相和歌辞 昭君词","a":"张文琮","d":6,"f":"五律","g":"诗","x":"戒途飞万里，回首望三秦。","b":0,"y":650,"th":["思乡","怀古","边塞"],"ap":1},{"id":"fb98169e654f","t":"相和歌辞 王昭君","a":"上官仪","d":6,"f":"五律","g":"诗","x":"玉关春色晚，金河路几千。","b":0,"y":650,"th":["思乡","边塞","咏史"],"ap":1},{"id":"1fcd09a51125","t":"相和歌辞 王昭君","a":"卢照邻","d":6,"f":"五律","g":"诗","x":"合殿恩中绝，交河使渐稀。","b":1,"y":665,"th":["宫怨","边塞","思乡"],"ap":1},{"id":"85cf42e81199","t":"横吹曲辞 梅花落","a":"卢照邻","d":6,"f":"五律","g":"诗","x":"梅岭花初发，天山雪未开。","b":1,"y":670,"th":["边塞","思乡","咏物"],"ap":1},{"id":"4c7a4874dc14","t":"相和歌辞 江南曲八首 四","a":"刘希夷","d":6,"f":"五古","g":"诗","x":"皓如楚江月，霭若吴岫云。","b":1,"y":670,"th":["送别","爱情","思乡"],"ap":1},{"id":"a13b78b033c3","t":"横吹曲辞 关山月","a":"卢照邻","d":6,"f":"五律","g":"诗","x":"塞垣通碣石，虏障抵祈连。","b":1,"y":671,"th":["边塞","思乡","爱情"],"ap":1},{"id":"dede30781241","t":"横吹曲辞 折杨柳","a":"卢照邻","d":6,"f":"五律","g":"诗","x":"倡楼启曙扉，园柳正依依。","b":1,"y":671,"th":["送别","思乡","边塞"],"ap":1},{"id":"08cffc067daa","t":"横吹曲辞 陇头水","a":"卢照邻","d":6,"f":"五律","g":"诗","x":"陇坂高无极，征人一望乡。","b":1,"y":671,"th":["边塞","思乡","忠君"],"ap":1},{"id":"b370b758366f","t":"相和歌辞 江南曲八首 七","a":"刘希夷","d":6,"f":"七律","g":"诗","x":"北堂红草盛丰茸，南湖碧水照芙蓉。","b":1,"y":675,"th":["闺怨","思乡","爱情"],"ap":1},{"id":"757fe9c72c84","t":"相和歌辞 江南曲八首 三","a":"刘希夷","d":6,"f":"五古","g":"诗","x":"君为陇西客，妾遇江南春。","b":1,"y":680,"th":["闺怨","爱情","思乡"],"ap":1},{"id":"8a823f7558f1","t":"相和歌辞 江南曲八首 五","a":"刘希夷","d":6,"f":"五古","g":"诗","x":"舣舟乘潮去，风帆振草凉。","b":1,"y":680,"th":["羁旅","行役","思乡"],"ap":1},{"id":"7a93bab74f88","t":"和晋陵陆丞早春游望","a":"杜审言","d":6,"f":"五律","g":"诗","x":"独有宦游人，偏惊物候新。","b":1,"y":690,"th":["思乡","羁旅","咏物"],"ap":1},{"id":"ea5ad740cd9d","t":"游九龙潭","a":"则天皇后","d":6,"f":"五律","g":"诗","x":"山窗游玉女，涧户对琼峰。","b":1,"y":6