[{"id":"bc3986158b0e","t":"公刘","a":"佚名","d":1,"f":"诗经","g":"诗","x":"笃公刘，匪居匪康。乃埸乃疆，乃积乃仓；乃裹餱粮，于橐于囊。","b":0,"y":-1050,"th":["史诗","开国","咏人"],"ap":1},{"id":"a4e2cb5f8f91","t":"噫嘻","a":"佚名","d":1,"f":"诗经","g":"诗","x":"噫嘻成王，既昭假尔。率时农夫，播厥百谷。骏发尔私，终三十里。亦服尔耕，十千维耦。","b":0,"y":-1050,"th":["农事","颂歌","祭祀"],"ap":1},{"id":"fb0c7b5a8a5f","t":"天作","a":"佚名","d":1,"f":"诗经","g":"诗","x":"天作高山，大王荒之。彼作矣，文王康之。彼徂矣，岐有夷之行。子孙保之。","b":0,"y":-1050,"th":["咏史","颂祖","祭祀"],"ap":1},{"id":"401913f5e551","t":"思文","a":"佚名","d":1,"f":"诗经","g":"诗","x":"思文后稷，克配彼天。立我烝民，莫菲尔极。贻我来牟，帝命率育，无此疆尔界。陈常于时夏。","b":0,"y":-1050,"th":["咏物","怀古","祭祀"],"ap":1},{"id":"b98b4f2e6235","t":"思齐","a":"佚名","d":1,"f":"诗经","g":"诗","x":"思齐大任，文王之母，思媚周姜，京室之妇。大姒嗣徽音，则百斯男。","b":0,"y":-1050,"th":["颂古","咏人","哲理"],"ap":1},{"id":"c7bd5c39d38c","t":"我将","a":"佚名","d":1,"f":"诗经","g":"诗","x":"我将我享，维羊维牛，维天其右之。仪式刑文王之典，日靖四方。","b":0,"y":-1050,"th":["祭祀","敬天法祖","治国"],"ap":1},{"id":"f9899ae6856d","t":"执竞","a":"佚名","d":1,"f":"诗经","g":"诗","x":"执竞武王，无竞维烈。不显成康，上帝是皇。自彼成康，奄有四方，斤斤其明。","b":0,"y":-1050,"th":["祭祀","咏史","颂德"],"ap":1},{"id":"286a573d2d41","t":"文王","a":"佚名","d":1,"f":"诗经","g":"诗","x":"文王在上，于昭于天。周虽旧邦，其命维新。有周不显，帝命不时。文王陟降，在帝左右。","b":0,"y":-1050,"th":["颂歌","咏史","哲理"],"ap":1},{"id":"a7351cc8141b","t":"文王有声","a":"佚名","d":1,"f":"诗经","g":"诗","x":"文王有声，遹骏有声。遹求厥宁，遹观厥成。文王烝哉！","b":0,"y":-1050,"th":["咏史","颂赞","家国"],"ap":1},{"id":"42746c53943d","t":"有瞽","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有瞽有瞽，在周之庭。设业设虡，崇牙树羽。应田县鼓，鞉磬柷圉。既备","b":0,"y":-1050,"th":["祭祀","礼乐","颂歌"],"ap":1},{"id":"445be98712f9","t":"清庙","a":"佚名","d":1,"f":"诗经","g":"诗","x":"于穆清庙，肃雍显相。济济多士，秉文之德。对越在天，骏奔走在庙。不显不承，无射于人斯。","b":0,"y":-1050,"th":["祭祀","颂德","宗庙"],"ap":1},{"id":"59c9880e8892","t":"灵台","a":"佚名","d":1,"f":"诗经","g":"诗","x":"经始灵台，经之营之。庶民攻之，不日成之。经始勿亟，庶民子来。","b":0,"y":-1050,"th":["颂德","田园","咏物"],"ap":1},{"id":"9bf2cc165731","t":"甘棠","a":"佚名","d":1,"f":"诗经","g":"诗","x":"蔽芾甘棠，勿翦勿伐，召伯所茇。","b":0,"y":-1050,"th":["怀古","咏物"],"ap":1},{"id":"78c759ab3d67","t":"维天之命","a":"佚名","d":1,"f":"诗经","g":"诗","x":"维天之命，于穆不已。于乎不显，文王之德之纯。假以溢我，我其收之。骏惠我文王，曾孙笃之。","b":0,"y":-1050,"th":["祭祀","颂德","天命"],"ap":1},{"id":"350284adda79","t":"维清","a":"佚名","d":1,"f":"诗经","g":"诗","x":"维清缉熙，文王之典。肇禋，迄用有成，维周之祯。","b":0,"y":-1050,"th":["祭祀","颂德","怀古"],"ap":1},{"id":"824cee8e2ba3","t":"谷风","a":"佚名","d":1,"f":"诗经","g":"诗","x":"习习谷风，以阴以雨。黾勉同心，不宜有怒。采葑采菲，无以下体？德音莫违，及尔同死。","b":0,"y":-1050,"th":["弃妇","婚姻","怨情","对比"],"ap":1},{"id":"1c75e52d670f","t":"雝","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有来雝雝，至止肃肃。相维辟公，天子穆穆。于荐广牡，相予四祀。假哉皇考！绥予孝子。","b":0,"y":-1050,"th":["祭祀","颂祖","礼乐"],"ap":1},{"id":"9073dbc03030","t":"鸱鸮","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鸱鸮鸱鸮，既取我子，无毁我室。恩斯勤斯，鬻子之闵斯。","b":0,"y":-1050,"th":["咏物","忧患","比兴"],"ap":1},{"id":"d69af022774f","t":"下武","a":"佚名","d":1,"f":"诗经","g":"诗","x":"下武维周，世有哲王。三后在天，王配于京。","b":0,"y":-1046,"th":["颂美","咏史","哲理"],"ap":1},{"id":"0c233e5837a3","t":"大明","a":"佚名","d":1,"f":"诗经","g":"诗","x":"明明在下，赫赫在上。天难忱斯，不易维王。天位殷适，使不挟四方。","b":0,"y":-1046,"th":["咏史","天命","战争","颂德"],"ap":1},{"id":"bb978f1e6e19","t":"时迈","a":"佚名","d":1,"f":"诗经","g":"诗","x":"时迈其邦，昊天其子之，实右序有周。薄言震之，莫不震叠。怀柔百神，及河乔岳，允王维后。","b":0,"y":-1046,"th":["祭祀","咏史","治国"],"ap":1},{"id":"5b1f97faba9a","t":"桓","a":"佚名","d":1,"f":"诗经","g":"诗","x":"绥万邦，屡丰年。天命匪解，桓桓武王。保有厥士，于以四方，克定厥家。于昭于天，皇以间之。","b":0,"y":-1046,"th":["颂赞","怀古","军旅"],"ap":1},{"id":"3469cf1b3e66","t":"武","a":"佚名","d":1,"f":"诗经","g":"诗","x":"于皇武王！无竞维烈。允文文王，克开厥后。嗣武受之，胜殷遏刘，耆定尔功。","b":0,"y":-1046,"th":["咏史","颂功","祭祀"],"ap":1},{"id":"c77619529c42","t":"赉","a":"佚名","d":1,"f":"诗经","g":"诗","x":"文王既勤止，我应受之。敷时绎思，我徂维求定。时周之命，于绎思。","b":0,"y":-1046,"th":["祭祀","颂歌","怀古"],"ap":1},{"id":"f0bf8a635be0","t":"小毖","a":"佚名","d":1,"f":"诗经","g":"诗","x":"予其惩，而毖后患。莫予荓蜂，自求辛螫。肇允彼桃虫，拚飞维鸟。未堪家多难，予又集于蓼。","b":0,"y":-1042,"th":["政治咏怀","哲理","自省"],"ap":1},{"id":"052e69baaeb5","t":"破斧","a":"佚名","d":1,"f":"诗经","g":"诗","x":"既破我斧，又缺我斨。周公东征，四国是皇。哀我人斯，亦孔之将。","b":0,"y":-1042,"th":["战争","咏史","悲叹"],"ap":1},{"id":"9e65cab984a0","t":"访落","a":"佚名","d":1,"f":"诗经","g":"诗","x":"访予落止，率时昭考。于乎悠哉，朕未有艾。将予就之，继犹判涣。","b":0,"y":-1042,"th":["咏史","政治","祭祀"],"ap":1},{"id":"741c54e81584","t":"闵予小子","a":"佚名","d":1,"f":"诗经","g":"诗","x":"闵予小子，遭家不造，嬛嬛在疚。于乎皇考，永世克孝。","b":0,"y":-1040,"th":["悼亡","咏史","颂德"],"ap":1},{"id":"b24a61578d79","t":"卷阿","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有卷者阿，飘风自南。岂弟君子，来游来歌，以矢其音。","b":0,"y":-1032,"th":["颂德","咏物","宴饮"],"ap":1},{"id":"262be2052fe7","t":"昊天有成命","a":"佚名","d":1,"f":"诗经","g":"诗","x":"昊天有成命，二后受之。成王不敢康，夙夜基命宥密。于缉熙！单厥心，四其靖之。","b":0,"y":-1022,"th":["颂歌","咏史","祭祀"],"ap":1},{"id":"865da1a7e103","t":"车攻","a":"佚名","d":1,"f":"诗经","g":"诗","x":"我车既攻，我马既同。四牡庞庞，驾言徂东。","b":0,"y":-950,"th":["田猎","颂歌","军威"],"ap":1},{"id":"fda945734a98","t":"东山","a":"佚名","d":1,"f":"诗经","g":"诗","x":"我徂东山，慆慆不归。我来自东，零雨其濛。我东曰归，我心西悲。","b":0,"y":-908,"th":["思乡","战争","归家"],"ap":1},{"id":"c0708d754559","t":"丝衣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"丝衣其紑，载弁俅俅。自堂徂基，自羊徂牛，鼐鼎及鼒，兕觥其觩。旨酒思柔。不吴不敖，胡考之休。","b":0,"y":-908,"th":["祭祀","颂歌","祈福"],"ap":1},{"id":"f6e0757d7a39","t":"伐柯","a":"佚名","d":1,"f":"诗经","g":"诗","x":"伐柯如何？匪斧不克。取妻如何？匪媒不得。","b":0,"y":-908,"th":["婚姻","哲理"],"ap":1},{"id":"1880fd93de30","t":"何草不黄","a":"佚名","d":1,"f":"诗经","g":"诗","x":"何草不黄？何日不行？何人不将？经营四方。","b":0,"y":-908,"th":["征役","哀怨","民生疾苦"],"ap":1},{"id":"7c1da9f91fce","t":"信南山","a":"佚名","d":1,"f":"诗经","g":"诗","x":"信彼南山，维禹甸之。畇畇原隰，曾孙田之。我疆我理，南东其亩。","b":0,"y":-908,"th":["农事","祭祀","颂祖"],"ap":1},{"id":"bccd51e0850a","t":"假乐","a":"佚名","d":1,"f":"诗经","g":"诗","x":"假乐君子，显显令德，宜民宜人。受禄于天，保右命之，自天申之。","b":0,"y":-908,"th":["颂赞","德政","天命"],"ap":1},{"id":"529aadffb57b","t":"敬之","a":"佚名","d":1,"f":"诗经","g":"诗","x":"敬之敬之，天维显思，命不易哉。无曰高高在上，陟降厥士，日监在兹。","b":0,"y":-908,"th":["哲理","咏志","敬天"],"ap":1},{"id":"4c6c56271264","t":"斯干","a":"佚名","d":1,"f":"诗经","g":"诗","x":"秩秩斯干，幽幽南山。如竹苞矣，如松茂矣。兄及弟矣，式相好矣，无相犹矣。","b":0,"y":-908,"th":["宴饮","咏物","祈福"],"ap":1},{"id":"23df10bba2e9","t":"瞻彼洛矣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"瞻彼洛矣，维水泱泱。君子至止，福禄如茨。韎韐有奭，以作六师。","b":0,"y":-908,"th":["颂赞","军事","家国"],"ap":1},{"id":"9cdbe00ccda7","t":"般","a":"佚名","d":1,"f":"诗经","g":"诗","x":"于皇时周！陟其高山，嶞山乔岳，允犹翕河。敷天之下，裒时之对。时周之命。","b":0,"y":-908,"th":["咏史","祭祀","家国"],"ap":1},{"id":"66818a17e489","t":"荡","a":"佚名","d":1,"f":"诗经","g":"诗","x":"荡荡上帝，下民之辟。疾威上帝，其命多辟。","b":0,"y":-908,"th":["咏史","怀古","哲理"],"ap":1},{"id":"53c120efc59e","t":"载见","a":"佚名","d":1,"f":"诗经","g":"诗","x":"载见辟王，曰求厥章。龙旂阳阳，和铃央央。鞗革有鸧，休有烈光。率见昭考，以孝以享。","b":0,"y":-908,"th":["祭祀","朝会","礼乐"],"ap":1},{"id":"fc9e79b534ae","t":"鱼藻","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鱼在在藻，有颁其首。王在在镐，岂乐饮酒。","b":0,"y":-908,"th":["颂赞","宴饮","太平"],"ap":1},{"id":"348b7975abb5","t":"大东","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有饛簋飧，有捄棘匕。周道如砥，其直如矢。君子所履，小人所视。眷言顾之，潸焉出涕。","b":0,"y":-850,"th":["怨刺","民生","讽喻"],"ap":1},{"id":"aa860bc62b54","t":"民劳","a":"佚名","d":1,"f":"诗经","g":"诗","x":"民亦劳止，汔可小康。惠此中国，以绥四方。无纵诡随，以谨无良。","b":0,"y":-850,"th":["忧国忧民","政治讽喻","劝谏"],"ap":1},{"id":"5b5b33f16ebe","t":"采薇","a":"佚名","d":1,"f":"诗经","g":"诗","x":"采薇采薇，薇亦作止。曰归曰归，岁亦莫止。靡室靡家，玁狁之故。不遑启居，玁狁之故。","b":0,"y":-850,"th":["思乡","边塞","厌战"],"ap":1},{"id":"479166f7eb7a","t":"楚茨","a":"佚名","d":1,"f":"诗经","g":"诗","x":"楚楚者茨，言抽其棘，自昔何为？我蓺黍稷。我黍与与，我稷翼翼。","b":0,"y":-836,"th":["祭祀","宗族","祈福"],"ap":1},{"id":"03280f3e5120","t":"六月","a":"佚名","d":1,"f":"诗经","g":"诗","x":"六月栖栖，戎车既饬。四牡骙骙，载是常服。玁狁孔炽，我是用急。王于出征，以匡王国。","b":0,"y":-823,"th":["边塞","战争","颂功","宴饮"],"ap":1},{"id":"01dfda4aec15","t":"羔羊","a":"佚名","d":1,"f":"诗经","g":"诗","x":"羔羊之皮，素丝五紽。退食自公，委蛇委蛇。","b":0,"y":-823,"th":["咏物","政治","哲理"],"ap":1},{"id":"0d5e4d6d7a15","t":"江汉","a":"佚名","d":1,"f":"诗经","g":"诗","x":"江汉浮浮，武夫滔滔。匪安匪游，淮夷来求。既出我车，既设我旟。匪安匪舒，淮夷来铺。","b":0,"y":-820,"th":["战争","颂功","咏史"],"ap":1},{"id":"96a554a213a0","t":"出车","a":"佚名","d":1,"f":"诗经","g":"诗","x":"我出我车，于彼牧矣。自天子所，谓我来矣。召彼仆夫，谓之载矣。王事多难，维其棘矣。","b":0,"y":-800,"th":["战争","思乡","边塞","爱国"],"ap":1},{"id":"be5438d7322d","t":"小宛","a":"佚名","d":1,"f":"诗经","g":"诗","x":"宛彼鸣鸠，翰飞戾天。我心忧伤，念昔先人。明发不寐，有怀二人。","b":0,"y":-800,"th":["怀古","教子","忧患","哲理"],"ap":1},{"id":"e9de788a774e","t":"崧高","a":"佚名","d":1,"f":"诗经","g":"诗","x":"崧高维岳，骏极于天。维岳降神，生甫及申。维申及甫，维周之翰。四国于蕃。四方于宣。","b":0,"y":-800,"th":["送别","颂赞","家国"],"ap":1},{"id":"a8bb995f5c71","t":"巷伯","a":"佚名","d":1,"f":"诗经","g":"诗","x":"萋兮斐兮，成是贝锦。彼谮人者，亦已大甚！","b":0,"y":-800,"th":["政治讽喻","疾恶如仇","抒愤"],"ap":1},{"id":"71a776b5f918","t":"常武","a":"佚名","d":1,"f":"诗经","g":"诗","x":"赫赫明明。王命卿士，南仲大祖，大师皇父。整我六师，以修我戎。既敬既戒，惠此南国。","b":0,"y":-800,"th":["战争","颂歌","军旅","怀古"],"ap":1},{"id":"800230804ed7","t":"板","a":"佚名","d":1,"f":"诗经","g":"诗","x":"上帝板板，下民卒瘅。出话不然，为犹不远。","b":0,"y":-800,"th":["政治讽刺","忧国忧民","咏史怀古"],"ap":1},{"id":"274e2c5e8884","t":"采芑","a":"佚名","d":1,"f":"诗经","g":"诗","x":"薄言采芑，于彼新田，呈此菑亩。方叔涖止，其车三千。师干之试，方叔率止。","b":0,"y":-800,"th":["战争","颂赞","边塞"],"ap":1},{"id":"fd04af5cee6f","t":"黍苗","a":"佚名","d":1,"f":"诗经","g":"诗","x":"芃芃黍苗，阴雨膏之。悠悠南行，召伯劳之。","b":0,"y":-800,"th":["颂功","劳役","思归"],"ap":1},{"id":"6edf7e62e45d","t":"十月之交","a":"佚名","d":1,"f":"诗经","g":"诗","x":"十月之交，朔月辛卯。日有食之，亦孔之丑。彼月而微，此日而微；今此下民，亦孔之哀。","b":0,"y":-776,"th":["政治讽刺","天灾人祸","忧国忧民","批判权臣"],"ap":1},{"id":"d6e1ac2908ec","t":"瞻卬","a":"佚名","d":1,"f":"诗经","g":"诗","x":"瞻卬昊天，则不我惠。孔填不宁，降此大厉。邦靡有定，士民其瘵。","b":0,"y":-776,"th":["政治讽喻","忧国忧民","咏史怀古"],"ap":1},{"id":"2ac77723beba","t":"雨无正","a":"佚名","d":1,"f":"诗经","g":"诗","x":"浩浩昊天，不骏其德。降丧饥馑，斩伐四国。旻天疾威，弗虑弗图。舍彼有罪，既伏其辜。若此无罪，沦胥以铺。","b":0,"y":-776,"th":["时政","伤时","怨刺"],"ap":1},{"id":"5f16bb42f2a9","t":"凫鹥","a":"佚名","d":1,"f":"诗经","g":"诗","x":"凫鹥在泾，公尸在燕来宁。尔酒既清，尔肴既馨。公尸燕饮，福禄来成。","b":0,"y":-771,"th":["祭祀","宴饮","祈福","颂歌"],"ap":1},{"id":"290e3a99c65e","t":"大田","a":"佚名","d":1,"f":"诗经","g":"诗","x":"大田多稼，既种既戒，既备乃事。以我覃耜，俶载南亩。","b":0,"y":-771,"th":["田园","农事","祭祀"],"ap":1},{"id":"93974184a46d","t":"天保","a":"佚名","d":1,"f":"诗经","g":"诗","x":"天保定尔，亦孔之固。俾尔单厚，何福不除？俾尔多益，以莫不庶。","b":0,"y":-771,"th":["祝颂","祭祀","宴饮"],"ap":1},{"id":"ccd5345b461e","t":"小弁","a":"佚名","d":1,"f":"诗经","g":"诗","x":"弁彼鸴斯，归飞提提。民莫不穀，我独于罹。何辜于天？我罪伊何？心之忧矣，云如之何？","b":0,"y":-771,"th":["弃子之怨","政治讽喻","亲情疏离"],"ap":1},{"id":"4d276f2ca195","t":"既醉","a":"佚名","d":1,"f":"诗经","g":"诗","x":"既醉以酒，既饱以德。君子万年，介尔景福。","b":0,"y":-771,"th":["祭祀","宴饮","祝颂","祈福"],"ap":1},{"id":"b9b5bb5b76b7","t":"旱麓","a":"佚名","d":1,"f":"诗经","g":"诗","x":"瞻彼旱麓，榛楛济济。岂弟君子，干禄岂弟。","b":0,"y":-771,"th":["祭祀","颂德","咏物","哲理"],"ap":1},{"id":"636114faec6f","t":"泂酌","a":"佚名","d":1,"f":"诗经","g":"诗","x":"泂酌彼行潦，挹彼注兹，可以餴饎。岂弟君子，民之父母。","b":0,"y":-771,"th":["颂赞","民本","哲理"],"ap":1},{"id":"d710a1e702d0","t":"白驹","a":"佚名","d":1,"f":"诗经","g":"诗","x":"皎皎白驹，食我场苗。絷之维之，以永今朝。所谓伊人，于焉逍遥？","b":0,"y":-771,"th":["思贤","送别","劝勉"],"ap":1},{"id":"6b6c68bdbae3","t":"良耜","a":"佚名","d":1,"f":"诗经","g":"诗","x":"畟畟良耜，俶载南亩。播厥百谷，实函斯活。或来瞻女，载筐及莒，其饟伊黍。","b":0,"y":-771,"th":["农事","祭祀","丰收"],"ap":1},{"id":"214da9858e2f","t":"鹿鸣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"呦呦鹿鸣，食野之苹。我有嘉宾，鼓瑟吹笙。吹笙鼓簧，承筐是将。人之好我，示我周行。","b":0,"y":-771,"th":["宴饮","礼乐","求贤"],"ap":1},{"id":"aac59adf28c6","t":"都人士","a":"佚名","d":1,"f":"诗经","g":"诗","x":"彼都人士，狐裘黄黄。其容不改，出言有章。行归于周，万民所望。","b":0,"y":-770,"th":["怀古","故国之思","伤时"],"ap":1},{"id":"94fda7635e5c","t":"草虫","a":"佚名","d":1,"f":"诗经","g":"诗","x":"喓喓草虫，趯趯阜螽。未见君子，忧心忡忡。亦既见止，亦既觏止，我心则降。","b":0,"y":-761,"th":["爱情","思妇","怀人"],"ap":1},{"id":"57dfc273e957","t":"何彼襛矣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"何彼襛矣，唐棣之华？曷不肃雍？王姬之车。","b":0,"y":-750,"th":["婚恋","咏物","贵族"],"ap":1},{"id":"aec36ff73546","t":"关雎","a":"佚名","d":1,"f":"诗经","g":"诗","x":"关关雎鸠，在河之洲。窈窕淑女，君子好逑。","b":0,"y":-750,"th":["爱情","婚恋"],"ap":1},{"id":"2927cb434b84","t":"匏有苦叶","a":"佚名","d":1,"f":"诗经","g":"诗","x":"匏有苦叶，济有深涉。深则厉，浅则揭。","b":0,"y":-750,"th":["爱情","期盼"],"ap":1},{"id":"1df8877a5438","t":"匪风","a":"佚名","d":1,"f":"诗经","g":"诗","x":"匪风发兮，匪车偈兮。顾瞻周道，中心怛兮。","b":0,"y":-750,"th":["思乡","伤国","怀古"],"ap":1},{"id":"a7576cb8dcf0","t":"召旻","a":"佚名","d":1,"f":"诗经","g":"诗","x":"旻天疾威，天笃降丧。瘨我饥馑，民卒流亡。我居圉卒荒。","b":0,"y":-750,"th":["忧国","怀古","讽谏"],"ap":1},{"id":"5f470a35867f","t":"小旻","a":"佚名","d":1,"f":"诗经","g":"诗","x":"旻天疾威，敷于下土。谋犹回遹，何日斯沮？谋臧不从，不臧覆用。我视谋犹，亦孔之邛。","b":0,"y":-750,"th":["政治讽喻","忧国忧民","哲理"],"ap":1},{"id":"1089c516e468","t":"山有扶苏","a":"佚名","d":1,"f":"诗经","g":"诗","x":"山有扶苏，隰有荷华。不见子都，乃见狂且。","b":0,"y":-750,"th":["爱情","娇嗔","民歌"],"ap":1},{"id":"f448546f6df6","t":"扬之水","a":"佚名","d":1,"f":"诗经","g":"诗","x":"扬之水，不流束楚。终鲜兄弟，维予与女。无信人之言，人实诳女。","b":0,"y":-750,"th":["亲情","劝诫","乱世"],"ap":1},{"id":"6b1bc0f2e970","t":"无羊","a":"佚名","d":1,"f":"诗经","g":"诗","x":"谁谓尔无羊？三百维群。谁谓尔无牛？九十其犉。尔羊来思，其角濈濈。尔牛来思，其耳湿湿。","b":0,"y":-750,"th":["田园","咏物","劳作"],"ap":1},{"id":"29c5c29eb7dd","t":"白华","a":"佚名","d":1,"f":"诗经","g":"诗","x":"白华菅兮，白茅束兮。之子之远，俾我独兮。","b":0,"y":-750,"th":["弃妇","宫怨","爱情","政治讽喻"],"ap":1},{"id":"7104bfb7f221","t":"硕人","a":"佚名","d":1,"f":"诗经","g":"诗","x":"硕人其颀，衣锦褧衣。齐侯之子，卫侯之妻。东宫之妹，邢侯之姨，谭公维私。","b":0,"y":-750,"th":["咏人","婚姻","贵族"],"ap":1},{"id":"f63924c313c2","t":"素冠","a":"佚名","d":1,"f":"诗经","g":"诗","x":"庶见素冠兮，棘人栾栾兮。劳心慱慱兮。","b":0,"y":-750,"th":["悼亡","丧礼","情义"],"ap":1},{"id":"31f9ed2c0c10","t":"缁衣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"缁衣之宜兮，敝予又改为兮。适子之馆兮。还予授子之粲兮。","b":0,"y":-750,"th":["家庭","爱情","咏物"],"ap":1},{"id":"a71652270044","t":"节南山","a":"佚名","d":1,"f":"诗经","g":"诗","x":"节彼南山，维石岩岩。赫赫师尹，民具尔瞻。忧心如惔，不敢戏谈。国既卒斩，何用不监！","b":0,"y":-750,"th":["政治讽刺","忧国忧民","咏史"],"ap":1},{"id":"c5c56c5c5e32","t":"载芟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"载芟载柞，其耕泽泽。千耦其耘，徂隰徂畛。侯主侯伯，侯亚侯旅，侯彊侯以。","b":0,"y":-750,"th":["农事","祭祀","颂歌"],"ap":1},{"id":"fb883494b4f4","t":"黍离","a":"佚名","d":1,"f":"诗经","g":"诗","x":"彼黍离离，彼稷之苗。行迈靡靡，中心摇摇。知我者，谓我心忧；不知我者，谓我何求。悠悠苍天，此何人哉？","b":0,"y":-750,"th":["怀古","咏史","家国"],"ap":1},{"id":"744083df86ee","t":"扬之水","a":"佚名","d":1,"f":"诗经","g":"诗","x":"扬之水，白石凿凿。素衣朱襮，从子于沃。既见君子，云何不乐？","b":0,"y":-745,"th":["政治","纪事","咏怀"],"ap":1},{"id":"cf25f99cc376","t":"新台","a":"佚名","d":1,"f":"诗经","g":"诗","x":"新台有泚，河水瀰瀰。燕婉之求，蘧篨不鲜。","b":0,"y":-718,"th":["讽刺","婚姻","怨愤"],"ap":1},{"id":"f13e8054490e","t":"东方之日","a":"佚名","d":1,"f":"诗经","g":"诗","x":"东方之日兮，彼姝者子，在我室兮。在我室兮，履我即兮。","b":0,"y":-700,"th":["爱情","民歌"],"ap":1},{"id":"a2b2a4f2e7a1","t":"东方未明","a":"佚名","d":1,"f":"诗经","g":"诗","x":"东方未明，颠倒衣裳。颠之倒之，自公召之。","b":0,"y":-700,"th":["徭役","批判","疾苦"],"ap":1},{"id":"0719cb676a9d","t":"东门之枌","a":"佚名","d":1,"f":"诗经","g":"诗","x":"东门之枌，宛丘之栩。子仲之子，婆娑其下。","b":0,"y":-700,"th":["爱情","民俗"],"ap":1},{"id":"ee50dc6fe53b","t":"中谷有蓷","a":"佚名","d":1,"f":"诗经","g":"诗","x":"中谷有蓷，暵其干矣。有女仳离，慨其叹矣。慨其叹矣，遇人之艰难矣。","b":0,"y":-700,"th":["爱情","咏怀"],"ap":1},{"id":"2ad5cefed45b","t":"丰","a":"佚名","d":1,"f":"诗经","g":"诗","x":"子之丰兮，俟我乎巷兮，悔予不送兮。","b":0,"y":-700,"th":["爱情","悔恨","婚姻"],"ap":1},{"id":"60c4f34ff75e","t":"丰年","a":"佚名","d":1,"f":"诗经","g":"诗","x":"丰年多黍多稌，亦有高廪，万亿及秭。为酒为醴，烝畀祖妣。以洽百礼，降福孔皆。","b":0,"y":-700,"th":["农事","祭祀","颂歌"],"ap":1},{"id":"d0d1ffe1f679","t":"九罭","a":"佚名","d":1,"f":"诗经","g":"诗","x":"九罭之鱼，鳟鲂。我觏之子，衮衣绣裳。","b":0,"y":-700,"th":["送别","挽留","咏物"],"ap":1},{"id":"539d61b33ac4","t":"二子乘舟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"二子乘舟，泛泛其景。愿言思子，中心养养！","b":0,"y":-700,"th":["送别","忧虑","怀人"],"ap":1},{"id":"0db2efd4c52f","t":"伐木","a":"佚名","d":1,"f":"诗经","g":"诗","x":"伐木丁丁，鸟鸣嘤嘤。出自幽谷，迁于乔木。嘤其鸣矣，求其友声。","b":0,"y":-700,"th":["宴饮","友情","哲理"],"ap":1},{"id":"f3c18d99ecae","t":"何人斯","a":"佚名","d":1,"f":"诗经","g":"诗","x":"彼何人斯？其心孔艰。胡逝我梁，不入我门？伊谁云从？维暴之云。","b":0,"y":-700,"th":["怨刺","绝交","友情"],"ap":1},{"id":"d0b85d86582b","t":"兔罝","a":"佚名","d":1,"f":"诗经","g":"诗","x":"肃肃兔罝，椓之丁丁。赳赳武夫，公侯干城。","b":0,"y":-700,"th":["尚武","赞颂","狩猎"],"ap":1},{"id":"1b55816d777a","t":"凯风","a":"佚名","d":1,"f":"诗经","g":"诗","x":"凯风自南，吹彼棘心。棘心夭夭，母氏劬劳。","b":0,"y":-700,"th":["孝道","感恩","自责"],"ap":1},{"id":"fb00f627b20f","t":"出其东门","a":"佚名","d":1,"f":"诗经","g":"诗","x":"出其东门，有女如云。虽则如云。匪我思存。缟衣綦巾，聊乐我员。","b":0,"y":-700,"th":["爱情","专一","咏人"],"ap":1},{"id":"c719391dc722","t":"北山","a":"佚名","d":1,"f":"诗经","g":"诗","x":"陟彼北山，言采其杞。偕偕士子，朝夕从事。王事靡盬，忧我父母。","b":0,"y":-700,"th":["怨刺","劳役","不公"],"ap":1},{"id":"ebaf6cf527cb","t":"北风","a":"佚名","d":1,"f":"诗经","g":"诗","x":"北风其凉，雨雪其雱。惠而好我，携手同行。其虚其邪？既亟只且！","b":0,"y":-700,"th":["政治怨刺","逃亡避祸","友谊"],"ap":1},{"id":"a3964f6dc9d4","t":"南山有台","a":"佚名","d":1,"f":"诗经","g":"诗","x":"南山有台，北山有莱。乐只君子，邦家之基。乐只君子，万寿无期。","b":0,"y":-700,"th":["颂德","祝寿","宴饮"],"ap":1},{"id":"7a1916fe30d7","t":"南有嘉鱼","a":"佚名","d":1,"f":"诗经","g":"诗","x":"南有嘉鱼，烝然罩罩。君子有酒，嘉宾式燕以乐。","b":0,"y":-700,"th":["宴饮","贵族","颂德"],"ap":1},{"id":"058b1c16e757","t":"卢令","a":"佚名","d":1,"f":"诗经","g":"诗","x":"卢令令，其人美且仁。","b":0,"y":-700,"th":["咏物","赞美","田猎"],"ap":1},{"id":"56f8e3c9e32f","t":"卷耳","a":"佚名","d":1,"f":"诗经","g":"诗","x":"采采卷耳，不盈顷筐。嗟我怀人，置彼周行。","b":0,"y":-700,"th":["爱情","思妇","征役"],"ap":1},{"id":"4e87892d0e20","t":"叔于田","a":"佚名","d":1,"f":"诗经","g":"诗","x":"叔于田，巷无居人。岂无居人？不如叔也。洵美且仁。","b":0,"y":-700,"th":["爱情","思慕"],"ap":1},{"id":"287290565ef0","t":"吉日","a":"佚名","d":1,"f":"诗经","g":"诗","x":"吉日维戊，既伯既祷。田车既好，四牡孔阜。升彼大阜，从其群丑。","b":0,"y":-700,"th":["田猎","宴饮","颂赞"],"ap":1},{"id":"e2a86f29696a","t":"君子于役","a":"佚名","d":1,"f":"诗经","g":"诗","x":"君子于役，不知其期。曷至哉？鸡栖于埘。日之夕矣，羊牛下来。君子于役，如之何勿思！","b":0,"y":-700,"th":["思妇","战争","田园"],"ap":1},{"id":"4c4bc11dcc4e","t":"君子阳阳","a":"佚名","d":1,"f":"诗经","g":"诗","x":"君子阳阳，左执簧，右招我由房，其乐只且！","b":0,"y":-700,"th":["燕乐","欢舞","友谊"],"ap":1},{"id":"fee982b24535","t":"四月","a":"佚名","d":1,"f":"诗经","g":"诗","x":"四月维夏，六月徂署。先祖匪人，胡宁忍予？","b":0,"y":-700,"th":["乱离之苦","仕途之怨","告哀"],"ap":1},{"id":"fe1cef2f04c1","t":"四牡","a":"佚名","d":1,"f":"诗经","g":"诗","x":"四牡騑騑，周道倭迟。岂不怀归？王事靡盬，我心伤悲。","b":0,"y":-700,"th":["思乡","行役","忠孝"],"ap":1},{"id":"244dda264797","t":"墓门","a":"佚名","d":1,"f":"诗经","g":"诗","x":"墓门有棘，斧以斯之。夫也不良，国人知之。知而不已，谁昔然矣。","b":0,"y":-700,"th":["讽谏","忧国","疾恶"],"ap":1},{"id":"e318e8fa0f9b","t":"大车","a":"佚名","d":1,"f":"诗经","g":"诗","x":"大车槛槛，毳衣如菼。岂不尔思？畏子不敢。","b":0,"y":-700,"th":["爱情","誓言"],"ap":1},{"id":"9b984f08a212","t":"宛丘","a":"佚名","d":1,"f":"诗经","g":"诗","x":"子之汤兮，宛丘之上兮。洵有情兮，而无望兮。","b":0,"y":-700,"th":["爱情","民俗","歌舞"],"ap":1},{"id":"130aa4d8e99c","t":"宾之初筵","a":"佚名","d":1,"f":"诗经","g":"诗","x":"宾之初筵，左右秩秩。笾豆有楚，殽核维旅。酒既和旨，饮酒孔偕。","b":0,"y":-700,"th":["宴饮","讽刺","礼仪","劝诫"],"ap":1},{"id":"729ca3f90c81","t":"小明","a":"佚名","d":1,"f":"诗经","g":"诗","x":"明明上天，照临下土。我征徂西，至于艽野。二月初吉，载离寒暑。","b":0,"y":-700,"th":["思乡","行役","劝诫"],"ap":1},{"id":"3a7e8a50139f","t":"小星","a":"佚名","d":1,"f":"诗经","g":"诗","x":"嘒彼小星，三五在东。肃肃宵征，夙夜在公。寔命不同！","b":0,"y":-700,"th":["劳役","咏物","叹命"],"ap":1},{"id":"bac75d7e4008","t":"山有枢","a":"佚名","d":1,"f":"诗经","g":"诗","x":"山有枢，隰有榆。子有衣裳，弗曳弗娄。子有车马，弗驰弗驱。宛其死矣，他人是愉。","b":0,"y":-700,"th":["讽刺","哲理","及时行乐"],"ap":1},{"id":"b2a49ab494c4","t":"巧言","a":"佚名","d":1,"f":"诗经","g":"诗","x":"悠悠昊天，曰父母且。无罪无辜，乱如此幠。昊天已威，予慎无罪。昊天大幠，予慎无辜。","b":0,"y":-700,"th":["政治讽喻","忧国忧民","刺谗"],"ap":1},{"id":"7d57b08784f7","t":"庭燎","a":"佚名","d":1,"f":"诗经","g":"诗","x":"夜如何其？夜未央，庭燎之光。君子至止，鸾声将将。","b":0,"y":-700,"th":["朝会","勤政","宫廷"],"ap":1},{"id":"96bc9355fda3","t":"彤弓","a":"佚名","d":1,"f":"诗经","g":"诗","x":"彤弓弨兮，受言藏之。我有嘉宾，中心贶之。钟鼓既设，一朝飨之。","b":0,"y":-700,"th":["宴饮","赏赐","礼乐"],"ap":1},{"id":"e6e83b8cc14a","t":"我行其野","a":"佚名","d":1,"f":"诗经","g":"诗","x":"我行其野，蔽芾其樗。婚姻之故，言就尔居。尔不我畜，复我邦家。","b":0,"y":-700,"th":["弃妇","怨情","婚姻"],"ap":1},{"id":"3b6f8e96b6cc","t":"扬之水","a":"佚名","d":1,"f":"诗经","g":"诗","x":"扬之水，不流束薪。彼其之子，不与我戍申。怀哉怀哉，曷月予还归哉？","b":0,"y":-700,"th":["思乡","戍边","怀人"],"ap":1},{"id":"13ed7843cdeb","t":"振鹭","a":"佚名","d":1,"f":"诗经","g":"诗","x":"振鹭于飞，于彼西雍。我客戾止，亦有斯容。在彼无恶，在此无斁。庶几夙夜，以永终誉。","b":0,"y":-700,"th":["宴飨","咏物","颂赞"],"ap":1},{"id":"39a10fc2b714","t":"摽有梅","a":"佚名","d":1,"f":"诗经","g":"诗","x":"摽有梅，其实七兮。求我庶士，迨其吉兮。","b":0,"y":-700,"th":["爱情","婚恋","惜时"],"ap":1},{"id":"741aae5de011","t":"旄丘","a":"佚名","d":1,"f":"诗经","g":"诗","x":"旄丘之葛兮，何诞之节兮。叔兮伯兮，何多日也？","b":0,"y":-700,"th":["流亡","怨刺","家国"],"ap":1},{"id":"92f37185a5d3","t":"无将大车","a":"佚名","d":1,"f":"诗经","g":"诗","x":"无将大车，祇自尘兮。无思百忧，祇自疧兮。","b":0,"y":-700,"th":["哲理","抒怀"],"ap":1},{"id":"2c040c6ce664","t":"无衣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"岂曰无衣七兮？不如子之衣，安且吉兮！","b":0,"y":-700,"th":["感恩","咏物","政治"],"ap":1},{"id":"e3ba8e24627e","t":"无衣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"岂曰无衣？与子同袍。王于兴师，修我戈矛。与子同仇！","b":0,"y":-700,"th":["边塞","爱国","战歌"],"ap":1},{"id":"f8a050cc7294","t":"日月","a":"佚名","d":1,"f":"诗经","g":"诗","x":"日居月诸，照临下土。乃如之人兮，逝不古处？胡能有定？宁不我顾。","b":0,"y":-700,"th":["弃妇","怨情","婚姻"],"ap":1},{"id":"be782b449492","t":"晨风","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鴥彼晨风，郁彼北林。未见君子，忧心钦钦。如何如何，忘我实多！","b":0,"y":-700,"th":["爱情","闺怨","弃妇"],"ap":1},{"id":"e470691a71ea","t":"月出","a":"佚名","d":1,"f":"诗经","g":"诗","x":"月出皎兮。佼人僚兮。舒窈纠兮。劳心悄兮。","b":0,"y":-700,"th":["爱情","相思","咏人"],"ap":1},{"id":"1a465f5bcd6c","t":"有女同车","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有女同车，颜如舜华。将翱将翔，佩玉琼琚。彼美孟姜，洵美且都。","b":0,"y":-700,"th":["爱情","咏人","赞美"],"ap":1},{"id":"e9a41e7c53da","t":"有客","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有客有客，亦白其马。有萋有且，敦琢其旅。有客宿宿，有客信信。","b":0,"y":-700,"th":["宴饮","送别","颂德"],"ap":1},{"id":"49fe6e812725","t":"有杕之杜","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有杕之杜，生于道左。彼君子兮，噬肯适我？中心好之，曷饮食之？","b":0,"y":-700,"th":["爱情","渴望","孤独"],"ap":1},{"id":"1dbe6359aaf9","t":"有狐","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有狐绥绥，在彼淇梁。心之忧矣，之子无裳。","b":0,"y":-700,"th":["爱情","忧思","怀人"],"ap":1},{"id":"aa543cd2fe13","t":"木瓜","a":"佚名","d":1,"f":"诗经","g":"诗","x":"投我以木瓜，报之以琼琚。匪报也，永以为好也！","b":0,"y":-700,"th":["爱情","友情","哲理"],"ap":1},{"id":"b87e485ae156","t":"杕杜","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有杕之杜，其叶湑湑。独行踽踽。岂无他人？不如我同父。嗟行之人，胡不比焉？人无兄弟，胡不佽焉？","b":0,"y":-700,"th":["孤独","亲情","羁旅"],"ap":1},{"id":"c5bee6a12ac0","t":"杕杜","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有杕之杜，有睆其实。王事靡盬，继嗣我日。日月阳止，女心伤止，征夫遑止。","b":0,"y":-700,"th":["思妇","怀远","战争徭役"],"ap":1},{"id":"03efd1f8ea43","t":"柏舟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"泛彼柏舟，在彼中河。髧彼两髦，实维我仪。之死矢靡它。母也天只，不谅人只！","b":0,"y":-700,"th":["爱情","婚姻","抗争"],"ap":1},{"id":"411c451bbdab","t":"桃夭","a":"佚名","d":1,"f":"诗经","g":"诗","x":"桃之夭夭，灼灼其华。之子于归，宜其室家。","b":0,"y":-700,"th":["爱情","贺婚","咏物"],"ap":1},{"id":"17430d01bc65","t":"桑中","a":"佚名","d":1,"f":"诗经","g":"诗","x":"爰采唐矣？沬之乡矣。云谁之思？美孟姜矣。期我乎桑中，要我乎上宫，送我乎淇之上矣。","b":0,"y":-700,"th":["爱情","民歌"],"ap":1},{"id":"cf9b1085ec99","t":"桑扈","a":"佚名","d":1,"f":"诗经","g":"诗","x":"交交桑扈，有莺其羽。君子乐胥，受天之祜。","b":0,"y":-700,"th":["宴饮","颂赞","礼乐"],"ap":1},{"id":"46c81de5b94b","t":"棠棣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"棠棣之华，鄂不韡韡。凡今之人，莫如兄弟。","b":0,"y":-700,"th":["亲情","伦理","宴饮"],"ap":1},{"id":"8e62eca867c4","t":"棫朴","a":"佚名","d":1,"f":"诗经","g":"诗","x":"芃芃棫朴，薪之槱之。济济辟王，左右趣之。","b":0,"y":-700,"th":["颂美","咏史","人才"],"ap":1},{"id":"9df59b25331d","t":"椒聊","a":"佚名","d":1,"f":"诗经","g":"诗","x":"椒聊之实，蕃衍盈升。彼其之子，硕大无朋。椒聊且，远条且。","b":0,"y":-700,"th":["咏物","赞美","爱情"],"ap":1},{"id":"e839a35851f9","t":"樛木","a":"佚名","d":1,"f":"诗经","g":"诗","x":"南有樛木，葛藟累之。乐只君子，福履绥之。","b":0,"y":-700,"th":["祝贺","比兴","福禄"],"ap":1},{"id":"924d597e17e6","t":"殷其雷","a":"佚名","d":1,"f":"诗经","g":"诗","x":"殷其雷，在南山之阳。何斯违斯，莫敢或遑？振振君子，归哉归哉！","b":0,"y":-700,"th":["思妇","行役","怀人"],"ap":1},{"id":"d864ea04d259","t":"殷武","a":"佚名","d":1,"f":"诗经","g":"诗","x":"挞彼殷武，奋伐荆楚。深入其阻，裒荆之旅。有截其所，汤孙之绪。","b":0,"y":-700,"th":["颂赞","咏史","祭祀"],"ap":1},{"id":"7facc3b67369","t":"汉广","a":"佚名","d":1,"f":"诗经","g":"诗","x":"南有乔木，不可休息。汉有游女，不可求思。汉之广矣，不可泳思。江之永矣，不可方思。","b":0,"y":-700,"th":["爱情","相思","怅惘"],"ap":1},{"id":"dad70fdb2381","t":"汝坟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"遵彼汝坟，伐其条枚。未见君子，惄如调饥。","b":0,"y":-700,"th":["闺怨","思妇","乱世离愁"],"ap":1},{"id":"d7ead9096b5a","t":"江有汜","a":"佚名","d":1,"f":"诗经","g":"诗","x":"江有汜，之子归，不我以。不我以，其后也悔。","b":0,"y":-700,"th":["弃妇","爱情","怨愤"],"ap":1},{"id":"aecdf8cbf352","t":"汾沮洳","a":"佚名","d":1,"f":"诗经","g":"诗","x":"彼汾沮洳，言采其莫。彼其之子，美无度。美无度，殊异乎公路。","b":0,"y":-700,"th":["爱情","赞美","劳动"],"ap":1},{"id":"8570d5f9cbdc","t":"沔水","a":"佚名","d":1,"f":"诗经","g":"诗","x":"沔彼流水，朝宗于海。鴥彼飞隼，载飞载止。嗟我兄弟，邦人诸友。莫肯念乱，谁无父母？","b":0,"y":-700,"th":["忧国忧民","乱世哀音"],"ap":1},{"id":"17c7a25da5e5","t":"河广","a":"佚名","d":1,"f":"诗经","g":"诗","x":"谁谓河广？一苇杭之。谁谓宋远？跂予望之。","b":0,"y":-700,"th":["思乡"],"ap":1},{"id":"bc32f7a8da8a","t":"淇奥","a":"佚名","d":1,"f":"诗经","g":"诗","x":"瞻彼淇奥，绿竹猗猗。有匪君子，如切如磋，如琢如磨，瑟兮僴兮，赫兮咺兮。有匪君子，终不可谖兮。","b":0,"y":-700,"th":["赞美","咏人","修身"],"ap":1},{"id":"1a477d2b9b31","t":"渐渐之石","a":"佚名","d":1,"f":"诗经","g":"诗","x":"渐渐之石，维其高矣。山川悠远，维其劳矣。武人东征，不遑朝矣。","b":0,"y":-700,"th":["战争","行役","劳苦"],"ap":1},{"id":"75a6a2f68eb4","t":"湛露","a":"佚名","d":1,"f":"诗经","g":"诗","x":"湛湛露斯，匪阳不晞。厌厌夜饮，不醉无归。","b":0,"y":-700,"th":["宴饮","颂德","宗庙"],"ap":1},{"id":"f0f935800541","t":"潜","a":"佚名","d":1,"f":"诗经","g":"诗","x":"猗与漆沮，潜有多鱼。有鳣有鲔，鲦鲿鰋鲤。以享以祀，以介景福。","b":0,"y":-700,"th":["祭祀","颂歌","咏物"],"ap":1},{"id":"d77c15e5c598","t":"烈文","a":"佚名","d":1,"f":"诗经","g":"诗","x":"烈文辟公，锡兹祉福。惠我无疆，子孙保之。无封靡于尔邦，维王其崇之。","b":0,"y":-700,"th":["祭祀","颂德","诫勉"],"ap":1},{"id":"6b53fdd4fd3d","t":"烈祖","a":"佚名","d":1,"f":"诗经","g":"诗","x":"嗟嗟烈祖！有秩斯祜。申锡无疆，及尔斯所。既载清酤，赉我思成。","b":0,"y":-700,"th":["祭祀","颂祖","祈福"],"ap":1},{"id":"6f7a519c7491","t":"烝民","a":"佚名","d":1,"f":"诗经","g":"诗","x":"天生烝民，有物有则。民之秉彝，好是懿德。天监有周，昭假于下。保兹天子，生仲山甫。","b":0,"y":-700,"th":["颂赞","德行","哲理","送别"],"ap":1},{"id":"a60570ff024e","t":"狼跋","a":"佚名","d":1,"f":"诗经","g":"诗","x":"狼跋其胡，载疐其尾。公孙硕肤，赤舄几几。","b":0,"y":-700,"th":["讽刺","咏物","政治"],"ap":1},{"id":"ea756c25a962","t":"瓠叶","a":"佚名","d":1,"f":"诗经","g":"诗","x":"幡幡瓠叶，采之亨之。君子有酒，酌言尝之。","b":0,"y":-700,"th":["宴饮","尚礼","田园"],"ap":1},{"id":"5c92bd3bc35f","t":"甫田","a":"佚名","d":1,"f":"诗经","g":"诗","x":"倬彼甫田，岁取十千。我取其陈，食我农人。自古有年。","b":0,"y":-700,"th":["农事","祭祀","丰收"],"ap":1},{"id":"d0545c8ffd1c","t":"甫田","a":"佚名","d":1,"f":"诗经","g":"诗","x":"无田甫田，维莠骄骄。无思远人，劳心忉忉。","b":0,"y":-700,"th":["思念","田园","怀人"],"ap":1},{"id":"b80e9482e5ae","t":"皇皇者华","a":"佚名","d":1,"f":"诗经","g":"诗","x":"皇皇者华，于彼原隰。駪駪征夫，每怀靡及。","b":0,"y":-700,"th":["使臣","出使","咏物","勤勉"],"ap":1},{"id":"cef5dd9e561a","t":"着","a":"佚名","d":1,"f":"诗经","g":"诗","x":"俟我于着乎而，充耳以素乎而，尚之以琼华乎而。","b":0,"y":-700,"th":["爱情","婚嫁","咏物"],"ap":1},{"id":"ed0bc22b4565","t":"祈父","a":"佚名","d":1,"f":"诗经","g":"诗","x":"祈父，予王之爪牙。胡转予于恤，靡所止居？","b":0,"y":-700,"th":["战争","怨刺","孝道"],"ap":1},{"id":"543fd246d437","t":"终南","a":"佚名","d":1,"f":"诗经","g":"诗","x":"终南何有？有条有梅。君子至止，锦衣狐裘。颜如渥丹，其君也哉！","b":0,"y":-700,"th":["赞颂","咏人","礼乐"],"ap":1},{"id":"06ee11bf38cf","t":"终风","a":"佚名","d":1,"f":"诗经","g":"诗","x":"终风且暴，顾我则笑，谑浪笑敖，中心是悼。","b":0,"y":-700,"th":["闺怨","爱情","弃妇"],"ap":1},{"id":"c668b992327c","t":"绵","a":"佚名","d":1,"f":"诗经","g":"诗","x":"绵绵瓜瓞。民之初生，自土沮漆。古公亶父，陶复陶冗，未有家室。","b":0,"y":-700,"th":["史诗","咏史","颂歌"],"ap":1},{"id":"92572b510be0","t":"绵蛮","a":"佚名","d":1,"f":"诗经","g":"诗","x":"绵蛮黄鸟，止于丘阿。道之云远，我劳如何。饮之食之，教之诲之。命彼后车，谓之载之。","b":0,"y":-700,"th":["行役","体恤","仁政"],"ap":1},{"id":"3133eab68715","t":"绸缪","a":"佚名","d":1,"f":"诗经","g":"诗","x":"绸缪束薪，三星在天。今夕何夕，见此良人？子兮子兮，如此良人何？","b":0,"y":-700,"th":["爱情","婚姻","喜悦"],"ap":1},{"id":"9a2827847ddd","t":"绿衣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"绿兮衣兮，绿衣黄裹。心之忧矣，曷维其已！","b":0,"y":-700,"th":["悼亡","哀伤","怀人"],"ap":1},{"id":"08b6b4adb2fa","t":"羔裘","a":"佚名","d":1,"f":"诗经","g":"诗","x":"羔裘如濡，洵直且侯。彼其之子，舍命不渝。","b":0,"y":-700,"th":["咏物","赞颂","政治"],"ap":1},{"id":"42f8ba2d2c3b","t":"羔裘","a":"佚名","d":1,"f":"诗经","g":"诗","x":"羔裘豹祛，自我人居居。岂无他人？维子之故。","b":0,"y":-700,"th":["讽刺","怨刺","人情冷暖"],"ap":1},{"id":"4319efcb24c2","t":"羔裘","a":"佚名","d":1,"f":"诗经","g":"诗","x":"羔裘逍遥，狐裘以朝。岂不尔思？劳心忉忉。","b":0,"y":-700,"th":["讽喻","忧国","怀人"],"ap":1},{"id":"ec64a7a9d8ae","t":"考槃","a":"佚名","d":1,"f":"诗经","g":"诗","x":"考槃在涧，硕人之宽。独寐寤言，永矢弗谖。","b":0,"y":-700,"th":["隐逸","咏人","高洁"],"ap":1},{"id":"7fdcdb83297b","t":"臣工","a":"佚名","d":1,"f":"诗经","g":"诗","x":"嗟嗟臣工，敬尔在公。王厘尔成，来咨来茹。嗟嗟保介，维莫之春，亦又何求？如何新畲？","b":0,"y":-700,"th":["农事","颂歌","劝农"],"ap":1},{"id":"e11aca99240e","t":"芄兰","a":"佚名","d":1,"f":"诗经","g":"诗","x":"芄兰之支，童子佩觿。虽则佩觿，能不我知。容兮遂兮，垂带悸兮。","b":0,"y":-700,"th":["讽刺","爱情","咏物"],"ap":1},{"id":"b558a45cc894","t":"芣苡","a":"佚名","d":1,"f":"诗经","g":"诗","x":"采采芣苡，薄言采之。采采芣苡，薄言有之。","b":0,"y":-700,"th":["田园","劳动","咏物"],"ap":1},{"id":"31faf5e433ba","t":"苕之华","a":"佚名","d":1,"f":"诗经","g":"诗","x":"苕之华，芸其黄矣。心之忧矣，维其伤矣！","b":0,"y":-700,"th":["哀怨","纪实","民生疾苦"],"ap":1},{"id":"472ed91c745e","t":"菀柳","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有菀者柳，不尚息焉。上帝甚蹈，无自暱焉。俾予靖之，后予极焉。","b":0,"y":-700,"th":["怨刺","放逐","忠而被弃"],"ap":1},{"id":"405bdaca3281","t":"菁菁者莪","a":"佚名","d":1,"f":"诗经","g":"诗","x":"菁菁者莪，在彼中阿。既见君子，乐且有仪。","b":0,"y":-700,"th":["宴饮","尊贤","知遇"],"ap":1},{"id":"0185b0c161dd","t":"葛生","a":"佚名","d":1,"f":"诗经","g":"诗","x":"葛生蒙楚，蔹蔓于野。予美亡此，谁与？独处？","b":0,"y":-700,"th":["悼亡","爱情","生死"],"ap":1},{"id":"cf87fb2d0dc4","t":"葛藟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"绵绵葛藟，在河之浒。终远兄弟，谓他人父。谓他人父，亦莫我顾！","b":0,"y":-700,"th":["流亡","思乡","世态炎凉"],"ap":1},{"id":"c89cdd66e9c4","t":"葛覃","a":"佚名","d":1,"f":"诗经","g":"诗","x":"葛之覃兮，施于中谷，维叶萋萋。黄鸟于飞，集于灌木，其鸣喈喈。","b":0,"y":-700,"th":["劳动","亲情","归宁"],"ap":1},{"id":"e5048c24d3e3","t":"蒹葭","a":"佚名","d":1,"f":"诗经","g":"诗","x":"蒹葭苍苍，白露为霜。所谓伊人，在水一方。溯洄从之，道阻且长。溯游从之，宛在水中央。","b":0,"y":-700,"th":["爱情","思慕","求索"],"ap":1},{"id":"4e242cd41187","t":"蓼莪","a":"佚名","d":1,"f":"诗经","g":"诗","x":"蓼蓼者莪，匪莪伊蒿。哀哀父母，生我劬劳。","b":0,"y":-700,"th":["悼亡","孝道","哀思"],"ap":1},{"id":"85747689802c","t":"蓼萧","a":"佚名","d":1,"f":"诗经","g":"诗","x":"蓼彼萧斯，零露湑兮。既见君子，我心写兮。燕笑语兮，是以有誉处兮。","b":0,"y":-700,"th":["宴饮","颂德","祈福"],"ap":1},{"id":"deaec5c5dc09","t":"蜉蝣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"蜉蝣之羽，衣裳楚楚。心之忧矣，于我归处。","b":0,"y":-700,"th":["咏物","哲理","生命意识"],"ap":1},{"id":"e0f794d59720","t":"蝃蝀","a":"佚名","d":1,"f":"诗经","g":"诗","x":"蝃蝀在东，莫之敢指。女子有行，远父母兄弟。","b":0,"y":-700,"th":["婚姻","讽刺","礼教"],"ap":1},{"id":"34fb33a0320f","t":"螽斯","a":"佚名","d":1,"f":"诗经","g":"诗","x":"螽斯羽，诜诜兮。宜尔子孙，振振兮。","b":0,"y":-700,"th":["祝颂","咏物","繁衍"],"ap":1},{"id":"259c1d635c0a","t":"蟋蟀","a":"佚名","d":1,"f":"诗经","g":"诗","x":"蟋蟀在堂，岁聿其莫。今我不乐，日月其除。无已大康，职思其居。好乐无荒，良士瞿瞿。","b":1,"y":-700,"th":["哲理","咏物","惜时"],"ap":1},{"id":"288f7e9a1a19","t":"行苇","a":"佚名","d":1,"f":"诗经","g":"诗","x":"敦彼行苇，牛羊勿践履。方苞方体，维叶泥泥。","b":1,"y":-700,"th":["宴饮","亲情","礼乐","祈福"],"ap":1},{"id":"ad61f1dd1739","t":"行露","a":"佚名","d":1,"f":"诗经","g":"诗","x":"厌浥行露，岂不夙夜，谓行多露。","b":1,"y":-700,"th":["婚姻","抗争","咏物"],"ap":1},{"id":"93d49c4ff0f4","t":"裳裳者华","a":"佚名","d":1,"f":"诗经","g":"诗","x":"裳裳者华，其叶湑兮。我觏之子，我心写兮。我心写兮，是以有誉处兮。","b":1,"y":-700,"th":["赞美","贵族","咏物"],"ap":1},{"id":"fe4f0804da9f","t":"角弓","a":"佚名","d":1,"f":"诗经","g":"诗","x":"骍骍角弓，翩其反矣。兄弟婚姻，无胥远矣。","b":1,"y":-700,"th":["说理","讽谏","宗族"],"ap":1},{"id":"84648cb493fe","t":"谷风","a":"佚名","d":1,"f":"诗经","g":"诗","x":"习习谷风，维风及雨。将恐将惧，维予与女。将安将乐，女转弃予。","b":1,"y":-700,"th":["弃妇","怨刺","爱情"],"ap":1},{"id":"13f5aa2d7742","t":"车舝","a":"佚名","d":1,"f":"诗经","g":"诗","x":"间关车之舝兮，思娈季女逝兮。匪饥匪渴，德音来括。虽无好友？式燕且喜。","b":1,"y":-700,"th":["婚恋","迎亲","赞美"],"ap":1},{"id":"6a8b4e9655a6","t":"车邻","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有车邻邻，有马白颠。未见君子，寺人之令。","b":1,"y":-700,"th":["宴饮","哲理","咏怀"],"ap":1},{"id":"282da55caa58","t":"载驰","a":"佚名","d":1,"f":"诗经","g":"诗","x":"载驰载驱，归唁卫侯。驱马悠悠，言至于漕。大夫跋涉，我心则忧。","b":1,"y":-700,"th":["爱国","咏怀","政治抱负"],"ap":1},{"id":"203046514567","t":"遵大路","a":"佚名","d":1,"f":"诗经","g":"诗","x":"遵大路兮，掺执子之袪兮。无我恶兮，不蓵故也！","b":1,"y":-700,"th":["爱情","离别"],"ap":1},{"id":"9dab1d281e8e","t":"那","a":"佚名","d":1,"f":"诗经","g":"诗","x":"猗与那与！置我鞉鼓。奏鼓简简，衎我烈祖。汤孙奏假，绥我思成。","b":1,"y":-700,"th":["祭祀","颂祖","礼乐"],"ap":1},{"id":"6fb100f8a178","t":"酌","a":"佚名","d":1,"f":"诗经","g":"诗","x":"于铄王师，遵养时晦。时纯熙矣，是用大介。我龙受之，蹻蹻王之造。载用有嗣，实维尔公允师。","b":1,"y":-700,"th":["战争","颂歌","怀古"],"ap":1},{"id":"60eaed4b9b26","t":"采绿","a":"佚名","d":1,"f":"诗经","g":"诗","x":"终朝采绿，不盈一匊。予发曲局，薄言归沐。","b":1,"y":-700,"th":["闺怨","爱情","相思"],"ap":1},{"id":"6a92a8432d58","t":"采菽","a":"佚名","d":1,"f":"诗经","g":"诗","x":"采菽采菽，筐之莒之。君子来朝，何锡予之？虽无予之？路车乘马。又何予之？玄衮及黼。","b":1,"y":-700,"th":["朝会","颂赞","政治","祝颂"],"ap":1},{"id":"40f6b92812d5","t":"采葛","a":"佚名","d":1,"f":"诗经","g":"诗","x":"彼采葛兮，一日不见，如三月兮！","b":1,"y":-700,"th":["爱情","相思"],"ap":1},{"id":"31530680e02a","t":"采蘋","a":"佚名","d":1,"f":"诗经","g":"诗","x":"于以采蘋？南涧之滨。于以采藻？于彼行潦。","b":1,"y":-700,"th":["祭祀","礼制","民俗"],"ap":1},{"id":"1656605a2d0d","t":"采蘩","a":"佚名","d":1,"f":"诗经","g":"诗","x":"于以采蘩？于沼于沚。于以用之？公侯之事。","b":1,"y":-700,"th":["祭祀","劳作","宫廷"],"ap":1},{"id":"4a3f81dd5fda","t":"野有死麕","a":"佚名","d":1,"f":"诗经","g":"诗","x":"野有死麕，白茅包之。有女怀春，吉士诱之。","b":1,"y":-700,"th":["爱情","民俗","婚恋"],"ap":1},{"id":"0ea59649a955","t":"长发","a":"佚名","d":1,"f":"诗经","g":"诗","x":"浚哲维商，长发其祥。洪水芒芒，禹敷下土方。外大国是疆，幅陨既长。有娀方将，帝立子生商。","b":1,"y":-700,"th":["史诗","祭祀","咏史","颂德"],"ap":1},{"id":"2b619a0cd945","t":"防有鹊巢","a":"佚名","d":1,"f":"诗经","g":"诗","x":"防有鹊巢，邛有旨苕。谁侜予美？心焉忉忉。","b":1,"y":-700,"th":["爱情","忧惧","谗言"],"ap":1},{"id":"b9d06d59695e","t":"陟岵","a":"佚名","d":1,"f":"诗经","g":"诗","x":"陟彼岵兮，瞻望父兮。父曰：嗟！予子行役，夙夜无已。上慎旃哉，犹来！无止！","b":1,"y":-700,"th":["思乡","行役","亲情"],"ap":1},{"id":"8ee5ab4bf474","t":"隰有苌楚","a":"佚名","d":1,"f":"诗经","g":"诗","x":"隰有苌楚，猗傩其枝，夭之沃沃，乐子之无知。","b":1,"y":-700,"th":["咏物","哲理","讽喻"],"ap":1},{"id":"9804dcbe5a47","t":"雄雉","a":"佚名","d":1,"f":"诗经","g":"诗","x":"雄雉于飞，泄泄其羽。我之怀矣，自诒伊阻。","b":1,"y":-700,"th":["思妇","怀人","哲理"],"ap":1},{"id":"13993fa28fb3","t":"青蝇","a":"佚名","d":1,"f":"诗经","g":"诗","x":"营营青蝇，止于樊。岂弟君子，无信谗言。","b":1,"y":-700,"th":["咏物","讽喻","政治"],"ap":1},{"id":"8bdf3416152c","t":"静女","a":"佚名","d":1,"f":"诗经","g":"诗","x":"静女其姝，俟我于城隅。爱而不见，搔首踟蹰。","b":1,"y":-700,"th":["爱情","民俗"],"ap":1},{"id":"cc47b6ccbed9","t":"頍弁","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有頍者弁，实维伊何？尔酒既旨，尔肴既嘉。岂伊异人？兄弟匪他。","b":1,"y":-700,"th":["宴饮","亲情","伤时","哲理"],"ap":1},{"id":"760d84fb5107","t":"驺虞","a":"佚名","d":1,"f":"诗经","g":"诗","x":"彼茁者葭，壹发五豝，于嗟乎驺虞！","b":1,"y":-700,"th":["田猎","咏人","赞美"],"ap":1},{"id":"57a898e49afa","t":"鱼丽","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鱼丽于罶，鲿鲨。君子有酒，旨且多。","b":1,"y":-700,"th":["宴饮","颂赞","乐歌"],"ap":1},{"id":"04eb572548f7","t":"鸡鸣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鸡既鸣矣，朝既盈矣。匪鸡则鸣，苍蝇之声。","b":1,"y":-700,"th":["爱情","生活","闺情"],"ap":1},{"id":"9d74835f627e","t":"鸳鸯","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鸳鸯于飞，毕之罗之。君子万年，福禄宜之。","b":1,"y":-700,"th":["祝颂","宴饮","咏物"],"ap":1},{"id":"785956f62569","t":"鸿雁","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鸿雁于飞，肃肃其羽。之子于征，劬劳于野。爰及矜人，哀此鳏寡。","b":1,"y":-700,"th":["劳役","咏物","民生疾苦","怀才不遇"],"ap":1},{"id":"1c0b4a82f6be","t":"鹊巢","a":"佚名","d":1,"f":"诗经","g":"诗","x":"维鹊有巢，维鸠居之。之子于归，百两御之。","b":1,"y":-700,"th":["婚嫁","祝贺","起兴"],"ap":1},{"id":"9f2a79732c93","t":"鹤鸣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鹤鸣于九皋，声闻于野。鱼潜在渊，或在于渚。乐彼之园，爰有树檀，其下维萚。他山之石，可以为错。","b":1,"y":-700,"th":["哲理","咏物","招贤"],"ap":1},{"id":"55e0cd59a0de","t":"麟之趾","a":"佚名","d":1,"f":"诗经","g":"诗","x":"麟之趾，振振公子，于嗟麟兮。","b":1,"y":-700,"th":["咏物","赞美","哲理"],"ap":1},{"id":"dcef9ba2f40f","t":"黄鸟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"黄鸟黄鸟，无集于穀，无啄我粟。此邦之人，不我肯穀。言旋言归，复我邦族。","b":1,"y":-700,"th":["思乡","流离","怀亲"],"ap":1},{"id":"632cdfaa598a","t":"鼓钟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鼓钟将将，淮水汤汤，忧心且伤。淑人君子，怀允不忘。","b":1,"y":-700,"th":["伤时","怀古","咏乐"],"ap":1},{"id":"74d23b1c9afe","t":"南山","a":"佚名","d":1,"f":"诗经","g":"诗","x":"南山崔崔，雄狐绥绥。鲁道有荡，齐子由归。既曰归止，曷又怀止？","b":1,"y":-694,"th":["讽刺","政治","伦理"],"ap":1},{"id":"b260e4a6c4c1","t":"猗嗟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"猗嗟昌兮，颀而长兮。抑若扬兮，美目扬兮。巧趋跄兮，射则臧兮。","b":1,"y":-694,"th":["赞美","讽喻","射猎"],"ap":1},{"id":"55a2cd4e75ff","t":"载驱","a":"佚名","d":1,"f":"诗经","g":"诗","x":"载驱薄薄，簟茀朱鞹。鲁道有荡，齐子发夕。","b":1,"y":-694,"th":["讽刺","史事","政治"],"ap":1},{"id":"bf5283d8796c","t":"定之方中","a":"佚名","d":1,"f":"诗经","g":"诗","x":"定之方中，作于楚宫。揆之以日，作于楚室。树之榛栗，椅桐梓漆，爰伐琴桑。","b":1,"y":-658,"th":["颂美","农事","咏史"],"ap":1},{"id":"2f799ba8d005","t":"丘中有麻","a":"佚名","d":1,"f":"诗经","g":"诗","x":"丘中有麻，彼留子嗟。彼留子嗟，将其来施施。","b":1,"y":-650,"th":["爱情","田园"],"ap":1},{"id":"7c5132d66073","t":"东门之墠","a":"佚名","d":1,"f":"诗经","g":"诗","x":"东门之墠，茹藘在阪。其室则迩，其人甚远。","b":1,"y":-650,"th":["爱情","相思","幽怨"],"ap":1},{"id":"55f14d7491b5","t":"东门之杨","a":"佚名","d":1,"f":"诗经","g":"诗","x":"东门之杨，其叶牂牂。昏以为期，明星煌煌。","b":1,"y":-650,"th":["爱情","怨情"],"ap":1},{"id":"3afca3179b59","t":"东门之池","a":"佚名","d":1,"f":"诗经","g":"诗","x":"东门之池，可以沤麻。彼美淑姬，可与晤歌。","b":1,"y":-650,"th":["爱情","劳动","田园"],"ap":1},{"id":"0bac9f63b137","t":"伯兮","a":"佚名","d":1,"f":"诗经","g":"诗","x":"伯兮朅兮，邦之桀兮。伯也执殳，为王前驱。","b":1,"y":-650,"th":["闺怨","战争","相思"],"ap":1},{"id":"b7c784d8c527","t":"候人","a":"佚名","d":1,"f":"诗经","g":"诗","x":"彼候人兮，何戈与祋。彼其之子，三百赤芾。","b":1,"y":-650,"th":["政治讽刺","民生疾苦","咏物"],"ap":1},{"id":"5e4d4fe17a0f","t":"兔爰","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有兔爰爰，雉离于罗。我生之初，尚无为；我生之后，逢此百罹。尚寐无吪。","b":1,"y":-650,"th":["伤时","乱世","哀怨"],"ap":1},{"id":"989b7f215d18","t":"北门","a":"佚名","d":1,"f":"诗经","g":"诗","x":"出自北门，忧心殷殷。终窭且贫，莫知我艰。已焉哉！天实为之，谓之何哉！","b":1,"y":-650,"th":["哀怨","仕途","咏叹"],"ap":1},{"id":"34f7d460708f","t":"君子偕老","a":"佚名","d":1,"f":"诗经","g":"诗","x":"君子偕老，副笄六珈。委委佗佗，如山如河，象服是宜。子之不淑，云如之何？","b":1,"y":-650,"th":["讽刺","咏人","宫廷"],"ap":1},{"id":"458a0c6020bf","t":"墙有茨","a":"佚名","d":1,"f":"诗经","g":"诗","x":"墙有茨，不可扫也。中冓之言，不可道也。所可道也，言之丑也。","b":1,"y":-650,"th":["讽刺","政治","宫闱"],"ap":1},{"id":"f8693bb90251","t":"大叔于田","a":"佚名","d":1,"f":"诗经","g":"诗","x":"叔于田，乘乘马。执辔如组，两骖如舞。叔在薮，火烈具举。襢裼暴虎，献于公所。将叔勿狃，戒其伤女。","b":1,"y":-650,"th":["狩猎","赞颂","关怀"],"ap":1},{"id":"18f3e9d55b6b","t":"子衿","a":"佚名","d":1,"f":"诗经","g":"诗","x":"青青子衿，悠悠我心。纵我不往，子宁不嗣音？","b":1,"y":-650,"th":["爱情","思念"],"ap":1},{"id":"d52c6c162c28","t":"将仲子","a":"佚名","d":1,"f":"诗经","g":"诗","x":"将仲子兮，无逾我里，无折我树杞。岂敢爱之？畏我父母。仲可怀也，父母之言亦可畏也。","b":1,"y":-650,"th":["爱情","礼教","闺怨"],"ap":1},{"id":"1e37209942b8","t":"小戎","a":"佚名","d":1,"f":"诗经","g":"诗","x":"小戎俴收，五楘梁辀。游环胁驱，阴靷鋈续。文茵畅毂，驾我骐馵。","b":1,"y":-650,"th":["思妇","战争","咏物"],"ap":1},{"id":"8bec7ed3ad4d","t":"干旄","a":"佚名","d":1,"f":"诗经","g":"诗","x":"孑孑干旄，在浚之郊。素丝纰之，良马四之。彼姝者子，何以畀之？","b":1,"y":-650,"th":["招贤","爱情","礼赞"],"ap":1},{"id":"d8a940788f15","t":"式微","a":"佚名","d":1,"f":"诗经","g":"诗","x":"式微，式微，胡不归？微君之故，胡为乎中露！","b":1,"y":-650,"th":["劳役","怨刺","思归"],"ap":1},{"id":"fd285bc59340","t":"敝笱","a":"佚名","d":1,"f":"诗经","g":"诗","x":"敝笱在梁，其鱼鲂鳏。齐子归止，其从如云。","b":1,"y":-650,"th":["讽刺","政治","咏物"],"ap":1},{"id":"6b9c1e0d07f4","t":"有駜","a":"佚名","d":1,"f":"诗经","g":"诗","x":"有駜有駜，駜彼乘黄。夙夜在公，在公明明。振振鹭，鹭于下。鼓咽咽，醉言舞。于胥乐兮！","b":1,"y":-650,"th":["颂赞","宴饮","祈福"],"ap":1},{"id":"f2ced702f4fa","t":"柏舟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"泛彼柏舟，亦泛其流。耿耿不寐，如有隐忧。微我无酒，以敖以游。","b":1,"y":-650,"th":["闺怨","言志","抒愤"],"ap":1},{"id":"1fddd3a8bef6","t":"氓","a":"佚名","d":1,"f":"诗经","g":"诗","x":"氓之蚩蚩，抱布贸丝。匪来贸丝，来即我谋。送子涉淇，至于顿丘。匪我愆期，子无良媒。将子无怒，秋以为期。","b":1,"y":-650,"th":["弃妇","婚姻","爱情","怨情"],"ap":1},{"id":"fef7dec8bc4d","t":"泉水","a":"佚名","d":1,"f":"诗经","g":"诗","x":"毖彼泉水，亦流于淇。有怀于卫，靡日不思。娈彼诸姬，聊与之谋。","b":1,"y":-650,"th":["思乡","思归","闺怨"],"ap":1},{"id":"94d88dfdff79","t":"泮水","a":"佚名","d":1,"f":"诗经","g":"诗","x":"思乐泮水，薄采其芹。鲁侯戾止，言观其旂。其旂茷茷，鸾声哕哕。无小无大，从公于迈。","b":1,"y":-650,"th":["颂功","战争","德化"],"ap":1},{"id":"b33bdc927c62","t":"清人","a":"佚名","d":1,"f":"诗经","g":"诗","x":"清人在彭，驷介旁旁。二矛重英，河上乎翱翔。","b":1,"y":-650,"th":["讽刺","军旅","怀古"],"ap":1},{"id":"50ce63a422ba","t":"燕燕","a":"佚名","d":1,"f":"诗经","g":"诗","x":"燕燕于飞，差池其羽。之子于归，远送于野。瞻望弗及，泣涕如雨。","b":1,"y":-650,"th":["送别","亲情","咏物"],"ap":1},{"id":"de65697df98a","t":"玄鸟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"天命玄鸟，降而生商，宅殷土芒芒。古帝命武汤，正域彼四方。","b":1,"y":-650,"th":["祭祀","咏史","颂歌"],"ap":1},{"id":"9b22d6c4574a","t":"相鼠","a":"佚名","d":1,"f":"诗经","g":"诗","x":"相鼠有皮，人而无仪！人而无仪，不死何为？","b":1,"y":-650,"th":["讽刺","哲理"],"ap":1},{"id":"17172b59b2f7","t":"竹竿","a":"佚名","d":1,"f":"诗经","g":"诗","x":"籊籊竹竿，以钓于淇。岂不尔思？远莫致之。","b":1,"y":-650,"th":["思乡","闺怨","怀古"],"ap":1},{"id":"b573a3ccec9c","t":"简兮","a":"佚名","d":1,"f":"诗经","g":"诗","x":"简兮简兮，方将万舞。日之方中，在前上处。","b":1,"y":-650,"th":["赞美","怀古","思慕"],"ap":1},{"id":"74a6717ece80","t":"葛屦","a":"佚名","d":1,"f":"诗经","g":"诗","x":"纠纠葛屦，可以履霜？掺掺女手，可以缝裳？要之襋之，好人服之。","b":1,"y":-650,"th":["讽喻","社会批判","阶级对立"],"ap":1},{"id":"7fd375f09fb5","t":"衡门","a":"佚名","d":1,"f":"诗经","g":"诗","x":"衡门之下，可以栖迟。泌之洋洋，可以乐饥。","b":1,"y":-650,"th":["哲理","安贫乐道","田园"],"ap":1},{"id":"940b41ece416","t":"褰裳","a":"佚名","d":1,"f":"诗经","g":"诗","x":"子惠思我，褰裳涉溱。子不我思，岂无他人？狂童之狂也且！","b":1,"y":-650,"th":["爱情","民俗"],"ap":1},{"id":"02c1e1e8803c","t":"还","a":"佚名","d":1,"f":"诗经","g":"诗","x":"子之还兮，遭我乎狃之间兮。并驱从两肩兮，揖我谓我儇兮。","b":1,"y":-650,"th":["田猎","尚武","豪情"],"ap":1},{"id":"77628e185c7c","t":"采苓","a":"佚名","d":1,"f":"诗经","g":"诗","x":"采苓采苓，首阳之巅。人之为言，苟亦无信。舍旃舍旃，苟亦无然。人之为言，胡得焉？","b":1,"y":-650,"th":["哲理","劝诫","讥讽"],"ap":1},{"id":"c00b6c3457ba","t":"野有蔓草","a":"佚名","d":1,"f":"诗经","g":"诗","x":"野有蔓草，零露漙兮。有美一人，清扬婉兮。邂逅相遇，适我愿兮。","b":1,"y":-650,"th":["爱情","邂逅"],"ap":1},{"id":"a2a234e23dea","t":"駉","a":"佚名","d":1,"f":"诗经","g":"诗","x":"駉駉牡马，在坰之野。薄言駉者，有驈有皇，有骊有黄，以车彭彭。思无疆思，马斯臧。","b":1,"y":-650,"th":["咏物","颂德","田园"],"ap":1},{"id":"ada6f2ad82a2","t":"驷驖","a":"佚名","d":1,"f":"诗经","g":"诗","x":"驷驖孔阜，六辔在手。公之媚子，从公于狩。","b":1,"y":-650,"th":["田猎","尚武","颂赞"],"ap":1},{"id":"5c30e9b4ae35","t":"鳲鸠","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鳲鸠在桑，其子七兮。淑人君子，其仪一兮。其仪一兮，心如结兮。","b":1,"y":-650,"th":["咏物","赞美","哲理"],"ap":1},{"id":"362bbc16085f","t":"鸨羽","a":"佚名","d":1,"f":"诗经","g":"诗","x":"肃肃鸨羽，集于苞栩。王事靡盬，不能蓺稷黍。父母何怙？悠悠苍天，曷其有所？","b":1,"y":-650,"th":["徭役","怨刺","孝道"],"ap":1},{"id":"64f67b16c954","t":"鹑之奔奔","a":"佚名","d":1,"f":"诗经","g":"诗","x":"鹑之奔奔，鹊之彊彊。人之无良，我以为兄！","b":1,"y":-650,"th":["讽刺","弃怨","伦理"],"ap":1},{"id":"d62d9f3e3e18","t":"渭阳","a":"佚名","d":1,"f":"诗经","g":"诗","x":"我送舅氏，曰至渭阳。何以赠之？路车乘黄。","b":1,"y":-637,"th":["送别","亲情"],"ap":1},{"id":"0c4612ddf296","t":"黄鸟","a":"佚名","d":1,"f":"诗经","g":"诗","x":"交交黄鸟，止于棘。谁从穆公？子车奄息。维此奄息，百夫之特。","b":1,"y":-621,"th":["挽歌","悼亡","控诉"],"ap":1},{"id":"51672a83c681","t":"株林","a":"佚名","d":1,"f":"诗经","g":"诗","x":"胡为乎株林？从夏南！匪适株林，从夏南！","b":1,"y":-600,"th":["讽刺","政治","咏史"],"ap":1},{"id":"f52c2a8db94b","t":"泽陂","a":"佚名","d":1,"f":"诗经","g":"诗","x":"彼泽之陂，有蒲与荷。有美一人，伤如之何？寤寐无为，涕泗滂沱。","b":1,"y":-600,"th":["爱情","相思"],"ap":1},{"id":"c76e6765b9b2","t":"下泉","a":"佚名","d":1,"f":"诗经","g":"诗","x":"冽彼下泉，浸彼苞稂。忾我寤叹，念彼周京。","b":1,"y":-550,"th":["怀古","伤时","思治"],"ap":1},{"id":"f070657f69b5","t":"伐檀","a":"佚名","d":1,"f":"诗经","g":"诗","x":"坎坎伐檀兮，置之河之干兮。河水清且涟猗。不稼不穑，胡取禾三百廛兮？","b":1,"y":-550,"th":["讽喻","劳动","社会批判"],"ap":1},{"id":"92d4fea5b7b4","t":"击鼓","a":"佚名","d":1,"f":"诗经","g":"诗","x":"击鼓其镗，踊跃用兵。土国城漕，我独南行。","b":1,"y":-550,"th":["战争","爱情","思乡"],"ap":1},{"id":"91bcaf2a2b04","t":"十亩之间","a":"佚名","d":1,"f":"诗经","g":"诗","x":"十亩之间兮，桑者闲闲兮，行与子还兮。","b":1,"y":-550,"th":["田园","劳作","友情"],"ap":1},{"id":"fe9e20b1973b","t":"园有桃","a":"佚名","d":1,"f":"诗经","g":"诗","x":"园有桃，其实之肴。心之忧矣，我歌且谣。不知我者，谓我士也骄。","b":1,"y":-550,"th":["怀才不遇","忧国伤时","孤独愤懑"],"ap":1},{"id":"1d610d21048e","t":"女曰鸡鸣","a":"佚名","d":1,"f":"诗经","g":"诗","x":"女曰鸡鸣，士曰昧旦。子兴视夜，明星有烂。将翱将翔，弋凫与雁。","b":1,"y":-550,"th":["爱情","家庭","田园"],"ap":1},{"id":"351ddff34bf6","t":"溱洧","a":"佚名","d":1,"f":"诗经","g":"诗","x":"溱与洧，方涣涣兮。士与女，方秉蕳兮。女曰观乎？士曰既且。且往观乎？","b":1,"y":-550,"th":["爱情","民俗","春日"],"ap":1},{"id":"41377b7cbf68","t":"狡童","a":"佚名","d":1,"f":"诗经","g":"诗","x":"彼狡童兮，不与我言兮。维子之故，使我不能餐兮。","b":1,"y":-550,"th":["爱情","闺怨"],"ap":1},{"id":"0c604dfa955a","t":"硕鼠","a":"佚名","d":1,"f":"诗经","g":"诗","x":"硕鼠硕鼠，无食我黍！三岁贯女，莫我肯顾。逝将去女，适彼乐土。乐土乐土，爰得我所。","b":1,"y":-550,"th":["讽谕","反抗","田园"],"ap":1},{"id":"f46502c1807b","t":"萚兮","a":"佚名","d":1,"f":"诗经","g":"诗","x":"萚兮萚兮，风其吹女。叔兮伯兮，倡予和女。","b":1,"y":-550,"th":["爱情","咏物","民俗"],"ap":1},{"id":"83084b9e81b9","t":"隰桑","a":"佚名","d":1,"f":"诗经","g":"诗","x":"隰桑有阿，其叶有难。既见君子，其乐如何。","b":1,"y":-550,"th":["爱情","思慕"],"ap":1},{"id":"7ae93c89aac6","t":"风雨","a":"佚名","d":1,"f":"诗经","g":"诗","x":"风雨凄凄，鸡鸣喈喈，既见君子。云胡不夷？","b":1,"y":-550,"th":["爱情","思念","重逢"],"ap":1},{"id":"fc7706dea687","t":"权舆","a":"佚名","d":1,"f":"诗经","g":"诗","x":"于我乎，夏屋渠渠，今也每食无余。于嗟乎，不承权舆！","b":5,"y":-221,"th":["怀古","感伤","今昔对比"],"ap":1}]